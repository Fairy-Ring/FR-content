~send_quest_progress_colour(questlist:death, %death_equiproom, ^death_complete);
~send_quest_progress_colour(questlist:troll, %troll_quest, ^troll_complete);
~send_quest_progress_colour(questlist:troll_love, %troll_love, ^troll_love_complete);
~send_quest_progress_colour(questlist:golem, %golem_a, ^golem_complete);
// Recruitment Drive — narrow journal colour (product writer t_130905cb).
~send_quest_progress_colour(questlist:rd, %rd_main, ^recruitmentdrive_complete);
// Haunted Mine — conclusion unit (t_24af0ea3). Distinct from questlist:haunted (Ernest).
~send_quest_progress_colour(questlist:hauntedmine, %hauntedmine, ^hauntedmine_complete);
// Creature of Fenkenstrain — M1 journal colour (t_d99d6bbc).
~send_quest_progress_colour(questlist:creatureoffenkenstrain, %fenk_quest, ^creatureoffenkenstrain_complete);
// Wanted! start/deputising progress persists through the shared login refresh.
~send_quest_progress_colour(questlist:wanted, %wanted_main, ^wanted_complete);
// Desert Treasure: without this line a relog leaves the started quest's row at its default colour.
~send_quest_progress_colour(questlist:deserttreasure, %deserttreasure, ^deserttreasure_complete);
~send_quest_progress_colour(questlist:onesmallfavour, %onesmallfavour, ^onesmallfavour_complete);
~send_quest_progress_colour(questlist:elid, %elidquest, ^elid_complete);
~send_quest_progress_colour(questlist:makinghistory, %makinghistory_prog, ^makinghistory_complete);
~send_quest_progress_colour(questlist:rag, ~rag_stage, ^rag_complete);
~send_quest_progress_colour(questlist:mdaughter, %mdaughter_quest_var, ^mdaughter_complete);
