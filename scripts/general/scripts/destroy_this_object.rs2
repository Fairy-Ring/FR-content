[if_close,destroy_this_object]
inv_stoptransmit(destroy_this_object:com_0);
inv_clear(destroy_this_object_display);

[label,open_destroy_this_object](namedobj $display_obj)
def_int $slot = last_slot;
def_obj $obj = inv_getobj(inv, $slot);
if ($obj = null) {
    return;
}
if ($obj ! last_item) {
    return;
}
def_int $count = inv_getnum(inv, $slot);
if_settext(destroy_this_object:com_13, oc_name($obj));
if_settext(destroy_this_object:com_11, ^string_empty);
if_settext(destroy_this_object:com_12, ^string_empty);
inv_clear(destroy_this_object_display);
inv_setslot(destroy_this_object_display, 0, $display_obj, $count);
inv_transmit(destroy_this_object_display, destroy_this_object:com_0);
if_openchat(destroy_this_object);
if_addresumebutton(destroy_this_object:com_4);
if_addresumebutton(destroy_this_object:com_5);
p_pausebutton;
inv_stoptransmit(destroy_this_object:com_0);
inv_clear(destroy_this_object_display);
if (last_com = destroy_this_object:com_4) {
    if (inv_getobj(inv, $slot) = $obj) inv_delslot(inv, $slot);
}
if_close;
