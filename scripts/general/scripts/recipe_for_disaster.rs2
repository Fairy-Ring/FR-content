// Recipe for Disaster guest icons; see the evidence file for source confidence.
// CANDIDATE: these fixed cache heads match the eight named rows.

[if_button,questlist:hundred_main]
inv_clear(rfd_journal_icons);
inv_setslot(rfd_journal_icons, 0, 100_journal_head_dwarf, 1);
inv_setslot(rfd_journal_icons, 1, 100_journal_head_goblin, 1);
inv_setslot(rfd_journal_icons, 2, 100_journal_head_pirate, 1);
inv_setslot(rfd_journal_icons, 3, 100_journal_head_guide, 1);
inv_setslot(rfd_journal_icons, 4, 100_journal_head_dave, 1);
inv_setslot(rfd_journal_icons, 5, 100_journal_head_monkey, 1);
inv_setslot(rfd_journal_icons, 6, 100_journal_head_sir, 1);
inv_setslot(rfd_journal_icons, 7, 100_journal_head_skrach, 1);
inv_transmit(rfd_journal_icons, recipe_for_disaster:com_11);
// UNKNOWN functional journal wording, not a recovered period transcript.
if (%hundred_main_quest_var = 0) {
    if_settext(recipe_for_disaster:com_14, "Speak to the Cook in Lumbridge Castle to begin.");
} else if (%hundred_main_quest_var = 1) {
    if_settext(recipe_for_disaster:com_14, "Bring the Cook his four requested ingredients.");
} else if (%hundred_main_quest_var = ^rfd_feast_ready) {
    if_settext(recipe_for_disaster:com_14, "Enter the dining room from Lumbridge Castle's kitchen.");
} else if (%hundred_main_quest_var >= ^rfd_complete) {
    if_settext(recipe_for_disaster:com_14, "Quest complete. Full access to the Culinaromancer's Chest.");
} else if (%hundred_main_quest_var = ^rfd_finale_ready) {
    if_settext(recipe_for_disaster:com_14, "Defeat the Culinaromancer through the portal in the banquet room.");
} else {
    if_settext(recipe_for_disaster:com_14, "Guests rescued: <tostring(%hundred_subquest_tally)> of 8.");
}
~send_quest_progress_colour(recipe_for_disaster:com_2, %hundred_dwarf_quest, ^rfd_guest_complete);
~send_quest_progress_colour(recipe_for_disaster:com_3, %100goblin, ^rfd_guest_complete);
~send_quest_progress_colour(recipe_for_disaster:com_4, %100_pirate_quest_var, ^rfd_guest_complete);
~send_quest_progress_colour(recipe_for_disaster:com_5, %100guide_prog, ^rfd_guest_complete);
~send_quest_progress_colour(recipe_for_disaster:com_6, %hundred_dave_main, ^rfd_dave_complete);
~send_quest_progress_colour(recipe_for_disaster:com_7, %100_ogre_prog, ^rfd_guest_complete);
~send_quest_progress_colour(recipe_for_disaster:com_8, %chickenquest, ^rfd_guest_complete);
~send_quest_progress_colour(recipe_for_disaster:com_9, %hundred_ilm_quest, ^rfd_guest_complete);
if_openmain(recipe_for_disaster);

[if_close,recipe_for_disaster]
inv_stoptransmit(recipe_for_disaster:com_11);
inv_clear(rfd_journal_icons);

// UNKNOWN functional guest journals; prerequisite and reward values follow the period guide.
[if_button,recipe_for_disaster:com_2]
def_string $text;
if (%hundred_dwarf_quest = ^rfd_guest_complete) {
    $text = "@str@I freed the Mountain Dwarf with a cooled Dwarven rock cake.|@red@GUEST RESCUED!";
} else if (%hundred_dwarf_quest = 0) {
    $text = "I should inspect the frozen Mountain Dwarf in the banquet room.|I must first complete Fishing Contest.";
} else {
    $text = "I need a cooled Dwarven rock cake for the Mountain Dwarf.|Rohak in the passage beneath White Wolf Mountain can make it.|I should ask about his son and bring the ingredients he requests.|Ice gloves will protect my hands when I collect the hot cake.";
}
~quest_journal("Freeing the Mountain Dwarf", $text);

[if_button,recipe_for_disaster:com_3]
def_string $text;
if (%100goblin = ^rfd_guest_complete) {
    $text = "@str@I freed Wartface and Bentnoze with Slop of Compromise.|@red@GUESTS RESCUED!";
} else if (%100goblin = 0) {
    $text = "I should inspect the frozen Goblin Generals in the banquet room.|I must first complete Goblin Diplomacy.";
} else {
    $text = "I should speak to the cook beneath Goblin Village.|Wartface and Bentnoze need food they can both accept.|I need dyed orange slices, spicy maggots and soggy bread.";
}
~quest_journal("Freeing the Goblin Generals", $text);

[if_button,recipe_for_disaster:com_4]
def_string $text;
if (%100_pirate_quest_var = ^rfd_guest_complete) {
    $text = "@str@I freed Pirate Pete with a fishcake.|@red@GUEST RESCUED!";
} else if (%100_pirate_quest_var = 0) {
    $text = "I should inspect frozen Pirate Pete in the banquet room.|I need level 31 Cooking.";
} else if (%100_pirate_quest_var = ^rfd_pete_inspected) {
    $text = "I should ask the Lumbridge Cook how to make Pete's fishcake.";
} else if (%100_pirate_quest_var < ^rfd_pete_pen_access) {
    $text = "Murphy at Port Khazard can help me dive for the ingredients.|I need a fishbowl, and must wear both pieces of diving equipment.|I must weigh no more than 27kg and leave my cat behind.|Underwater, Nung needs five mudskipper hides, then three bronze|wires and a needle. Five rocks will weigh me down in the cavern.";
} else {
    $text = "I need breadcrumbs, ground cod, ground kelp and ground crab meat.|I can grind the cod, kelp and crab meat with a pestle and mortar,|and cut bread with a knife. I should combine all four ingredients,|cook the raw fishcake on a range, then use it on Pirate Pete.";
}
~quest_journal("Freeing Pirate Pete", $text);

[if_button,recipe_for_disaster:com_5]
def_string $text;
if (%100guide_prog = ^rfd_guest_complete) {
    $text = "@str@I freed the Lumbridge Guide with a Cake of Guidance.|@red@GUEST RESCUED!";
} else {
    $text = "I should inspect the frozen Lumbridge Guide.|I need level 40 Cooking, Big Chompy Bird Hunting, Biohazard,|Demon Slayer, Murder Mystery, Nature Spirit, Priest in Peril,|The Restless Ghost and Witch's House.|Traiborn in the Wizards' Tower can enchant cake ingredients.|I should bake the Cake of Guidance in Lumbridge Castle.";
}
~quest_journal("Freeing the Lumbridge Guide", $text);

[if_button,recipe_for_disaster:com_6]
def_string $text;
if (%hundred_dave_main = ^rfd_dave_complete) {
    $text = "@str@I freed Evil Dave with his specially seasoned stew.|@red@GUEST RESCUED!";
} else {
    $text = "I should inspect frozen Evil Dave.|I need Gertrude's Cat, Shadow of the Storm and level 25 Cooking.|Doris lives west of Edgeville bank. Dave is in her cellar.|My cat can catch Hell-Rats for four colours of spice.|Dave can taste my stew and count the correct spice amounts.|I should take an approved stew to Dave in the banquet.";
}
~quest_journal("Freeing Evil Dave", $text);

[if_button,recipe_for_disaster:com_7]
def_string $text;
if (%100_ogre_prog = ^rfd_guest_complete) {
    $text = "@str@I freed Skrach Uglogwee with cooked Jubbly.|@red@GUEST RESCUED!";
} else {
    $text = "I should inspect frozen Skrach Uglogwee.|I need Big Chompy Bird Hunting, level 41 Cooking and|level 20 Firemaking. Rantz in Feldip Hills can help.|I need balloon toads to lure a Jubbly, then my ogre bow|to hunt it. I should pluck it and roast it on Rantz's spit.";
}
~quest_journal("Freeing Skrach Uglogwee", $text);

[if_button,recipe_for_disaster:com_8]
def_string $text;
if (%chickenquest = ^rfd_guest_complete) {
    $text = "@str@I freed Sir Amik Varze with Brulee supreme.|@red@GUEST RESCUED!";
} else {
    $text = "I should inspect frozen Sir Amik Varze.|I must complete Lost City and start Legends' Quest.|The Cook can explain his creme brulee recipe.|I need milk, cream, cornflour, vanilla, cinnamon ground from|a Dramen branch and the Evil Chicken's egg.|The Wise Old Man in Draynor knows about the Evil Chicken.|Raw chicken on the Zanaris shrine leads to its lair.|A Black dragon drops a token. I should wear ice gloves|and rub the token to have the brulee flambeed.";
}
~quest_journal("Freeing Sir Amik Varze", $text);

[if_button,recipe_for_disaster:com_9]
def_string $text;
if (%hundred_ilm_quest = ^rfd_guest_complete) {
    $text = "@str@I freed King Awowogei with a cooked stuffed snake.|@red@GUEST RESCUED!";
} else {
    $text = "I should inspect frozen Awowogei.|I need Monkey Madness, level 70 Cooking and level 48 Agility.|Awowogei and the Three Monkeys on Ape Atoll know his food.|I need a giant snake corpse, sliced red banana and Tchiki nut paste.|A guard greegree and rope help collect red bananas.|A ninja greegree helps reach the nuts beyond the agility course.|The monkeys want to taste the first correct ingredients.|A zombie greegree protects me at the temple's lava oven.";
}
~quest_journal("Freeing King Awowogei", $text);
