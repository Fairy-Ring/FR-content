// CANDIDATE: source-backed drain, selected bounds/cadence; see ice-product-contract-1109.
[proc,dt_ice_cold_area]()(boolean)
if (inzone(^dt_ice_cold_valley_sw, ^dt_ice_cold_valley_ne, coord) = true | inzone(^dt_ice_cold_wolves_sw, ^dt_ice_cold_wolves_ne, coord) = true | inzone(^dt_ice_cold_clearing_sw, ^dt_ice_cold_clearing_ne, coord) = true | inzone(^dt_ice_cold_ridge_sw, ^dt_ice_cold_ridge_ne, coord) = true | inzone(^dt_ice_cold_parents_sw, ^dt_ice_cold_parents_ne, coord) = true) return(true);
return(false);

[proc,dt_ice_enter_zone]
if (~dt_ice_cold_area = false) return;
// Align re-entries to the same pulse; crossing a zone cannot postpone the cold.
settimer(dt_ice_cold, sub(^dt_ice_cold_ticks, modulo(map_clock, ^dt_ice_cold_ticks)));
~dt_kamil_spawn;

[timer,dt_ice_cold]
if (~dt_ice_cold_area = false) {
    cleartimer(dt_ice_cold);
    return;
}
settimer(dt_ice_cold, ^dt_ice_cold_ticks);
queue(dt_ice_cold_damage, 0, 0);
if (coordy(coord) = 1 & stat_random(agility, ^dt_ice_slip_low, ^dt_ice_slip_high) = false) queue(dt_ice_slip, 0, 0);
~dt_kamil_spawn;

[queue,dt_ice_cold_damage]
if (~dt_ice_cold_area = false) return;
def_int $i = 1;
while ($i <= enum_getoutputcount(stats)) {
    def_stat $stat = enum(int, stat, stats, $i);
    if ($stat ! hitpoints & stat($stat) > 1) stat_sub($stat, 1, 0);
    $i = add($i, 1);
}
healenergy(-10000);
%sa_energy = 0;
// Period guides agree on one hitpoint; cold alone never takes the last hitpoint.
def_int $damage = min(1, max(0, sub(stat(hitpoints), 1)));
if ($damage > 0) ~damage_self($damage);

// Original zone coordinates; no new saved state or shared mapzone override.
[zone,0_44_58_16_0] ~dt_ice_enter_zone;
[zone,0_44_58_16_8] ~dt_ice_enter_zone;
