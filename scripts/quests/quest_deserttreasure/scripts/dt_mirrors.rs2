// Desert Treasure — Look-into the six mystical mirrors after Eblis sets them
// up (%fd_mirror_present = 1). Chat only — no dest, no rotate_mirror 6084,
// no warriors / Ancient Magicks, no %deserttreasure write (stays 10).
// CANDIDATE gaze wording from later OSRS Transcript:Desert Treasure I, minus Changes.
// Exact scene/camera presentation remains UNKNOWN; no unsupported placeholder text.

[oploc1,fd_mirror1] @dt_mirror_look;
[oploc1,fd_mirror2] @dt_mirror_look;
[oploc1,fd_mirror3] @dt_mirror_look;
[oploc1,fd_mirror4] @dt_mirror_look;
[oploc1,fd_mirror5] @dt_mirror_look;
[oploc1,fd_mirror6] @dt_mirror_look;
[oploc1,sword_mirror1] @dt_mirror_look;
[oploc1,sword_mirror2] @dt_mirror_look;
[oploc1,sword_mirror3] @dt_mirror_look;
[oploc1,sword_mirror4] @dt_mirror_look;
[oploc1,sword_mirror5] @dt_mirror_look;
[oploc1,sword_mirror6] @dt_mirror_look;

[label,dt_mirror_look]
// Three full stops, not U+2026: the engine writes one byte per character, so the 377 client
// received "&" (found by the S1 live round 2).
mes("You gaze into the mirror...");
