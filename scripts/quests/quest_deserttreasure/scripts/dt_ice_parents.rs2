// CANDIDATE: two original 377 NPC blocks; source-backed 10 HP and independent rescue flags.
[opnpc2,troll_block_1] ~dt_ice_smash(true);
[opnpc2,fd_trollblock1] ~dt_ice_smash(true);
[opnpc2,troll_block_2] ~dt_ice_smash(false);
[opnpc2,fd_trollblock2] ~dt_ice_smash(false);

[proc,dt_ice_smash](boolean $dad)
if (%deserttreasure < ^dt_stage_hunts | %fd_icewarrior_dead = 0 | %fd_icewarrior_subquest ! ^dt_ice_substate_kamil_dead) return;
if (($dad = true & %fd_icewarrior_dadfree ! 0) | ($dad = false & %fd_icewarrior_mumfree ! 0)) return;
if (%action_delay > map_clock) {
    p_opnpc(2);
    return;
}
if_close;
anim(%com_attackanim, 0);
// CANDIDATE: ordinary equipped melee maximum; no elemental shortcut or fixed kill.
def_int $damage = min(randominc(max(1, %com_maxhit)), npc_stat(hitpoints));
npc_heropoints($damage);
if ($damage = 0) npc_damage(^hitmark_block, 0);
else npc_damage(^hitmark_damage, $damage);
%action_delay = add(map_clock, 4);
if (npc_stat(hitpoints) = 0) {
    p_stopaction;
    ~dt_ice_block_broken($dad);
    return;
}
p_opnpc(2);

[ai_queue3,troll_block_1] ~dt_ice_block_broken(true);
[ai_queue3,fd_trollblock1] ~dt_ice_block_broken(true);
[ai_queue3,troll_block_2] ~dt_ice_block_broken(false);
[ai_queue3,fd_trollblock2] ~dt_ice_block_broken(false);

[proc,dt_ice_block_broken](boolean $dad)
if (npc_findhero = ^false) {
    npc_statheal(hitpoints, 10, 0);
    return;
}
queue*(dt_ice_block_freed, 0)($dad);
// Keep the native multi-NPC for other players. Full healing also clears native hero points.
npc_statheal(hitpoints, 10, 0);

[queue,dt_ice_block_freed](boolean $dad)
if (%deserttreasure < ^dt_stage_hunts) return;
if (%fd_icewarrior_dead ! 0 & %fd_icewarrior_subquest = ^dt_ice_substate_kamil_dead) {
    if ($dad = true) %fd_icewarrior_dadfree = 1;
    else %fd_icewarrior_mumfree = 1;
    if (%fd_icewarrior_dadfree ! 0 & %fd_icewarrior_mumfree ! 0) {
        %fd_icewarrior_subquest = ^dt_ice_substate_parents_freed;
    }
}

[opnpc1,troll_block_1] ~dt_ice_parent_talk(true);
[opnpc1,fd_trollblock1] ~dt_ice_parent_talk(true);
[opnpc1,fd_troll_dad] ~dt_ice_parent_talk(true);
[opnpc1,troll_block_2] ~dt_ice_parent_talk(false);
[opnpc1,fd_trollblock2] ~dt_ice_parent_talk(false);
[opnpc1,fd_troll_mum] ~dt_ice_parent_talk(false);
[opnpc1,troll_frozen_1] ~dt_ice_parent_talk(true);
[opnpc1,troll_frozen_2] ~dt_ice_parent_talk(false);

[proc,dt_ice_parent_talk](boolean $dad)
if (%fd_icewarrior_subquest >= ^dt_ice_substate_family_returned) {
    if ($dad = true) ~chatnpc_specific("Troll father", fd_troll_dad, "Thanks again for freeing me from that ice block! I might be a troll, but it was real uncomfortable in there!");
    else ~chatnpc_specific("Troll mother", fd_troll_mum, "Thanks again for freeing me from that ice block! I don't know what my little snookums would have done without us!");
    return;
}
if (($dad = true & %fd_icewarrior_dadfree = 0) | ($dad = false & %fd_icewarrior_mumfree = 0)) {
    mes("There is a thick layer of ice covering this troll. You will have to find some way of shattering it.");
    return;
}
if (%fd_icewarrior_dadfree = 0 | %fd_icewarrior_mumfree = 0) {
    if ($dad = true) ~chatnpc_specific("Troll father", fd_troll_dad, "Oh thank you! It was really cold in there! But please, you must free my wife as well! Our son is depending on us!");
    else ~chatnpc_specific("Troll mother", fd_troll_mum, "Wow, thanks for breaking me out of that ice! But please, my husband is still trapped in there!");
    return;
}
if (%fd_icewarrior_subquest ! ^dt_ice_substate_parents_freed) return;
~chatnpc_specific("Troll father", fd_troll_dad, "Phew! Am I glad to be out of that big ice cube! Are you okay too darling?");
~chatnpc_specific("Troll mother", fd_troll_mum, "Yes, I thought we were done for! Why ever did that nasty Kamil freeze us up there anyway?");
~chatplayer("He must have been trying to protect his Diamond...");
~chatnpc_specific("Troll father", fd_troll_dad, "You mean that diamond I found the other day belonged to him? But why didn't he just ask for it back? It's not like I really want it or anything!");
~chatnpc_specific("Troll father", fd_troll_dad, "And how did you know we had that diamond anyway, fleshy?");
~chatplayer("Your son told me. That's why I rescued you, it is very important that I have that diamond...");
~chatnpc_specific("Troll mother", fd_troll_mum, "Ooohhhhh, my poor baby! He must have been so worried about us...");
~chatnpc_specific("Troll father", fd_troll_dad, "Yes, but he certainly inherited his Dad's smarts!");
~chatnpc_specific("Troll father", fd_troll_dad, "If he'd told this fleshy that he had the Diamond and not us, we might never have been rescued!");
~chatplayer("Wait... what? That stupid little troll kid had the diamond all along?");
~chatnpc_specific("Troll mother", fd_troll_mum, "Don't you talk about my baby like that!");
~chatnpc_specific("Troll father", fd_troll_dad, "Now, now dear, all's well that ends well. We've been freed and this fleshy has certainly earned himself that diamond.");
~chatnpc_specific("Troll father", fd_troll_dad, "Let's get out of this terrible place and see our son!");
%fd_icewarrior_subquest = ^dt_ice_substate_family_returned;
// CANDIDATE arrival: original family spawn, not a shortcut around the rescue route.
p_teleport(0_44_58_20_27);
cleartimer(dt_ice_cold);
