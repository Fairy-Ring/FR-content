return(null);

[proc,rag_bone_index](obj $item)(int)
def_int $bone = 1;
while ($bone <= 35) {
    if ($item = ~rag_raw($bone) | $item = ~rag_potted($bone) | $item = ~rag_polished($bone)) return($bone);
    $bone = add($bone, 1);
}
return(0);

// CANDIDATE: OSRS initial-eight drops are guaranteed, unlike wish-list drops.
// UNKNOWN possession policy: include bank and own boiler, not other players.
[proc,rag_drop](int $bone)
if (~rag_stage ! 1 | ~rag_handed($bone) = true) return;
if (~obj_gettotal(~rag_raw($bone)) > 0 | ~obj_gettotal(~rag_potted($bone)) > 0 | ~obj_gettotal(~rag_polished($bone)) > 0) return;
if (%rag_inv_check = $bone & %rag_boiler >= 2) return;
obj_add(npc_coord, ~rag_raw($bone), 1, ^lootdrop_duration);

// Default animal deaths retain their ordinary bones, timing and credit rules.
[ai_queue3,ramsheered] @rag_ram_death;
[ai_queue3,ramunsheered] @rag_ram_death;
[label,rag_ram_death]
gosub(npc_default_death);
if (npc_findhero = ^true) ~rag_drop(4);

[ai_queue3,medium_frog]
gosub(npc_default_death);
if (npc_findhero = ^true) ~rag_drop(3);

[ai_queue3,bat]
gosub(npc_default_death);
if (npc_findhero = ^true) ~rag_drop(8);
