// Creature of Fenkenstrain — Gardener Ghost Talk-to + follower lifecycle.
// CANDIDATE 2007-base (Transcript + Tip.it beats). Bind fenk_gardener 1675.
// Following directions use later RS3/OSRS text; area bounds below are explicit
// CANDIDATE map-square reconstructions, not historical measurements.
// Gate %fenk_quest >= 1. Ghostspeak worn check. Follow: dynamic npc_add +
// playerfollow, CANDIDATE 10 min duration, loss on logout/death/plane/timer
// and ordinary gameplay teleport (stock ~p_telejump_safe). Exact historical
// leash radius: UNKNOWN material gap — do not invent a tile distance or treat
// p_teleport walk/stairs as teleport-loss. Dig independent of follower.
// directions bit hides courtyard multi while following (1666 woods spawn
// UNKNOWN — dynamic add is I representation).
// Cleanup: logout.rs2 + death.rs2 call ~fenk_on_player_cleanup; login queues
// fenk_on_login_cleanup; ~fenk_on_gameplay_teleport from p_telejump_safe.
// Do NOT hook pet.rs2 follower_death (cat hunger/shoo). Separate cat UID.
// Cite full-source-contract §3.2 · fenkenstrain-gardener-first-slice-377.md.

[opnpc1,fenk_gardener]
if (%fenk_quest < ^fenk_hired) {
    return;
}
if (inv_total(worn, amulet_of_ghostspeak) = 0) {
    mes("The gardener's neck twitches at you, but the lack of any head");
    mes("prevents him from speaking.");
    return;
}
// Active dynamic follower owned by this player?
if (%fenk_follower_uid ! null & npc_uid = %fenk_follower_uid & %npc_attacking_uid = uid) {
    @fenk_gardener_following_talk;
    return;
}
// Stale directions bit (e.g. crashed session before cleanup): restore courtyard.
if (%fenk_gardener_directions = 1 & %fenk_follower_uid = null) {
    %fenk_gardener_directions = 0;
}
// Courtyard / reacquire menu
if (%fenk_quest >= ^fenk_assembled) {
    def_int $c2 = ~p_choice4("What happened to your head?", 1, "Can you tell me anything about Fenkenstrain?", 2, "Do you know where the key to the shed is?", 3, "Do you know where a conductor mould is?", 4);
    if ($c2 = 1) {
        @fenk_gardener_head_path;
        return;
    }
    if ($c2 = 2) {
        @fenk_gardener_lore;
        return;
    }
    if ($c2 = 3) {
        @fenk_gardener_shed_key;
        return;
    }
    @fenk_gardener_mould_hint;
    return;
}
def_int $choice = ~p_choice4("What happened to your head?", 1, "Can you tell me anything about Fenkenstrain?", 2, "What's your name?", 3, "I must get back to work.", 4);
if ($choice = 1) {
    @fenk_gardener_head_path;
    return;
}
if ($choice = 2) {
    @fenk_gardener_lore;
    return;
}
if ($choice = 3) {
    ~fenk_gardener_name;
    return;
}
~chatplayer("<p,neutral>I must get back to work.");
return;

[label,fenk_gardener_head_path]
~chatplayer("<p,neutral>What happened to your head?");
~chatnpc("<p,neutral>Oi was in the old 'aunted Forest to the south, diggin' a pit for moi old maaster, old Fenkenstrain, when would you believe it, someone chops me head off. Awful bad luck, weren't it?");
~chatplayer("<p,neutral>Oh yes, dreadful bad luck.");
~chatnpc("<p,neutral>So oi thinks to meself, I don't needs any 'ead to be gettin on with me gardenin', long as I got me hands and me spade.");
~chatplayer("<p,neutral>Would you show me where the place was?");
// Already have head item, or already handed it in — refuse follow.
if (inv_total(inv, fenk_head_empty) > 0 | inv_total(inv, fenk_head_full) > 0 | %fenk_head = 1) {
    ~chatnpc("<p,neutral>No mate, you've found my head already, oi think.");
    %fenk_spoken_to_gardener = 1;
    return;
}
~chatnpc("<p,neutral>Well, oi s'pose oi've got 10 minutes to spare.");
%fenk_spoken_to_gardener = 1;
~fenk_start_gardener_follow;
return;

[label,fenk_gardener_lore]
~chatplayer("<p,neutral>Can you tell me anything about Fenkenstrain?");
~chatnpc("<p,neutral>Oi could tell you a few things about old Fenky, yeah.");
~chatplayer("<p,neutral>Go on.");
~chatnpc("<p,neutral>Once, this castle were full o' good folk - my friends. Fenky was just the castle doctor you know, to the Lord and the castle folk.");
~chatnpc("<p,neutral>I don't know what happened to them all, but one by one they all disappeared. When they were gone a while, I went an dug graves for 'em, in the forest.");
~chatnpc("<p,neutral>After a while there weren't no-one left, but the Lord, Fenkenstrain, and meself.");
~chatnpc("<p,neutral>Old Fenky sent me into the Forest to dig 'im a pit. Never said what for. Then would you believe it, someone chops me head off.");
return;

[proc,fenk_gardener_name]
~chatplayer("<p,quiz>What's your name?");
~chatnpc("<p,neutral>Me name? It's been a moivellous long while, mate, since I had any use for such a thing as a name.");
~chatplayer("<p,neutral>Don't worry, I was just trying to make conversation.");
~chatnpc("<p,neutral>No, no, I can't be havin' that - I'll remember in a minute-");
~chatplayer("<p,neutral>Please, don't worry.");
~chatnpc("<p,happy>Lestwit, that's it! Ed Lestwit!");

[label,fenk_gardener_shed_key]
~chatplayer("<p,quiz>Do you know where the key to the shed is?");
if (inv_total(inv, fenk_shed_key) > 0) {
    ~chatnpc("<p,neutral>You've already got the key, mate.");
    return;
}
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>Got it right 'ere in my pocket - but your hands are full.");
    return;
}
~chatnpc("<p,neutral>Got it right 'ere in my pocket. Here you go.");
inv_add(inv, fenk_shed_key, 1);
~objbox(fenk_shed_key, "The headless gardener hands you a rusty key.", 250, 0, 0);
return;

[label,fenk_gardener_mould_hint]
~chatplayer("<p,quiz>Do you know where I can find a lightning conductor mould?");
~chatnpc("<p,neutral>A conductive mould, you say? Let me see-");
~chatnpc("<p,neutral>There used to be a bloke 'ere, sort of an 'andyman e was. Did everything round the place - fixed what was broke, swept the chimneys and the like. He would 'ave had a mould, I imagine.");
~chatplayer("<p,quiz>Where is he now?");
~chatnpc("<p,sad>E's dead, just like everyone else round 'ere ... 'cept for me.");
return;

// Current RS3/OSRS transcripts provide qualitative area labels only. CANDIDATE
// geometry: Castle=m55_55; Woods=m55_54..m56_54; grave threshold=3x3 at 3608,3491.
// `coord_direction` supplies the dominant-axis cardinal; its tie is east/west.
[label,fenk_gardener_following_talk]
if (inzone(0_55_55_0_0, 0_55_55_63_63, coord) = true) {
    npc_say("You need to head off to them Haunted Woods, mate.");
    ~fenk_resume_owned_follow;
    return;
}
if (inzone(0_55_54_0_0, 0_56_54_63_63, coord) = true) {
    if (inzone(0_56_54_23_34, 0_56_54_25_36, coord) = true) {
        npc_say("This is the place where I met me' maker.");
        // OSRS says he returns to the Castle; clear the owned dynamic copy so
        // the courtyard multi becomes visible again after the overhead is sent.
        queue(fenk_gardener_clear_follow, 1, 0);
        return;
    }
    def_int $direction = ~coord_direction(coord, 0_56_54_24_35);
    switch_int ($direction) {
        case ^exact_north : npc_say("Go north, mate.");
        case ^exact_east : npc_say("Go east, mate.");
        case ^exact_south : npc_say("Go south, mate.");
        case ^exact_west : npc_say("Go west, mate.");
    }
    ~fenk_resume_owned_follow;
    return;
}
~fenk_gardener_stray;
return;

// Talk-to sets a facing interaction. Resume PLAYERFOLLOW only for this player's
// owned dynamic follower. Courtyard multi, another player's actor, or missing
// ownership: no-op. Does not add, delete, retarget or rewrite lifetime.
[proc,fenk_resume_owned_follow]
if (%fenk_follower_uid = null) {
    return;
}
if (npc_uid ! %fenk_follower_uid) {
    return;
}
if (%npc_attacking_uid ! uid) {
    return;
}
npc_setmode(playerfollow);

// The current transcript presents the two departure lines in sequence.
// NPC_SAY replaces the active overhead for the tick. A nonzero queue delay keeps
// each line visible before the next one or deletion, even within queue processing.
[proc,fenk_gardener_stray]
if (%fenk_follower_uid = null) {
    return;
}
if (npc_uid ! %fenk_follower_uid | %npc_attacking_uid ! uid) {
    return;
}
clearsofttimer(fenk_follow_watch);
npc_say("Oi'm afraid you've gone well off the beaten track.");
queue(fenk_gardener_stray_followup, 1, 0);

[queue,fenk_gardener_stray_followup]
if (%fenk_follower_uid = null) {
    ~fenk_clear_gardener_follow;
    return;
}
if (npc_finduid(%fenk_follower_uid) = false) {
    ~fenk_clear_gardener_follow;
    return;
}
if (npc_uid ! %fenk_follower_uid | %npc_attacking_uid ! uid) {
    ~fenk_clear_gardener_follow;
    return;
}
npc_say("Fare thee well - oi must return to me' garden.");
queue(fenk_gardener_clear_follow, 1, 0);

[queue,fenk_gardener_clear_follow]
~fenk_clear_gardener_follow;


// --- follower start / stop ---
[proc,fenk_start_gardener_follow]
// Clear any prior owned follower first (also restores directions=0 then re-set).
~fenk_clear_gardener_follow;
// Hide courtyard multi while following (bit 31).
%fenk_gardener_directions = 1;
def_coord $spawn = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk);
if ($spawn = null) {
    $spawn = coord;
}
// Duration CANDIDATE 10 minutes; npc lifetime = follow window.
// Type fenk_gardener is mobile (no moverestrict=nomove). Multi parents alone are
// NOMOVE-pinned; engine short-circuits updateMovement on NOMOVE regardless of mode.
npc_add($spawn, fenk_gardener, ^fenk_follow_ticks);
%npc_attacking_uid = uid;
%fenk_follower_uid = npc_uid;
npc_setmode(playerfollow);
npc_settimer(10);
softtimer(fenk_follow_watch, 10);
mes("The gardener ghost starts to follow you.");

[proc,fenk_clear_gardener_follow]
clearsofttimer(fenk_follow_watch);
if (%fenk_follower_uid ! null) {
    if (npc_finduid(%fenk_follower_uid) = true) {
        // Only delete dynamic follower owned by this player.
        // Guard stale owner / NPC-slot reuse: attacking_uid must match this player.
        if (%npc_attacking_uid = uid) {
            npc_del;
        }
    }
}
%fenk_follower_uid = null;
// Restore courtyard gardener multi visibility (bit31 → 0 shows multi_2 child).
%fenk_gardener_directions = 0;

// Ordinary gameplay teleport loss (guide CANDIDATE: stop follow on teleport).
// Stock owner: scripts/skill_magic/scripts/spells/teleport.rs2 ~p_telejump_safe
// (magic, jewellery, levers that use ~player_teleport_normal). Not p_teleport
// (stairs / death dest / short walk). Does not touch cat %follower_uid or RD.
[proc,fenk_on_gameplay_teleport]
if (%fenk_follower_uid = null) {
    return;
}
mes("The gardener ghost stops following you.");
~fenk_clear_gardener_follow;

// Softtimer has active_player only — not p_active_player. Protected writes
// (%fenk_follower_uid, %fenk_gardener_directions via fenk_flags) must go through
// a queue (p_active_player), not ~fenk_clear_gardener_follow directly.
[softtimer,fenk_follow_watch]
if (%fenk_follower_uid = null) {
    clearsofttimer(fenk_follow_watch);
    return;
}
if (npc_finduid(%fenk_follower_uid) = false) {
    clearsofttimer(fenk_follow_watch);
    mes("The gardener ghost has stopped following you.");
    queue(fenk_on_login_cleanup, 0, 0);
    return;
}
// Plane change (level tele / dungeon hop): end follow. Exact tile leash radius
// is UNKNOWN — do not invent a historical distance check here.
if (coordy(coord) ! coordy(npc_coord)) {
    clearsofttimer(fenk_follow_watch);
    mes("The gardener ghost stops following you.");
    queue(fenk_on_login_cleanup, 0, 0);
    return;
}
// Source-backed direction-area loss: only the explicit Castle/Woods map-square
// reconstruction is accepted; no numeric leash radius is inferred.
if (inzone(0_55_55_0_0, 0_55_55_63_63, coord) = false & inzone(0_55_54_0_0, 0_56_54_63_63, coord) = false) {
    ~fenk_gardener_stray;
    return;
}

// NPC-side timer: expire / owner lost.
[ai_timer,fenk_gardener]
if (%npc_attacking_uid = null) {
    return;
}
if (finduid(%npc_attacking_uid) = false) {
    npc_del;
    return;
}
if (p_finduid(%npc_attacking_uid) = true) {
    if (%fenk_follower_uid ! npc_uid) {
        // Not the active follower session (courtyard multi child shares type).
        return;
    }
}

// Logout / death — called from login_logout/logout.rs2 and player/death.rs2.
// Restores directions bit so courtyard gardener is never hidden forever.
// Safe no-op when no active gardener follow.
[proc,fenk_on_player_cleanup]
~fenk_clear_gardener_follow;

// Login queue (login.rs2 adjacent follower_login): clear stale temp UID + restore multi.
[queue,fenk_on_login_cleanup]
~fenk_on_player_cleanup;
