// Creature of Fenkenstrain — memorial Search/Push/star Use + cavern/island return.
//
// Map pairing (CANDIDATE stands from root static collision receipt
// `.tmp/r377-fenkenstrain-m1-2026-09-09/root-memorial-collision.json`):
//   east-surface 5167@3578,3527 angle3 → underband stand 3577,9927 (0_55_155_57_7)
//     unique reachable/unblocked sample beside ladder_1757@3578,9927
//   island-surface 5167@3505,3571 angle0 → underband stand 3504,9969 (0_54_155_48_49)
//     unique reachable/unblocked sample beside ladder_1757@3504,9970
// Wiki (spine-old17 lines 105–110): climb ladder to island graves, then Push the
// memorial you came out of and RETRACE STEPS THROUGH CAVERN — island Push is a
// downward return to positive dungeon band, NOT surface z−6400 (that yields z=−2829).
// Do not use generic west offset on rotated east coffin (angle3). Exact historical
// teleport offset remains unproven live; collision proves approach/stand only.
// Return surface←underband: stock ladder_1757 Climb-up movecoord(coord,0,0,−6400)
// (ladders.rs2) at mapped 3504,9970 and 3578,9927 — no fenk-named ladder join.
// Cite full-source-contract §2.2–2.4 · §3.4 · Transcript 185–196.

[oploc2,fenk_coffin]
// Search
if (loc_coord = 0_55_55_58_7) {
    // Easternmost memorial
    if (%fenk_coffin = 1) {
        mes("The star amulet is already fitted into the depression.");
        return;
    }
    mes("You find a depression in the memorial stone in the shape of a six-pointed star.");
    return;
}
mes("You find nothing remarkable about the memorial stone.");

[oploc1,fenk_coffin]
// Push
p_arrivedelay;
if (loc_coord = 0_55_55_58_7) {
    if (%fenk_coffin = 0) {
        mes("The coffin is incredibly heavy, and does not budge.");
        return;
    }
    // CANDIDATE enter: underband stand 3577,9927 next to ladder_1757@3578,9927
    mes("You push the memorial aside and climb down into the darkness.");
    p_telejump(0_55_155_57_7);
    return;
}
if (loc_coord = 0_54_55_49_51) {
    // CANDIDATE island→cavern return: underband stand 3504,9969 next to ladder@3504,9970
    // (wiki retrace-through-cavern; NOT surface −6400)
    mes("You push the memorial aside and climb back down into the cavern.");
    p_telejump(0_54_155_48_49);
    return;
}
mes("The coffin is incredibly heavy, and does not budge.");

[oplocu,fenk_coffin]
if (last_useitem ! fenk_star_amulet) {
    ~displaymessage(^dm_default);
    return;
}
if (loc_coord ! 0_55_55_58_7) {
    mes("Nothing interesting happens.");
    return;
}
if (%fenk_coffin = 1) {
    mes("The star amulet is already fitted into the depression.");
    return;
}
inv_del(inv, fenk_star_amulet, 1);
%fenk_coffin = 1;
~objbox(fenk_star_amulet, "The star amulet fits exactly into the depression on the coffin lid.", 250, 0, 0);
