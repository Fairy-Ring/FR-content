// Creature of Fenkenstrain — Dr Fenkenstrain Talk-to (stage-gated).
// CANDIDATE 2007-base lines (OSRS Transcript:Creature of Fenkenstrain minus
// 2020 signpost-start overlay). Period menus VERIFIED (RuneVillage 14 Feb /
// 5 May 2006): Q1 Braindead, Q2 Grave-digging. Bind fenk_fenkenstrain_model
// 1670 (multi 1668 keys 0-7; key 8 tower). Fixes repeat-interview defect.
// Cite full-source-contract §3.1 · Transcript · red-19-start-impl-377.md §2.

[opnpc1,fenk_fenkenstrain_model]
if (%fenk_quest >= ^fenk_complete) {
    @fenk_dr_postquest;
    return;
}
if (%fenk_quest >= ^fenk_lightning_done) {
    @fenk_dr_after_lightning;
    return;
}
if (%fenk_quest >= ^fenk_assembled) {
    @fenk_dr_assembled;
    return;
}
if (%fenk_quest >= ^fenk_need_sewing) {
    @fenk_dr_need_sewing;
    return;
}
if (%fenk_quest >= ^fenk_hired) {
    @fenk_dr_hired;
    return;
}
// --- hire interview (quest 0 only) ---
~chatnpc("<p,neutral>Have you come to apply for the job?");
def_int $apply = ~p_choice2("Yes.", 1, "No.", 2);
if ($apply = 2) {
    ~chatplayer("<p,neutral>No.");
    return;
}
~chatplayer("<p,neutral>Yes, if it pays well.");
~chatnpc("<p,neutral>I'll have to ask you some questions first.");
~chatplayer("<p,neutral>Okay...");
~chatnpc("<p,neutral>How would you describe yourself in one word?");
def_int $desc = ~p_choice4("Stunning.", 1, "Awe-inspiring.", 2, "Breathtaking.", 3, "Braindead.", 4);
if ($desc = 4) {
    ~chatnpc("<p,neutral>Mmmm, I see.");
    ~chatnpc("<p,neutral>Just one more question. What would you say is your greatest skill?");
    def_int $skill = ~p_choice4("Combat.", 1, "Magic.", 2, "Cooking.", 3, "Grave-digging.", 4);
    if ($skill = 4) {
        ~chatnpc("<p,neutral>Mmmm, I see.");
        ~chatnpc("<p,happy>Looks like you're just the <text_gender("man", "woman")> for the job! Welcome aboard!");
        ~chatplayer("<p,neutral>Is there anything you'd like me to do for you, sir?");
        ~chatnpc("<p,neutral>Yes, there is. You're highly skilled at grave-digging, yes?");
        ~chatplayer("<p,neutral>Err...yes, that's what I said.");
        ~chatnpc("<p,neutral>Excellent. Now listen carefully.");
        ~chatnpc("<p,neutral>I need you to find some...stuff...for me.");
        ~chatplayer("<p,neutral>Stuff?");
        ~chatnpc("<p,neutral>That's what I said...stuff.");
        ~chatplayer("<p,neutral>What kind of stuff?");
        ~chatnpc("<p,neutral>Well...dead stuff.");
        ~chatplayer("<p,neutral>Go on...");
        ~chatnpc("<p,neutral>I need you to get me enough dead body parts for me to stitch together a complete body, which I plan to bring to life.");
        ~chatplayer("<p,neutral>Right...okay...if you insist.");
        // Only write hire from 0 — never clobber higher stages.
        if (%fenk_quest = ^fenk_not_started) {
            %fenk_quest = ^fenk_hired;
            ~update_questlist;
        }
        return;
    }
    ~chatnpc("<p,neutral>Mmmm, I see.");
    ~chatnpc("<p,neutral>I'm sorry, but I don't think you have the aptitude for this position.");
    return;
}
~chatnpc("<p,neutral>Mmmm, I see.");
~chatnpc("<p,neutral>I'm sorry, but I don't think you have the aptitude for this position.");

// --- hired: body-part collection / hand-in ---
[label,fenk_dr_hired]
~chatnpc("<p,neutral>Have you brought me any dead body parts yet?");
@fenk_dr_parts_menu;

[label,fenk_dr_parts_menu]
def_int $choice = ~p_choice4("I have some body parts for you.", 1, "Remind me what you want me to do.", 2, "Why are you trying to make this creature?", 3, "I must get back to work, sir.", 4);
if ($choice = 4) {
    ~chatplayer("<p,neutral>I must get back to work, sir.");
    return;
}
if ($choice = 2) {
    ~chatplayer("<p,neutral>Remind me what you want me to do.");
    ~chatnpc("<p,neutral>I need enough dead body parts to stitch together a complete body - head, torso, arms and legs.");
    return;
}
if ($choice = 3) {
    ~chatplayer("<p,neutral>Why are you trying to make this creature?");
    ~chatnpc("<p,neutral>I have my reasons. Do not question them.");
    return;
}
~chatplayer("<p,neutral>I have some body parts for you.");
~fenk_try_hand_parts;
if (%fenk_arms = 1 & %fenk_legs = 1 & %fenk_torso = 1 & %fenk_head = 1) {
    ~chatnpc("<p,happy>Superb!! Those are all the parts I need. Now to sew them together ...");
    ~chatnpc("<p,neutral>Go and get me a needle, and I'll need 5 lots of thread.");
    if (%fenk_quest < ^fenk_need_sewing) {
        %fenk_quest = ^fenk_need_sewing;
        ~update_questlist;
    }
    return;
}
if (%fenk_arms = 0 & %fenk_legs = 0 & %fenk_torso = 0 & %fenk_head = 0) {
    ~chatnpc("<p,neutral>I don't see any body parts. Get to work!");
}
return;

// Partial / cumulative part hand-in (Transcript 361-369).
[proc,fenk_try_hand_parts]
// Full head preferred; empty head alone is not enough for final head bit.
if (%fenk_head = 0 & inv_total(inv, fenk_head_full) > 0) {
    inv_del(inv, fenk_head_full, 1);
    %fenk_head = 1;
    ~chatnpc("<p,happy>Ah, a head - and with a brain no less. Excellent.");
}
if (%fenk_torso = 0 & inv_total(inv, fenk_torso) > 0) {
    inv_del(inv, fenk_torso, 1);
    %fenk_torso = 1;
    ~chatnpc("<p,happy>Wonderful, you've brought me a torso.");
}
if (%fenk_arms = 0 & inv_total(inv, fenk_arms) > 0) {
    inv_del(inv, fenk_arms, 1);
    %fenk_arms = 1;
    ~chatnpc("<p,happy>Great, you've brought me some arms.");
}
if (%fenk_legs = 0 & inv_total(inv, fenk_legs) > 0) {
    inv_del(inv, fenk_legs, 1);
    %fenk_legs = 1;
    ~chatnpc("<p,happy>Excellent, you've brought me some legs.");
}

// --- needle + thread cumulative (Transcript 381-399) ---
[label,fenk_dr_need_sewing]
if (%fenk_needle = 1 & %fenk_threads_given >= 5) {
    @fenk_dr_do_sew;
    return;
}
if (%fenk_needle = 1 & %fenk_threads_given < 5) {
    ~chatnpc("<p,neutral>Where's my thread, <displayname>?");
    ~fenk_try_hand_thread;
    if (%fenk_needle = 1 & %fenk_threads_given >= 5) {
        @fenk_dr_do_sew;
    }
    return;
}
if (%fenk_needle = 0 & %fenk_threads_given >= 5) {
    ~chatnpc("<p,neutral>Where's my needle, <displayname>?");
    ~fenk_try_hand_needle;
    if (%fenk_needle = 1 & %fenk_threads_given >= 5) {
        @fenk_dr_do_sew;
    }
    return;
}
~chatnpc("<p,neutral>Where are my needle and thread, <displayname>?");
~fenk_try_hand_needle;
~fenk_try_hand_thread;
if (%fenk_needle = 1 & %fenk_threads_given >= 5) {
    @fenk_dr_do_sew;
}
return;

[proc,fenk_try_hand_needle]
if (%fenk_needle = 1) {
    return;
}
if (inv_total(inv, needle) < 1) {
    return;
}
// Costume needle SUBTRACT — only plain needle.
inv_del(inv, needle, 1);
%fenk_needle = 1;
~chatnpc("<p,happy>Ah, a needle. Wonderful.");

[proc,fenk_try_hand_thread]
if (%fenk_threads_given >= 5) {
    return;
}
def_int $have = inv_total(inv, thread);
if ($have < 1) {
    return;
}
def_int $need = sub(5, %fenk_threads_given);
def_int $take = $have;
if ($take > $need) {
    $take = $need;
}
inv_del(inv, thread, $take);
%fenk_threads_given = add(%fenk_threads_given, $take);
~chatnpc("<p,happy>Some thread, excellent.");

[label,fenk_dr_do_sew]
~mesbox("Fenkenstrain uses the needle and thread to sew the body parts together. Soon, a hideous creature lies inanimate on the ritual table.");
~chatnpc("<p,neutral>Perfect. But I need one more thing from you - flesh and bones by themselves do not make life.");
~chatplayer("<p,quiz>Really?");
~chatnpc("<p,neutral>I have honed to perfection an ancient ritual that will give life to this creature, but for this I must harness the very power of Nature.");
~chatplayer("<p,quiz>And what power is this?");
~chatnpc("<p,neutral>The power of lightning.");
~chatplayer("<p,neutral>Sorry, can't make lightning, you've got the wrong man-");
~chatnpc("<p,angry>Silence your insolent tongue! The storm that brews overhead will create the lightning. What I need you to do is to repair the lightning conductor on the balcony above.");
~chatplayer("<p,neutral>Repair the lightning conductor, right. Can I have a break, soon? By law I'm entitled to 15 minutes every-");
~chatnpc("<p,angry>Repair the conductor and BEGONE!!!");
if (%fenk_quest < ^fenk_assembled) {
    %fenk_quest = ^fenk_assembled;
    ~update_questlist;
}
return;

// --- after body assembled: conductor advice ---
[label,fenk_dr_assembled]
if (inv_total(inv, fenk_conductor) > 0) {
    ~chatnpc("<p,happy>Very good, you have made a new conductor - now get up on the roof and repair it before this storm passes!");
    return;
}
~chatplayer("<p,quiz>How do I repair the lightning conductor?");
~chatnpc("<p,angry>Oh, it would be easier to do it myself! If you find a conductor mould you should be able to cast a new one.");
~chatnpc("<p,neutral>Remember this, <displayname>: my experiment will only work with a conductor made from silver.");
return;

// --- after lightning ---
[label,fenk_dr_after_lightning]
if (inv_total(inv, fenk_tower_key) > 0 | %fenk_unlocked_tower = 1) {
    // Creature talked path: refuse release
    if (%fenk_counter >= 1) {
        ~chatnpc("<p,shock>So have you destroyed it?!!!?");
        ~chatplayer("<p,angry>Never, now that he has told me the truth!");
        ~chatnpc("<p,shock>Oh my, oh my, this is exactly what I feared!");
        ~chatnpc("<p,shock>Why did you have to pick Rologarth's brain of all brains?!?");
        ~chatplayer("<p,angry>I'm through working for you.");
        ~chatnpc("<p,angry>No!! I refuse to release you!! You must help me build another creature to destroy this dreadful mistake!!");
        return;
    }
    ~chatnpc("<p,shock>Destroy it!!! Take the key to the Tower and take back the life I never should have granted!!!");
    return;
}
~chatplayer("<p,quiz>So did it work, then?");
~chatnpc("<p,sad>Yes, I'm afraid it did, <displayname> - all too well.");
~chatplayer("<p,quiz>I can't see it anywhere.");
~chatnpc("<p,sad>I tricked it into going up to the Tower, and there it remains, imprisoned.");
~chatplayer("<p,quiz>So the creature wasn't all you'd hoped, then?");
~chatnpc("<p,sad>...oh, what have I done...");
~chatplayer("<p,neutral>Oh, I see, we're developing a sense of right and wrong now are we?");
~chatplayer("<p,neutral>Bit late for that, I'd say.");
~chatnpc("<p,shock>I have no control over it! It's coming to get me!");
~chatplayer("<p,quiz>What do you want me to do about it?");
~chatnpc("<p,shock>Destroy it!!! Take the key to the Tower and take back the life I never should have granted!!!");
if (inv_total(inv, fenk_tower_key) < 1 & inv_freespace(inv) = 0) {
    mes("You don't have enough inventory space for the tower key.");
    return;
}
if (inv_total(inv, fenk_tower_key) < 1) {
    inv_add(inv, fenk_tower_key, 1);
    mes("Dr Fenkenstrain hands you a tower key.");
}
return;

// --- post-quest panic ---
[label,fenk_dr_postquest]
~chatnpc("<p,shock>theyrecomingtogetme theyrecomingtogetme...");
~chatplayer("<p,neutral>It is all you deserve. Lord Rologarth is master of this castle once more. Let him protect you - if he wants to.");
~chatnpc("<p,shock>theyrecomingtogetme theyrecomingtogetme...");
