// Creature of Fenkenstrain — Read the job advertisement.
// CANDIDATE OSRS guide retained 2026-11-04: the signpost checks both skills,
// but the doctor still offers the job below those levels. No quest-start UI.
// The refusal is stock product text; the period wording is not known.

[oploc1,fenk_signpost]
if (%fenk_quest = ^fenk_not_started) {
    if (stat(crafting) < 20 | stat(thieving) < 25) {
        mes("You need Crafting level 20 and Thieving level 25 to meet the requirements.");
        return;
    }
}
mes("The signpost has a note pinned onto it. The note says:");
mes("'----Braindead Butler Wanted----");
mes("Gravedigging skills essential - Hunchback advantageous");
mes("See Dr Fenkenstrain at the castle NE of Canifis'");
%fenk_read_signpost = 1;
