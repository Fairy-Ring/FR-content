// VERIFIED compass interaction: Tip.It q116 (2006-05-02), line206.
// VERIFIED original inter_311 face, whiskers and eight nose sequences.
// UNKNOWN eight bearing sectors and near radius (10 tiles), engineering defaults.
[opheld3,twocats_amuletofcatspeak]
~twocats_locator_open;

[proc,twocats_locator_open]
if (inv_total(inv, twocats_amuletofcatspeak) = 0 & inv_total(worn, twocats_amuletofcatspeak) = 0) return;
if_openmain(inter_311);
~twocats_locator_update;

[if_button,inter_311:com_5]
%twocats_locator_direction = calc((%twocats_locator_direction + 7) % 8);
~twocats_locator_update;
[if_button,inter_311:com_6]
%twocats_locator_direction = calc((%twocats_locator_direction + 1) % 8);
~twocats_locator_update;

[proc,twocats_locator_update]
if (inv_total(inv, twocats_amuletofcatspeak) = 0 & inv_total(worn, twocats_amuletofcatspeak) = 0) { if_close; return; }
def_int $bearing = ~twocats_bob_bearing;
if_setanim(inter_311:com_2, null);
if_setanim(inter_311:com_3, null);
if_setanim(inter_311:com_4, null);
if ($bearing = %twocats_locator_direction | $bearing = 8) {
    if_setanim(inter_311:com_2, bob_locator_eyes);
    if_setanim(inter_311:com_3, bob_locator_eyes);
}
if ($bearing = 8) if_setanim(inter_311:com_4, bob_locator_eyes);
switch_int (%twocats_locator_direction) {
    case 0 : if_setanim(inter_311:com_1, bob_locator_nose_north);
    case 1 : if_setanim(inter_311:com_1, bob_locator_nose_northeast);
    case 2 : if_setanim(inter_311:com_1, bob_locator_nose_east);
    case 3 : if_setanim(inter_311:com_1, bob_locator_nose_southeast);
    case 4 : if_setanim(inter_311:com_1, bob_locator_nose_south);
    case 5 : if_setanim(inter_311:com_1, bob_locator_nose_southwest);
    case 6 : if_setanim(inter_311:com_1, bob_locator_nose_west);
    case 7 : if_setanim(inter_311:com_1, bob_locator_nose_northwest);
}

[proc,twocats_bob_bearing]()(int)
if (.npc_finduid(%twocats_bob_uid) = false) return(-1);
def_int $dx = calc(coordx(.npc_coord) - coordx(coord));
def_int $dz = calc(coordz(.npc_coord) - coordz(coord));
if (abs($dx) <= 10 & abs($dz) <= 10 & coordy(coord) = coordy(.npc_coord)) return(8);
if (multiply(abs($dx), 2) < abs($dz)) {
    if ($dz > 0) return(0);
    return(4);
}
if (multiply(abs($dz), 2) < abs($dx)) {
    if ($dx > 0) return(2);
    return(6);
}
if ($dx > 0) {
    if ($dz > 0) return(1);
    return(3);
}
if ($dz > 0) return(7);
return(5);
