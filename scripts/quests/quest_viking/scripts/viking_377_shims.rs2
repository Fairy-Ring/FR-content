// 377 engine has midi_jingle(midi, length); 274 used ~music_jingle(midi).
[proc,music_jingle](midi $jingle)
midi_jingle($jingle, 80);

// setidkcolour is a real engine command (274 PlayerOps colors[slot]).
// Viking shoes: setidkcolour(^idk_colour_boots, $color). Makeover still uses setskincolour.
