// Enakhra statue craft — chisel 32 kg lump → base, place on Flat ground.
// Period 23 Jan: Use chisel → base and legs; place on flat ground beside him.
// Gametext CANDIDATE. Do not bind [opheldu,chisel] (live gems).
// Statue 0→1 base, 1→2 body, 2→3 slim. No head / Camulet / 10.
// Cite enakhra-sandstone-period-media-377.md §2.

[opheldu,enakh_sandstone_huge_base+legs]
if (last_useitem ! chisel & last_useitem ! enakh_chisel) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_quest < 1) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, enakh_sandstone_huge_base+legs) < 1) {
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You need some inventory space to do that.");
    return;
}
inv_del(inv, enakh_sandstone_huge_base+legs, 1);
inv_add(inv, enakh_sandstone_crafted_base+legs, 1);
mes("You chisel the sandstone into a statue base.");
return;

[oplocu,enakh_building_area]
if (last_useitem ! enakh_sandstone_crafted_base+legs) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_quest < 1) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_statue_multivar ! 0) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, enakh_sandstone_crafted_base+legs, 1);
%enakh_statue_multivar = 1;
mes("You place the base on the flat ground.");
return;

[opheldu,enakh_sandstone_huge_body]
if (last_useitem ! chisel & last_useitem ! enakh_chisel) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_quest < 1) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, enakh_sandstone_huge_body) < 1) {
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You need some inventory space to do that.");
    return;
}
inv_del(inv, enakh_sandstone_huge_body, 1);
inv_add(inv, enakh_sandstone_crafted_body, 1);
mes("You chisel the sandstone into a statue body.");
return;

[oplocu,enakh_statue_stage_1]
if (last_useitem ! enakh_sandstone_crafted_body) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_quest < 1) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_statue_multivar ! 1) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, enakh_sandstone_crafted_body, 1);
%enakh_statue_multivar = 2;
mes("You add the body to the base.");
return;

[oplocu,enakh_statue_stage_2]
if (last_useitem ! chisel & last_useitem ! enakh_chisel) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_quest < 1) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_statue_multivar ! 2) {
    ~displaymessage(^dm_default);
    return;
}
%enakh_statue_multivar = 3;
mes("You chisel the statue a bit slimmer.");
return;

// Head place — Use one of the four stone heads on the headless statue.
// Keys 4-7 = lazim / zamorak / icthlarin / camel (statue multi multiloc).
// Visual only: no crack / bighole / %enakh_quest write / Camulet / dest.
// CANDIDATE line (2007-base minus Changes). Cite spine-17-remaining-impl-377.md
// §5 + enakh-head-place-next-377.md.

[oplocu,enakh_statue_stage_3]
if (last_useitem = enakh_statue_head_lazim) { @enakh_place_head(4); return; }
if (last_useitem = enakh_statue_head_zamorak) { @enakh_place_head(5); return; }
if (last_useitem = enakh_statue_head_icthlarin) { @enakh_place_head(6); return; }
if (last_useitem = enakh_statue_head_camel) { @enakh_place_head(7); return; }
~displaymessage(^dm_default);

[label,enakh_place_head](int $stage)
if (%enakh_quest < 1) {
    ~displaymessage(^dm_default);
    return;
}
if (%enakh_statue_multivar ! 3) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, last_useitem, 1);
%enakh_statue_multivar = $stage;
mes("You place the stone head on the statue.");
return;
