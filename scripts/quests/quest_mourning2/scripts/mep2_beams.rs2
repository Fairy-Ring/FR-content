// UNKNOWN server routing/orientation encodings over the original 377 beam graph.
// Directions: north0, east1, south2, west3, up4, down5. No new saved state.
// Nodes1..31 use the puzzle slots;32 is the fixed magenta filter;33..38 are
// the three upper drop mirrors and their ground counterparts;39 is the final prism.

[proc,mep2_puzzle_colour_mask](int $colour)(int)
switch_int($colour) {
    case 1 : return(1);
    case 2 : return(3);
    case 3 : return(2);
    case 4 : return(6);
    case 5 : return(4);
    case 6 : return(5);
    case 7 : return(7);
}
return(0);

[proc,mep2_puzzle_colour_index](int $mask)(int)
switch_int($mask) {
    case 1 : return(1);
    case 2 : return(3);
    case 3 : return(2);
    case 4 : return(5);
    case 5 : return(6);
    case 6 : return(4);
    case 7 : return(7);
}
return(0);

[proc,mep2_puzzle_colour_merge](int $first, int $second)(int)
return(~mep2_puzzle_colour_index(or(~mep2_puzzle_colour_mask($first), ~mep2_puzzle_colour_mask($second))));

[proc,mep2_puzzle_filter_colour](int $piece, int $input)(int)
if ($piece < ^mep2_puzzle_crystal_red | $piece > ^mep2_puzzle_crystal_magenta) return(0);
def_int $filter = add(sub($piece, ^mep2_puzzle_crystal_red), 1);
return(~mep2_puzzle_colour_index(and(~mep2_puzzle_colour_mask($input), ~mep2_puzzle_colour_mask($filter))));

[proc,mep2_puzzle_vertical_route](int $node, int $direction, int $colour)(int)
// A vertical span crosses every original intermediate beam field, even where
// that floor has no controllable pillar. Fixed filters remain real intervening nodes.
if ($direction = 4) {
    switch_int($node) {
        case 1 : %mourning_light_temple_1_1_up = $colour; %mourning_light_temple_2_1_up = $colour; return(21);
        case 2 : %mourning_light_temple_1_3_up = $colour; return(12);
        case 3 : %mourning_light_temple_1_6_up = $colour; return(14);
        case 4 : %mourning_light_temple_1_7_up = $colour; return(15);
        case 5 : %mourning_light_temple_1_10_up = $colour; return(17);
        case 6 : %mourning_light_temple_1_11_up = $colour; return(18);
        case 7 : %mourning_light_temple_1_12_up = $colour; %mourning_light_temple_2_12_up = $colour; return(28);
        case 8 : %mourning_light_temple_1_13_up = $colour; %mourning_light_temple_2_13_up = $colour; return(29);
        case 9 : %mourning_light_temple_1_14_up = $colour; %mourning_light_temple_2_14_up = $colour; %mourning_light_temple_3_14_up = $colour; return(0);
        case 10 : %mourning_light_temple_1_16_up = $colour; return(20);
        case 11 : %mourning_light_temple_2_2_up = $colour; return(32);
        case 12 : %mourning_light_temple_2_3_up = $colour; return(22);
        case 13 : %mourning_light_temple_2_5_up = $colour; return(23);
        case 14 : %mourning_light_temple_2_6_up = $colour; return(24);
        case 15 : %mourning_light_temple_2_7_up = $colour; %mourning_light_temple_3_7_up = $colour; return(0);
        case 16 : %mourning_light_temple_2_9_up = $colour; %mourning_light_temple_3_9_up = $colour; return(0);
        case 17 : %mourning_light_temple_2_10_up = $colour; return(26);
        case 18 : %mourning_light_temple_2_11_up = $colour; return(27);
        case 19 : %mourning_light_temple_2_15_up = $colour; return(30);
        case 20 : %mourning_light_temple_2_16_up = $colour; return(31);
        case 21 : %mourning_light_temple_3_1_up = $colour; return(0);
        case 22 : %mourning_light_temple_3_3_up = $colour; return(0);
        case 23 : %mourning_light_temple_3_5_up = $colour; return(0);
        case 24 : %mourning_light_temple_3_6_up = $colour; return(0);
        case 25 : %mourning_light_temple_3_8_up = $colour; return(0);
        case 26 : %mourning_light_temple_3_10_up = $colour; return(0);
        case 27 : %mourning_light_temple_3_11_up = $colour; return(0);
        case 28 : %mourning_light_temple_3_12_up = $colour; return(0);
        case 29 : %mourning_light_temple_3_13_up = $colour; return(0);
        case 30 : %mourning_light_temple_3_15_up = $colour; return(0);
        case 31 : %mourning_light_temple_3_16_up = $colour; return(0);
        case 32 : %mourning_light_temple_3_2_up = $colour; return(0);
    }
} else {
    switch_int($node) {
        case 11 : %mourning_light_temple_1_2_up = $colour; return(0);
        case 12 : %mourning_light_temple_1_3_up = $colour; return(2);
        case 13 : %mourning_light_temple_1_5_up = $colour; return(0);
        case 14 : %mourning_light_temple_1_6_up = $colour; return(3);
        case 15 : %mourning_light_temple_1_7_up = $colour; return(4);
        case 17 : %mourning_light_temple_1_10_up = $colour; return(5);
        case 18 : %mourning_light_temple_1_11_up = $colour; return(6);
        case 19 : %mourning_light_temple_1_15_up = $colour; return(0);
        case 20 : %mourning_light_temple_1_16_up = $colour; return(10);
        case 21 : %mourning_light_temple_2_1_up = $colour; %mourning_light_temple_1_1_up = $colour; return(1);
        case 22 : %mourning_light_temple_2_3_up = $colour; return(12);
        case 23 : %mourning_light_temple_2_5_up = $colour; return(13);
        case 24 : %mourning_light_temple_2_6_up = $colour; return(14);
        case 25 : %mourning_light_temple_2_8_up = $colour; return(0);
        case 26 : %mourning_light_temple_2_10_up = $colour; return(17);
        case 27 : %mourning_light_temple_2_11_up = $colour; return(18);
        case 28 : %mourning_light_temple_2_12_up = $colour; %mourning_light_temple_1_12_up = $colour; return(7);
        case 29 : %mourning_light_temple_2_13_up = $colour; %mourning_light_temple_1_13_up = $colour; return(8);
        case 30 : %mourning_light_temple_2_15_up = $colour; return(19);
        case 31 : %mourning_light_temple_2_16_up = $colour; return(20);
        case 32 : %mourning_light_temple_2_2_up = $colour; return(11);
        case 33 : return(36);
        case 34 : return(37);
        case 35 : return(38);
    }
}
return(0);

[proc,mep2_puzzle_route](int $node, int $direction, int $colour)(int)
if ($direction >= 4) return(~mep2_puzzle_vertical_route($node, $direction, $colour));
// Only named original spans connect pillars. Collinear pillars separated by a
// wall do not acquire an invented edge merely because their coordinates line up.
switch_int(add(multiply($node, 10), $direction)) {
    case 11 : %mourning_light_temple_1_1_east = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_1_east, $colour); return(0);
    case 12 : %mourning_light_temple_1_1_south = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_1_south, $colour); return(0);
    case 21 : %mourning_light_temple_1_3_east = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_3_east, $colour); return(0);
