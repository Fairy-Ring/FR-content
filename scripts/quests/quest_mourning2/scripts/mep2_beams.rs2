    case 182 : %mourning_light_temple_2_11_15 = ~mep2_puzzle_colour_merge(%mourning_light_temple_2_11_15, $colour); return(19);
    case 183 : %mourning_light_temple_2_10_11 = ~mep2_puzzle_colour_merge(%mourning_light_temple_2_10_11, $colour); %mourning_light_temple_2_11_west = $colour; return(17);
    case 190 : %mourning_light_temple_2_11_15 = ~mep2_puzzle_colour_merge(%mourning_light_temple_2_11_15, $colour); return(18);
