    case 32 : %mourning_light_temple_1_6_11 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_6_11, $colour); return(6);
    case 33 : %mourning_light_temple_1_6_west = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_6_west, $colour); return(0);
    case 43 : %mourning_light_temple_1_6_7 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_6_7, $colour); return(3);
    case 51 : %mourning_light_temple_1_10_11 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_10_11, $colour); return(6);
    case 52 : %mourning_light_temple_1_10_14 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_10_14, $colour); return(9);
    case 60 : %mourning_light_temple_1_6_11 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_6_11, $colour); return(3);
    case 61 : %mourning_light_temple_1_11_12 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_11_12, $colour); return(7);
    case 62 : %mourning_light_temple_1_11_south = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_11_south, $colour); return(0);
    case 63 : %mourning_light_temple_1_10_11 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_10_11, $colour); return(5);
    case 73 : %mourning_light_temple_1_11_12 = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_11_12, $colour); return(6);
    case 80 : %mourning_light_temple_1_13_north = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_13_north, $colour); return(0);
    case 81 : %mourning_light_temple_1_13_east = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_13_east, $colour); return(0);
