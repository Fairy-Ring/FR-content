    case 310 : %mourning_light_temple_3_16_north = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_16_north, $colour); return(0);
    case 313 : %mourning_light_temple_3_15_16 = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_15_16, $colour); return(30);
    case 321 : %mourning_light_temple_3_2_3 = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_2_3, $colour); return(22);
    case 322 : %mourning_light_temple_3_2_5 = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_2_5, $colour); return(23);
    case 323 : %mourning_light_temple_3_1_2 = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_1_2, $colour); return(21);
    case 362 : return(39);
    case 371 : %mourning_light_temple_1_b_east = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_b_east, $colour); return(0);
    case 373 : %mourning_light_temple_1_b_west = ~mep2_puzzle_colour_merge(%mourning_light_temple_1_b_west, $colour); return(39);
    case 380 : return(39);
}
return(0);

[proc,mep2_puzzle_emit](int $node, int $direction, int $colour, int $seen_low, int $seen_high)
def_int $next = ~mep2_puzzle_route($node, $direction, $colour);
if ($next > 0) ~mep2_puzzle_trace($next, $direction, $colour, $seen_low, $seen_high);

[proc,mep2_puzzle_trace](int $node, int $incoming, int $colour, int $seen_low, int $seen_high)
if ($colour = 0) return;
if ($node = 39) return;
def_int $piece = 0;
if ($node <= 31) $piece = ~mep2_puzzle_slot_get($node);

// A filter/empty pillar preserves the ray's direction. Mirrors and splitters
// determine their exits, so revisiting one on a single ray is a closed cycle.
// Each split copies the path mask, not another branch's progress.
def_int $turn = 0;
if (~mep2_puzzle_is_mirror($piece) = true | ~mep2_puzzle_is_fracture($piece) = true) $turn = 1;
if ($node = 1 | $node = 8 | $node = 10 | $node >= 33) $turn = 1;
if ($turn = 1) {
    def_int $bit = sub($node, 1);
    if ($node <= 32) {
        if (getbit_range($seen_low, $bit, $bit) = 1) return;
        $seen_low = setbit_range_toint($seen_low, 1, $bit, $bit);
    } else {
        $bit = sub($node, 33);
        if (getbit_range($seen_high, $bit, $bit) = 1) return;
        $seen_high = setbit_range_toint($seen_high, 1, $bit, $bit);
    }
}

def_int $direction = $incoming;
if ($node = 17) {
    $colour = ~mep2_puzzle_filter_colour(^mep2_puzzle_crystal_green, $colour);
} else if ($node = 32) {
    $colour = ~mep2_puzzle_filter_colour(^mep2_puzzle_crystal_magenta, $colour);
} else if ($node >= 33 & $node <= 35) {
    $direction = 5;
} else if ($node = 36) {
    $direction = 2;
} else if ($node = 37) {
    $direction = 1;
    if (%mourning_temple_mirror = 1) $direction = 3;
} else if ($node = 38) {
    $direction = 0;
} else if ($node = 1 | $node = 8 | $node = 10) {
    $direction = $piece;
    if ($node = 1) {
        if ($piece = 0) $direction = 2;
        else if ($piece = 2) $direction = 0;
    } else if ($node = 10) {
        if ($piece = 0) $direction = 3;
        else if ($piece = 1) $direction = 0;
        else if ($piece = 2) $direction = 1;
        else if ($piece = 3) $direction = 2;
    }
} else if (~mep2_puzzle_is_mirror($piece) = true) {
    $direction = sub($piece, ^mep2_puzzle_mirror_0);
} else if (~mep2_puzzle_is_fracture($piece) = true) {
    if ($incoming > 3) return;
    def_int $pose = getbit_range(%mourning_part2_basevar2, 27, 28);
    if ($piece = ^mep2_puzzle_fracture_2) $pose = getbit_range(%mourning_part2_basevar2, 29, 30);
    def_int $entry = add($incoming, 2);
    if ($entry > 3) $entry = sub($entry, 4);
    if ($pose ! $entry) return;
    def_int $exit = 0;
    while ($exit < 4) {
        if ($exit ! $entry) ~mep2_puzzle_emit($node, $exit, $colour, $seen_low, $seen_high);
        $exit = add($exit, 1);
    }
    return;
} else if ($piece >= ^mep2_puzzle_crystal_red & $piece <= ^mep2_puzzle_crystal_magenta) {
    $colour = ~mep2_puzzle_filter_colour($piece, $colour);
}
if ($colour > 0) ~mep2_puzzle_emit($node, $direction, $colour, $seen_low, $seen_high);

[proc,mep2_puzzle_recalculate]
~mep2_puzzle_clear_beams;
if (%mourning_quest_main < ^mep2_crystal_created) return;
%mourning_light_temple_2_9_south = 7;
~mep2_puzzle_trace(^mep2_slot_2_9, 0, 7, 0, 0);
~mep2_puzzle_render_crossings;
// The period final-prism route requires all three actual directional inputs.
if (%mourning_light_temple_1_b_west = 1 & %mourning_light_temple_3_10_west = 3 & %mourning_light_temple_3_5_west = 5) {
    %mourning_light_temple_1_d_west = 7;
}
~mep2_puzzle_open_doors;

[proc,mep2_puzzle_open_doors]
if (%mourning_light_temple_1_1_south = 5) %mourning_door_1_1_south = 1;
if (%mourning_light_temple_1_1_east = 5) %mourning_door_1_1_east = 1;
if (%mourning_light_temple_2_3_east = 3) %mourning_door_2_4_west = 1;
if (%mourning_light_temple_2_3_south = 3) %mourning_door_2_4_south = 1;
if (%mourning_light_temple_1_13_north = 1) %mourning_door_1_13_north = 1;
if (%mourning_light_temple_1_13_east = 1) %mourning_door_1_13_east = 1;
if (%mourning_light_temple_1_16_north = 5) %mourning_door_1_16_north = 1;
if (%mourning_light_temple_1_16_west = 3 | %mourning_light_temple_1_14_east = 3) %mourning_door_1_16_west = 1;
if (%mourning_light_temple_2_15_east = 2) %mourning_door_2_16_west = 1;
if (%mourning_light_temple_2_16_north = 2) %mourning_door_2_16_north = 1;
if (%mourning_light_temple_1_b_east = 1) %mourning_door_1_b = 1;
if (%mourning_light_temple_1_d_west = 7) %mourning_door_1_c = 1;
