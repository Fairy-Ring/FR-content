    case 200 : %mourning_light_temple_2_16_north = ~mep2_puzzle_colour_merge(%mourning_light_temple_2_16_north, $colour); return(0);
    case 203 : %mourning_light_temple_2_16_west = ~mep2_puzzle_colour_merge(%mourning_light_temple_2_16_west, $colour); return(19);
    case 211 : %mourning_light_temple_3_1_2 = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_1_2, $colour); return(32);
    case 212 : %mourning_light_temple_3_1_8 = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_1_8, $colour); return(25);
    case 221 : %mourning_light_temple_3_3_east = ~mep2_puzzle_colour_merge(%mourning_light_temple_3_3_east, $colour); return(0);
