[proc,mep2_death_list_open]
if (%mourning_quest_main < ^mep2_death_chamber | inv_total(inv, mourning_deathalter_list) = 0) return;
def_int $index = 0;
while ($index < ^mep2_list_slots) {
    def_obj $item = ~mep2_dwarf_item($index);
    def_string $text;
    if (~mep2_dwarf_paid($index) = true) {
        // UNKNOWN functional wording for the three completed variable rows.
        if ($index = 0) $text = "Ticket (received)";
        else if ($index = 1) $text = "Book (received)";
        else if ($index = 2) $text = "Key (received)";
        else $text = oc_name($item);
        $text = append("@gre@", $text);
    } else {
        $text = append("@red@", oc_name($item));
    }
    ~mep2_death_list_set_row($index, $text);
    $index = add($index, 1);
}
if_openmain(mourning_deathalter);

[proc,mep2_dwarf_has_talisman]()(boolean)
if (calc(inv_total(inv, death_talisman) + inv_total(bank, death_talisman) + inv_total(worn, death_talisman)) > 0) return(true);
return(false);

[proc,mep2_dwarf_try_reward]
if (%mourning_dwarf_startedtask ! ^mep2_task_reward_pending) return;
if (~mep2_dwarf_has_talisman = true) {
    %mourning_dwarf_startedtask = ^mep2_task_reward_complete;
    return;
}
if (inv_freespace(inv) = 0) return;
inv_add(inv, death_talisman, 1);
%mourning_dwarf_startedtask = ^mep2_task_reward_complete;

[proc,mep2_dwarf_collect_available]
def_int $index = 0;
while ($index < ^mep2_list_slots) {
    if (~mep2_dwarf_paid($index) = false) {
        def_obj $item = ~mep2_dwarf_item($index);
        if ($item ! null & inv_total(inv, $item) > 0) {
            inv_del(inv, $item, 1);
            ~mep2_dwarf_mark_paid($index);
        }
    }
    $index = add($index, 1);
}

[opnpc1,mourning_deathalter_dwarf_vis] ~mep2_dwarf_talk;

[proc,mep2_dwarf_talk]
if (%mourning_quest_main < ^mep2_death_chamber) return;
if (~mep2_dwarf_has_talisman = true) {
    %mourning_dwarf_startedtask = ^mep2_task_reward_complete;
    return;
}
// UNKNOWN in-quest loss recovery only; completion ends free talisman replacement.
if (%mourning_dwarf_startedtask = ^mep2_task_reward_complete & %mourning_quest_main < ^mourning2_complete) {
    %mourning_dwarf_startedtask = ^mep2_task_reward_pending;
    ~mep2_dwarf_try_reward;
    return;
}
if (%mourning_dwarf_startedtask = ^mep2_task_not_started) {
    if (calc(inv_total(inv, mourning_deathalter_list) + inv_total(bank, mourning_deathalter_list)) = 0) {
        if (inv_freespace(inv) = 0) {
            ~displaymessage(^dm_default);
            return;
        }
        inv_add(inv, mourning_deathalter_list, 1);
    }
    %mourning_dwarf_startedtask = ^mep2_task_active;
}
if (%mourning_dwarf_startedtask = ^mep2_task_active) {
    ~mep2_dwarf_collect_available;
    if (~mep2_dwarf_all_paid = true) {
        %mourning_dwarf_startedtask = ^mep2_task_reward_pending;
        ~mep2_dwarf_try_reward;
        return;
    }
    if (calc(inv_total(inv, mourning_deathalter_list) + inv_total(bank, mourning_deathalter_list)) = 0 & inv_freespace(inv) > 0) {
        inv_add(inv, mourning_deathalter_list, 1);
    }
    return;
}
if (%mourning_dwarf_startedtask = ^mep2_task_reward_pending) ~mep2_dwarf_try_reward;

[opnpcu,mourning_deathalter_dwarf_vis] @mep2_dwarf_item_used;
[apnpcu,mourning_deathalter_dwarf_vis] @mep2_dwarf_item_used;

[label,mep2_dwarf_item_used]
if (%mourning_quest_main < ^mep2_death_chamber | %mourning_dwarf_startedtask ! ^mep2_task_active) {
    ~displaymessage(^dm_default);
    return;
}
if (~mep2_dwarf_has_talisman = true) {
    %mourning_dwarf_startedtask = ^mep2_task_reward_complete;
    return;
}
def_int $index = 0;
def_int $found = 0;
while ($index < ^mep2_list_slots) {
    if (($found = 0) & (~mep2_dwarf_paid($index) = false)) {
        def_obj $required = ~mep2_dwarf_item($index);
        if (($required ! null) & ($required = last_useitem) & (inv_total(inv, last_useitem) > 0)) {
            inv_del(inv, last_useitem, 1);
            ~mep2_dwarf_mark_paid($index);
            $found = 1;
        }
    }
    $index = add($index, 1);
}
if ($found = 0) {
    ~displaymessage(^dm_default);
    return;
}
if (~mep2_dwarf_all_paid = true) {
    %mourning_dwarf_startedtask = ^mep2_task_reward_pending;
    ~mep2_dwarf_try_reward;
    return;
}
if (calc(inv_total(inv, mourning_deathalter_list) + inv_total(bank, mourning_deathalter_list)) = 0 & inv_freespace(inv) > 0) {
    inv_add(inv, mourning_deathalter_list, 1);
}

// VERIFIED 2 May 2006 Tip.It: Prifddinas' history is found in Lletya bookcases.
[oploc1,elf_village_bookcase_1] ~mep2_lletya_history;
[oploc1,elf_village_bookcase_2] ~mep2_lletya_history;
[oploc1,elf_village_bookcase_3] ~mep2_lletya_history;

[proc,mep2_lletya_history]
if (calc(inv_total(inv, mourning_book1) + inv_total(bank, mourning_book1)) > 0) return;
if (inv_freespace(inv) = 0) return;
inv_add(inv, mourning_book1, 1);
