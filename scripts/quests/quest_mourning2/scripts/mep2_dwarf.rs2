    case 0 : if_settext(mourning_deathalter:com_4, $text); return;
    case 1 : if_settext(mourning_deathalter:com_6, $text); return;
    case 2 : if_settext(mourning_deathalter:com_7, $text); return;
    case 3 : if_settext(mourning_deathalter:com_8, $text); return;
    case 4 : if_settext(mourning_deathalter:com_9, $text); return;
    case 5 : if_settext(mourning_deathalter:com_10, $text); return;
    case 6 : if_settext(mourning_deathalter:com_11, $text); return;
    case 7 : if_settext(mourning_deathalter:com_12, $text); return;
