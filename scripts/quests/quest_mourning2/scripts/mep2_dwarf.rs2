// VERIFIED Thorgel list from retained 2 May 2006 Tip.It Q120; original cache bit layout is preserved.
// UNKNOWN engineering default: call random(3) once for each variable row when the quest starts.

[proc,mep2_dwarf_seed_choices]
%varp593_bits = setbit_range_toint(%varp593_bits, random(3), 0, 1);
%varp593_bits = setbit_range_toint(%varp593_bits, random(3), 2, 3);
%varp593_bits = setbit_range_toint(%varp593_bits, random(3), 4, 5);

[proc,mep2_dwarf_item](int $index)(obj)
if ($index < 0 | $index >= ^mep2_list_slots) return(null);
if ($index < ^mep2_variable_list_items) {
    def_int $bit = multiply($index, 2);
    def_int $choice = getbit_range(%varp593_bits, $bit, add($bit, 1));
    if ($choice = ^mep2_paid_choice) return(null);
    if ($index = 0) {
        if ($choice = 0) return(archery_ticket);
        if ($choice = 1) return(agilityarena_ticket);
        if ($choice = 2) return(castlewars_ticket);
    } else if ($index = 1) {
        if ($choice = 0) return(barrows_book_history);
        if ($choice = 1) return(mourning_book1);
        if ($choice = 2) return(elemental_workshop_shield_book);
    } else {
        if ($choice = 0) return(jail_key);
        if ($choice = 1) return(dusty_key);
        if ($choice = 2) return(witches_doorkey);
    }
    return(null);
}
switch_int($index) {
    case 3 : return(rope);
    case 4 : return(spade);
    case 5 : return(iron_pickaxe);
    case 6 : return(iron_axe);
    case 7 : return(knife);
    case 8 : return(woodplank);
    case 9 : return(piedish);
    case 10 : return(sack_potato_10);
    case 11 : return(pot_flour);
    case 12 : return(bucket_milk);
    case 13 : return(ball_of_wool);
    case 14 : return(oak_logs);
    case 15 : return(chisel);
    case 16 : return(shears);
    case 17 : return(needle);
    case 18 : return(thread);
    case 19 : return(cooked_meat);
    case 20 : return(nails_iron);
    case 21 : return(unicorn_horn_dust);
    case 22 : return(bronze_bar);
    case 23 : return(white_berries);
    case 24 : return(hammer);
    case 25 : return(cactus_potato);
    case 26 : return(skull);
    case 27 : return(babydragon_bones);
    case 28 : return(slayer_facemask);
    case 29 : return(blankrune);
    case 30 : return(lobster_pot);
    case 31 : return(fishing_rod);
    case 32 : return(tinderbox);
    case 33 : return(lockpick);
    case 34 : return(bronze_med_helm);
    case 35 : return(white_apron);
    case 36 : return(jug_wine);
    case 37 : return(kebab);
    case 38 : return(leather_boots);
    case 39 : return(swamppaste);
    case 40 : return(redberries);
    case 41 : return(cheese);
    case 42 : return(vial_water);
    case 43 : return(flax);
    case 44 : return(gold_ring);
    case 45 : return(egg);
    case 46 : return(leather_gloves);
    case 47 : return(cake_tin);
    case 48 : return(necklace_mould);
    case 49 : return(rotten_tomato);
    case default : return(null);
}

[proc,mep2_dwarf_paid](int $index)(boolean)
if ($index < 0 | $index >= ^mep2_list_slots) return(false);
if ($index < ^mep2_variable_list_items) {
    def_int $bit = multiply($index, 2);
    if (getbit_range(%varp593_bits, $bit, add($bit, 1)) = ^mep2_paid_choice) {
        return(true);
    }
    return(false);
}
if ($index < 29) {
    if (testbit(%varp593_bits, add($index, 3)) = 1) return(true);
    return(false);
}
if (testbit(%mourning_part2_basevar2, sub($index, 29)) = 1) return(true);
return(false);

[proc,mep2_dwarf_mark_paid](int $index)
if ($index < 0 | $index >= ^mep2_list_slots) return;
if ($index < ^mep2_variable_list_items) {
    def_int $bit = multiply($index, 2);
    %varp593_bits = setbit_range_toint(%varp593_bits, ^mep2_paid_choice, $bit, add($bit, 1));
    return;
}
if ($index < 29) {
    %varp593_bits = setbit(%varp593_bits, add($index, 3));
    return;
}
%mourning_part2_basevar2 = setbit(%mourning_part2_basevar2, sub($index, 29));

[proc,mep2_dwarf_all_paid]()(boolean)
def_int $index = 0;
while ($index < ^mep2_list_slots) {
    if (~mep2_dwarf_paid($index) = false) return(false);
    $index = add($index, 1);
}
return(true);

[proc,mep2_death_list_set_row](int $index, string $text)
