// CANDIDATE: Lost City 289 directional reward doors and stage 9 -> 10.
// Keep the r377 Steel key ring path. Neither form consumes the key.

[oploc1,hauntedmine_rewarddoor_l]
@hm_reward_door_open(^left);

[oploc1,hauntedmine_rewarddoor_r]
@hm_reward_door_open(^right);

[oplocu,hauntedmine_rewarddoor_l]
@hm_reward_door_use(^left);

[oplocu,hauntedmine_rewarddoor_r]
@hm_reward_door_use(^right);

[label,hm_reward_door_use](int $side)
if (last_useitem = hauntedmine_reward_key) {
    @hm_reward_door_open($side);
}
if (last_useitem = favour_key_ring & ~osf_key_ring_has(hauntedmine_reward_key) = true) {
    @hm_reward_door_open($side);
}
~displaymessage(^dm_default);

[label,hm_reward_door_open](int $side)
def_boolean $entering = ~check_axis_locactive(coord);
if ($entering = true & inv_total(inv, hauntedmine_reward_key) < 1) {
    if (~osf_key_ring_has(hauntedmine_reward_key) = true) {
        mes("You use your keyring to unlock the door.");
    } else {
        mes("The door is locked.");
        sound_synth(lockeddoor, 0, 0);
        return;
    }
}
if (inzone(0_43_69_20_33, 0_43_69_21_34, coord) = true & %hauntedmine = ^hauntedmine_boss_defeated) {
    %hauntedmine = ^hauntedmine_rewarddoor_found;
}
~open_and_close_double_door($entering, $side);
