// --- 4918 ridge obstacle cart: Climb over west/east only ---
// Loc 3445,3236. VERIFIED walkable stand/reach: 3444,3236 and 3446,3236.
// Exact climb animation / timing: UNKNOWN — do not invent seq or delays.
// Side hop preserves ordinary walk/interaction path across the ridge block.

[oploc1,hauntedmine_obstacle_cart]
p_arrivedelay;
switch_coord (loc_coord) {
    case 0_53_50_53_36 :
        // CANDIDATE side crossing only; anim/timing UNKNOWN.
        if (coordx(coord) <= coordx(loc_coord)) {
            p_teleport(0_53_50_54_36); // west side -> east 3446,3236
        } else {
            p_teleport(0_53_50_52_36); // east side -> west 3444,3236
        }
    case default :
        mes("Unhandled Haunted Mine cart:");
        mes(~coord_tostring(loc_coord));
}
