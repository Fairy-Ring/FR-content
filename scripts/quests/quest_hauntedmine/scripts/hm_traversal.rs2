// Haunted Mine M1 entrance traversal unit (r377).
// Config unit (keep together; packed ops/IDs/models/forceapproach unchanged):
//   surface 4913–4919, inside 4920–4923, ridge cart 4918;
//   main stairs handlers live in stairs.rs2 (this file does not own them);
//   deferred: ladders 4965–4970, dark/light stairs 4971–4973, fungus/cart/panel,
//   lift/valve, NPC/boss/puzzle/reward.
// Pair routes/offsets: CANDIDATE (names + map geometry + era-adjusted sequence).
// Static adjacent landings were checked against the packed map collision.
// No %hauntedmine / %hauntedmine_bits writes. No fabricated quest gates.

// --- 4913 secondary entrance <-> 4920 inside ---
// Surface loc 3440,3232; inside loc 3437,9637.
// Chosen landings: surface 3439,3232; inside 3436,9637 (CANDIDATE offset).

[oploc1,hauntedmine_secondary_entrance]
p_arrivedelay;
switch_coord (loc_coord) {
    case 0_53_50_48_32 : p_telejump(0_53_150_44_37); // Crawl down -> 3436,9637
    case default :
        mes("Unhandled Haunted Mine entrance:");
        mes(~coord_tostring(loc_coord));
}

[oploc1,hauntedmine_secondary_entrance_inside]
p_arrivedelay;
switch_coord (loc_coord) {
    case 0_53_150_45_37 : p_telejump(0_53_50_47_32); // Crawl through -> 3439,3232
    case default :
        mes("Unhandled Haunted Mine entrance:");
        mes(~coord_tostring(loc_coord));
}

