// VERIFIED sale/unlock: Tip.It guide 100, captured 2 May 2006.
// UNKNOWN functional wording. This is a balm sale, not a disease-cure step.
[opnpc1,zogre_uglug_nar]
if (%thzfe_sold_balm = 1) {
    ~openshop_activenpc;
    return;
}
~chatnpc("<p,neutral>Me's not got no glug-glugs to sell, yous bring me da sickies glug-glug den me's open da stufsies for ya.");

[opnpc3,zogre_uglug_nar]
if (%thzfe_sold_balm = 1 & %zogre >= ^zogre_complete) ~openshop_activenpc;
else mes("Bring Uglug Nar a four-dose Relicym's balm after helping Grish.");

[opnpcu,zogre_uglug_nar]
if (%zogre < ^zogre_complete | %thzfe_sold_balm = 1) return;
if (last_useitem ! relicyms_balm4) {
    mes("Uglug Nar wants a four-dose Relicym's balm.");
    return;
}
inv_del(inv, relicyms_balm4, 1);
%thzfe_sold_balm = 1;
inv_add(inv, coins, 1000);
mes("Uglug Nar pays you 1000 coins and opens his shop.");
