// VERIFIED recipe/unlocks: Tip.It guide 100, captured 2 May 2006.
// UNKNOWN: functional wording, crafting XP, brutal tiers and batch size.
[opheldu,rogues_purse]
~attempt_brew_potion(last_useslot, last_slot);

[opheldu,rogues_purse_sol]
~attempt_brew_potion(last_useslot, last_slot);

[opheldu,snake_weed]
~attempt_brew_potion(last_useslot, last_slot);

[proc,zogre_brew_pair](int $use_slot, int $last_slot)(boolean)
def_obj $first = inv_getobj(inv, $use_slot);
def_obj $second = inv_getobj(inv, $last_slot);
def_boolean $unfinished = false;
def_boolean $finished = false;
if ($first = vial_water & $second = rogues_purse | $second = vial_water & $first = rogues_purse) $unfinished = true;
if ($first = rogues_purse_sol & $second = snake_weed | $second = rogues_purse_sol & $first = snake_weed) $finished = true;
if ($unfinished = false & $finished = false) return (false);
if (map_members = ^false) {
    mes("You need to be on a members world to make this potion.");
    return (true);
}
if (%thzfe_makecuredisease = 0) {
    mes("Sithik has not taught you to make Relicym's balm yet.");
    return (true);
}
if (stat(herblore) < 8) {
    mes("You need a Herblore level of 8 to make Relicym's balm.");
    return (true);
}
if ($unfinished = true) {
    inv_del(inv, vial_water, 1);
    inv_del(inv, rogues_purse, 1);
    inv_add(inv, rogues_purse_sol, 1);
    mes("You mix the rogue's purse into the water.");
} else {
    inv_del(inv, rogues_purse_sol, 1);
    inv_del(inv, snake_weed, 1);
    inv_add(inv, relicyms_balm3, 1);
    stat_advance(herblore, ^zogre_balm_xp);
    mes("You finish mixing Relicym's balm.");
}
anim(human_herbing_vial, 0);
return (true);

[label,zogre_achey_log]
if (%thzfe_makecompozogrebow = 0) @make_ogre_shafts;
if (~p_choice2("Make ogre arrow shafts.", 1, "Make an ogre composite bow.", 2) = 1) @make_ogre_shafts;
if (stat(fletching) < 30 | stat(strength) < 20) {
    mes("You need 30 Fletching and 20 Strength to carve an ogre composite bow.");
    return;
}
if (inv_total(inv, knife) = 0 | inv_total(inv, achey_tree_logs) = 0 | inv_total(inv, wolf_bones) = 0) {
    mes("You need a knife, achey tree logs and wolf bones to carve this bow.");
    return;
}
inv_del(inv, achey_tree_logs, 1);
inv_del(inv, wolf_bones, 1);
inv_add(inv, unstrung_zogre_bow, 1);
stat_advance(fletching, ^zogre_comp_cut_xp);
mes("You carve an unstrung ogre composite bow.");

[opheldu,nails_bronze] ~zogre_brutal_arrows;
[opheldu,nails_iron] ~zogre_brutal_arrows;
[opheldu,nails] ~zogre_brutal_arrows;
[opheldu,nails_black] ~zogre_brutal_arrows;
[opheldu,nails_mithril] ~zogre_brutal_arrows;
[opheldu,nails_adamant] ~zogre_brutal_arrows;
[opheldu,nails_rune] ~zogre_brutal_arrows;

[proc,zogre_brutal_arrows]()(boolean)
def_obj $nail = last_useitem;
if (last_item ! ogre_headless_arrow) {
    if (last_useitem ! ogre_headless_arrow) return (false);
    $nail = last_item;
}
def_namedobj $arrow = null;
def_int $level = 0;
def_int $xp = 0;
switch_obj($nail) {
    case nails_bronze : $arrow = zogre_brutal_bronze; $level = ^zogre_brutal_bronze_level; $xp = ^zogre_brutal_bronze_xp;
    case nails_iron : $arrow = zogre_brutal_iron; $level = ^zogre_brutal_iron_level; $xp = ^zogre_brutal_iron_xp;
    case nails : $arrow = zogre_brutal_steel; $level = ^zogre_brutal_steel_level; $xp = ^zogre_brutal_steel_xp;
    case nails_black : $arrow = zogre_brutal_black; $level = ^zogre_brutal_black_level; $xp = ^zogre_brutal_black_xp;
    case nails_mithril : $arrow = zogre_brutal_mithril; $level = ^zogre_brutal_mithril_level; $xp = ^zogre_brutal_mithril_xp;
    case nails_adamant : $arrow = zogre_brutal_adamant; $level = ^zogre_brutal_adamant_level; $xp = ^zogre_brutal_adamant_xp;
    case nails_rune : $arrow = zogre_brutal_rune; $level = ^zogre_brutal_rune_level; $xp = ^zogre_brutal_rune_xp;
    case default : return (false);
}
if (map_members = ^false | %thzfe_makebrutalarrow = 0) {
    mes("You have not learned to make brutal arrows.");
    return (true);
}
if (stat(fletching) < $level) {
    mes("You need a Fletching level of <tostring($level)> to make these brutal arrows.");
    return (true);
}
if (inv_total(inv, hammer) = 0) {
    mes("You need a hammer to make brutal arrows.");
    return (true);
}
def_int $count = inv_total(inv, ogre_headless_arrow);
if ($count > ^zogre_brutal_batch) $count = ^zogre_brutal_batch;
if ($count > inv_total(inv, $nail)) $count = inv_total(inv, $nail);
if ($count = 0) return (true);
if (inv_total(inv, $arrow) = 0 & inv_freespace(inv) = 0 & inv_total(inv, $nail) > $count & inv_total(inv, ogre_headless_arrow) > $count) {
    mes("You need an inventory space for the brutal arrows.");
    return (true);
}
inv_del(inv, $nail, $count);
inv_del(inv, ogre_headless_arrow, $count);
inv_add(inv, $arrow, $count);
stat_advance(fletching, calc($xp * $count));
mes("You hammer nails into the headless ogre arrows.");
return (true);
