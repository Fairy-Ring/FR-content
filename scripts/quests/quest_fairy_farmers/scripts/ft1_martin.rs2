// A Fairy Tale Part I start-gate — Martin the Master Gardener (3299) @ 3078,3258.
// CANDIDATE last-resort 2007-base: OSRS Transcript:Fairytale I minus Skillcape /
// overlay / toast / FT2 / RS3 Overview. Hunt 289? no.
// Accept: %fairy_farmers_quest 0→1 only. NEVER 10 (opens Zanaris wall + guard).
// Keep [opnpc3] pickpocket. Do not open leftover fairy_queen_symptoms.

[opnpc1,martin_the_master_farmer]
if (%fairy_farmers_quest = 1) {
    @ft1_martin_started;
}
if (%fairy_farmers_quest = 2) {
    @ft1_martin_report1;
}
if (%fairy_farmers_quest = 3) {
    @ft1_martin_report2;
}
if (%fairy_farmers_quest = 4) {
    @ft1_martin_report3;
}
if (%fairy_farmers_quest = 5) {
    @ft1_martin_report4;
}
if (%fairy_farmers_quest >= 6) {
    @ft1_martin_report5;
}
@ft1_martin_start;

[label,ft1_martin_start]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,sad>I can't chat now, I have too many things to worry about.");
@ft1_martin_options;

[label,ft1_martin_options]
def_int $opt = ~p_choice3("Anything I can help with?", 1, "Oh dear. I hope you can sort them out by yourself.", 2, "What is the banner for?", 3);
if ($opt = 2) {
    ~chatplayer("<p,sad>Oh dear. I hope you can sort them out by yourself.");
    ~chatnpc("<p,sad>I'm not sure I can, but I guess I have to try.");
    return;
} else if ($opt = 3) {
    @ft1_martin_banner;
}
~chatplayer("<p,quiz>Anything I can help with?");
@ft1_martin_pitch;

[label,ft1_martin_banner]
~chatplayer("<p,quiz>What is the banner for?");
~chatnpc("<p,neutral>That banner is the emblem of the Group of Advanced Gardeners. We're a loosely affiliated group of gardeners that are united in our concern for declining vegetable production.");
~chatplayer("<p,confused>Err, of course you are.");
~chatnpc("<p,quiz>Say, you're a brave adventurer, would you be interested in trying to get to the root of our woes? There would be a cash reward if you could help us.");
def_int $help = ~p_choice2("Of course I'll help.", 1, "Sorry, I have better things to do.", 2);
if ($help = 2) {
    ~chatplayer("<p,neutral>Sorry, I have better things to do.");
    ~chatnpc("<p,sad>Oh. Oh dear. Oh well, if there's nothing I can do to make you change your mind...");
    ~chatplayer("<p,neutral>No, nothing. My mind is made up.");
    ~chatnpc("<p,neutral>Well come back and chat to me if you change it.");
    return;
}
~chatplayer("<p,happy>Of course I'll help.");
~chatnpc("<p,happy>I'm so glad to hear that.");
~chatplayer("<p,quiz>You don't look it.");
~chatnpc("<p,confused>Sorry, what was that?");
~chatplayer("<p,neutral>Oh, nothing. Don't worry about it.");
@ft1_martin_pitch_body;

[label,ft1_martin_pitch]
~chatnpc("<p,sad>I certainly could do with some help.");
~chatplayer("<p,quiz>So tell me about your problems.");
@ft1_martin_pitch_body;

[label,ft1_martin_pitch_body]
~chatnpc("<p,neutral>It all seemed to start about a month ago. I grow roses, you know?");
~chatplayer("<p,confused>Um, you seem to be getting side-tracked already.");
~chatnpc("<p,confused>What? Oh sorry.");
~chatnpc("<p,neutral>As I was saying about a month ago I noticed that the yield on my prize rose bushes had dropped slightly. I immediately suspected Crown Gall, a disease that can be fatal to a Mister Lincoln.");
~chatplayer("<p,quiz>You're not making much sense. Who's Mister Lincoln?");
~chatnpc("<p,neutral>Sorry, Mister Lincoln's are the variety of roses that I specialise in. None of the plants showed any other symptoms of disease though. Then I noticed a reduced yield occurring in most of my other crops too.");
~chatnpc("<p,sad>I spoke to other gardeners that I know, and they had all noticed similar problems.");
~chatnpc("<p,sad>Vegetable patches are growing fewer vegetables, bushes are producing fewer berries and everything that is planted seems to be more prone to disease!");
if (stat_base(farming) > 1) {
    ~chatnpc("<p,quiz>You've done some farming, haven't you noticed a decrease in the amount of produce you are getting lately?");
} else {
    ~chatnpc("<p,neutral>If you were more interested in turning your hand to farming, you would have noticed it too.");
}
def_int $go = ~p_choice2("Yes", 1, "No", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>This doesn't sound like something I can help with. Good luck.");
    return;
}
@ft1_martin_accept;

[label,ft1_martin_accept]
~chatplayer("<p,quiz>So what do you want me to do?");
~chatnpc("<p,neutral>I'd like you to find out what is causing this terrible problem and to try and rectify whatever the problem is.");
~chatplayer("<p,quiz>Do you have any ideas where I should start?");
~chatnpc("<p,neutral>If I were you I would start by speaking to some of the other gardeners.");
%fairy_farmers_quest = 1;
return;

[label,ft1_martin_started]
~chatnpc("<p,quiz>Have you spoken to any other members of the Gardening Group yet?");
~chatplayer("<p,sad>No, I haven't had a chance yet.");
~chatnpc("<p,sad>Well please hurry, otherwise I won't be able to make enough produce to feed my 13 children soon.");
return;

[label,ft1_martin_report1]
~chatplayer("<p,neutral>I've spoken to one of your members and they reckon that it's the lack of rain that we've had recently.");
~chatnpc("<p,neutral>I'm afraid that can't be the problem. It never rains on the farming patches. That's why we have to water the crops.");
~chatplayer("<p,confused>Oh, yeah. I hadn't thought of that.");
~chatnpc("<p,neutral>Go chat to some other group members. Maybe somebody has a different idea.");
return;

[label,ft1_martin_report2]
~chatplayer("<p,angry>Insects! You need to get rid of the insects! They're eating the crops.");
~chatnpc("<p,neutral>Good idea, but I spray my crops with insecticide every week. No, that's not the problem.");
return;

[label,ft1_martin_report3]
~chatplayer("<p,angry>One of your members is implying that the gardeners' problems are all caused by adventurers using the plots. I would like to point out that these plots are communal property and that we have as much right as anyone to grow plants here!");
~chatnpc("<p,shock>All right! All right! You're absolutely right! I never said there was a problem with anybody using my plots. Besides, we get part of our income from watching crops for adventurers. I'm afraid that our problem is something totally different.");
return;

[label,ft1_martin_report4]
~chatplayer("<p,neutral>Apparently, the seasons are all mixed up. Late summers and early winters. I don't know what I can do to solve that problem, though.");
~chatnpc("<p,neutral>Yes, I've noticed that the seasons seem to be slightly confused, but that hasn't been a big enough change to affect the crops so badly. I'm afraid you should try a different branch of investigation to get to the root of our problems.");
~chatplayer("<p,happy>Ha ha!");
~chatnpc("<p,angry>What are you laughing at? These are serious problems!");
~chatplayer("<p,neutral>You're absolutely right. Don't worry, I'll find out what the problem is.");
return;

[label,ft1_martin_report5]
~chatnpc("<p,quiz>Hello again, <displayname()>. How are you getting on with solving the Gardening Group's problems?");
~chatplayer("<p,sad>To be honest I'm worried about the sort of person you let join your organisation.");
~chatnpc("<p,quiz>Why is that?");
~chatplayer("<p,neutral>I've heard theories ranging from climate change to fairies from your members.");
~chatnpc("<p,quiz>Hmm, that's an interesting idea. Now that I think about it that does make some sense. Yes, maybe you should talk to a fairy about it.");
~chatplayer("<p,quiz>O-kay! You're the boss, any idea which flower I should look under to find a fairy?");
~chatnpc("<p,neutral>No, sorry, but I did hear that there were some adventurers with a similar problem in the swamps near Lumbridge. Just don't mention my name if you talk to them, they're trying to keep it a secret, but everybody actually knows what they're up to.");
~chatplayer("<p,neutral>Yes, I've spoken to them before.");
return;
