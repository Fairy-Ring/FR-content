// Original 377 block moved verbatim; the combat category follows it.
[fairy_enchanted_secateurs]
name=Magic secateurs
desc=The only way to kill a Tanglefoot.
recol1s=15855
recol1d=704
recol2s=10570
recol2d=352
recol3s=5217
recol3d=608
model=obj_secateurs
manwear=obj_secateurs_manwear,0
womanwear=obj_secateurs_manwear,6
2dxof=-1
2dyof=11
2dzoom=710
2dyan=320
2dxan=312
members=yes
iop2=Wield
iop5=Destroy
wearpos=righthand
weight=1lb
// UNKNOWN default: quest rewards are untradeable unless a source says otherwise.
tradeable=no
// UNKNOWN engineering melee stance: use the existing slash-weapon style table.
category=weapon_slash
// CANDIDATE bonuses: OSRS Wiki Magic secateurs, revision 14965052 (2025-08-13).
// History shows these values by 2014, but does not establish the original 2006 stats.
// https://oldschool.runescape.wiki/w/Magic_secateurs?oldid=14965052
param=stabattack,7
param=slashattack,9
param=crushattack,-5
param=magicattack,1
param=rangeattack,0
param=stabdefence,0
param=slashdefence,1
param=crushdefence,0
param=magicdefence,1
param=rangedefence,0
param=strengthbonus,1
param=rangebonus,0
param=prayerbonus,0
// The source's mdmg=0 has no equivalent in skill_combat/configs/combat.param.
param=attackrate,4
// UNKNOWN engineering motion/sound bindings, using existing 377 assets.
param=slashattack_anim,human_sword_slash
param=stabattack_anim,human_sword_stab
param=defend_anim,human_sword_def
param=slash_sound,FT_secateurs
param=stab_sound,FT_secateurs
