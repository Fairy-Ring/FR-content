// Giant Dwarf company secretaries. Company IDs follow 377 all.npc order and
// the `dwarf_stat_head_multi` values 1..7; see giantdwarf_company.rs2.
// The helper preserves the pre-stage-5 greeting and never changes stages 0-2.

[opnpc1,dwarf_city_secretary_purple_pewter]
~giantdwarf_company_secretary(1);
return;

[opnpc1,dwarf_city_secretary_yellow_fortune]
~giantdwarf_company_secretary(2);
return;

[opnpc1,dwarf_city_secretary_blue_opal]
~giantdwarf_company_secretary(3);
return;

[opnpc1,dwarf_city_secretary_green_gemstone]
~giantdwarf_company_secretary(4);
return;

[opnpc1,dwarf_city_secretary_white_chisel]
~giantdwarf_company_secretary(5);
return;

[opnpc1,dwarf_city_secretary_silver_cog]
~giantdwarf_company_secretary(6);
return;

[opnpc1,dwarf_city_secretary_brown_engine]
~giantdwarf_company_secretary(7);
return;
