// Giant Dwarf — Dwarven Boatman (mines) Talk-to + period intro cutscene.
// Dump lines (Transcript:The Giant Dwarf Starting off minus overlay / Skip /
// Travel — verbatim block in giantdwarf-boatman-cutscene-377.md; the extract
// was never in .wiki). Fresh 0: start talk (<displayname>, ferryman line),
// Deal + ready-Yes (~p_choice2, not overlay), write 1 on ready-Yes, then
// [proc,giantdwarf_intro_cutscene]: tele + cam first (palace stairs
// 2863,10188 L1, roof-on cam 2872,10184), then inter_260 titles + inter_235
// history, packed steamer cam (m44_158 hull, no loc_add), Red Axe look-east
// + plinth look-down, statue crash talk + cam_shake +
// %giantdwarf_statue_invis = 1 + inter_234 crash map, dock guards (Halt!
// on 2231), HQ dest, then Veldaban "Identify yourself" via ~chatnpc_specific
// (NOT Forget's [opnpc1,dwarf_city_black_guard_leader] — already bound) and
// Yes help -> %giantdwarf_quest = 2 + %giantdwarf_veldaban_introduced = 1.
// BAR cross-talk three-way (110 complete / >= 10 started / else). Re-talk
// >= 1: stub + dest, no second crash. 0 new ops. Never dest the statue
// 2878,10177 / L1-L2 / Veldaban tile / 16 Consortium rooms. No && / ||.
// Cite giantdwarf-boatman-cutscene-377.md + crawl giantdwarf-changes-377.md.

[opnpc1,dwarf_city_boatman_mines_prequest]
if (%giantdwarf_quest >= 1) {
    ~chatnpc("<p,neutral>There she is! All aboard for Keldagrim!");
    p_telejump(0_44_159_11_39); // 2827,10215 L0 — E of Veldaban 2129
    p_delay(2);
    ~music_playbycoord(coord); // HQ = west, Land of the Dwarves
    return;
}
~chatnpc("<p,neutral>Ho there, human!");
~chatplayer("<p,neutral><displayname>");
~chatnpc("<p,neutral>Ho there, <displayname>! Want to take a ride with me?");
~chatplayer("<p,neutral>Where are you going? Across the river?");
~chatnpc("<p,neutral>No no, that's what the ferryman is for! I'm going to Keldagrim, my home!");
~chatplayer("<p,neutral>How much will that cost me then?");
~chatnpc("<p,neutral>For a human like you, I can do it for free!");
def_int $go = ~p_choice2("That's a deal!", 1, "I prefer the mines to the city.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>I prefer the mines to the city.");
    ~chatnpc("<p,neutral>Well, suit yourself then!");
    return;
}
~chatplayer("<p,happy>That's a deal!");
~chatnpc("<p,neutral>Excellent! I'm just waiting for my ship to arrive and then we can go.");
~chatnpc("<p,quiz>Mind, this trip could take a few minutes! Are you sure you're ready to go as well?");
def_int $ready = ~p_choice2("Yes, I'm ready and don't mind it taking a few minutes.", 1, "No, I don't have time right now, I'll be back later.", 2);
if ($ready = 2) {
    ~chatplayer("<p,neutral>No, I don't have time right now, I'll be back later.");
    ~chatnpc("<p,neutral>Sure, sure! Come back when you need to!");
    return;
}
~chatplayer("<p,happy>Yes, I'm ready and don't mind it taking a few minutes.");
~chatnpc("<p,happy>Well, let's not waste any more time then!");
%giantdwarf_quest = 1;
~giantdwarf_intro_cutscene;

[proc,giantdwarf_intro_cutscene]()
if_close;
p_delay(0);
// tele + cam FIRST so the history plays on the city floor, not the mines
minimap_toggle(2);
if_settab(null, 0);
if_settab(null, 1);
if_settab(null, 2);
if_settab(null, 3);
if_settab(null, 4);
if_settab(null, 5);
if_settab(null, 6);
if_settab(null, 11);
if_settab(null, 12);
// fade BEFORE any tele — opaque first, then tele behind the cam
if_openoverlay(fade_to_black);
p_delay(2);
// palace — 2014 roof ON. Dest stairs (Climb-up 6088), cam SOUTH of the facade,
// no RemoveRoof, LOW hei so we look THROUGH the colonnade, not onto 6126.
p_telejump(1_44_159_47_12); // 2863,10188 L1 — 6088 wide stairs (opener dest)
~music_playbycoord(coord); // west = Land of the Dwarves
cam_moveto(1_44_159_56_8, 280, 0, 100); // 2872,10184 — f1, roof stays on
cam_lookat(1_44_159_56_24, 40, 0, 100); // 2872,10200 — into the hall, NOT down onto 6126
p_delay(1);
if_openoverlay(null);
// 2:30 — KELDAGRIM q8 title on inter_260 (top-only). NOT inter_235.
if_openoverlay(inter_260);
if_setcolour(inter_260:com_0, ^red_rgb);
if_setcolour(inter_260:com_1, ^red_rgb);
if_settext(inter_260:com_0, "KELDAGRIM");
if_settext(inter_260:com_1, "Grand Capital of the Dwarven realm");
p_delay(4);
if_openoverlay(null);
// 2:35-3:00 — history in stanzas on inter_235 (b12, packed Alvis lines),
// SAME palace-down cam (~8 ticks each, ~4 gap)
if_openoverlay(inter_235);
if_sethide(inter_235:com_0, false); // Five hundred years... (Alvis)
if_sethide(inter_235:com_1, false); // saviour of Keldagrim...
p_delay(8);
p_delay(4); // stanza gap
if_sethide(inter_235:com_2, false); // Founder of the Consortium...
if_sethide(inter_235:com_3, false); // that were to serve the monarchy...
if_sethide(inter_235:com_4, false); // to serve the Consortium.
p_delay(8);
p_delay(4); // stanza gap
if_sethide(inter_235:com_5, false); // By the time of his death...
if_sethide(inter_235:com_6, false); // By now, the Kings of Keldagrim...
if_sethide(inter_235:com_7, false); // with only the statue...
if_sethide(inter_235:com_8, false); // old days.
p_delay(8);
// 3:05 — history gone, still palace-down
if_sethide(inter_235:com_0, true);
if_sethide(inter_235:com_1, true);
if_sethide(inter_235:com_2, true);
if_sethide(inter_235:com_3, true);
if_sethide(inter_235:com_4, true);
if_sethide(inter_235:com_5, true);
if_sethide(inter_235:com_6, true);
if_sethide(inter_235:com_7, true);
if_sethide(inter_235:com_8, true);
p_delay(2);
if_openoverlay(null); // 235 closed — steamer beat needs overlay null
// 3:10-3:20 — steamer already on the LIVE river (hull 2873-2875, 10138-10147
// m44_158). Do NOT loc_add. Cam it, south of the boat, mid hull.
p_telejump(0_44_158_50_21); // 2866,10133 L0 — walkable, south-west of hull (2866,10132 blocked)
~music_playbycoord(coord);
cam_moveto(0_44_158_58_20, 400, 0, 100); // 2874,10132 — south of the boat
cam_lookat(0_44_158_58_32, 80, 0, 100); // 2874,10144 — mid hull
p_delay(6);
// 3:25-3:33 — Red Axe on the long water. Look EAST along o86 toward the statue,
// not west (cave). Title (q8 top).
p_telejump(0_44_159_46_4); // 2862,10180 L0 — bank, walkable (probe)
~music_playbycoord(coord);
cam_moveto(0_44_159_56_4, 350, 0, 100); // 2872,10180 — east band, over o86
cam_lookat(0_44_159_62_1, 40, 0, 100); // 2878,10177 — east along the Kelda
p_delay(1);
if_openoverlay(inter_260);
if_setcolour(inter_260:com_0, ^red_rgb);
if_setcolour(inter_260:com_1, ^red_rgb);
if_settext(inter_260:com_0, "Rise of the Red Axe");
if_settext(inter_260:com_1, "Part 1");
p_delay(14);
if_openoverlay(null);
// 3:35 — 7042 from the water, looking UP (thighs-head + axe), title off
cam_moveto(0_44_159_62_4, 350, 0, 100); // 2878,10180 — river south of the statue
cam_lookat(0_44_159_62_1, 700, 0, 100); // 2878,10177 — look up at the head
p_delay(2);
// 3:40-3:45 — THE GIANT DWARF: look DOWN at the plinth (2014 busted-apart),
// hei < 800. Over water, not the west bank.
cam_moveto(0_44_159_60_2, 620, 0, 100); // 2876,10178 — over water
cam_lookat(0_44_159_62_1, 20, 0, 100); // 2878,10177 — look DOWN at the plinth
if_openoverlay(inter_260);
if_setcolour(inter_260:com_0, ^red_rgb);
if_setcolour(inter_260:com_1, ^red_rgb);
if_settext(inter_260:com_0, "The Giant");
if_settext(inter_260:com_1, "Dwarf");
p_delay(8);
if_openoverlay(null);
// 3:47 — map first, no chat. Boat at the river-mouth. Overlay (not main —
// openChatModal IfClose's main; overlay survives the chat slot).
if_openoverlay(inter_234);
if_setanim(inter_234:com_3, mini_statue_explodes); // packed seq; delay1=275 then explode
%giantdwarf_statue_invis = 1;
cam_shake(3, 0, 20, 2);
p_delay(2);
// 3:50-4:00 — crash talk ON the map (chat box under overlay 234). Boat creeps.
~chatnpc_specific("Dwarven Boatman", dwarf_city_boatman_mines_prequest, "<p,neutral>Look, there's the statue of King Alvis, guarding the entrance to Keldagrim!");
~chatplayer("<p,happy>Amazing! And we're going to go straight past it?");
~chatnpc_specific("Dwarven Boatman", dwarf_city_boatman_mines_prequest, "<p,happy>That's right!");
~chatnpc_specific("Dwarven Boatman", dwarf_city_boatman_mines_prequest, "<p,angry>Er, hold on! There's something wrong!");
p_delay(3); // ~4:00 -> 4:04, not 10
// 4:04 — Both/Argh at impact, on that map. Do NOT close 234. Heads must talk.
split_init("<p,shock>Argh!", 380, 4, q8_full);
if_setplayerhead(inter_274:com_0);
if_setanim(inter_274:com_0, split_getanim(0));
if_setnpchead(inter_274:com_3, dwarf_city_boatman_mines_prequest);
if_setanim(inter_274:com_3, split_getanim(0));
if_openchat(inter_274); // packed *Both* / *Argh!*
p_delay(8); // explode ON this card
if_close; // chat only; overlay 234 stays
// 4:07 — map, rubble, no chat
p_delay(2);
if_close; // close overlay 234
if_openoverlay(null);
// dock — cutscene berserkers appear, then the arrest
%giantdwarf_cutscene_guard_visible = 1;
p_telejump(0_45_159_9_49); // 2889,10225 L0 — dock stand next to both berserkers
p_delay(3);
~music_playbycoord(coord); // east = Tale of Keldagrim (intro-end unlock via proc)
cam_moveto(0_45_159_5_49, 380, 0, 100); // 2885,10225 — raise + back, planks out
cam_lookat(0_45_159_10_49, 220, 0, 100); // 2890,10225 — guards 2231 in frame
~chatnpc_specific("Black Guard Berserker", dwarf_city_berserker_cutscene, "<p,angry>Halt! By order of the Black Guard, you are under arrest!");
~chatplayer("<p,shock>What?? I didn't do anything! It wasn't me!");
~chatnpc_specific("Black Guard Berserker", dwarf_city_berserker_cutscene, "<p,neutral>Come with us, human! Commander Veldaban wants a word with you!");
// HQ — fade covers the dock BEFORE tele/reset (no warp into HQ)
if_openoverlay(fade_to_black);
p_delay(2); // dock is black first
%giantdwarf_cutscene_guard_visible = 0;
p_telejump(0_44_159_11_39); // 2827,10215 L0 — E of Veldaban 2129
cam_reset();
minimap_toggle(0);
~initalltabs;
p_delay(2);
if_openoverlay(null);
~music_playbycoord(coord); // HQ = west, back to Land
// Veldaban "Identify yourself" — chatnpc_specific, not Forget's op
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Identify yourself, human!");
~chatplayer("<p,neutral>I err, I'm <displayname>. I was told I was under arrest. I had a little accident on the way in here.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Ah, so you're the one who knocked over the statue of our glorious king!");
~chatplayer("<p,neutral>I suppose so... I mean, I didn't do it on purpose or anything...");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Ah, don't worry about it!");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>We haven't been ruled by a king for many a year... that statue was long overdue for replacement anyway. You're not under arrest, I merely wanted to talk to you.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>But let me introduce myself. I am Veldaban, son of Dondakan. I am the Commander of the Black Guard in Keldagrim.");
if (%dwarfrock_quest = 110) {
    ~chatplayer("<p,neutral>Dondakan, you say?");
    ~chatplayer("<p,neutral>I helped your father in the mines south of the city.");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,happy>Ah, so you are the one! I heard you banished a demon by defeating its avatar, most impressive.");
} else if (%dwarfrock_quest >= 10) {
    ~chatplayer("<p,neutral>Dondakan, you say?");
    ~chatplayer("<p,neutral>I'm helping your father in the mines south of the city.");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Ah, he is forever trying to break open that rock of his, until his death I sometimes think.");
    ~chatplayer("<p,neutral>So you don't think it's possible?");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Perhaps, human, perhaps... but if even our multicannon does not dent it, what chance is there really?");
} else {
    ~chatplayer("<p,neutral>Well, ehm... nice to meet you, Veldaban.");
}
// task + choice
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Now listen carefully. I have a task for you.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>I want you to go and see the local sculptor and help him build a new statue.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,quiz>Will you do this for us?");
def_int $help = ~p_choice2("Yes, I will do this.", 1, "No, I can't be bothered.", 2);
if ($help = 2) {
    ~chatplayer("<p,neutral>No, I can't be bothered.");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,angry>You destroy our statue and you cannot be bothered to help rebuild it? By Guthix, you are rude... even for a human!");
    return;
}
~chatplayer("<p,happy>Yes, I will do this.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,happy>You are a good human, <displayname>.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Now, I need you to go to Blasidar, he is a sculptor who lives in Keldagrim-East.");
~chatplayer("<p,neutral>To be honest I'm not much of a sculptor myself.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Oh, don't worry! I just need you to help him out while he rebuilds the statue.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>I'm sure there are many tasks that he needs doing.");
~chatplayer("<p,neutral>I'll see what I can do.");
%giantdwarf_veldaban_introduced = 1;
%giantdwarf_quest = 2;
