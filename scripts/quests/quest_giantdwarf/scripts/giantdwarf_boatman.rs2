// Giant Dwarf — Dwarven Boatman (mines) Talk-to + period intro cutscene.
// Dump lines (Transcript:The Giant Dwarf Starting off minus overlay / Skip /
// Travel — verbatim block in giantdwarf-boatman-cutscene-377.md; the extract
// was never in .wiki). Fresh 0: start talk (<displayname>, ferryman line),
// Deal + ready-Yes (~p_choice2, not overlay), write 1 on ready-Yes, then
// [proc,giantdwarf_intro_cutscene]: tele + cam first (palace 2841,10183), then
// inter_260 q8 title + inter_235 sliding-window history (2014 t011-t032: lines
// add one at a time, oldest drops), statue cam + force-timed crash talk (hide
// continue before if_openchat, 1/2/3/4-line IFs, per-line delays) + cam_shake +
// %giantdwarf_statue_invis = 1 + inter_234 crash map, explosion on the Both
// card, dock guards (Halt! overhead via npc_say, then arrest chat), HQ dest,
// then Veldaban "Identify yourself" via ~chatnpc_specific
// (NOT Forget's [opnpc1,dwarf_city_black_guard_leader] — already bound) and
// Yes help -> %giantdwarf_quest = 2 + %giantdwarf_veldaban_introduced = 1.
// BAR cross-talk three-way (110 complete / >= 10 started / else). Re-talk
// >= 1: stub + dest, no second crash. 0 new ops. Never dest the statue
// 2878,10177 / L1-L2 / Veldaban tile / 16 Consortium rooms. No && / ||.
// Cite giantdwarf-boatman-cutscene-377.md + crawl giantdwarf-changes-377.md.

[opnpc1,dwarf_city_boatman_mines_prequest]
if (%giantdwarf_quest >= 1) {
    ~chatnpc("<p,neutral>There she is! All aboard for Keldagrim!");
    p_telejump(0_44_159_11_39); // 2827,10215 L0 — E of Veldaban 2129
    p_delay(2);
    ~music_playbycoord(coord); // HQ = west, Land of the Dwarves
    return;
}
~chatnpc("<p,neutral>Ho there, human!");
~chatplayer("<p,neutral><displayname>");
~chatnpc("<p,neutral>Ho there, <displayname>! Want to take a ride with me?");
~chatplayer("<p,neutral>Where are you going? Across the river?");
~chatnpc("<p,neutral>No no, that's what the ferryman is for! I'm going to Keldagrim, my home!");
~chatplayer("<p,neutral>How much will that cost me then?");
~chatnpc("<p,neutral>For a human like you, I can do it for free!");
def_int $go = ~p_choice2("That's a deal!", 1, "I prefer the mines to the city.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>I prefer the mines to the city.");
    ~chatnpc("<p,neutral>Well, suit yourself then!");
    return;
}
~chatplayer("<p,happy>That's a deal!");
~chatnpc("<p,neutral>Excellent! I'm just waiting for my ship to arrive and then we can go.");
~chatnpc("<p,quiz>Mind, this trip could take a few minutes! Are you sure you're ready to go as well?");
def_int $ready = ~p_choice2("Yes, I'm ready and don't mind it taking a few minutes.", 1, "No, I don't have time right now, I'll be back later.", 2);
if ($ready = 2) {
    ~chatplayer("<p,neutral>No, I don't have time right now, I'll be back later.");
    ~chatnpc("<p,neutral>Sure, sure! Come back when you need to!");
    return;
}
~chatplayer("<p,happy>Yes, I'm ready and don't mind it taking a few minutes.");
~chatnpc("<p,happy>Well, let's not waste any more time then!");
%giantdwarf_quest = 1;
~giantdwarf_intro_cutscene;

[proc,giantdwarf_intro_cutscene]()
if_close;
p_delay(0);
// tele + cam FIRST so the history plays on the city floor, not the mines
minimap_toggle(2);
if_settab(null, 0);
if_settab(null, 1);
if_settab(null, 2);
if_settab(null, 3);
if_settab(null, 4);
if_settab(null, 5);
if_settab(null, 6);
if_settab(null, 11);
if_settab(null, 12);
// fade BEFORE any tele — opaque first. Shop floor is L0; Consortium is L1.
if_openoverlay(fade_to_black);
p_delay(3);
// 10184 = lid (sx5j57j). 10186 = interiors + south colonnade in the
// near plane (sx5n288). Dest WEST of the cam so the player is not on
// the carpet (red shirt at the bottom of p07).
p_telejump(1_44_159_44_10); // 2860,10186 L1 — west of the cam
~music_playbycoord(coord);
cam_moveto(1_44_159_56_10, 720, 0, 100); // 2872,10186 L1 south edge
cam_lookat(1_44_159_58_30, 80, 0, 100); // 2874,10206 L1 centre halls
p_delay(2);
if_openoverlay(null);
// 2:30 — KELDAGRIM q8 title on inter_260 (top-only). NOT inter_235.
if_openoverlay(inter_260);
if_setcolour(inter_260:com_0, ^red_rgb);
if_setcolour(inter_260:com_1, ^red_rgb);
if_settext(inter_260:com_0, "KELDAGRIM");
if_settext(inter_260:com_1, "Grand Capital of the Dwarven realm");
p_delay(4);
if_openoverlay(null);
p_delay(1); // t010 — title off one beat, history starts t011
// 2:35-3:00 — history stanzas on inter_235 (b12, packed Alvis lines).
// 2014 t011-t032: lines ADD one at a time, then the OLDEST drops (slide).
// Never more than 4 up. p_delay(1) ≈ 0.5s frame step.
if_openoverlay(inter_235);
if_sethide(inter_235:com_0, false); // t011 — "Five hundred years..."
p_delay(1);
if_sethide(inter_235:com_1, false); // t012-t014 — +"saviour of Keldagrim..."
p_delay(3);
if_sethide(inter_235:com_0, true); // t015 — com_1 only
p_delay(1);
if_sethide(inter_235:com_1, true); // t016 — "Founder of the Consortium..."
if_sethide(inter_235:com_2, false);
p_delay(1);
if_sethide(inter_235:com_3, false); // t017 — +"...serve the monarchy..."
p_delay(1);
if_sethide(inter_235:com_4, false); // t018-t020 — +"to serve the Consortium."
p_delay(3);
if_sethide(inter_235:com_2, true); // t021 — com_3+4
p_delay(1);
if_sethide(inter_235:com_3, true); // t022 — none
if_sethide(inter_235:com_4, true);
p_delay(1);
if_sethide(inter_235:com_5, false); // t023 — "By the time of his death..."
p_delay(1);
if_sethide(inter_235:com_6, false); // t024 — +"By now, the Kings..."
p_delay(1);
if_sethide(inter_235:com_7, false); // t025 — +"with only the statue..."
p_delay(1);
if_sethide(inter_235:com_8, false); // t026-t029 — +"old days." (4 up)
p_delay(4);
if_sethide(inter_235:com_5, true); // t030 — com_6-8
p_delay(1);
if_sethide(inter_235:com_6, true); // t031 — com_8 only
if_sethide(inter_235:com_7, true);
p_delay(1);
if_sethide(inter_235:com_8, true); // t032 — none
p_delay(2);
if_openoverlay(null); // 235 closed — aerials need overlay null
// 3:10-3:20 — aerials. hei 900/850 = square roof lids (sx4a7s6 air01).
// hei < 800; look at streets / river, not down onto a rooftop.
p_telejump(0_44_159_40_18); // 2856,10194 behind the west aerial
~music_playbycoord(coord);
cam_moveto(0_44_159_24_20, 620, 0, 100); // 2840,10196 — west, under the lid
cam_lookat(0_44_159_16_28, 180, 0, 100); // 2832,10204 — street / furnace, not the tiles
p_delay(5);
p_telejump(0_44_159_46_4); // 2862,10180 — behind the Kelda aerial
~music_playbycoord(coord);
cam_moveto(0_44_159_48_2, 620, 0, 100); // 2864,10178 — Kelda, hei < 800
cam_lookat(0_44_159_62_1, 220, 0, 100); // 2878,10177 — river mouth / statue
p_delay(5);
p_telejump(0_44_159_40_18); // 2856,10194 behind the bridge aerial
~music_playbycoord(coord);
cam_moveto(0_44_159_44_14, 620, 0, 100); // 2860,10190
cam_lookat(0_44_159_56_6, 160, 0, 100); // 2872,10182 — river, not the palace lid
p_delay(6);
// 3:25-3:33 — look-west from 2864,10178 is the cave (sx5j57j).
// 2864,10176 look-east has water + a bank wedge. Sit 4 tiles further
// east on that same z so the bank is behind the cam.
p_telejump(0_44_159_46_4); // 2862,10180 L0 — bank, walkable (probe)
~music_playbycoord(coord);
cam_moveto(0_44_159_52_0, 520, 0, 100); // 2868,10176 — over the water
cam_lookat(0_44_159_62_1, 140, 0, 100); // 2878,10177 — east along the Kelda
p_delay(1);
if_openoverlay(inter_260);
if_setcolour(inter_260:com_0, ^red_rgb);
if_setcolour(inter_260:com_1, ^red_rgb);
if_settext(inter_260:com_0, "Rise of the Red Axe");
if_settext(inter_260:com_1, "Part 1");
p_delay(14);
if_openoverlay(null);
// 3:35-3:45 — full 7042 over the water. The look-up at 2876,10176 h220
// was a solid cyan fill (sx4a7s6 w01). Skip it; the SW pull already works.
cam_moveto(0_44_159_48_0, 680, 0, 100); // 2864,10176 — pulled SW, high
cam_lookat(0_44_159_62_1, 200, 0, 100); // 2878,10177 — full body
p_delay(2);
if_openoverlay(inter_260);
if_setcolour(inter_260:com_0, ^red_rgb);
if_setcolour(inter_260:com_1, ^red_rgb);
if_settext(inter_260:com_0, "The Giant");
if_settext(inter_260:com_1, "Dwarf");
p_delay(8);
if_openoverlay(null);
// 3:47 — map first, no chat. Boat at the river-mouth. Overlay (not main —
// openChatModal IfClose's main; overlay survives the chat slot). Statue stays
// WHOLE while the boat creeps (2014 t080-t105); the explode anim lands on the
// Both card below, not here.
if_openoverlay(inter_234);
%giantdwarf_statue_invis = 1;
cam_shake(3, 0, 20, 2);
p_delay(2);
// 3:50-4:00 — crash talk ON the map (chat box under overlay 234). Boat creeps.
// 2014 t076-t102: ALL lines force-timed — no "Click here to continue" in any
// frame; durations track text length (4.5s / 2.0s / 3.0s). Hide continue
// BEFORE if_openchat; handle 1/2/3-line IFs.
split_init("<p,neutral>Look, there's the statue of King Alvis, guarding the entrance to Keldagrim!", 380, 4, q8_full);
~giantdwarf_timed_npcchat("Dwarven Boatman", dwarf_city_boatman_mines_prequest, 7); // t076-t083 ≈ 4.0s
split_init("<p,happy>Amazing! And we're going to go straight past it?", 380, 4, q8_full);
~giantdwarf_timed_playerchat(8); // t084-t092 ≈ 4.5s
split_init("<p,happy>That's right!", 380, 4, q8_full);
~giantdwarf_timed_npcchat("Dwarven Boatman", dwarf_city_boatman_mines_prequest, 3); // t093-t096 ≈ 2.0s
split_init("<p,angry>Er, hold on! There's something wrong!", 380, 4, q8_full);
~giantdwarf_timed_npcchat("Dwarven Boatman", dwarf_city_boatman_mines_prequest, 5); // t097-t102 ≈ 3.0s
// 2014: hold-on ends t102, Argh opens t103 (~1 tick). Explosion lands ON the
// Both card (t103 Argh, t110 statue explodes). delay1=275 hold plays on it.
p_delay(1);
if_setanim(inter_234:com_3, mini_statue_explodes);
// 4:04 — Both/Argh at impact, on that map. Do NOT close 234. Heads must talk.
split_init("<p,shock>Argh!", 380, 4, q8_full);
if_setplayerhead(inter_274:com_0);
if_setanim(inter_274:com_0, split_getanim(0));
if_setnpchead(inter_274:com_3, dwarf_city_boatman_mines_prequest);
if_setanim(inter_274:com_3, split_getanim(0));
if_openchat(inter_274); // packed *Both* / *Argh!*
p_delay(8); // explode ON this card
if_close; // chat only; overlay 234 stays
// 4:07 — map, rubble, no chat
p_delay(2);
if_close; // close overlay 234
if_openoverlay(null);
// dock — cutscene berserkers appear, then the arrest
%giantdwarf_cutscene_guard_visible = 1;
p_telejump(0_45_159_9_49); // 2889,10225 L0 — dock stand next to both berserkers
p_delay(3);
~music_playbycoord(coord); // east = Tale of Keldagrim (intro-end unlock via proc)
cam_moveto(0_45_159_5_49, 380, 0, 100); // 2885,10225 — raise + back, planks out
cam_lookat(0_45_159_10_49, 220, 0, 100); // 2890,10225 — guards 2231 in frame
// 4:10-4:25 — dock 3D, high cam, two 2231 + player. 2014 t120-t122: the
// guards are at their posts and "Halt!" floats ABOVE them (npc_say overhead),
// THEN the arrest chat (t123). Force-timed like the map.
if (npc_find(0_45_159_10_49, dwarf_city_berserker_cutscene, 3, 0) = true) {
    npc_say("Halt!");
}
p_delay(2); // overhead holds ~1.5s, then the chat line
split_init("<p,angry>Halt! By order of the Black Guard, you are under arrest!", 380, 4, q8_full);
~giantdwarf_timed_npcchat("Black Guard Berserker", dwarf_city_berserker_cutscene, 8); // t123-t131 ≈ 4.5s
split_init("<p,shock>What?? I didn't do anything! It wasn't me!", 380, 4, q8_full);
~giantdwarf_timed_playerchat(8); // t132-t140 ≈ 4.5s
split_init("<p,neutral>Come with us, human! Commander Veldaban wants a word with you!", 380, 4, q8_full);
~giantdwarf_timed_npcchat("Black Guard Berserker", dwarf_city_berserker_cutscene, 8); // t141+ ≈ 5s
// HQ — fade covers the dock BEFORE tele/reset (no warp into HQ)
if_openoverlay(fade_to_black);
p_delay(2); // dock is black first
%giantdwarf_cutscene_guard_visible = 0;
p_telejump(0_44_159_11_39); // 2827,10215 L0 — E of Veldaban 2129
cam_reset();
minimap_toggle(0);
~initalltabs;
p_delay(2);
if_openoverlay(null);
~music_playbycoord(coord); // HQ = west, back to Land
// Veldaban "Identify yourself" — chatnpc_specific, not Forget's op
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Identify yourself, human!");
~chatplayer("<p,neutral>I err, I'm <displayname>. I was told I was under arrest. I had a little accident on the way in here.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Ah, so you're the one who knocked over the statue of our glorious king!");
~chatplayer("<p,neutral>I suppose so... I mean, I didn't do it on purpose or anything...");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Ah, don't worry about it!");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>We haven't been ruled by a king for many a year... that statue was long overdue for replacement anyway. You're not under arrest, I merely wanted to talk to you.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>But let me introduce myself. I am Veldaban, son of Dondakan. I am the Commander of the Black Guard in Keldagrim.");
if (%dwarfrock_quest = 110) {
    ~chatplayer("<p,neutral>Dondakan, you say?");
    ~chatplayer("<p,neutral>I helped your father in the mines south of the city.");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,happy>Ah, so you are the one! I heard you banished a demon by defeating its avatar, most impressive.");
} else if (%dwarfrock_quest >= 10) {
    ~chatplayer("<p,neutral>Dondakan, you say?");
    ~chatplayer("<p,neutral>I'm helping your father in the mines south of the city.");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Ah, he is forever trying to break open that rock of his, until his death I sometimes think.");
    ~chatplayer("<p,neutral>So you don't think it's possible?");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Perhaps, human, perhaps... but if even our multicannon does not dent it, what chance is there really?");
} else {
    ~chatplayer("<p,neutral>Well, ehm... nice to meet you, Veldaban.");
}
// task + choice
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Now listen carefully. I have a task for you.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>I want you to go and see the local sculptor and help him build a new statue.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,quiz>Will you do this for us?");
def_int $help = ~p_choice2("Yes, I will do this.", 1, "No, I can't be bothered.", 2);
if ($help = 2) {
    ~chatplayer("<p,neutral>No, I can't be bothered.");
    ~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,angry>You destroy our statue and you cannot be bothered to help rebuild it? By Guthix, you are rude... even for a human!");
    return;
}
~chatplayer("<p,happy>Yes, I will do this.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,happy>You are a good human, <displayname>.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Now, I need you to go to Blasidar, he is a sculptor who lives in Keldagrim-East.");
~chatplayer("<p,neutral>To be honest I'm not much of a sculptor myself.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>Oh, don't worry! I just need you to help him out while he rebuilds the statue.");
~chatnpc_specific("Commander Veldaban", dwarf_city_black_guard_leader, "<p,neutral>I'm sure there are many tasks that he needs doing.");
~chatplayer("<p,neutral>I'll see what I can do.");
%giantdwarf_veldaban_introduced = 1;
%giantdwarf_quest = 2;

// Hide continue BEFORE if_openchat. ~chatnpc_page then hide left npcchat3:com_5
// up on the 3-line Look line, so continue showed and the rest never played.
[proc,giantdwarf_timed_npcchat](string $npc_name, npc $npc, int $delay)
def_int $lines = split_linecount(0);
if ($lines = 1) {
    if_setnpchead(npcchat1:com_0, $npc);
    if_setanim(npcchat1:com_0, split_getanim(0));
    if_settext(npcchat1:com_1, $npc_name);
    if_settext(npcchat1:com_2, split_get(0, 0));
    if_sethide(npcchat1:com_3, true);
    if_openchat(npcchat1);
} else if ($lines = 2) {
    if_setnpchead(npcchat2:com_0, $npc);
    if_setanim(npcchat2:com_0, split_getanim(0));
    if_settext(npcchat2:com_1, $npc_name);
    if_settext(npcchat2:com_2, split_get(0, 0));
    if_settext(npcchat2:com_3, split_get(0, 1));
    if_sethide(npcchat2:com_4, true);
    if_openchat(npcchat2);
} else if ($lines = 3) {
    if_setnpchead(npcchat3:com_0, $npc);
    if_setanim(npcchat3:com_0, split_getanim(0));
    if_settext(npcchat3:com_1, $npc_name);
    if_settext(npcchat3:com_2, split_get(0, 0));
    if_settext(npcchat3:com_3, split_get(0, 1));
    if_settext(npcchat3:com_4, split_get(0, 2));
    if_sethide(npcchat3:com_5, true);
    if_openchat(npcchat3);
} else if ($lines = 4) {
    if_setnpchead(npcchat4:com_0, $npc);
    if_setanim(npcchat4:com_0, split_getanim(0));
    if_settext(npcchat4:com_1, $npc_name);
    if_settext(npcchat4:com_2, split_get(0, 0));
    if_settext(npcchat4:com_3, split_get(0, 1));
    if_settext(npcchat4:com_4, split_get(0, 2));
    if_settext(npcchat4:com_5, split_get(0, 3));
    if_sethide(npcchat4:com_6, true);
    if_openchat(npcchat4);
}
p_delay($delay);
if_close;

[proc,giantdwarf_timed_playerchat](int $delay)
def_int $lines = split_linecount(0);
if ($lines = 1) {
    if_setplayerhead(chat1:com_0);
    if_setanim(chat1:com_0, split_getanim(0));
    if_settext(chat1:com_1, displayname);
    if_settext(chat1:com_2, split_get(0, 0));
    if_sethide(chat1:com_3, true);
    if_openchat(chat1);
} else if ($lines = 2) {
    if_setplayerhead(chat2:com_0);
    if_setanim(chat2:com_0, split_getanim(0));
    if_settext(chat2:com_1, displayname);
    if_settext(chat2:com_2, split_get(0, 0));
    if_settext(chat2:com_3, split_get(0, 1));
    if_sethide(chat2:com_4, true);
    if_openchat(chat2);
} else if ($lines = 3) {
    if_setplayerhead(chat3:com_0);
    if_setanim(chat3:com_0, split_getanim(0));
    if_settext(chat3:com_1, displayname);
    if_settext(chat3:com_2, split_get(0, 0));
    if_settext(chat3:com_3, split_get(0, 1));
    if_settext(chat3:com_4, split_get(0, 2));
    if_sethide(chat3:com_5, true);
    if_openchat(chat3);
} else if ($lines = 4) {
    if_setplayerhead(chat4:com_0);
    if_setanim(chat4:com_0, split_getanim(0));
    if_settext(chat4:com_1, displayname);
    if_settext(chat4:com_2, split_get(0, 0));
    if_settext(chat4:com_3, split_get(0, 1));
    if_settext(chat4:com_4, split_get(0, 2));
    if_settext(chat4:com_5, split_get(0, 3));
    if_sethide(chat4:com_6, true);
    if_openchat(chat4);
}
p_delay($delay);
if_close;
