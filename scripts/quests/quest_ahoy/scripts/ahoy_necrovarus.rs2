// CANDIDATE dialogue: retained Ghosts Ahoy transcript. Stage integers UNKNOWN.

[opnpc1,ahoy_necrovarus]
if (%ahoy_questvar < 1) {
    ~displaymessage(^dm_default);
    return;
}
if (~ahoy_can_speak = false) {
    ~chatnpc("<p,shock>Woooo wooo wooooo woooo");
    ~mesbox("You cannot understand the ghost.");
    return;
}
if (%ahoy_questvar >= 7) {
    ~chatnpc("<p,angry>I should fry you for what you have done...");
    return;
}
if (%ahoy_questvar = 6 & inv_total(worn, amulet_of_ghostspeak_enchanted) > 0) {
    @ahoy_necro_command;
}
if (%ahoy_questvar >= 4 & inv_total(inv, ahoy_petition) > 0) {
    @ahoy_necro_petition;
}
if (%ahoy_questvar >= 5 & inv_total(inv, ahoy_bone_key) = 0 & %ahoy_templedoor_unlocked = 0) {
    // UNKNOWN favourable recovery: a lost dropped key never blocks the quest.
    obj_add(npc_coord, ahoy_bone_key, 1, 200);
    return;
}
if (%ahoy_questvar >= 2) {
    @ahoy_necro_again;
}
@ahoy_necro_first;

[label,ahoy_necro_first]
~chatplayer("<p,neutral>I must speak with you on behalf of Velorina.");
~chatnpc("<p,angry>You dare to speak that name in this place?????");
~chatplayer("<p,neutral>She wants to pass-");
~chatnpc("<p,angry>Silence!! Or I will incinerate the flesh from your bones!!!");
~chatplayer("<p,neutral>But she-");
~chatnpc("<p,angry>Get out of my sight!! Or I promise you that you will regret your insolence for the rest of eternity!!!");
if (%ahoy_questvar = 1) {
    %ahoy_questvar = 2;
}
return;

[label,ahoy_necro_again]
~chatplayer("<p,sad>Please, listen to me-");
~chatnpc("<p,angry>No - listen to me. Go from this place and do not return, or I will remove your head.");
return;
