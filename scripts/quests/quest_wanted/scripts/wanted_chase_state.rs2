[proc,wanted_chase_count]()(int)
def_int $count = 0;
def_int $mission = 1;
while ($mission < 19) {
    $count = add($count, ~wanted_chase_done($mission));
    $mission = add($mission, 1);
}
return($count);

[proc,wanted_chase_near](int $mission)(boolean)
if ($mission = 19) return(inzone(0_45_75_0_0, 0_45_75_63_63, coord));
def_coord $centre = ~wanted_chase_coord($mission);
if (coordy(coord) ! coordy($centre)) return(false);
if (distance(coord, $centre) <= ^wanted_scan_radius) return(true);
return(false);
