// UNKNOWN product mapping of the original mission pairs; no new saved fields.
// Period guides give places, not precise tiles. Centres/radius are engineering values.
[proc,wanted_chase_coord](int $mission)(coord)
switch_int ($mission) {
    case 1 : return(0_54_54_48_30);
    case 2 : return(1_38_54_33_39);
    case 3 : return(0_49_52_55_34);
    case 4 : return(0_39_48_53_21);
    case 5 : return(0_45_49_33_29);
    case 6 : return(0_43_49_44_19);
    case 7 : return(0_38_50_7_25);
    case 8 : return(0_38_48_10_18);
    case 9 : return(0_50_149_20_24);
    case 10 : return(0_46_54_11_49);
    case 11 : return(0_51_150_37_5);
    case 12 : return(0_51_50_36_11);
    case 13 : return(0_40_57_60_22);
    case 14 : return(0_41_51_38_39);
    case 15 : return(0_41_54_29_24);
    case 16 : return(0_48_49_36_26);
    case 17 : return(0_53_55_31_30);
    case 18 : return(0_48_50_9_52);
    case 19 : return(0_45_75_32_33);
}
return(null);

[proc,wanted_chase_clue](int $mission)(namedobj)
switch_int ($mission) {
    case 2 : return(gnome_hat_cream);
    case 3 : return(blue_cape);
    case 4 : return(greenmans_ale);
    case 5 : return(banana);
    case 6 : return(eye_patch);
    case 7 : return(blessedsnake);
    case 8 : return(castlewars_ticket);
    case 9 : return(giant_frog_legs);
    case 10 : return(goblin_armour);
    case 11 : return(cave_goblin_bone_spear);
    case 12 : return(feud_karidian_fakebeard);
    case 13 : return(viking_cloak_grey);
    case 14 : if (random(2) = 0) return(cake); return(fur);
    case 15 : return(red_vine_worm);
    case 16 : return(bluewizhat);
    case 17 : return(slayer_earmuffs);
    case 18 : return(horsey_grey);
    case 19 : return(blankrune);
}
return(null);

