// CANDIDATE wording: wanted.dlg.tiffy-start, tiffy-plan, tiffy-crisis,
// tiffy-mission and tiffy-commorb-help. Product stages follow the 0..11 ladder.
// The exchange and replacement checks do not yield between item and stage writes.

[label,wanted_tiffy_menu]
~chatnpc("<p,happy>What ho, <text_gender("sirrah", "milady")>. Jolly good show on the old training grounds thingy, what?");
def_string $quest = "Ask about the Wanted! Quest";
if (%wanted_main = ^wanted_not_started) {
    $quest = "Do you have any jobs for me yet?";
}
def_int $choice = ~p_choice5($quest, 1, "Can you explain the Gaze of Saradomin to me?", 2, "Can I buy some armour?", 3, "Can I switch respawns please?", 4, "Goodbye.", 5);
switch_int ($choice) {
    case 1 : @wanted_tiffy_quest;
    case 2 : @rd_tiffy_gaze_explain;
    case 3 : @rd_tiffy_armour_shop;
    case 4 : @rd_tiffy_switch_respawn;
}
~chatplayer("<p,neutral>Well, see you around Tiffy.");
~chatnpc("<p,happy>Ta-ta for now, old bean!");
return;

[label,wanted_tiffy_quest]
switch_int (%wanted_main) {
    case ^wanted_not_started : @wanted_tiffy_start;
    case ^wanted_plan_accepted, ^wanted_plan_explained : @wanted_tiffy_plan;
    case ^wanted_squire : @wanted_tiffy_squire_crisis;
    case ^wanted_no_crisis : @wanted_tiffy_crisis;
    case ^wanted_crisis_reported : @wanted_tiffy_crisis_reminder;
    case ^wanted_deputised : @wanted_tiffy_mission;
    case ^wanted_commorb_issued, ^wanted_intelligence_open, ^wanted_chase, ^wanted_solus_defeated, ^wanted_complete : @wanted_tiffy_commorb_help;
}
~wanted_journal;
return;

[label,wanted_tiffy_start]
if (~wanted_requirements_met = false) {
    // Product requirement notice, not invented NPC speech.
    mes("You need Recruitment Drive, Priest in Peril, The Lost Tribe and Rune Mysteries complete, and 32 Quest Points to start Wanted!");
    return;
}
~chatplayer("<p,quiz>So Tiffy, now that I'm a Temple Knight Initiate do you have any jobs for me to do?");
~chatplayer("<p,quiz>Do you have any quests for a hard-working adventurer?");
~chatnpc("<p,neutral>Well old <text_gender("boy", "gal")>, looking at the old dossier we have on you here there seems to be a tiny problem, what?");
~chatplayer("<p,confused>Problem? What problem? Er... and you have a dossier on me???");
~chatnpc("<p,neutral>Well OF COURSE we have a dossier on you! We have a dossier on EVERYONE! It's our job, dontchaknow!");
~chatplayer("<p,quiz>Um... okay... So what's the problem?");
~chatnpc("<p,neutral>Well now, seems we made a tiny blunder when we first contacted you to join the Temple Knights, what?");
~chatnpc("<p,neutral>Entirely our own fault, could have been avoided and all that, but a bit of a show-stopper, what?");
~chatplayer("<p,quiz>What is?");
~chatnpc("<p,neutral>Well <text_gender("lad", "lass")>, here's the thing: Only members of the White Knights may join the Temple Knights. By ancient decree, dontchaknow.");
~chatplayer("<p,angry>What? But I am a member of the White Knights! I went and did that stuff with the cabbage and the potion!");
~chatplayer("<p,angry>And I've already done your stupid little mind test thing! You can't get rid of me that easily!");
~chatnpc("<p,neutral>Calm yourself down <text_gender("lad", "lass")>... We have no intention of 'getting rid of you', we are very keen on seeing you join us...");
~chatplayer("<p,quiz>Then what's the problem?");
~chatnpc("<p,neutral>Well, it's like this: Although you have performed a mission on behalf of the White Knights, you were never actually working for them.");
~chatnpc("<p,neutral>As I say, when our order was founded, we were expected to take the best of the best, and it was assumed that anyone worth having on the team would have been a White Knight already, what?");
~chatnpc("<p,neutral>Sadly, this is not the case anymore, and the fact that you have to serve as a Squire to a White Knight for a minimum period of five years before you can actually become one tends to put the more short-attention spanned adventurers off joining, what?");
~chatplayer("<p,shock>You want me to be a squire for five years?!?!");
~chatnpc("<p,laugh>Haw Haw Haw! No, no, goodness me, no!");
~chatnpc("<p,neutral>Five years is a very long period of time nowadays - ANYTHING could happen in that time, and we need capable <text_gender("men", "women")> like yourself as soon as possible.");
~chatnpc("<p,neutral>No, I had a bit of a chat with Sir Vey, and we came up with... A different solution to the problem. Assuming you're still interested, of course.");
def_int $go = ~p_choice2("Yes I'm interested.", 1, "No, I'm bored now.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>No, I'm bored now.");
    ~chatplayer("<p,neutral>No, to be honest I'm getting sick of all these excuses and procrastination. Plus being an initiate was nowhere near as fun as I thought it would be.");
    ~chatplayer("<p,neutral>I'd rather just go off by myself and kill stuff for cash.");
    ~chatnpc("<p,neutral>Well, sorry to hear you say that old boy, but I can't hold it against you.");
    ~chatnpc("<p,neutral>You will of course still be entitled to all that we can provide you with at an initiate level, but sadly you will never advance beyond that in our order. Was there anything you wanted?");
    @wanted_tiffy_menu;
}
// Recheck after the yielding offer; write acceptance before any further Continue.
if (%wanted_main ! ^wanted_not_started | ~wanted_requirements_met = false) {
    return;
}
%wanted_main = ^wanted_plan_accepted;
~wanted_update_progress;
~chatplayer("<p,happy>Yes I'm interested.");
~chatplayer("<p,neutral>I'm still up for joining the Temple Knights, I just don't really feel like spending five years running around shining peoples boots for them.");
~chatnpc("<p,laugh>Haw Haw Haw!");
~chatnpc("<p,neutral>I quite understand, what? No, don't worry, we were doing a little research into the White Knight Charter, and found an interesting loophole, what?");
~chatplayer("<p,quiz>Loophole? What kind of loophole?");
~chatnpc("<p,neutral>Well, you don't need to worry about the details, you just do as I tell you and it will all work out for us both, what?");
~chatplayer("<p,neutral>I guess... I don't really like blindly following orders though...");
return;

[label,wanted_tiffy_plan]
~chatplayer("<p,quiz>So what exactly do you want me to do?");
~chatnpc("<p,neutral>Well now, it's really very simple. I want you to go to Sir Amik, tell him that you have decided to not join the Temple Knights, and that you have decided to become a White Knight instead.");
~chatnpc("<p,neutral>He will then offer you to join as a squire; you will then decline his offer, and ask if you can be deputised instead.");
~chatplayer("<p,neutral>Okaaaay....");
~chatnpc("<p,neutral>If you run into any problems with that, come and see me.");
if (%wanted_main = ^wanted_plan_accepted) {
    %wanted_main = ^wanted_plan_explained;
    ~wanted_update_progress;
}
def_int $question = ~p_choice3("How will all that help?", 1, "Do I really have to quit the Temple Knights?", 2, "What am I supposed to be doing again?", 3);
switch_int ($question) {
    case 1 : @wanted_tiffy_plan_help;
    case 2 : @wanted_tiffy_plan_quit;
}
@wanted_tiffy_plan_again;

[label,wanted_tiffy_plan_help]
~chatplayer("<p,quiz>How will all that help?");
~chatplayer("<p,quiz>I don't exactly understand how that will help me become a White Knight...");
~chatnpc("<p,neutral>Ah, your curiosity does you credit old boy! Let me tell you a little history lesson.");
~chatnpc("<p,neutral>Many centuries ago, the founders of the White Knights realized that in times of crisis, a long waiting period for new Knights could be disastrous for the kingdom, so they added a clause to the founding charter that would allow any citizen who has performed an act in the name of the White Knight to become deputised on a purely temporary basis to a full-fledged White Knight.");
~chatnpc("<p,neutral>Well now, your actions in the Black Knights' Fortress on behalf of the White Knights make you eligible to be deputised.");
~chatnpc("<p,neutral>Besides, you passed the trials to become a Temple Knight, what? If you're good enough to join the elite, then we'd not hesitate to deputise you into the White Knights.");
~chatplayer("<p,quiz>But if deputisation's only temporary, and I have to be a 'proper' White Knight to then become a Temple Knight, doesn't that mean that I am still going to have to squire for Amik for five years?");
~chatnpc("<p,neutral>Ah, well this is where the beauty of the plan lies, dontchaknow?");
~chatnpc("<p,neutral>Once you have been deputised, for the time that you are still working for their order, you are subject to all of the same rules and regulations that normal White Knights are, which means you are also eligible for battlefield promotions.");
~chatplayer("<p,confused>I... don't understand...");
~chatnpc("<p,neutral>Let me put it like this; As a deputy you will be considered the lowest possible rank of the White Knight, and may be removed entirely from their order at a whim.");
~chatnpc("<p,neutral>However, should you achieve some great feat while serving as a White Knight that you would be eligible for a promotion from, then by their own rules you would then have to be raised to a higher level within their order, and it would therefore become impossible to remove your rank, or make you no longer a deputy.");
~chatplayer("<p,quiz>So I get to be a White Knight without having to do five years of pointless busywork?");
~chatnpc("<p,neutral>Indeed. We Temple Knights have our reputation for a reason, donchaknow?");
~chatplayer("<p,quiz>Okay, I guess that makes sense... But we're not in a time of crisis, so doesn't that mean I won't actually get deputised?");
~chatnpc("<p,neutral>Ah, do not concern yourself with THAT old <text_gender("boy", "gal")>; Crisis is such a subjective term, and as you will find out when you join us fully in the Temple Knights, is always some potential crisis or other brewing.");
~chatnpc("<p,neutral>If we weren't as good at our jobs we were, almost every day would be a day of crisis!");
~chatnpc("<p,neutral>All we really need to do is allow the old White Knights to handle a problem that we would normally deal with, and that should be a sufficient crisis to allow you to be deputised, donchaknow.");
def_int $question = ~p_choice2("Do I really have to quit the Temple Knights?", 1, "What am I supposed to be doing again?", 2);
if ($question = 1) {
    @wanted_tiffy_plan_quit;
}
@wanted_tiffy_plan_again;

[label,wanted_tiffy_plan_quit]
~chatplayer("<p,quiz>But... Do I really need to quit the Temple Knights");
~chatplayer("<p,neutral>You seem pretty cool, and I really like the armour...");
~chatnpc("<p,laugh>Haw Haw Haw!");
~chatnpc("<p,neutral>No, not at all, this is merely a ruse; Sir Amik knows full well that his authority over our organization is limited, so he will not deputise you unless he thinks that you are entirely unaffiliated with us.");
~chatnpc("<p,neutral>You are simply going to tell him that you have decided not to join us so that he will in turn deputise you to join the White Knights! We of course still want you to join us, it is just a little... misdirection.");
def_int $question = ~p_choice2("How will all that help?", 1, "What am I supposed to be doing again?", 2);
if ($question = 1) {
    @wanted_tiffy_plan_help;
}
@wanted_tiffy_plan_again;

[label,wanted_tiffy_plan_again]
~chatplayer("<p,quiz>What am I supposed to be doing again?");
~chatnpc("<p,neutral>You are to go to Sir Amik Varze, leader of the White Knights of Falador, and are to tell him that you have decided not to join the Temple Knights.");
~chatnpc("<p,neutral>We will send him a messenger confirming this. He will offer you the opportunity to become his squire, you are to decline, and ask if you can be deputised instead.");
~chatnpc("<p,neutral>If you run into any problems with that, you are then to come and see me for further advice.");
~chatnpc("<p,quiz>Understood?");
~chatplayer("<p,neutral>Um, yeah, I think so...");
return;

[label,wanted_tiffy_squire_crisis]
~chatplayer("<p,happy>I did it Tiffy! I became Sir Amik's squire!");
~chatplayer("<p,happy>That means in just five short years I can be a White Knight!");
~chatnpc("<p,shock>...What? I told you to decline!");
~chatplayer("<p,neutral>Yeeeesssssss.... But I thought it would be more fun to do this?");
~chatnpc("<p,sad>*sigh* This is a less than illustrious start to your career with us <displayname>.");
~chatnpc("<p,neutral>Never mind, all is not lost, I have sent word to Amik that a dangerous criminal we once thought exiled is on the loose again, and that he should send all available White Knights to confront him.");
if (%wanted_main = ^wanted_squire) {
    %wanted_main = ^wanted_crisis_reported;
    ~wanted_update_progress;
}
~chatnpc("<p,neutral>This should give him enough of a scare to deputise you immediately.");
~chatnpc("<p,neutral>Go and speak to Amik again, and then immediately come back here, we will need to prepare you for your mission.");
return;

[label,wanted_tiffy_crisis]
~chatplayer("<p,neutral>Hello again Tiffy. I've just spoken to Amik, and he says he's fine for me to be deputised as a White Knight, there just needs to be a crisis first.");
~chatplayer("<p,quiz>I assume you can arrange a small crisis for me?");
~chatnpc("<p,laugh>Haw Haw Haw, fitting right in with the Temple Knight way of thinking, what?");
~chatnpc("<p,neutral>Well as a matter of fact, I will not have to organise anything, there is a particularly vicious and dangerous criminal currently at loose!");
~chatnpc("<p,neutral>I have already notified Sir Amik through the usual channels, so just go and speak to him quickly, then pop back here and we'll get you equipped for the hunt, what?");
if (%wanted_main = ^wanted_no_crisis) {
    %wanted_main = ^wanted_crisis_reported;
    ~wanted_update_progress;
}
~chatplayer("<p,quiz>You know... Is all this back and forth strictly necessary?");
~chatplayer("<p,neutral>I don't mean to sound ungrateful for the help you're giving me here, but you could have just got this sorted out before sending me off there in the first place!");
~chatnpc("<p,neutral>Ah, yes, well most awfully sorry about all the running around you've been doing old bean, but when it comes to our line of work, sometimes the indirect route is the best, what?");
~chatplayer("<p,confused>I don't understand...?");
~chatplayer("<p,angry>And stop calling me bean! I am not a vegetable, I am a human bean, er, being!");
~chatnpc("<p,neutral>Awfully sorry dear heart, it's just a term of affection, what? Anyway...");
~chatnpc("<p,neutral>This criminal is a very dangerous fellow, and has some very dangerous friends.");
~chatnpc("<p,neutral>If he has no reason to suspect you to be working for us, then he will be a little sloppier than he otherwise might be, because he will just assume you to be one of those stupid White Knights.");
~chatnpc("<p,neutral>We want this man caught, for the good of the country, and if we need to fool a few people into thinking you're nothing to do with us, and you have to do a little extra walking, then that's what is going to happen, what?");
~chatplayer("<p,neutral>I guess... But this spy stuff is a lot more boring than it sounded at first...");
return;

[label,wanted_tiffy_crisis_reminder]
~chatplayer("<p,quiz>Hi Tiffy. What am I supposed to be doing again?");
~chatnpc("<p,neutral>Go and report to Sir Amik for 'orders'. You will be unsurprised to find out he will now be prepared to deputise you.");
~chatnpc("<p,neutral>After you have spoken to him return here immediately, your life will be at risk without our assistance, and we don't want you dying on your first mission for us, what?");
return;
[label,wanted_tiffy_mission]
if (%wanted_main ! ^wanted_deputised | inv_total(inv, wanted_crystal_ball) > 0 | inv_total(bank, wanted_crystal_ball) > 0) {
    return;
}
~chatplayer("<p,neutral>Tiffy, it worked exactly to plan! Sir Amik deputised me to take care of this Solus Doolally dude, so let's go get him!");
~chatnpc("<p,neutral>His name is Solus Dellagar, and honestly, he is one of the most dangerous men on the planet.");
~chatnpc("<p,neutral>Not only is he extremely adapt at magic, he is also quite prepared to use that magic at a moments notice, because he is quite, quite mad.");
~chatplayer("<p,quiz>So... Dragonhide armour and an elemental shield and I'm laughing?");
~chatnpc("<p,neutral>No, no, no. Listen to me <text_gender("boy", "girl")>; You are under NO CIRCUMSTANCES to engage him directly in combat!");
~chatnpc("<p,neutral>You are to act as our agent and track him down, when you have managed to corner him somewhere then we will send in a field recovery team directly to take him away without incident.");
~chatnpc("<p,neutral>I cannot stress this enough; You are to observe and locate, you are NOT to enter a combat situation!");
~chatplayer("<p,neutral>Riiiiight.... So I'm just going to scout him out for you then.");
~chatplayer("<p,quiz>Any tips on how to find him?");
~chatnpc("<p,neutral>Well old <text_gender("boy", "girl")>, we need to equip you for the task, but you'll need to get something for me first, what?");
~chatplayer("<p,quiz>What kind of stuff?");
~chatnpc("<p,neutral>Well, we teach our operatives the value of their equipment by making them pay for it, what?");
~chatnpc("<p,neutral>You have two choices here, you can either give me the cash directly, and I will hand it over, or you can bring me the raw materials and I will make you one.");
def_int $method = ~p_choice2("Buy One", 1, "Have One Made", 2);
if ($method = 1) {
    @wanted_tiffy_buy_commorb;
} else {
    @wanted_tiffy_make_commorb;
}
return;

[label,wanted_tiffy_buy_commorb]
// The recorded Buy One route refuses a full inventory before checking coins.
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>Well we in the Temple Knights have some specific equipment for situations such as this dontchaknow, but you'll need to free up some inventory space first!");
    return;
}
~chatnpc("<p,neutral>It's 10,000 coins for the Temple Knight Communication Orb. You have that kind of money with you?");
if (inv_total(inv, coins) < 10000) {
    @wanted_tiffy_commorb_missing_coins;
    return;
}
~chatplayer("<p,neutral>Oh yeah, I got your money.");
~chatnpc("<p,neutral>Then you wish to purchase a Temple Knight Communication Orb?");
def_int $confirm = ~p_choice2("Yes", 1, "No", 2);
if ($confirm ! 1) {
    ~chatplayer("<p,neutral>Actually, no thanks.");
    ~chatnpc("<p,neutral>As you wish, what?");
    return;
}
// The confirmation yields. Recheck every precondition, then commit the payment,
// item and stage together before the next dialogue can yield.
if (%wanted_main ! ^wanted_deputised | inv_total(inv, wanted_crystal_ball) > 0 | inv_total(bank, wanted_crystal_ball) > 0) {
    return;
}
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>Well we in the Temple Knights have some specific equipment for situations such as this dontchaknow, but you'll need to free up some inventory space first!");
    return;
}
if (inv_total(inv, coins) < 10000) {
    return;
}
inv_del(inv, coins, 10000);
inv_add(inv, wanted_crystal_ball, 1);
%wanted_main = ^wanted_commorb_issued;
~wanted_update_progress;
@wanted_tiffy_commorb_issued;
return;

[label,wanted_tiffy_commorb_missing_coins]
~chatplayer("<p,sad>I don't have that kind of money with me...");
~chatnpc("<p,neutral>Perhaps you would like to just bring me the components of it then, what?");
~chatnpc("<p,neutral>Bring me one law rune, one slayer gem and one piece of molten glass and I will make you a Communication Orb.");
if (inv_total(inv, lawrune) > 0 | inv_total(inv, slayer_gem) > 0 | inv_total(inv, molten_glass) > 0) {
    ~chatplayer("<p,quiz>Can I give you the components I have with me now?");
    ~chatnpc("<p,neutral>Heavens, boy! I am not a pawn shop, to be holding bits and pieces for you while you go off and do something else!");
    ~chatnpc("<p,neutral>No, no you bring me all three components at the same time, what?");
}
~chatplayer("<p,neutral>Okay Tiffy.");
return;

[label,wanted_tiffy_make_commorb]
if (inv_total(inv, lawrune) = 0 & inv_total(inv, slayer_gem) = 0 & inv_total(inv, molten_glass) = 0) {
    ~chatnpc("<p,neutral>Bring me one Law Rune, one Slayer Gem and one piece of Molten Glass and I will make you a Communication Orb.");
    return;
}
if (inv_total(inv, lawrune) < 1 | inv_total(inv, slayer_gem) < 1 | inv_total(inv, molten_glass) < 1) {
    ~chatplayer("<p,quiz>Can I give you the components I have with me now?");
    ~chatnpc("<p,neutral>Heavens, boy! I am not a pawn shop, to be holding bits and pieces for you while you go off and do something else!");
    ~chatnpc("<p,neutral>No, no you bring me all three components at the same time, what?");
    return;
}
~chatplayer("<p,neutral>I have all three components for you to make me a Communication Orb out of now Tiffy.");
~chatnpc("<p,happy>Excellent! You wish me to make you one now then, what?");
def_int $confirm = ~p_choice2("Yes", 1, "No", 2);
if ($confirm ! 1) {
    ~chatplayer("<p,neutral>Actually, no thanks.");
    ~chatnpc("<p,neutral>As you wish, what?");
    return;
}
// Consuming the three source items frees output capacity even when the inventory
// was full; the post-confirmation check avoids partial payment after a stale menu.
if (%wanted_main ! ^wanted_deputised | inv_total(inv, wanted_crystal_ball) > 0 | inv_total(bank, wanted_crystal_ball) > 0) {
    return;
}
if (inv_total(inv, lawrune) < 1 | inv_total(inv, slayer_gem) < 1 | inv_total(inv, molten_glass) < 1) {
    return;
}
inv_del(inv, lawrune, 1);
inv_del(inv, slayer_gem, 1);
inv_del(inv, molten_glass, 1);
inv_add(inv, wanted_crystal_ball, 1);
%wanted_main = ^wanted_commorb_issued;
~wanted_update_progress;
@wanted_tiffy_commorb_issued;
return;

[label,wanted_tiffy_commorb_issued]
~chatnpc("<p,happy>Here take this Communications Orb, or 'CommOrb' for short.");
~chatnpc("<p,neutral>It is a precise magical mechanism that we can use to track him, by sending data of the surrounding area back to one of our information operatives at the Temple Knight Headquarters.");
~chatnpc("<p,neutral>Your information operative is known as Savant, I suggest you contact them using your CommOrb at your earliest convenience.");
~chatnpc("<p,neutral>They will be able to send you any useful data about Solus directly through it for your perusal, dontchaknow.");
~chatplayer("<p,neutral>Ok, thanks Tiffy!");
return;

[label,wanted_tiffy_commorb_help]
if (%wanted_main ! ^wanted_commorb_issued & %wanted_main ! ^wanted_intelligence_open & %wanted_main ! ^wanted_chase & %wanted_main ! ^wanted_solus_defeated & %wanted_main ! ^wanted_complete) {
    return;
}
// A held or banked Commorb is still the player's; only a genuinely missing
// orb gets the source-record free replacement. No floor inventory is consulted.
if (inv_total(inv, wanted_crystal_ball) = 0 & inv_total(bank, wanted_crystal_ball) = 0) {
    // No recorded capacity response exists. Do not invent NPC speech.
    if (inv_freespace(inv) = 0) {
        return;
    }
    ~chatplayer("<p,sad>Hey Tiffy, I lost my CommOrb...");
    if (%wanted_main ! ^wanted_commorb_issued & %wanted_main ! ^wanted_intelligence_open & %wanted_main ! ^wanted_chase & %wanted_main ! ^wanted_solus_defeated & %wanted_main ! ^wanted_complete) {
        return;
    }
    if (inv_total(inv, wanted_crystal_ball) > 0 | inv_total(bank, wanted_crystal_ball) > 0 | inv_freespace(inv) = 0) {
        return;
    }
    inv_add(inv, wanted_crystal_ball, 1);
    ~chatnpc("<p,neutral>Very careless of you, what? Here, take another, but be careful of this one!");
    if (inv_total(inv, wanted_crystal_ball) > 0 & %wanted_commorb_intel = 0) {
        @wanted_tiffy_commorb_first_use;
    }
    return;
}
// The record has no post-intelligence reminder. Keep that state silent.
if (%wanted_commorb_intel = 0 & (inv_total(inv, wanted_crystal_ball) > 0 | inv_total(bank, wanted_crystal_ball) > 0)) {
    @wanted_tiffy_commorb_first_use;
}
return;

[label,wanted_tiffy_commorb_first_use]
~chatplayer("<p,quiz>Hi Tiffy. What am I supposed to be doing again?");
~chatnpc("<p,neutral>You are hunting for Solus Dellagar, the evil criminal mastermind.");
~chatnpc("<p,neutral>I suggest you contact Savant through your CommOrb and see if she can send you any relevant information about your assignment.");
return;
