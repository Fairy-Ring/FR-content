// The later (2024) postquest Fire shortcut is deliberately excluded.
[oploc1,dwarf_rock_multicannon1]
if (%dwarfrock_quest < 50 | %dwarfrock_quest >= 100) {
    mes("You should speak to Dondakan first."); // UNKNOWN functional refusal.
    return;
}
@dwarfrock_launch;

[label,dwarfrock_launch]
if (%dwarfrock_quest < 50 | %dwarfrock_quest = 100) return;
if (inv_total(worn, dwarf_goldrock_helmet) = 0) {
    mes("Not without wearing your golden helmet you're not!");
    return;
}
// UNKNOWN map-derived landing, not a recovered historical destination.
anim(dwarfrock_cannon_incannon, 0);
~mesbox("Dondakan fires the cannon.");
p_telejump(0_36_77_2_24);
anim(dwarfrock_cannon_fly_getup, 0);
if (%dwarfrock_quest < 100) %dwarfrock_quest = 60;
%dwarfrock_inside_visited = 1;
%dwarfrock_inside_timeleft = 800; // CANDIDATE eight minutes, 2007-base transcript.
settimer(dwarfrock_inside, 1);
mes("Your helmet starts to feel heavier and heavier!");

[timer,dwarfrock_inside]
if (~dwarfrock_in_mine = false) return;
if (inv_total(worn, dwarf_goldrock_helmet) = 0 | %dwarfrock_inside_timeleft = 0) {
    queue(dwarfrock_leave_mine, 0, 0);
    return;
}
%dwarfrock_inside_timeleft = sub(%dwarfrock_inside_timeleft, 1);
settimer(dwarfrock_inside, 1);

[proc,dwarfrock_in_mine]()(boolean)
return(inzone(0_36_77_0_0, 3_39_77_63_63, coord));

[queue,dwarfrock_leave_mine]
if (~dwarfrock_in_mine = false) return;
~dwarfrock_exit;

[proc,dwarfrock_exit]
%dwarfrock_inside_timeleft = 0;
// UNKNOWN favourable default: preserve carried gold; no invented item-loss rule.
p_telejump(0_44_158_8_55);
mes("The world turns black and you feel as if you're being sucked out of the rock.");
