// Pyramid interactions use original locs/NPCs/varbits only.
// VERIFIED q97: first Touch enters; the west-chamber tile board grants the jar and flashes the player outside.
// UNKNOWN: initial board mask, selector-to-jar/guardian mapping, safe landings, and local recovery choices.

[proc,ics_little_in_pyramid](coord $at)(boolean)
if (coordx($at) < ^ics_little_pyramid_min_x | coordx($at) > ^ics_little_pyramid_max_x) return(false);
if (coordz($at) < ^ics_little_pyramid_min_z | coordz($at) > ^ics_little_pyramid_max_z) return(false);
return(true);

[proc,ics_little_in_east_room](coord $at)(boolean)
if (coordx($at) < ^ics_little_east_room_min_x | coordx($at) > ^ics_little_east_room_max_x) return(false);
if (coordz($at) < ^ics_little_east_room_min_z | coordz($at) > ^ics_little_east_room_max_z) return(false);
return(true);

[proc,ics_little_teleport_check](coord $at)(boolean)
// `$at` is the player's current tile in the native magic precheck.
if (%ics_stateofmind = 1 & ~ics_little_in_pyramid($at) = true) return(false);
if (%ics_stateofmind = 1) %ics_stateofmind = 0;
return(true);

[proc,ics_little_guardian]()(boolean)
if (npc_type = ics_little_het | npc_type = ics_little_apmeken | npc_type = ics_little_scabaras | npc_type = ics_little_crondis) return(true);
return(false);

// Quiet admission predicate shared by native melee, ranged, and magic.
[proc,ics_little_encounter_attackable]()(boolean)
def_npc $type = npc_type;
if ($type ! ics_little_het & $type ! ics_little_apmeken & $type ! ics_little_scabaras & $type ! ics_little_crondis & $type ! ics_little_possessedpriest) return(true);
if (%npc_attacking_uid ! uid | ~ics_little_in_pyramid(coord) = false) return(false);
if ($type = ics_little_possessedpriest) {
    if (%ics_little_var = 19) return(true);
    return(false);
}
if (%ics_little_var = 6) return(true);
return(false);


[oploc1,icthalarins_temple_door]
if (%ics_little_var ! 2) return;
%ics_stateofmind = 1;
settimer(ics_little_traps, 1);
p_telejump(^ics_little_pyramid_entry);

[oploc3,icthalarins_temple_door]
if (%ics_little_var < 5) return;
if (~ics_little_has_cat = false) {
    ~displaymessage(^dm_default);
    return;
}
%ics_stateofmind = 0;
if (%ics_little_var = 5 | %ics_little_var = 6) ~ics_little_set_pot_visibility(0);
settimer(ics_little_traps, 1);
p_telejump(^ics_little_pyramid_entry);

// The western doorway owns the native tile puzzle. The eastern doorway is the
// sourced exit/return trigger for the hidden symbol and the ceremony.
[oploc1,doorway]
if (loc_coord = ^ics_little_west_door & %ics_little_var = 2) {
    if (%ics_little_tilecount = 0 & %ics_tilechecker = 0) ~ics_little_puzzle_reset;
    if (%ics_tilechecker = ^ics_little_puzzle_goal & %ics_little_tilecount > 0) {
        if (~ics_little_finish_puzzle = true) return;
    }
    if_openmain(inter_96);
    ~ics_little_render_puzzle;
    return;
}
if (loc_coord = ^ics_little_west_door & %ics_little_var >= 5) {
    loc_anim(icthalarins_door_closes);
    if (coordz(coord) <= coordz(loc_coord)) {
        p_telejump(^ics_little_west_door_outside);
    } else {
        p_telejump(^ics_little_west_door_inside);
    }
    return;
}
if (loc_coord = ^ics_little_east_door) {
    def_boolean $from_inside = false;
    if (coordz(coord) <= coordz(loc_coord)) $from_inside = true;
    loc_anim(icthalarins_door_closes);
    if ($from_inside = true) {
        p_telejump(^ics_little_east_door_outside);
    } else {
        p_telejump(^ics_little_east_door_inside);
    }
    if (%ics_little_var = 14 & $from_inside = true) {
        %ics_little_var = 15;
        %ics_stateofmind = 0;
        return;
    }
    if ((%ics_little_var = 15 | %ics_little_var = 19) & $from_inside = false) {
        if (%ics_little_var = 15) %ics_little_var = 19;
        ~ics_little_start_possessed_priest;
    }
    return;
}
loc_anim(icthalarins_door_closes);

[if_button,inter_96:com_4] ~ics_little_puzzle_click(0, 0);
[if_button,inter_96:com_5] ~ics_little_puzzle_click(0, 1);
