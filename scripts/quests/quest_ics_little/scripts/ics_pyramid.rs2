[ai_queue3,ics_little_crondis] ~ics_little_guardian_death;

[proc,ics_little_encounter_damage](int $damage)
if (finduid(%npc_attacking_uid) = false) return;
if (%npc_aggressive_player ! uid) return;
if (~ics_little_encounter_attackable = false) return;
~npc_default_damage($damage);

[proc,ics_little_guardian_spawned]
%npc_action_delay = map_clock;
npc_settimer(1);

[proc,ics_little_start_guardian]()(boolean)
if (%ics_little_var = 5) %ics_little_var = 6;
if (%ics_little_var ! 6) return(false);
%ics_stateofmind = 1;
def_npc $guardian;
switch_int (%ics_little_jar_multi) {
    case 1 : $guardian = ics_little_het;
    case 2 : $guardian = ics_little_apmeken;
    case 3 : $guardian = ics_little_scabaras;
    case 4 : $guardian = ics_little_crondis;
}
if ($guardian = null) return(false);
npc_findall(^ics_little_guardian_spawn, $guardian, ^ics_little_encounter_search_radius, 0);
while (npc_findnext = true) {
    if (%npc_attacking_uid = uid) return(true);
}
npc_add(^ics_little_guardian_spawn, $guardian, ^ics_little_encounter_lifetime);
%npc_attacking_uid = uid;
%npc_macro_event_target = uid;
%npc_action_delay = map_clock;
npc_setmode(opplayer2);
npc_settimer(1);
return(true);

[proc,ics_little_guardian_timer]
if (finduid(%npc_attacking_uid) = false) {
    npc_del;
    return;
}
if (%death = ^true | %ics_little_var ! 6 | ~ics_little_in_pyramid(coord) = false) {
    npc_del;
    return;
}
npc_settimer(1);

[proc,ics_little_guardian_retaliate]
if (~npc_retal_ready = false) return;
if (finduid(%npc_attacking_uid) = false) return;
%npc_action_delay = add(map_clock, divide(npc_param(attackrate), 2));
npc_setmode(opplayer2);

[proc,ics_little_guardian_death]
if (npc_findhero = ^true & uid = %npc_attacking_uid & %ics_little_var = 6) queue(ics_little_guardian_defeated, 0, 0);
gosub(npc_default_death);

[queue,ics_little_guardian_defeated]
if (%ics_little_var ! 6) return;
%ics_little_var = 7;
%ics_stateofmind = 1;

[proc,ics_little_start_possessed_priest]
if (%ics_little_var ! 19 | ~ics_little_in_pyramid(coord) = false) return;
npc_findall(^ics_little_possessed_spawn, ics_little_possessedpriest, ^ics_little_encounter_search_radius, 0);
while (npc_findnext = true) {
    if (%npc_attacking_uid = uid) return;
}
npc_add(^ics_little_possessed_spawn, ics_little_possessedpriest, ^ics_little_encounter_lifetime);
%npc_attacking_uid = uid;
%npc_macro_event_target = uid;
%npc_action_delay = map_clock;
%npc_int = 0;
npc_setmode(none);
npc_settimer(1);

[ai_spawn,ics_little_possessedpriest] ~ics_little_possessed_spawned;
[ai_timer,ics_little_possessedpriest] ~ics_little_possessed_timer;
[ai_applayer2,ics_little_possessedpriest]
if (~ics_little_encounter_attackable = false) return;
// VERIFIED q97:107: spellcaster. UNKNOWN: Wind Strike is a favourable spell selection.
~npc_cast_spell(^wind_strike, npc_param(attackrate));
[ai_queue1,ics_little_possessedpriest] ~ics_little_possessed_retaliate;
[ai_queue2,ics_little_possessedpriest] ~ics_little_encounter_damage(last_int);
[ai_queue3,ics_little_possessedpriest] ~ics_little_possessed_death;

[proc,ics_little_possessed_spawned]
%npc_action_delay = map_clock;
npc_settimer(1);

[proc,ics_little_possessed_timer]
if (finduid(%npc_attacking_uid) = false) {
    npc_del;
    return;
}
if (%death = ^true | %ics_little_var ! 19 | ~ics_little_in_pyramid(coord) = false) {
    npc_del;
    return;
}
if (~ics_little_in_east_room(coord) = false) {
    npc_setmode(none);
    %npc_int = 0;
    npc_settimer(1);
    return;
}
if (%npc_int = 0) {
    npc_setmode(applayer2);
    %npc_int = 1;
}
npc_settimer(1);

[proc,ics_little_possessed_retaliate]
if (~npc_retal_ready = false) return;
if (finduid(%npc_attacking_uid) = false) return;
%npc_action_delay = add(map_clock, divide(npc_param(attackrate), 2));
npc_setmode(applayer2);

[proc,ics_little_possessed_death]
if (npc_findhero = ^true & uid = %npc_attacking_uid & %ics_little_var = 19) queue(ics_little_possessed_defeated, 0, 0);
gosub(npc_default_death);

[queue,ics_little_possessed_defeated]
if (%ics_little_var ! 19) return;
%ics_little_var = 24;
%ics_stateofmind = 0;
