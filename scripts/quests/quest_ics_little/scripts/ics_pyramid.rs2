[if_button,inter_96:com_17] ~ics_little_puzzle_click(2, 3);
[if_button,inter_96:com_18] ~ics_little_puzzle_click(2, 4);
[if_button,inter_96:com_19] ~ics_little_puzzle_click(3, 0);
