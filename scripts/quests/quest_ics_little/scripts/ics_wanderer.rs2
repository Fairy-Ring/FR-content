// VERIFIED: Tip.It q97, captured 15 April 2006, requirements and start.
// UNKNOWN: concise functional dialogue where no pre-rewrite transcript survives.
[opnpc1,ics_little_redheadlady]
if (%ics_little_var >= 2) {
    ~chatnpc("<p,neutral>The passage into Sophanem is open.");
    return;
}
if (%ics_little_var = 0) {
    if (%fluffs < ^fluffs_complete) {
        ~chatnpc("<p,neutral>You must complete Gertrude's Cat first.");
        return;
    }
    if (~ics_little_has_cat = false) {
        ~chatnpc("<p,neutral>Bring your cat with you.");
        return;
    }
    ~chatplayer("<p,neutral>Good day, wanderer.");
    ~chatnpc("<p,angry>Aghhh get that cat away from me.");
    ~chatnpc("<p,neutral>I can show you a secret passage into Sophanem.");
    def_int $go = ~p_choice2("Okay, I'll get you your supplies.", 1, "Sorry, I've got other things to do.", 2);
    if ($go = 2) {
        return;
    }
    %ics_little_var = 1;
    ~send_quest_progress(questlist:ics_little, %ics_little_var, ^ics_little_complete);
}
~ics_little_wanderer_supplies;

[opnpcu,ics_little_redheadlady]
if (last_useitem = water_skin4 | last_useitem = tinderbox) {
    if (%ics_little_var = 1) {
        ~ics_little_wanderer_supplies;
        return;
    }
}
~displaymessage(^dm_default);

[proc,ics_little_wanderer_supplies]
if (~ics_little_has_cat = true) {
    ~chatnpc("<p,angry>Get that cat away from me!");
    return;
}
if (inv_total(inv, water_skin4) = 0 | inv_total(inv, tinderbox) = 0) {
    ~chatnpc("<p,neutral>Bring me a full waterskin and a tinderbox.");
    return;
}
~chatnpc("<p,neutral>Good... Now, look into my eyes...");
~chatnpc("<p,neutral>Look deeply into them...");
~chatnpc("<p,neutral>Don't blink...");
// Commit the accepted supplies and hypnosis before the journey.
inv_del(inv, water_skin4, 1);
inv_del(inv, tinderbox, 1);
%ics_ent_open = 1;
%ics_little_var = 2;
p_telejump(^ics_little_pyramid_surface);
~mesbox("You wake in Sophanem, with no memory of your journey.");

[proc,ics_little_has_cat]()(boolean)
if (%follower_obj = null) {
    return(false);
}
def_category $kind = oc_category(%follower_obj);
if ($kind ! kitten & $kind ! cat & $kind ! overgrown) {
    return(false);
}
if (.npc_finduid(%follower_uid) = false) {
    return(false);
}
if (.%npc_attacking_uid ! uid | .npc_range(coord) > ^ics_little_cat_max_range) {
    return(false);
}
return(true);

[oploc1,icthal_entrance_open]
if (%ics_little_var < 2) {
    return;
}
p_telejump(^ics_little_pyramid_surface);

[oploc1,ics_wall_crack]
// An unconditional way out prevents a lost cat or jar from stranding the player.
p_telejump(0_51_44_58_40);

[oploc1,clue_suggestion_list]
if (coordz(coord) > 2809) {
    if (%ics_little_var < 5) {
        ~mesbox("The city is closed. The Wanderer's passage may offer another way in.");
        return;
    }
    p_telejump(0_51_43_20_56);
} else {
    p_telejump(0_51_43_20_58);
}
