// VERIFIED flow: Tip.It q125. UNKNOWN functional connecting dialogue.
[opnpc1,agrith_badden]
if (%agrith_quest = 0) return;
if (%agrith_quest = 120) {
    ~agrith_reward;
    return;
}
if (%agrith_quest >= ^agrith_complete) {
    ~chatnpc("<p,happy>Thank Saradomin!");
    return;
}
if (%agrith_quest >= 90) {
    if (%agrith_badden_uzer < 2) {
        ~chatnpc("<p,neutral>You need someone to help with the ritual?");
        if (~p_choice2("Please help us.", 1, "Not yet.", 2) = 1) {
            def_string $speaker_name = npc_name;
            def_npc $speaker = npc_type;
            %agrith_badden_uzer = 2;
            ~chatnpc_specific($speaker_name, $speaker, "<p,neutral>I will meet you in the throne room.");
        }
    }
    ~agrith_sword_recovery;
    return;
}
~chatnpc("<p,neutral>What brings you to this godsforsaken desert?");
if (%agrith_quest = 10) {
    if (~p_choice2("Reen sent me.", 1, "Just passing through.", 2) ! 1) return;
    ~chatplayer("<p,neutral>Reen sent me.");
    ~chatnpc("<p,neutral>We need you to infiltrate Denath's group. You will find them beneath these ruins.");
    %agrith_quest = 20;
}
~agrith_sword_recovery;
