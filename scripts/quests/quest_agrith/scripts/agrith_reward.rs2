// VERIFIED: retained period Tip.It q125 rewards and Sir Prysin recovery price.
[proc,agrith_reward]
if (%agrith_quest ! 120) return;
if (~agrith_reward_space = false) return;
def_stat $skill = null;
while ($skill = null) {
    switch_int(~p_choice5("Attack", 1, "Strength", 2, "Defence", 3, "Ranged", 4, "More skills", 5)) {
        case 1 : $skill = attack;
        case 2 : $skill = strength;
        case 3 : $skill = defence;
        case 4 : $skill = ranged;
        case 5 :
            switch_int(~p_choice3("Magic", 1, "Hitpoints", 2, "Back", 3)) {
                case 1 : $skill = magic;
                case 2 : $skill = hitpoints;
            }
        case default : return;
    }
}
if (%agrith_quest ! 120 | ~agrith_reward_space = false) return;
// Commit first: cancelling a dialogue, relogging or talking to another monk
// cannot replay XP, sword, quest points or the completion scroll.
%agrith_quest = ^agrith_complete;
~agrith_transform_sword;
stat_advance($skill, 100000); // VERIFIED 10,000 XP; the engine stores tenths.
session_log(^log_adventure, "Quest complete: Shadow of the Storm");
~send_quest_complete(questlist:agrith, darklight, 250, ^agrith_questpoints, "You have completed Shadow of the Storm!", "Darklight|10,000 <~stat_name($skill)> XP");
~agrith_clear_cult;

[proc,agrith_reward_space]()(boolean)
def_obj $sword = inv_getobj(worn, ^wearpos_rhand);
if ($sword = silverlight | $sword = agrith_silverlight_dyed) return(true);
if (inv_total(inv, silverlight) > 0 | inv_total(inv, agrith_silverlight_dyed) > 0 | inv_freespace(inv) > 0) return(true);
mes("Make a free inventory space for Darklight, then speak to Father Reen or Father Badden.");
return(false);

[proc,agrith_transform_sword]
def_obj $sword = inv_getobj(worn, ^wearpos_rhand);
if ($sword = silverlight | $sword = agrith_silverlight_dyed) {
    inv_setslot(worn, ^wearpos_rhand, darklight, 1);
    ~update_all($sword);
    return;
}
if (inv_total(inv, agrith_silverlight_dyed) > 0) inv_del(inv, agrith_silverlight_dyed, 1);
else if (inv_total(inv, silverlight) > 0) inv_del(inv, silverlight, 1);
inv_add(inv, darklight, 1);

[proc,agrith_prysin_recovery]
// The caller preserves hard-clue precedence and Demon Slayer before entering.
if (~obj_gettotal(darklight) > 0) {
    ~chatnpc("<p,neutral>You already have Darklight.");
    return;
}
~chatnpc("<p,neutral>I can replace Darklight for 1,000 gold pieces.");
if (~p_choice2("Buy Darklight for 1,000 coins.", 1, "No thanks.", 2) ! 1) return;
if (%agrith_quest < ^agrith_complete | ~obj_gettotal(darklight) > 0) return;
if (inv_total(inv, coins) < 1000) {
    ~chatnpc("<p,neutral>You don't have enough gold.");
    return;
}
if (inv_freespace(inv) = 0 & inv_total(inv, coins) ! 1000) {
    mes("You need a free inventory space for Darklight.");
    return;
}
inv_del(inv, coins, 1000);
inv_add(inv, darklight, 1);
~objbox(darklight, "Sir Prysin gives you Darklight.", 250, 0, ^objbox_height);
