// CANDIDATE: bounded Old School Darklight article; Weaken uses 50% energy,
// stab defence, and additive 5% base + 1 drains (10% base + 1 for demons).
// The later movement-animation fix is not adopted. Original animation unknown:
// use the cache sword's ordinary swing, without a movement-unlocking override.
[label,agrith_darklight_special]
~set_sa_vars(oc_param(darklight, sa_energy));
def_int $damage = 0;
def_int $maxhit = ~player_npc_salve_scale(%com_maxhit);
def_int $attack_roll = ~player_npc_salve_scale(~player_attack_roll_specific(%damagetype));
if (npc_param(demonbane_vulnerable) = true) {
    $attack_roll = scale(160, 100, $attack_roll);
    $maxhit = scale(160, 100, $maxhit);
}
if (randominc($attack_roll) > randominc(~npc_defence_roll_specific(^stab_style))) {
    $damage = randominc(~npc_max_dealt($maxhit, 0));
    if (npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth) $damage = 0;
    def_int $drain = 5;
    if (npc_param(demonbane_vulnerable) = true) $drain = 10;
    npc_statsub(attack, add(scale(npc_basestat(attack), 100, $drain), 1), 0);
    npc_statsub(strength, add(scale(npc_basestat(strength), 100, $drain), 1), 0);
    npc_statsub(defence, add(scale(npc_basestat(defence), 100, $drain), 1), 0);
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
anim(%com_attackanim, 0);
if (%com_attacksound ! null) sound_synth(%com_attacksound, 0, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20);
if (npc_param(defend_sound) ! null) sound_synth(npc_param(defend_sound), 0, 20);

// CANDIDATE: the same bounded Weaken description applies to player opponents.
// Players are non-demonic: successful hits drain 5% of each base level plus one.
[label,agrith_darklight_pvp_special]
~set_sa_vars(oc_param(darklight, sa_energy));
~set_pk_vars;
def_int $damage = 0;
def_int $maxhit = %com_maxhit;
def_int $attack_roll = ~player_attack_roll_specific(%damagetype);
def_int $defence_roll = ~.player_defence_roll_specific(^stab_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    if (~.check_protect_prayer(^melee_style) = true) $maxhit = scale(6, 10, $maxhit);
    $damage = min(randominc($maxhit), .stat(hitpoints));
    .stat_drain(attack, add(scale(.stat_base(attack), 100, 5), 1), 0);
    .stat_drain(strength, add(scale(.stat_base(strength), 100, 5), 1), 0);
    .stat_drain(defence, add(scale(.stat_base(defence), 100, 5), 1), 0);
    ~give_combat_experience_pvp(%damagestyle, $damage, ~pvp_xp_multiplier(~.player_combat_level));
    both_heropoints($damage);
}
anim(%com_attackanim, 0);
if (%com_attacksound ! null) {
    sound_synth(%com_attacksound, 0, 0);
    .sound_synth(%com_attacksound, 1, 0);
}
if (.%com_defendanim ! null) .anim(.%com_defendanim, 20);
.queue*(pvp_retaliate, 0)(uid);
~.pvp_damage(0, $damage);
