// One Small Favour — Seers weathervane Look / rusted Search / hammer / part grant
// / anvil swap / Use-fixed / last-part. CANDIDATE last-resort 2007-base minus
// Changes (OSRS Transcript:One Small Favour Weather vane). Bind broken child
// 5809 only. Gate %onesmallfavour >= 28. No dest / 12346 / 4435. Hunt 289? no.
// Loosen _9_9 · grant-done _10_10. Place bits ornamentfixed / directionalsfixed
// / rotatingpillarfixed. Last part weathervanefixed. Stay 28.

[oploc1,favour_weathervane_broken]
if (%onesmallfavour < 28 | %weathervanefixed = 1) {
    ~displaymessage(^dm_default);
    return;
}
~mesbox("It looks pretty broken!");
return;

[oploc5,favour_weathervane_broken]
if (%onesmallfavour < 28 | %weathervanefixed = 1) {
    ~displaymessage(^dm_default);
    return;
}
if (%onesmallfavourmulti_10_10 = 1) {
    ~mesbox("You can find nothing interesting here, all the parts seem to be missing.");
    return;
}
if (%onesmallfavourmulti_9_9 = 0) {
    ~mesbox("You search the weather vane... you find that the ornament is broken, as are the directionals and the rotating bar. You think you may be able to repair them if you can get them off. They look pretty rusted on, it might take quite a powerful force to loosen them.");
    return;
}
if (inv_freespace(inv) < 3) {
    ~mesbox("You see that there are three parts which you could replace, but you don't have enough inventory space to store them all.");
    return;
}
// CANDIDATE Transcript § Searching after loosening — three click-to-continue pages.
~mesbox("You find a broken ornament...");
~mesbox("broken directionals...");
~mesbox("and a broken rotating pillar.");
inv_add(inv, favour_ornament_broken, 1);
inv_add(inv, favour_directionals_broken, 1);
inv_add(inv, favour_pillar_broken, 1);
%onesmallfavourmulti_10_10 = 1;
return;

[oplocu,favour_weathervane_broken]
if (%onesmallfavour < 28 | %weathervanefixed = 1) {
    ~displaymessage(^dm_default);
    return;
}
if (last_useitem = hammer) {
    mes("You give the structure a good solid whack...");
    %onesmallfavourmulti_9_9 = 1;
    return;
}
if (last_useitem = favour_ornament_fixed | last_useitem = favour_directionals_fixed | last_useitem = favour_pillar_fixed) {
    @osf_vane_place;
}
~displaymessage(^dm_default);
return;

[label,osf_vane_place]
if (last_useitem = favour_ornament_fixed) {
    if (%ornamentfixed = 1) {
        ~displaymessage(^dm_default);
        return;
    }
    inv_del(inv, favour_ornament_fixed, 1);
    %ornamentfixed = 1;
    mes("You fix the ornament into the weather vane.");
} else if (last_useitem = favour_directionals_fixed) {
    if (%directionalsfixed = 1) {
        ~displaymessage(^dm_default);
        return;
    }
    inv_del(inv, favour_directionals_fixed, 1);
    %directionalsfixed = 1;
    mes("You fix the directionals into the weather vane.");
} else if (last_useitem = favour_pillar_fixed) {
    if (%rotatingpillarfixed = 1) {
        ~displaymessage(^dm_default);
        return;
    }
    inv_del(inv, favour_pillar_fixed, 1);
    %rotatingpillarfixed = 1;
    mes("You fix the Weathervane Pillar into the weather vane.");
} else {
    ~displaymessage(^dm_default);
    return;
}
if (%ornamentfixed = 1 & %directionalsfixed = 1 & %rotatingpillarfixed = 1) {
    %weathervanefixed = 1;
    // Packed synth 911 — leftover CANDIDATE last-part. Not a player seq.
    sound_synth(fix_weathervane, 0, 0);
    ~mesbox("You fix the last part of the weather vane into place.");
    ~mesbox("The weather vane seems to be totally repaired.");
}
return;

[label,osf_vane_anvil]
if (%onesmallfavour < 28) {
    ~displaymessage(^dm_default);
    return;
}
// No unique OSF player seq. Live adjacent [oplocu,anvil] pair.
if (last_useitem = favour_ornament_broken | last_useitem = favour_directionals_broken | last_useitem = favour_pillar_broken) {
    anim(human_smithing, 0);
    sound_synth(anvil_4, 0, 0);
    p_delay(2);
}
if (last_useitem = favour_ornament_broken) {
    inv_del(inv, favour_ornament_broken, 1);
    inv_add(inv, favour_ornament_fixed, 1);
    mes("You fix the ornament.");
    return;
}
if (last_useitem = favour_directionals_broken) {
    inv_del(inv, favour_directionals_broken, 1);
    inv_add(inv, favour_directionals_fixed, 1);
    mes("You fix the directionals.");
    return;
}
if (last_useitem = favour_pillar_broken) {
    inv_del(inv, favour_pillar_broken, 1);
    inv_add(inv, favour_pillar_fixed, 1);
    mes("You fix the Weathervane Pillar.");
    return;
}
~displaymessage(^dm_default);
return;
