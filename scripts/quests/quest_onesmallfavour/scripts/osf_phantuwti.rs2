// One Small Favour — Phantuwti after Arhein 14→15 + PREFIX after free Petra 27
// + vane last-part grant 4435. First-talk / unwind KEEP. Grant CANDIDATE
// last-resort I've fixed minus quests/place/topic. Cite
// osf-weather-report-grant-377.md + osf-phantuwti-mid-repair-377.md.
// Do not bind [opnpc1,seer]. No dest / 12346 / lamps. Hunt 289? no.

[opnpc1,favour_phantuwti_farsight]
if (%onesmallfavour < 15) {
    ~displaymessage(^dm_default);
    return;
}
// Grant / mid-repair / unwind above >=16 so cave reminder does not steal.
if (%onesmallfavour >= 28 & %weathervanefixed = 1) {
    @osf_phantuwti_vane_grant;
}
if (%onesmallfavour >= 28 & %onesmallfavourmulti_10_10 = 1 & %weathervanefixed = 0) {
    @osf_phantuwti_mid_repair;
}
if (%onesmallfavour >= 27) {
    @osf_phantuwti_after_petra;
}
if (%onesmallfavour >= 16) {
    ~chatplayer("<p,quiz>What did you need me to do again?");
    ~chatnpc("<p,neutral>I need you to start checking nearby caves looking for our missing Petra. The caves are probably home to some creature or creatures. Check around the vicinity.");
    ~chatnpc("<p,neutral>The impressions are coming from a south westerly direction. Don't go further east than you are already, no further south than Ardougne and no further west than the combat training camp.");
    return;
}
~chatplayer("<p,quiz>Hi, can you give me a weather forecast?");
~chatnpc("<p,neutral>Hmm, somehow I knew you were going to ask me that...strange...life is so predictable when you have the power of foresight.");
~chatplayer("<p,happy>Great! So I can assume you've been really pro-active and compiled an up-to-date one for me?");
~chatnpc("<p,sad>Alas my presumptuous friend, the power of foresight and the impulse to act is quite similar to the interplay between intelligence and wisdom.");
~chatnpc("<p,neutral>One might have intelligence enough to realise that cakes are bad for us, but we may not have the wisdom to stop cramming that delicious-looking fatty cream cake into our salivating mouth.");
~chatplayer("<p,quiz>So, in your case, you have the power of foresight, but you're too lazy to act on it?");
~chatnpc("<p,sad>Not exactly lazy...but unable. My abilities and concern have been focused on the fate of a local girl whose association with a certain wizard has landed her between a rock and hard place.");
def_int $help = ~p_choice2("What can I do to help?", 1, "I'm sorry but I can't help.", 2);
if ($help = 2) {
    ~chatplayer("<p,sad>I'm sorry but I can't help.");
    ~chatnpc("<p,sad>Well, that's a bit of a shame, I have to say...we all miss our Petra!");
    return;
}
~chatplayer("<p,quiz>What can I do to help?");
~chatnpc("<p,neutral>Do you think you could do me a small favour? Check around the vicinity. The impressions are coming from a south westerly direction.");
~chatnpc("<p,neutral>Don't go further east than you are already, no further south than Ardougne and no further west than the combat training camp.");
~chatplayer("<p,quiz>So, let me get this right. You want me to start poking my nose into a lot of caves where some creatures might be?");
~chatplayer("<p,angry>Risking my neck for some tomboy who thinks she's got what it takes to be a real adventurer?");
~chatnpc("<p,sad>Well, I wouldn't have put it quite that way...");
def_int $yes = ~p_choice2("Yes, Ok, I'll do it.", 1, "No, sorry, I can't do it right now. Or maybe ever!", 2);
if ($yes = 2) {
    ~chatplayer("<p,angry>No, sorry, I can't do it right now. Or maybe ever!");
    ~chatnpc("<p,sad>I knew you wouldn't help...oh well, perhaps someday you'll surprise me.");
    return;
}
~chatplayer("<p,happy>Yes, Ok, I'll do it.");
~chatnpc("<p,happy>Great! I just knew you'd agree to help!");
if (%onesmallfavour = 15) {
    %onesmallfavour = 16;
}
return;

// CANDIDATE last-resort After freeing Petra minus Changes. Write 27→28 only on roof-send.
[label,osf_phantuwti_after_petra]
if (%onesmallfavour >= 28) {
    ~chatplayer("<p,quiz>Ok, show me where this weather vane is...I want to look at it.");
    ~chatnpc("<p,neutral>Ok, ok, it's up on the roof...");
    return;
}
~chatplayer("<p,quiz>I've released Petra, she should have returned.");
~chatnpc("<p,happy>Hi there, yes she has actually! Well done, you're a true hero!");
~chatplayer("<p,quiz>So, can I have the weather report now please?");
~chatnpc("<p,sad>I wish I could but it's just been so difficult to get a clear image of the future at the moment. You know...we're all so relieved that Petra has returned and all that.");
def_int $why = ~p_choice2("Why can't you get a clear picture?", 1, "Listen you...just give me the blooming weather report!", 2);
if ($why = 2) {
    ~chatplayer("<p,angry>Listen you...just give me the blooming weather report!");
    ~chatnpc("<p,sad>Er...no. I can't, I told you, I can't get a clear picture. Nope, sorry, the conditions are just not quite right.");
    return;
}
~chatplayer("<p,quiz>Why can't you get a clear picture?");
~chatnpc("<p,neutral>Well, it's complicated, the special Seers tools that help us predict the weather are not aligned properly...");
def_int $tools = ~p_choice2("Which special Seers tools do you mean?", 1, "You're just a fake...you can't predict the weather!", 2);
if ($tools = 2) {
    ~chatplayer("<p,angry>You're just a fake...you can't predict the weather!");
    ~chatnpc("<p,angry>Why...how dare you...I've never been so insulted in my life.");
    ~chatplayer("<p,neutral>You should get out more!");
    return;
}
~chatplayer("<p,quiz>Which special Seers tools do you mean?");
~chatnpc("<p,neutral>Well, we use a special combination of items which are used to gauge current weather movements and we're able to predict future weather patterns from these. Of course, it's strongly linked to the Seers' foresight ability.");
~chatplayer("<p,quiz>What do you mean, 'special combination of items'?");
~chatnpc("<p,neutral>Well, let me think now...There's a copper eye, a rotating thing, and some pointy direction thingies. It's all highly scientific - and of course mystical - in a very magical 'foresight' sort of way.");
~chatplayer("<p,quiz>You're talking about a weather vane aren't you?");
~chatnpc("<p,confused>Er...maybe...I may be talking about that...");
~chatplayer("<p,angry>You can't predict the weather because your weather vane is broken...that's it isn't it? Holy Saradomin breath....you can't even predict the weather, you need a weather vane!");
~chatnpc("<p,sad>Erm, well....err....");
~chatplayer("<p,quiz>Ok, show me where this weather vane is...I want to look at it.");
~chatnpc("<p,quiz>What for?");
~chatplayer("<p,happy>I may be able to fix it and then you can give me a weather report...come on, let's go!");
~chatnpc("<p,sad>Oh, very well..but you'll need to be a specialist to fix this weather vane, it was made by some of the most experienced....");
~chatplayer("<p,angry>Just show me it!");
~chatnpc("<p,neutral>Ok, ok, it's up on the roof...");
if (%onesmallfavour = 27) {
    %onesmallfavour = 28;
}
return;

// CANDIDATE last-resort mid-repair minus Changes. Stay 28. No 4435.
[label,osf_phantuwti_mid_repair]
~chatplayer("<p,happy>Hey, I'm fixing the weather vane!");
~chatnpc("<p,happy>Fantastic, come and let me know when you've finished.");
return;

// CANDIDATE last-resort I've fixed minus Changes. Grant 4435. Write 28→29.
[label,osf_phantuwti_vane_grant]
if (%onesmallfavour >= 29) {
    if (inv_total(inv, favour_weather_report) < 1) {
        ~chatplayer("<p,sad>I've lost the weather report.");
        ~chatnpc("<p,neutral>Well, I knew you were going to say that! Here you go...have another one!");
        inv_add(inv, favour_weather_report, 1);
        ~chatplayer("<p,happy>Thanks!");
        return;
    }
    ~chatplayer("<p,quiz>Hi again, what should I do now?");
    ~chatnpc("<p,neutral>I've no clue my friend, you mentioned something about Arhein, but your plans might have changed in the meantime.");
    return;
}
~chatplayer("<p,happy>I've fixed the weather vane!");
~chatnpc("<p,happy>Oh, thanks so much...you can't believe how helpful it is to get accurate predictions on the weather...we Seers are almost blind without it.");
mes("Phantuwti starts compiling a weather report for you.");
inv_add(inv, favour_weather_report, 1);
if (%onesmallfavour = 28) {
    %onesmallfavour = 29;
}
~chatnpc("<p,happy>There you go...a weather report as asked for...I hope it helps you!");
return;
