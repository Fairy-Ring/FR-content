// One Small Favour — Hammerspike after Tassie 10→11.
// CANDIDATE last-resort 2007-base (OSRS Transcript:One Small Favour Hammerspike).
// No dest / gang Attack / Sanfew product / 12346. Hunt 289? no.
// Cite osf-hammerspike-after-tassie-377.md.

[opnpc1,favour_hammerspike_stoutbeard]
if (%onesmallfavour < 11) {
    ~displaymessage(^dm_default);
    return;
}
// Return leftover after Sanfew unwind 31→32. Tip.it 2007 two-talk:
// first talk = initiate news + changed mind (this hop). Second talk /
// leftover-IF Attack / after-kill = later. Cite osf-hammerspike-return-377.md.
if (%onesmallfavour >= 32) {
    @osf_hammerspike_return;
    return;
}
if (%onesmallfavour >= 12) {
    ~chatnpc("<p,angry>And what's wrong now?");
    ~chatplayer("<p,quiz>What was it that I was supposed to do for you?");
    ~chatnpc("<p,neutral>Go and talk to Sanfew and get him to accept me as a druid initiate!");
    return;
}
~chatnpc("<p,angry>And who da heck are you?");
~chatplayer("<p,neutral>I'm <displayname> and I want to talk to you about a friend of mine, Tassie Slipcast. She says you're putting the screws on her for some loan she had from you. Is this true?");
~chatnpc("<p,shifty>And what if it is? Tassie got into an arrangement that is mutually beneficial, as far as I understood it, she was happy with the deal.");
def_int $ask = ~p_choice2("Have you always been a gangster?", 1, "Ok, thanks.", 2);
if ($ask = 2) {
    ~chatplayer("<p,neutral>Okay, thanks.");
    return;
}
~chatplayer("<p,quiz>Have you always been a gangster? Wasn't there anything else that you wanted to do instead? Come on, tell me what you want to do...I'm listening.");
~chatnpc("<p,sad>Well, I was just thinking the other day that I'm feeling sort of unfulfilled in my life.");
~chatnpc("<p,neutral>I'd like to get rid of all this anger and frustration that my current lifestyle brings and do something relaxing...like those druids, I mean, all day sitting around, looking at herbs and wearing robes and stuff.");
~chatplayer("<p,neutral>Ok, that sounds good.");
~chatnpc("<p,happy>Yeah, yeah, I really want to be a druid...so...go and see the druid leader, I think Sanfew is his name, and persuade him to take me as an initiate. Do me this one small favour and I'll leave Tassie alone.");
def_int $yes = ~p_choice2("Ok, another favour...I think I can manage that.", 1, "I don't think they take dwarven gangsters as initiates.", 2);
if ($yes = 2) {
    ~chatplayer("<p,quiz>I don't think they take dwarven gangsters as initiates.");
    ~chatnpc("<p,shifty>Whatever...I guess Tassie's gonna be working hard for a bit longer yet then!");
    return;
}
~chatplayer("<p,happy>Ok, another favour...I think I can manage that.");
~chatnpc("<p,happy>Good...I mean great! Come back when Sanfew has agreed to take me as an initiate!");
if (%onesmallfavour = 11) {
    %onesmallfavour = 12;
}
return;

[label,osf_hammerspike_return]
// CANDIDATE last-resort 2007-base (Tip.it 2007 §23 two-talk).
// First talk = news + changed mind (32→33). Second talk = My men, stay 33
// (prefer no extra write). Guards / leftover-IF Attack = later leftover.
// Hunt 289? no.
if (%onesmallfavour >= 33) {
    def_npc_uid $ham = npc_uid;
    def_boolean $alive = ~osf_hammerspike_gang_alive;
    if (npc_finduid($ham) = false) {
        return;
    }
    if ($alive = false) {
        @osf_hammerspike_bargain;
        return;
    }
    ~chatnpc("<p,angry>My men are going to deal with you!");
    @osf_hammerspike_set_guards;
    return;
}
~chatnpc("<p,happy>Oh, it's you! Back are you then?");
~chatplayer("<p,happy>Yep and with good news...your life is about to change for the better.");
~chatplayer("<p,happy>I've persuaded Sanfew to take you in as an initiate!");
~chatnpc("<p,happy>Ha, ha ha ha! How funny is that! I've gone and changed my mind now!");
~chatnpc("<p,shifty>I've decided that I make a far better gangster than I ever would a druid!");
if (%onesmallfavour = 32) {
    %onesmallfavour = 33;
}
return;

[proc,osf_hammerspike_gang_alive]()(boolean)
if (npc_find(coord, favour_gangster_dwarf, 8, 0) = true) {
    return(true);
}
if (npc_find(coord, favour_gangster_dwarf_2, 8, 0) = true) {
    return(true);
}
if (npc_find(coord, favour_gangster_dwarf_3, 8, 0) = true) {
    return(true);
}
return(false);

[label,osf_hammerspike_set_guards]
// CANDIDATE last-resort 2007-base (Tip.it 2007 §23 set his guards /
// Transcript men attack). Not leftover-IF Attack. Find range 8 = live
// arena/foreman pattern (gang is packed 3–4 tiles N). Hunt 289? no.
if_close;
if (npc_find(coord, favour_gangster_dwarf, 8, 0) = true) {
    npc_setmode(opplayer2);
}
if (npc_find(coord, favour_gangster_dwarf_2, 8, 0) = true) {
    npc_setmode(opplayer2);
}
if (npc_find(coord, favour_gangster_dwarf_3, 8, 0) = true) {
    npc_setmode(opplayer2);
}
return;

[label,osf_hammerspike_bargain]
// CANDIDATE last-resort 2007-base (Transcript after defeating his men).
// Stay 33 — leftover extra write UNKNOWN, prefer none. Tassie potlid
// leftover gates on >= this return write. Hunt 289? no.
if (%onesmallfavour >= 34) {
    ~chatnpc("<p,shifty>Ok then, fair enough....I'll leave her alone...but I'm going to deal with you personally one of these days!");
    return;
}
~chatnpc("<p,shifty>Well...sure if you're not full of surprises then...I guess I'll have to either hire more men to try and kill you or forget Tassie's loan.");
~chatplayer("<p,neutral>Ok, you promise me that you won't bother Tassie anymore and I'll leave you alone.");
~chatnpc("<p,shifty>Ok then, fair enough....I'll leave her alone...but I'm going to deal with you personally one of these days!");
if (%onesmallfavour = 33) {
    %onesmallfavour = 34;
}
return;
