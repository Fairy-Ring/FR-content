// VERIFIED quest thresholds/rewards: target-day Tip.It, src.tears-tipit-quest-20060502.
// UNKNOWN: functional refusal and quest-scroll wording; no period copy survives.
// The original opener is retained. Quest start opens no HUD; tog_minigame_offer owns post-quest admission.

[oploc1,hidey_unbuilt_bush_easy]
if (%tog_juna_bowl = ^tog_quest_complete) {
    ~tog_minigame_offer;
    return;
}
if (%tog_juna_bowl = ^tog_quest_started) {
    if (inv_total(inv, tog_bowl) > 0 | inv_total(worn, tog_bowl) > 0) {
        // VERIFIED Talk-to hand-in; commit completion before either reward.
        %tog_juna_bowl = ^tog_quest_complete;
        if (inv_total(worn, tog_bowl) > 0) {
            inv_del(worn, tog_bowl, 1);
            ~update_bas;
        } else {
            inv_del(inv, tog_bowl, 1);
        }
        stat_advance(crafting, ^tog_quest_reward_crafting_xp_tenths);
        // UNKNOWN scroll wording; reward values are VERIFIED by the period guide.
        ~send_quest_complete(questlist:tog, null, 0, ^tog_questpoints, "You have completed the\\nTears of Guthix Quest!", "1,000 Crafting XP|Weekly access to the Tears of Guthix minigame");
        return;
    }
    ~chatnpc_specific("Juna", tog_juna_dummy, "<p,neutral>Mine some stone from that cave, make it into a bowl, and bring it to me.");
    return;
}

// UNKNOWN refusal wording and base-skill boost policy; the thresholds are VERIFIED.
if (%qp < ^tog_quest_required_questpoints) {
    ~mesbox("You need at least 43 Quest Points to begin this quest.");
    return;
}
if (stat_base(firemaking) < ^tog_quest_requirement_firemaking) {
    ~mesbox("You need a Firemaking level of at least 49 to begin this quest.");
    return;
}
if (stat_base(crafting) < ^tog_quest_requirement_crafting) {
    ~mesbox("You need a Crafting level of at least 20 to begin this quest.");
    return;
}
if (stat_base(mining) < ^tog_quest_requirement_mining) {
    ~mesbox("You need a Mining level of at least 20 to begin this quest.");
    return;
}

def_int $c = ~tog_juna_story;
if ($c = 2) return;
%tog_juna_bowl = ^tog_quest_started;
~chatnpc_specific("Juna", tog_juna_dummy, "<p,neutral>Your stories have entertained me. I will let you into the cave for a short time.");
~chatnpc_specific("Juna", tog_juna_dummy, "<p,neutral>But first you will need to make a bowl in which to collect the tears.");
~chatnpc_specific("Juna", tog_juna_dummy, "<p,neutral>Mine some stone from that cave, make it into a bowl, and bring it to me.");
~send_quest_progress(questlist:tog, %tog_juna_bowl, ^tog_quest_complete);


[proc,tog_juna_story]()(int)
// Opener/choice/accept lines: CANDIDATE, retained verbatim from tog-juna-talk-2007base §3.1.
~chatnpc_specific("Juna", tog_juna_dummy, "<p,neutral>Tell me... a story...");
def_int $c = ~p_choice2("Okay.", 1, "Not now.", 2);
if ($c = 2) {
    ~chatplayer("<p,neutral>Not now.");
    return(2);
}
~chatplayer("<p,neutral>You tell me a story.");
return(1);
