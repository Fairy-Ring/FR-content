// UNKNOWN functional refusal and geometry landings. Original Cross operations and client fields are unchanged.

[oploc1,fever_gangplank]
if (%fever_quest < 1) {
    mes("Speak to Bill Teach before boarding.");
    return;
}
p_telejump(^fever_port_deck);

[oploc1,fever_gangplank_exit]
if (%fever_quest < 1) {
    mes("Speak to Bill Teach before boarding.");
    return;
}
~fever_remove_supplies;
p_telejump(^fever_port_pier);

[oploc1,fever_gangplank_harmless]
if (%fever_quest < ^fever_arrived) return;
p_telejump(^fever_mos_deck);

[oploc1,fever_gangplank_exit_harmless]
if (%fever_quest < ^fever_arrived) return;
~fever_remove_supplies;
p_telejump(^fever_mos_pier);
