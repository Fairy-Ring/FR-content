// Cabin Fever — gangplank Cross dests. Stay fever_quest 1. No write 2.
// Cross lands on the ship TOPSIDE (L1 deck o42), not the L0 hold.
// Plank loc tiles 3710/3711 L1 are midair. Hold 3713,3496 L0 is below deck
// (ladder later). Pier dest is L0. Do not bind Mos Le' 11211/11212.

[oploc1,fever_gangplank]
if (%fever_quest < 1) {
    mes("I don't think that whoever owns this ship will be happy with me wandering all over it.");
    return;
}
p_telejump(1_58_54_1_40); // 3713,3496 L1 — topside deck (not hold)

[oploc1,fever_gangplank_exit]
if (%fever_quest < 1) {
    mes("I don't think that whoever owns this ship will be happy with me wandering all over it.");
    return;
}
p_telejump(0_57_54_61_40); // 3709,3496 L0 — pier
