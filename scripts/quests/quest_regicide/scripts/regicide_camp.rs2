// Inherited Lost City camp conversations (CANDIDATE wording).
[opnpc1,regicide_general_hining]
~chatplayer("<p,happy>Hello.");
if(%regicide_quest > ^regicide_spoken_iorwerth2) {
    ~chatnpc("<p,scared>This is not a good place to be, go and prepare for the coming darkness.");
    ~chatplayer("<p,confused>What do you mean?");
    ~chatnpc("<p,scared>There is no great hero left to fight back the forces that face us now... Go, leave, prepare for the darkness. While you still have time!");
    return;
}
~chatnpc("<p,neutral>Yes, is there anything I can help with?|I'm General of what's left of this army|and I'm rather busy.");
~chatplayer("<p,quiz>If you're a General can you help me meet the king?");
~chatnpc("<p,neutral>The king will see no one. He can trust no one!");
~chatplayer("<p,sad>Is there no way I can see him?");
~chatnpc("<p,neutral>In the coming battle he will stand between us and the end. Then you will see him.");
~chatplayer("<p,shifty>Not quite what I had in mind.");

[oploc1,regicide_tent_door]
if(npc_findexact(movecoord(loc_coord, -1, 0, 0), regicide_tyras_camp_tent_guard) = true) {
    if(%regicide_quest > ^regicide_spoken_iorwerth2) {
        ~chatnpc("<p,neutral>You cannot enter! This is now General Hining's pavilion. Since the king's death he has held us together.");
        ~chatplayer("<p,quiz>You're not going home to Ardougne then?");
        ~chatnpc("<p,sad>I wish I could. Just to see my wife, but if we don't stop the evil here, it will be too late!");
        ~chatplayer("<p,quiz>Evil?");
        ~chatnpc("<p,scared>Soon Zamorak's fury will be released upon us.");
        return;
    }
    ~chatnpc("<p,neutral>You cannot pass! These are the king's quarters. No one enters without invitation.");
    ~chatplayer("<p,neutral>How do I get an invitation?");
    ~chatnpc("<p,neutral>If the king wants to see you he will ask for you.");
    ~chatplayer("<p,neutral>What's the chances of that?");
    ~chatnpc("<p,neutral>Absolutely none! Now let me get on with my job.");
}

[opnpc1,regicidegeneralshopkeeper]
~chatnpc("<p,happy>Good day <text_gender("sir", "miss")>. I'm the quartermaster for this camp. We have a little we could trade here.");
if(%regicide_quest = ^regicide_complete) {
    ~chatnpc("<p,happy>We have a new stock of dragon halberds. Would you like a look at what we have now?");
} else {
    ~chatnpc("<p,happy>We should be getting a new stock soon. Would you like a look at what we do have?");
}
switch_int(~p_choice2("Yes please. What are you selling?", 1, "No thanks.", 2)) {
    case 1 :
        ~chatplayer("<p,happy>Yes please. What are you selling?");
        ~regicide_quartermaster_shop;
    case 2 :
        ~chatplayer("<p,neutral>No thanks.");
}

[proc,regicide_quartermaster_shop]
def_inv $stock = npc_param(owned_shop);
if(%regicide_quest = ^regicide_complete) {
    $stock = regicide_general_shop_2;
}
~openshop($stock, npc_param(shop_buy_multiplier), npc_param(shop_sell_multiplier), npc_param(shop_delta), npc_param(shop_title));
