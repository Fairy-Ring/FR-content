// Thin slice — complete queue only (full quest_regicide.rs2 port later).
// Source: 274 quest_regicide.rs2 [queue,quest_regicide_complete]

[queue,quest_regicide_complete]
inv_add(inv, coins, 15000);
stat_advance(agility, 137500);
%regicide_quest = ^regicide_complete;
session_log(^log_adventure, "Quest complete: Regicide");
~send_quest_complete(questlist:regicide, regicide_alchemy_symbol4, 250, ^regicide_questpoints, "You have completed the\\nRegicide Quest!", "15,000 coins|13,750 Agility XP|3 Quest Points");
