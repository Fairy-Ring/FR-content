// Recruitment Drive — route/lifecycle varps (internal encoding, not historical).
// recruitmentdrive stays permanent for questmain / room-complete bits.
// Route run state is server-only temp (transmit omitted = no client wire).
// Do not make rd_rooms_tempvar* permanent.

// Packed five-slot route + cursor + active. See rd_route.rs2 header.
[rd_route_state]
type=int
scope=temp

// region_uid captured at select/begin for mark_complete / stale guards.
[rd_route_uid]
type=int
scope=temp

// Durable server-only marker: 0=no assessment, 1=active, 2=pending Tiffy.
[rd_assessment]
type=int
scope=perm
transmit=no

// Internal bookkeeping (not a historical pack bit): durable first-intro vs retry.
// 0 = has not accepted Tiffy testing yet; 1 = accepted at least once.
// Survives logout/run reset. Temp %rd_spoke_to_tiffy remains session-only.
[rd_tiffy_introduced]
type=int
scope=perm
transmit=no

// Lifecycle-only death snapshot; never transmitted or persisted.
[rd_death_active]
type=int
scope=temp
