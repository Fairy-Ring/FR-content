// ─── alchemical notes Read ───────────────────────────────────────────────────
// Body CANDIDATE: runescape.wiki Transcript:Alchemical_notes (item release 2005).
// Shared buttons delegate only this book to the owned-room pager.

[opheld1,rd_chem_book]
if (~rd_room_is_current(6) = false) {
    return;
}
%open_book = rd_chem_book;
%book_page = 0;
~rd_chem_book_page;
return;

[proc,rd_chem_book_flip](int $direction)
if (~rd_room_is_current(6) = false) {
    return;
}
%book_page = add(%book_page, $direction);
~rd_chem_book_page;

[proc,rd_chem_book_page]
// The compiler encodes each constant string in a 1024-byte buffer.
def_string $text = "Acetic acid and|Cupric Sulphate:|Endothermic.|The Cupric is in insufficient quantities to cause any noticeable reaction.||Acetic acid and Gypsum:|Endothermic.|Made a particularly bad smell, but little else that|was productive.||Acetic acid and|Sodium Chloride:|Endothermic.|Very tasty when combined with fried potatoes at|room temperature.||Acetic acid and|Dihydrogen Monoxide:|Endothermic.|The Dihydrogen Monoxide served only to dilute the|Acetic acid at|room temperature.||Acetic acid and|Cupric Ore Powder:|Endothermic.|The powdered form of Cupric Ore allowed a lower than usual melting temperature, but the end product was non-usable.||Acetic acid and|Tin Ore powder:|Endothermic.|Similar results";
$text = append($text, " to those made using Cupric Ore.||Cupric Sulphate and|Dihyrdogen Monoxide:|Exothermic.|A blue compound was produced, along with heat.||Cupric Sulphate and|Gypsum:|Endothermic.|At room temperature, no useful product was created.||Gypsum and|Dihydrogen Monoxide:|Exothermic.|A white liquid compound was formed, that quickly cooled at room temperature to a white heat resistant solid very similar to plaster.||Cupric Ore Powder and|Tin Ore Powder:|Endothermic.|When both ores are in particulate form, a much lower than usual bonding temperature can be obtained. When combined at a moderate heat (my laboratory heating apparatus) I was able to form liquid Bronze quite|easily.||Nitrous Monoxide:|Was not ");
$text = append($text, "able to perform an experimentation using this substance, as the gaseous form would always escape when the vial was opened.");
split_init($text, 175, 22, q8_full);
def_int $last = sub(split_pagecount, 1);
if (%book_page < 0) { %book_page = 0; }
if (%book_page > $last) { %book_page = $last; }
~book_page("Alchemical notes", %book_page);
if (%book_page = 0) {
    if_sethide(book:page_left_button, true);
} else {
    if_sethide(book:page_left_button, false);
}
if (%book_page = $last) {
    if_sethide(book:page_right_button, true);
} else {
    if_sethide(book:page_right_button, false);
}
return;

// Nitrous Open — book: gas escapes.
[opheld1,rd_nitorus_oxide]
if (~rd_room_is_current(6) = false) {
    return;
}
mes("You open the vial and the gas escapes."); // CANDIDATE from notes
inv_del(inv, rd_nitorus_oxide, 1);
return;

// ─── vial-on-vial mixes (wrong / side products) ───────────────────────────────

[proc,rd_chem_vial_mix](namedobj $a, namedobj $b)
// Consumes one of each; produces spoilt / hot / plaster based on pair.
inv_del(inv, $a, 1);
inv_del(inv, $b, 1);
// Cupric sulphate + water → hot mixture (obj rd_cupric_sulphate2).
if (($a = rd_cupric_sulphate & $b = rd_dihydrogen_monoxide) | ($a = rd_dihydrogen_monoxide & $b = rd_cupric_sulphate)) {
    inv_add(inv, rd_cupric_sulphate2, 1);
    mes("The mixture gets very hot."); // CANDIDATE
    return;
}
// Gypsum + water in vial → plaster vial (should have been tin).
if (($a = rd_gypsum & $b = rd_dihydrogen_monoxide) | ($a = rd_dihydrogen_monoxide & $b = rd_gypsum)) {
    inv_add(inv, rd_plaster_vial, 1);
    mes("The mixture gets warm and lumpy."); // CANDIDATE
    return;
}
inv_add(inv, rd_spoilt_potion, 1);
mes("The mixture looks horrible. You think you messed something up."); // from spoilt desc
return;

[opheldu,rd_cupric_sulphate]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_dihydrogen_monoxide : ~rd_chem_vial_mix(rd_cupric_sulphate, rd_dihydrogen_monoxide);
    case rd_acetic_acid : ~rd_chem_vial_mix(rd_cupric_sulphate, rd_acetic_acid);
    case rd_gypsum : ~rd_chem_vial_mix(rd_cupric_sulphate, rd_gypsum);
    case rd_sodium_chloride : ~rd_chem_vial_mix(rd_cupric_sulphate, rd_sodium_chloride);
    case rd_tin_ore_powder : ~rd_chem_vial_mix(rd_cupric_sulphate, rd_tin_ore_powder);
    case rd_copper_ore_powder : ~rd_chem_vial_mix(rd_cupric_sulphate, rd_copper_ore_powder);
    case default : ~displaymessage(^dm_default);
}

[opheldu,rd_acetic_acid]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_dihydrogen_monoxide : ~rd_chem_vial_mix(rd_acetic_acid, rd_dihydrogen_monoxide);
    case rd_cupric_sulphate : ~rd_chem_vial_mix(rd_acetic_acid, rd_cupric_sulphate);
    case rd_gypsum : ~rd_chem_vial_mix(rd_acetic_acid, rd_gypsum);
    case rd_sodium_chloride : ~rd_chem_vial_mix(rd_acetic_acid, rd_sodium_chloride);
