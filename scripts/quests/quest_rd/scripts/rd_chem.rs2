// ─── tin mould chain ─────────────────────────────────────────────────────────

[label,rd_chem_water_on_tin]
// Refuse double pour on partial tin — do not consume another vial.
if (%rd_water_in_tin = 1) {
    mes("The tin already has liquid in it."); // CANDIDATE
    return;
}
inv_del(inv, rd_dihydrogen_monoxide, 1);
if (%rd_gypsum_in_tin = 1) {
    // Both present → tinfull.
    inv_del(inv, rd_tin, 1);
    inv_add(inv, rd_tinfull, 1);
    %rd_water_in_tin = 0;
    %rd_gypsum_in_tin = 0;
    mes("You pour the liquid into the tin. The mixture turns into a white lumpy paste."); // CANDIDATE
    return;
}
%rd_water_in_tin = 1;
mes("You pour the liquid into the tin."); // CANDIDATE
return;

[label,rd_chem_gypsum_on_tin]
// Refuse double pour on partial tin — do not consume another vial.
if (%rd_gypsum_in_tin = 1) {
    mes("The tin already has gypsum in it."); // CANDIDATE
    return;
}
inv_del(inv, rd_gypsum, 1);
if (%rd_water_in_tin = 1) {
    inv_del(inv, rd_tin, 1);
    inv_add(inv, rd_tinfull, 1);
    %rd_water_in_tin = 0;
    %rd_gypsum_in_tin = 0;
    mes("You add the gypsum. The mixture turns into a white lumpy paste."); // CANDIDATE
    return;
}
%rd_gypsum_in_tin = 1;
mes("You add the gypsum to the tin."); // CANDIDATE
return;

[proc,rd_chem_spoil_tin](namedobj $reagent)
inv_del(inv, $reagent, 1);
inv_del(inv, rd_tin, 1);
inv_add(inv, rd_tin_of_crap, 1);
%rd_water_in_tin = 0;
%rd_gypsum_in_tin = 0;
mes("You ruin the contents of the tin."); // CANDIDATE waste

[opheldu,rd_tin]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_dihydrogen_monoxide : @rd_chem_water_on_tin;
    case rd_gypsum : @rd_chem_gypsum_on_tin;
    case rd_cupric_sulphate : ~rd_chem_spoil_tin(rd_cupric_sulphate);
    case rd_acetic_acid : ~rd_chem_spoil_tin(rd_acetic_acid);
    case rd_sodium_chloride : ~rd_chem_spoil_tin(rd_sodium_chloride);
    case rd_tin_ore_powder : ~rd_chem_spoil_tin(rd_tin_ore_powder);
    case rd_copper_ore_powder : ~rd_chem_spoil_tin(rd_copper_ore_powder);
    case default : ~displaymessage(^dm_default);
}

// Imprint: tinfull on chained key.
[oplocu,rd_key_chained]
if (~rd_room_is_current(6) = false) {
    return;
}
if (region_findbycoord(coord()) = false) {
    return;
}
def_int $uid = region_uid();
if (last_useitem = rd_tinfull) {
    anim(human_pickupfloor, 0);
    p_delay(0);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    inv_del(inv, rd_tinfull, 1);
    inv_add(inv, rd_keymould, 1);
    mes("You press the tin against the key. An impression forms in the mixture."); // CANDIDATE
    return;
}
mes("Nothing interesting happens.");
return;

[opheldu,rd_tinfull]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case default : ~displaymessage(^dm_default);
}

[label,rd_chem_tinore_on_mould]
inv_del(inv, rd_tin_ore_powder, 1);
inv_del(inv, rd_keymould, 1);
inv_add(inv, rd_full_keymould_tin, 1);
mes("You fill the key impression with tin ore powder.");
return;

[label,rd_chem_copore_on_mould]
inv_del(inv, rd_copper_ore_powder, 1);
inv_del(inv, rd_keymould, 1);
inv_add(inv, rd_full_keymould_copper, 1);
mes("You fill the key impression with cupric ore powder.");
return;

[label,rd_chem_tinore_on_copper_mould]
inv_del(inv, rd_tin_ore_powder, 1);
inv_del(inv, rd_full_keymould_copper, 1);
inv_add(inv, rd_full_keymould_unheated, 1);
mes("You add tin ore powder. The mould now holds both ores.");
return;

[label,rd_chem_copore_on_tin_mould]
inv_del(inv, rd_copper_ore_powder, 1);
inv_del(inv, rd_full_keymould_tin, 1);
inv_add(inv, rd_full_keymould_unheated, 1);
mes("You add cupric ore powder. The mould now holds both ores.");
return;

[opheldu,rd_keymould]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_tin_ore_powder : @rd_chem_tinore_on_mould;
    case rd_copper_ore_powder : @rd_chem_copore_on_mould;
    case default : ~displaymessage(^dm_default);
}

[opheldu,rd_full_keymould_tin]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_copper_ore_powder : @rd_chem_copore_on_tin_mould;
    case default : ~displaymessage(^dm_default);
}

[opheldu,rd_full_keymould_copper]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_tin_ore_powder : @rd_chem_tinore_on_copper_mould;
    case default : ~displaymessage(^dm_default);
}

// Pry complete mould → bronze key.
[proc,rd_chem_pry_key](namedobj $tool)
if (inv_total(inv, rd_full_keymould_complete) < 1) {
    return;
}
inv_del(inv, rd_full_keymould_complete, 1);
// Tool not consumed (CANDIDATE).
inv_add(inv, rd_puzzleroom_key, 1);
inv_add(inv, rd_tin_of_crap_empty, 1);
mes("You carefully pry the bronze key out of the tin."); // CANDIDATE
return;

[opheldu,rd_full_keymould_complete]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_knife : ~rd_chem_pry_key(rd_knife);
    case rd_chisel : ~rd_chem_pry_key(rd_chisel);
    case rd_wire : ~rd_chem_pry_key(rd_wire);
    case default : ~displaymessage(^dm_default);
}

[opheldu,rd_knife]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_full_keymould_complete : ~rd_chem_pry_key(rd_knife);
    case default : ~displaymessage(^dm_default);
}

[opheldu,rd_chisel]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_full_keymould_complete : ~rd_chem_pry_key(rd_chisel);
    case default : ~displaymessage(^dm_default);
}

[opheldu,rd_wire]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case rd_full_keymould_complete : ~rd_chem_pry_key(rd_wire);
    case default : ~displaymessage(^dm_default);
}

// ─── Bunsen burner ───────────────────────────────────────────────────────────

[oplocu,rd_wooden_table_bunsen_burner]
if (~rd_room_is_current(6) = false) {
    return;
}
if (region_findbycoord(coord()) = false) {
    return;
}
def_int $uid = region_uid();
def_obj $item = last_useitem;
if ($item = rd_metal_spade) {
    anim(human_cooking, 0); // CANDIDATE anim
    p_delay(1);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    inv_del(inv, rd_metal_spade, 1);
    inv_add(inv, rd_metal_spade_no_handle, 1);
    mes("You burn the wooden handle off the spade."); // CANDIDATE guide
    return;
}
if ($item = rd_full_keymould_unheated) {
    anim(human_cooking, 0);
    p_delay(2);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    inv_del(inv, rd_full_keymould_unheated, 1);
    inv_add(inv, rd_full_keymould_complete, 1);
    mes("You heat the tin. The ores melt into a bronze key set in plaster."); // CANDIDATE
    return;
}
// Wrong heat attempts on partial tins / ores → crap (finite waste).
if ($item = rd_full_keymould_tin | $item = rd_full_keymould_copper | $item = rd_keymould | $item = rd_tinfull | $item = rd_tin) {
    anim(human_cooking, 0);
    p_delay(1);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    inv_del(inv, $item, 1);
    inv_add(inv, rd_tin_of_crap, 1);
    %rd_water_in_tin = 0;
    %rd_gypsum_in_tin = 0;
    mes("You heat the tin, but the contents are ruined.");
    return;
}
mes("Nothing interesting happens.");
return;

// ─── stone door ──────────────────────────────────────────────────────────────

[oploc1,rd_stone_door_basic]
if (~rd_room_is_current(6) = false) {
    return;
}
mes("There's a small hole in the centre of the door."); // from loc desc
return;

[oploc1,rd_stone_door]
if (~rd_room_is_current(6) = false) {
    return;
}
// Multi parent may receive Study when basic — resolve via var.
if (%rd_room6_stone_door = ^rd_stone_opened) {
    @rd_chem_walk_stone;
    return;
}
if (%rd_room6_stone_door = ^rd_stone_reacted) {
    @rd_chem_pull_spade;
    return;
}
if (%rd_room6_stone_door = ^rd_stone_spade) {
    @rd_chem_pull_spade;
    return;
}
mes("There's a small hole in the centre of the door.");
return;

[oploc1,rd_stone_door_spade]
if (~rd_room_is_current(6) = false) {
    return;
}
@rd_chem_pull_spade;

[oploc1,rd_stone_door_opened]
if (~rd_room_is_current(6) = false) {
    return;
}
@rd_chem_walk_stone;

[label,rd_chem_pull_spade]
if (region_findbycoord(coord()) = false) {
    return;
}
def_int $uid = region_uid();
if (%rd_room6_stone_door = ^rd_stone_reacted) {
    anim(human_pickupfloor, 0);
    p_delay(0);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    %rd_room6_stone_door = ^rd_stone_opened;
    %rd_react_on_spade = 0;
    mes("You pull the spade. The expanded metal jams and forces the door open."); // CANDIDATE
    return;
}
if (%rd_room6_stone_door = ^rd_stone_spade) {
    // Not yet reacted — pull the spade back out.
    if (~rd_chem_try_give(rd_metal_spade_no_handle) = false) {
        return;
    }
    %rd_room6_stone_door = ^rd_stone_basic;
    %rd_react_on_spade = 0;
    mes("You pull the spade back out of the hole.");
    return;
}
return;

[label,rd_chem_walk_stone]
if (region_findbycoord(coord()) = false) {
    return;
}
if (%rd_room6_stone_door ! ^rd_stone_opened) {
    return;
}
// Opened stone is a length=2 ground barrier (map angle0 / west) between the
// west chem half and the east exit half (final door one tile east of origin).
// Generic check_axis tests wall-axis equality, not which side the player is on:
// west approach (x < loc) returned false and telejumped back west (live probe
// trial-chem-stone-01: 6892 stayed at 6892 beside stone 6893,z76).
// Side compare matches other RD ground crossings (rd_entrance_inside) and
// supports both directions without changing shared door procs.
if (coordx(coord) < coordx(loc_coord)) {
    // West of origin → east of barrier (toward exit / chained key).
    p_telejump(movecoord(loc_coord, 1, 0, 0));
} else {
    // On or east of origin → west chem half.
    p_telejump(movecoord(loc_coord, -1, 0, 0));
}
return;

[oplocu,rd_stone_door_basic]
if (~rd_room_is_current(6) = false) {
    return;
}
@rd_chem_use_on_stone;

[oplocu,rd_stone_door_spade]
if (~rd_room_is_current(6) = false) {
    return;
}
@rd_chem_use_on_stone;

[oplocu,rd_stone_door]
if (~rd_room_is_current(6) = false) {
    return;
}
@rd_chem_use_on_stone;

[label,rd_chem_use_on_stone]
if (region_findbycoord(coord()) = false) {
    return;
}
def_int $uid = region_uid();
def_obj $item = last_useitem;
// Insert handle-less spade.
if ($item = rd_metal_spade_no_handle) {
    if (%rd_room6_stone_door ! ^rd_stone_basic) {
        mes("The spade is already in the door.");
        return;
    }
    anim(human_pickupfloor, 0);
    p_delay(0);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    inv_del(inv, rd_metal_spade_no_handle, 1);
    %rd_room6_stone_door = ^rd_stone_spade;
    mes("You jam the metal spade into the hole in the door."); // CANDIDATE
    return;
}
// Cupric sulphate onto spade-in-door.
if ($item = rd_cupric_sulphate) {
    if (%rd_room6_stone_door ! ^rd_stone_spade & %rd_room6_stone_door ! ^rd_stone_reacted) {
        mes("You need to put something in the hole first.");
        return;
    }
    if (%rd_react_on_spade = 1) {
        mes("You've already applied the cupric sulfate.");
        return;
    }
    anim(human_herbing_vial, 0);
    // Named pour seq exists; use if engine accepts.
    // anim(rd_pour_vial, 0); — may not be player anim; keep herbing.
    p_delay(0);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    inv_del(inv, rd_cupric_sulphate, 1);
    %rd_react_on_spade = 1;
    mes("You pour the cupric sulfate onto the spade."); // CANDIDATE
    return;
}
// Liquid activates expansion when sulphate present.
if ($item = rd_dihydrogen_monoxide) {
    if (%rd_room6_stone_door ! ^rd_stone_spade) {
        mes("Nothing interesting happens.");
        return;
    }
    if (%rd_react_on_spade = 0) {
        mes("Nothing happens. Maybe another chemical is needed first."); // CANDIDATE
        return;
    }
    anim(human_herbing_vial, 0);
    p_delay(1);
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    inv_del(inv, rd_dihydrogen_monoxide, 1);
    %rd_room6_stone_door = ^rd_stone_reacted;
    mes("The metal spade expands and jams tightly in the hole!"); // CANDIDATE guide
    return;
}
mes("Nothing interesting happens.");
return;

// Also allow vial use via opheldu on spade item before insert? Guide pours on door.

[opheldu,rd_metal_spade]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case default : ~displaymessage(^dm_default);
}

[opheldu,rd_metal_spade_no_handle]
if (~rd_room_is_current(6) = false) {
    return;
}
switch_obj (last_useitem) {
    case default : ~displaymessage(^dm_default);
}

// ─── exit door (key) ─────────────────────────────────────────────────────────

[proc,rd_chem_unlock_exit]
if (%rd_room6_complete = 1) {
    return;
}
if (inv_total(inv, rd_puzzleroom_key) < 1) {
    mes("The door is locked.");
    return;
}
// Consume key on unlock (CANDIDATE — key is room-temp).
inv_del(inv, rd_puzzleroom_key, 1);
if (~rd_room_mark_complete(6) = false) {
    return;
}
mes("You unlock the door with the bronze key."); // CANDIDATE
return;

[oploc1,rd_room6_exitdoor]
if (~rd_room_is_current(6) = false) {
    return;
}
if (region_findbycoord(coord()) = false) {
    return;
}
if (%rd_room6_complete = 0) {
    if (inv_total(inv, rd_puzzleroom_key) > 0) {
        ~rd_chem_unlock_exit;
    } else {
        mes("The door is locked.");
        return;
    }
}
if (%rd_room6_complete = 0) {
    return;
}
def_boolean $entering = ~check_axis(coord, loc_coord, loc_angle);
~open_and_close_door2(desertdoor_inactive, $entering, door_open);
return;

[oplocu,rd_room6_exitdoor]
if (~rd_room_is_current(6) = false) {
    return;
}
if (region_findbycoord(coord()) = false) {
    return;
}
if (last_useitem = rd_puzzleroom_key) {
    ~rd_chem_unlock_exit;
    if (%rd_room6_complete = 1) {
        def_boolean $entering = ~check_axis(coord, loc_coord, loc_angle);
        ~open_and_close_door2(desertdoor_inactive, $entering, door_open);
    }
    return;
}
mes("Nothing interesting happens.");
return;
