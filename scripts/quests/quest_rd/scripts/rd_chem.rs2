// Recruitment Drive — Miss Cheevers chemistry trial (physical room 6).
//
// Cache surface (VERIFIED): rd.loc shelves/bunsen/stone multi/key/crates/chest;
// objs 5577–5605; varbits rd_got_*, rd_spare_water, rd_room6_stone_door,
// rd_react_on_spade, rd_gypsum_in_tin, rd_water_in_tin, rd_room6_hint1,
// rd_room6_complete; seq rd_pour_vial. No recipe in cache.
//
// Solutions (CANDIDATE 2007-base guide Recruitment_Drive lines 78–100):
// spade→burner→door + cupric sulphate + liquid; tin+water+gypsum → imprint on
// chained key → tin/copper powders → burner → pry knife/chisel/wire → exitdoor.
// Wrong vial mixes → ??? mixture objs; wrong tin → tin_of_crap.
//
// Shelf/crate/chest provenance is CANDIDATE (no period per-loc item map). One-to-
// one from got_* bits + guide item list; shelf_8 multi-water via spare_water.
// Alchemical notes: CANDIDATE later wiki Transcript:Alchemical_notes.
// Internal server state enforces the source-backed finite tin ore supply.
// Expose ~rd_chem_enter / ~rd_reset_chem. Root owns portals/observer/route.
// Write %rd_room6_complete only after sourced exit-door unlock with bronze key.
// No entrance/exit portal handlers in this unit.

// ─── inventory cleanup ───────────────────────────────────────────────────────

[proc,rd_chem_del_all](namedobj $obj)
if (inv_total(inv, $obj) > 0) {
    inv_del(inv, $obj, inv_total(inv, $obj));
}
if (inv_total(worn, $obj) > 0) {
    inv_del(worn, $obj, inv_total(worn, $obj));
}

[proc,rd_reset_chem]
%rd_got_vinegar = 0;
%rd_got_water = 0;
%rd_got_copsulph = 0;
%rd_got_gypsum = 0;
%rd_got_salt = 0;
%rd_got_n2o = 0;
%rd_got_tin = 0;
%rd_got_copore = 0;
%rd_chem_tin_ore_taken = 0;
%rd_spare_water = 0;
%rd_room6_stone_door = ^rd_stone_basic;
%rd_react_on_spade = 0;
%rd_gypsum_in_tin = 0;
%rd_water_in_tin = 0;
%rd_room6_hint1 = 0;
%rd_room6_complete = 0;
~rd_chem_del_all(rd_cupric_sulphate);
~rd_chem_del_all(rd_acetic_acid);
~rd_chem_del_all(rd_gypsum);
~rd_chem_del_all(rd_sodium_chloride);
~rd_chem_del_all(rd_nitorus_oxide);
~rd_chem_del_all(rd_dihydrogen_monoxide);
~rd_chem_del_all(rd_tin_ore_powder);
~rd_chem_del_all(rd_copper_ore_powder);
~rd_chem_del_all(rd_puzzleroom_key);
~rd_chem_del_all(rd_metal_spade);
~rd_chem_del_all(rd_metal_spade_no_handle);
~rd_chem_del_all(rd_chem_book);
~rd_chem_del_all(rd_cupric_sulphate2);
~rd_chem_del_all(rd_plaster_vial);
~rd_chem_del_all(rd_spoilt_potion);
~rd_chem_del_all(rd_tin);
~rd_chem_del_all(rd_tinfull);
~rd_chem_del_all(rd_keymould);
~rd_chem_del_all(rd_full_keymould_tin);
~rd_chem_del_all(rd_full_keymould_copper);
~rd_chem_del_all(rd_full_keymould_unheated);
~rd_chem_del_all(rd_full_keymould_complete);
~rd_chem_del_all(rd_tin_of_crap);
~rd_chem_del_all(rd_tin_of_crap_empty);
~rd_chem_del_all(rd_chisel);
~rd_chem_del_all(rd_wire);
~rd_chem_del_all(rd_shears);
~rd_chem_del_all(rd_magnet);
~rd_chem_del_all(rd_knife);

[proc,rd_chem_reset]
~rd_reset_chem;

[proc,rd_chem_enter]
if (region_findbycoord(coord()) = false) {
    return;
}
return;

[proc,rd_chem_same_instance](int $expected_uid)(boolean)
if (~rd_room_is_current(6) = false) {
    return(false);
}
if (region_findbycoord(coord()) = false) {
    return(false);
}
if (region_uid() ! $expected_uid) {
    return(false);
}
return(true);

[proc,rd_chem_try_give](namedobj $obj)(boolean)
if (~pickup_obj_check_for_space($obj, 1) = false) {
    return(false);
}
inv_add(inv, $obj, 1);
return(true);

// ─── Miss Cheevers (CANDIDATE Transcript_Recruitment_Drive Miss Cheevers) ────

[opnpc1,rd_observer_room_6]
if (~rd_room_is_current(6) = false) {
    return;
}
if (region_findbycoord(coord()) = false) {
    return;
}
def_int $uid = region_uid();
if (%rd_room6_complete = 1) {
    ~chatnpc("<p,happy>Excellent work, <displayname>. Please step through the portal to meet your next challenge.");
    return;
}
if (%rd_room6_hint1 = 1) {
    ~chatplayer("<p,quiz>Can you give me any more help?");
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    ~chatnpc("<p,neutral>I really can't be any more help than that I'm afraid, it is more than my job's worth to have given you the help I already have.");
    if (~rd_chem_same_instance($uid) = false) {
        return;
    }
    ~chatnpc("<p,happy>Best of luck with the test <displayname>, I hope your application is successful.");
    return;
}
// First conversation: briefing, then optional help → tip (hint1).
// Transcript splits refuse and tip across later talks; one bit forces collapse
// into this tree (CANDIDATE staging).
~chatnpc("<p,happy>Greetings, <displayname>. Welcome to my challenge.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>All you need to do is leave from the opposite door to where you came in by.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>I will warn you that this is more complicated than it may at first appear.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>I should also warn you that there are limited supplies of the items in this room, so think carefully before using them, or you may find yourself stuck, and have to leave to start again!");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,happy>Best of luck!");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
def_int $help = ~p_choice2("Can you give me any help with this puzzle?", 1, "I'll get on with it.", 0);
if (~rd_chem_same_instance($uid) = false) {
    return;
}
if ($help = 0) {
    return;
}
~chatplayer("<p,quiz>Can you give me any help with this puzzle?");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>No, I am sorry, but that is forbidden by our rules.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>If you are having a particularly tough time of it, I suggest you leave and come back later when you are in a more receptive frame of mind.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>Sometimes a break from concentration will yield fresh insight. Our aim is to test you, but not to the point of frustration!");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatplayer("<p,quiz>Please?");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>Well... Look, I really shouldn't say anything about this room, but...");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>When I was attempting to join the Temple Knights I myself had to do this puzzle myself.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>It was slightly different, but the idea behind it was the same, and I left the notes I had made while doing it hidden in one of the bookcases.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>If you look carefully you may find them, and they may be of some use to you.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,neutral>I really can't be any more help than that I'm afraid, it is more than my job's worth to have given you the help I already have.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
~chatnpc("<p,happy>Best of luck with the test <displayname>, I hope your application is successful.");
if (~rd_chem_same_instance($uid) = false) {
    return;
}
%rd_room6_hint1 = 1;
return;

