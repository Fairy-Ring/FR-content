// Recruitment Drive — Spishyus fox / chicken / grain.
// Loc names + objs 5kg Wear. Eat from loc descs (fat fox / empty sack) + 2007-base
// Transcript:Recruitment Drive (unattended fox+chicken / chicken+grain). Fail → Falador park.

[proc,rd_reset_fox]
%rd_foxleft = 0;
%rd_foxright = 0;
%rd_chickleft = 0;
%rd_chickright = 0;
%rd_grainleft = 0;
%rd_grainright = 0;
if (inv_total(inv, rd_fox) > 0) {
    inv_del(inv, rd_fox, inv_total(inv, rd_fox));
}
if (inv_total(worn, rd_fox) > 0) {
    inv_del(worn, rd_fox, inv_total(worn, rd_fox));
}
if (inv_total(inv, rd_chicken) > 0) {
    inv_del(inv, rd_chicken, inv_total(inv, rd_chicken));
}
if (inv_total(worn, rd_chicken) > 0) {
    inv_del(worn, rd_chicken, inv_total(worn, rd_chicken));
}
if (inv_total(inv, rd_sack) > 0) {
    inv_del(inv, rd_sack, inv_total(inv, rd_sack));
}
if (inv_total(worn, rd_sack) > 0) {
    inv_del(worn, rd_sack, inv_total(worn, rd_sack));
}

[proc,rd_carry_count]()(int)
def_int $n = 0;
if (inv_total(inv, rd_fox) > 0 | inv_total(worn, rd_fox) > 0) {
    $n = calc($n + 1);
}
if (inv_total(inv, rd_chicken) > 0 | inv_total(worn, rd_chicken) > 0) {
    $n = calc($n + 1);
}
if (inv_total(inv, rd_sack) > 0 | inv_total(worn, rd_sack) > 0) {
    $n = calc($n + 1);
}
return($n);

// West-bank uneaten (right=1). Eaten is 3 / fail-out. Carry still counts as not done.
[proc,rd_fox_complete]()(boolean)
if (~rd_carry_count > 0) {
    return(false);
}
if (%rd_foxright = 1 & %rd_chickright = 1 & %rd_grainright = 1) {
    return(true);
}
return(false);

[proc,rd_pickup_east]()(boolean)
def_coord $sw = region_getcoord(0, 0, 0);
if (calc(coordx(loc_coord) - coordx($sw)) >= 48) {
    return(true);
}
return(false);

[proc,rd_pickup_animal](namedobj $obj)
if (region_findbycoord(coord()) = false) {
    return;
}
// Physical-current-room guard: fox ops only when route current is room 1.
if (~rd_route_active = true & ~rd_route_current ! 1) {
    return;
}
if (loc_type = rd_sack_empty) {
    mes("The sack is empty.");
    return;
}
if (~rd_carry_count > 0) {
    mes("You can only carry one of these at a time."); // CANDIDATE 2007-base 5kg
    return;
}
if (~pickup_obj_check_for_space($obj, 1) = false) {
    return;
}
anim(human_pickupfloor, 0);
p_delay(0);
sound_synth(pick, 0, 0);
if (~rd_pickup_east = true) {
    if ($obj = rd_fox) {
        %rd_foxleft = 1;
    } else if ($obj = rd_chicken) {
        %rd_chickleft = 1;
    } else {
        %rd_grainleft = 1;
    }
} else {
    if ($obj = rd_fox) {
        %rd_foxright = 0;
    } else if ($obj = rd_chicken) {
        %rd_chickright = 0;
    } else {
        %rd_grainright = 0;
    }
}
inv_add(inv, $obj, 1);
def_int $pos = oc_wearpos($obj);
if ($pos ! null) {
    if (inv_getobj(worn, $pos) = null) {
        inv_moveitem(inv, worn, $obj, 1);
        ~update_all($obj);
    }
}

[oploc1,rd_room2_fox_multi]
~rd_pickup_animal(rd_fox);
return;

[oploc1,rd_room2_fox_multi_right]
~rd_pickup_animal(rd_fox);
return;

[oploc1,rd_fox_normal]
~rd_pickup_animal(rd_fox);
return;

[oploc1,rd_fox_fat]
~rd_pickup_animal(rd_fox);
return;

[oploc1,rd_room2_chicken_multi]
~rd_pickup_animal(rd_chicken);
return;

[oploc1,rd_room2_chicken_multi_right]
~rd_pickup_animal(rd_chicken);
return;

[oploc1,rd_chicken_normal]
~rd_pickup_animal(rd_chicken);
return;

[oploc1,rd_room2_grain_multi]
~rd_pickup_animal(rd_sack);
return;

[oploc1,rd_room2_grain_multi_right]
~rd_pickup_animal(rd_sack);
return;

[oploc1,rd_sack_full]
~rd_pickup_animal(rd_sack);
return;

[oploc1,rd_sack_empty]
~rd_pickup_animal(rd_sack);
return;

[proc,rd_player_east]()(boolean)
def_coord $sw = region_getcoord(0, 0, 0);
if (calc(coordx(coord) - coordx($sw)) >= 48) {
    return(true);
}
return(false);

[proc,rd_putdown](obj $obj)
if (region_findbycoord(coord()) = false) {
    return;
}
if (~rd_route_active = true & ~rd_route_current ! 1) {
    return;
}
def_boolean $east = ~rd_player_east;
if ($obj = rd_fox) {
    if ($east = true) {
        if (%rd_foxleft = 0 | %rd_foxleft = 2) {
            return;
        }
        %rd_foxleft = 0;
    } else {
        if (%rd_foxright = 1 | %rd_foxright = 3) {
            return;
        }
        %rd_foxright = 1;
    }
} else if ($obj = rd_chicken) {
    if ($east = true) {
        if (%rd_chickleft = 0 | %rd_chickleft = 2) {
            return;
        }
        %rd_chickleft = 0;
    } else {
        if (%rd_chickright = 1 | %rd_chickright = 3) {
            return;
        }
        %rd_chickright = 1;
    }
} else if ($obj = rd_sack) {
    if ($east = true) {
        if (%rd_grainleft = 0 | %rd_grainleft = 2) {
            return;
        }
        %rd_grainleft = 0;
    } else {
        if (%rd_grainright = 1 | %rd_grainright = 3) {
            return;
        }
        %rd_grainright = 1;
    }
} else {
    return;
}
if (inv_total(inv, $obj) > 0) {
    inv_del(inv, $obj, inv_total(inv, $obj));
}
if (inv_total(worn, $obj) > 0) {
    inv_del(worn, $obj, inv_total(worn, $obj));
}
// Write physical room1 complete through shared mark when fox test is done.
if (~rd_fox_complete = true) {
    ~rd_room_mark_complete(1);
}

[proc,rd_side_eats]()(boolean)
if (~rd_player_east = true) {
    if ((%rd_foxleft = 0 | %rd_foxleft = 2) & (%rd_chickleft = 0 | %rd_chickleft = 2)) {
        %rd_foxleft = 2;
        %rd_chickleft = 1;
        mes("The fox eats the chicken.");
        return(true);
    }
    if ((%rd_chickleft = 0 | %rd_chickleft = 2) & %rd_grainleft = 0) {
        %rd_grainleft = 2;
        mes("The chicken eats the grain.");
        return(true);
    }
} else {
    if ((%rd_foxright = 1 | %rd_foxright = 3) & (%rd_chickright = 1 | %rd_chickright = 3)) {
        %rd_foxright = 3;
        %rd_chickright = 0;
        mes("The fox eats the chicken.");
        return(true);
    }
    if ((%rd_chickright = 1 | %rd_chickright = 3) & %rd_grainright = 1) {
        %rd_grainright = 3;
        mes("The chicken eats the grain.");
        return(true);
    }
}
return(false);

// Run-level fail: clear all trials (guide/transcript), not fox-only.
[proc,rd_fox_fail]
~rd_run_fail;

[oploc1,rd_bridge_left]
if (region_findbycoord(coord()) = false) {
    return;
}
if (~rd_route_active = true & ~rd_route_current ! 1) {
    return;
}
if (~rd_side_eats = true) {
    ~rd_fox_fail;
    return;
}
def_coord $sw = region_getcoord(0, 0, 0);
if (~rd_player_east = true) {
    p_telejump(movecoord($sw, 43, 0, 44)); // west bank dest-from-maps CANDIDATE
} else {
    p_telejump(movecoord($sw, 52, 0, 44)); // east bank
}
return;

[oploc1,rd_bridge_right]
if (region_findbycoord(coord()) = false) {
    return;
}
if (~rd_route_active = true & ~rd_route_current ! 1) {
    return;
}
if (~rd_side_eats = true) {
    ~rd_fox_fail;
    return;
}
def_coord $sw = region_getcoord(0, 0, 0);
if (~rd_player_east = true) {
    p_telejump(movecoord($sw, 43, 0, 44));
} else {
    p_telejump(movecoord($sw, 52, 0, 44));
}
return;
