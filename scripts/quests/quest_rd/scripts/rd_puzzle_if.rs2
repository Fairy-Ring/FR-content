// Recruitment Drive — shared portal/door helpers for the five-trial route.
// Room-specific exit doors stay in fox/statue/combat scripts.
// Entrance portals: inside → ~rd_run_quit; outside current → ~rd_room_begin.
// Exit portals: gate physical complete + route-current, then ~rd_route_advance.
// Do not if_openmain(balloon_animal): leftover 16129 title is Prison Pete.

// --- entrance portals (yellow) — quit or enter current ---

[oploc1,rd_portal_room1_entrance]
~rd_entrance_use(1);
return;

[oploc1,rd_portal_room2_entrance]
~rd_entrance_use(2);
return;

[oploc1,rd_portal_room3_entrance]
~rd_entrance_use(3);
return;

[oploc1,rd_portal_room4_entrance]
~rd_entrance_use(4);
return;

[oploc1,rd_portal_room5_entrance]
~rd_entrance_use(5);
return;

[oploc1,rd_portal_room6_entrance]
~rd_entrance_use(6);
return;

[oploc1,rd_portal_room7_entrance]
~rd_entrance_use(7);
return;

// --- exit portals — advance route (not hard-coded next room) ---

[oploc1,rd_portal_room1_exit]
~rd_try_exit_portal(1);
return;

[oploc1,rd_portal_room2_exit]
~rd_try_exit_portal(2);
return;

[oploc1,rd_portal_room3_exit]
~rd_try_exit_portal(3);
return;

[oploc1,rd_portal_room4_exit]
~rd_try_exit_portal(4);
return;

[oploc1,rd_portal_room5_exit]
~rd_try_exit_portal(5);
return;

[oploc1,rd_portal_room6_exit]
~rd_try_exit_portal(6);
return;

[oploc1,rd_portal_room7_exit]
~rd_try_exit_portal(7);
return;

// Interior Zanaris-style door in front of fox exit portal. Open is the fox *test*
// gate (walkthrough: door unlocks after all three are across).
[oploc1,rd_room1_exitdoor]
if (region_findbycoord(coord()) = false) {
    return;
}
if (~rd_route_current ! 1 & ~rd_route_active = true) {
    mes("The door is locked.");
    return;
}
// Prefer physical complete bit; also allow live fox_complete then mark.
if (%rd_room1_complete = 0) {
    if (~rd_fox_complete = false) {
        mes("The door is locked."); // CANDIDATE 2007-base: door unlocks after fox test
        return;
    }
    ~rd_room_mark_complete(1);
}
def_boolean $entering = ~check_axis(coord, loc_coord, loc_angle);
~open_and_close_door2(desertdoor_inactive, $entering, door_open);
return;
