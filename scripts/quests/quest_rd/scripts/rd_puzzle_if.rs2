// Recruitment Drive — room 3 entrance Use: instance-local dest east of 7315.
// Do not if_openmain(balloon_animal): leftover 16129 title is Prison Pete
// ("Pop the correct balloon animal to find a key") + pack prisonpete_balloon*
// / prisonpete_key. Kuam's room is loc-silent in rd.loc — not that IF.

[oploc1,rd_portal_room3_entrance]
if (region_findbycoord(coord()) = true) {
    p_telejump(movecoord(loc_coord, 1, 0, 0)); // instance-local: east of 7315 into room 3
}
return;
