// Swan Song restoration at Piscatoris. Source: Tip.It Q138, 2006-06-09.
// Functional prompts below are UNKNOWN wording, not reconstructed dialogue.

[opnpc1,swan_franklin]
if (%swansong ! 65) return;
if (%swansong_franklin = 4) {
    mes("The five wall sections are repaired.");
    return;
}
if (%swansong_franklin = 0) %swansong_franklin = 1;

def_boolean $gave_tools = false;
def_boolean $hammer_due = false;
if (~swan_add_tool_if_missing(tinderbox) = true) $gave_tools = true;
// Tip.It places Franklin's hammer after five sheets; repaired walls keep recovery available.
if (%swansong_franklin >= 3) {
    if (inv_total(inv, iron_sheet) >= 5 | %swansong_wall_1 = 1 | %swansong_wall_2 = 1 |
        %swansong_wall_3 = 1 | %swansong_wall_4 = 1 | %swansong_wall_5 = 1) {
        $hammer_due = true;
    }
}
if ($hammer_due = true) {
    if (~swan_add_tool_if_missing(hammer) = true) $gave_tools = true;
}
if (%swansong_pickaxe = 1 & ~swan_has_pickaxe = false) {
    if (~swan_add_tool_if_missing(bronze_pickaxe) = true) $gave_tools = true;
}
if (%swansong_hatchet = 1 & ~swan_has_axe = false) {
    if (~swan_add_tool_if_missing(bronze_axe) = true) $gave_tools = true;
}
if ($gave_tools = true) mes("Franklin gives you replacement tools.");

def_boolean $needs_space = false;
if (inv_total(inv, tinderbox) = 0 & inv_total(worn, tinderbox) = 0) $needs_space = true;
if ($hammer_due = true & inv_total(inv, hammer) = 0 & inv_total(worn, hammer) = 0) $needs_space = true;
if (%swansong_pickaxe = 1 & ~swan_has_pickaxe = false) $needs_space = true;
if (%swansong_hatchet = 1 & ~swan_has_axe = false) $needs_space = true;
if ($needs_space = true) mes("Make room for the missing tools and speak to Franklin again.");
mes("Use logs and a tinderbox on the firebox, then press five iron bars into sheets.");
mes("Use one iron sheet on each of the five broken wall sections.");
[opnpcu,swan_franklin]
if (%swansong < 200 | last_useitem ! iron_sheet | inv_getobj(inv, last_useslot) ! iron_sheet) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, iron_sheet) < 1) return;
inv_del(inv, iron_sheet, 1);
inv_add(inv, coins, 20);
mes("Franklin gives you 20 coins for the iron sheet.");

[proc,swan_add_tool_if_missing](namedobj $tool)(boolean)
if (inv_total(inv, $tool) > 0 | inv_total(worn, $tool) > 0) return(false);
if (inv_freespace(inv) < 1) return(false);
inv_add(inv, $tool, 1);
return(true);

[proc,swan_has_pickaxe]()(boolean)
if (inv_total(inv, bronze_pickaxe) > 0 | inv_total(worn, bronze_pickaxe) > 0 |
    inv_total(inv, iron_pickaxe) > 0 | inv_total(worn, iron_pickaxe) > 0 |
    inv_total(inv, steel_pickaxe) > 0 | inv_total(worn, steel_pickaxe) > 0 |
    inv_total(inv, mithril_pickaxe) > 0 | inv_total(worn, mithril_pickaxe) > 0 |
    inv_total(inv, adamant_pickaxe) > 0 | inv_total(worn, adamant_pickaxe) > 0 |
    inv_total(inv, rune_pickaxe) > 0 | inv_total(worn, rune_pickaxe) > 0) return(true);
return(false);

[proc,swan_has_axe]()(boolean)
if (inv_total(inv, bronze_axe) > 0 | inv_total(worn, bronze_axe) > 0 |
    inv_total(inv, iron_axe) > 0 | inv_total(worn, iron_axe) > 0 |
    inv_total(inv, steel_axe) > 0 | inv_total(worn, steel_axe) > 0 |
    inv_total(inv, black_axe) > 0 | inv_total(worn, black_axe) > 0 |
    inv_total(inv, mithril_axe) > 0 | inv_total(worn, mithril_axe) > 0 |
    inv_total(inv, adamant_axe) > 0 | inv_total(worn, adamant_axe) > 0 |
    inv_total(inv, rune_axe) > 0 | inv_total(worn, rune_axe) > 0) return(true);
return(false);

[oploc1,bronze_pickaxe_14910]
if (%swansong ! 65) return;
if (~swan_has_pickaxe = true) {
    %swansong_pickaxe = 1;
    mes("You already have a pickaxe.");
    return;
}
if (inv_freespace(inv) < 1) {
    mes("Make room for the bronze pickaxe.");
    return;
}
inv_add(inv, bronze_pickaxe, 1);
%swansong_pickaxe = 1;
mes("You take a bronze pickaxe.");

[oploc1,bronze_axe_14912]
if (%swansong ! 65) return;
if (~swan_has_axe = true) {
    %swansong_hatchet = 1;
    mes("You already have an axe.");
    return;
}
if (inv_freespace(inv) < 1) {
    mes("Make room for the bronze axe.");
    return;
}
inv_add(inv, bronze_axe, 1);
%swansong_hatchet = 1;
mes("You take a bronze axe.");

[oplocu,firebox] @swan_firebox_use;
[oplocu,firebox_14959] @swan_firebox_use;
[oplocu,firebox_14960] @swan_firebox_use;

[label,swan_firebox_use]
if (%swansong ! 65) return;
if (%swansong_franklin < 1) {
    mes("Speak to Franklin before using the press.");
    return;
}
switch_obj(last_useitem) {
    case logs :
        if (%swansong_franklin = 1) {
            if (inv_total(inv, logs) < 1) return;
            inv_del(inv, logs, 1);
            %swansong_franklin = 2;
            mes("You place a log in the firebox.");
        } else if (%swansong_franklin = 2) {
            mes("The firebox already has a log.");
        } else {
            mes("The firebox is already lit.");
        }
    case tinderbox :
        if (%swansong_franklin = 2) {
            if (stat(firemaking) < 42) {
                mes("You need a Firemaking level of 42 to light the firebox.");
                return;
            }
            if (inv_total(inv, tinderbox) < 1) return;
            %swansong_franklin = 3;
            mes("You light the firebox.");
        } else if (%swansong_franklin >= 3) {
            mes("The firebox is already lit.");
        } else {
            mes("Place a log in the firebox first.");
        }
    case default : ~displaymessage(^dm_default);
}

[oplocu,metal_press] @swan_press_use;
[oplocu,metal_press_14957] @swan_press_use;

[label,swan_press_use]
if (%swansong = 65) {
    if (%swansong_franklin >= 4) {
        mes("All five wall sections are already repaired.");
        return;
    }
} else if (%swansong >= 200) {
    if (%swansong_franklin < 3) {
        mes("The press must be hot before making iron sheets.");
        return;
    }
} else {
    return;
}
if (%swansong_franklin < 3) {
    mes("Light the firebox before pressing an iron bar.");
    return;
}
if (stat(smithing) < 45) {
    mes("You need a Smithing level of 45 to use the press.");
    return;
}
if (last_useitem ! iron_bar) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, iron_bar) < 1) return;
inv_del(inv, iron_bar, 1);
inv_add(inv, iron_sheet, 1);
// VERIFIED: Tip.It Q138 gives 20 Smithing XP for each post-quest sheet.
stat_advance(smithing, 200);
mes("You press the iron bar into an iron sheet.");

[oplocu,broken_wall] @swan_wall_use;
[oplocu,broken_wall_14946] @swan_wall_use;
[oplocu,broken_wall_14947] @swan_wall_use;
[oplocu,patched_wall] @swan_wall_use;
[oplocu,patched_wall_14949] @swan_wall_use;
[oplocu,patched_wall_14950] @swan_wall_use;

[label,swan_wall_use]
if (%swansong ! 65) return;
if (last_useitem ! iron_sheet) {
    ~displaymessage(^dm_default);
    return;
}
// VERIFIED positions: 377 map m36_57, local x7 and z36..40.
def_int $x = coordx(loc_coord);
def_int $z = coordz(loc_coord);
def_int $wall = 0;
if ($x = 2311) {
    if ($z = 3688) $wall = 1;
    else if ($z = 3687) $wall = 2;
    else if ($z = 3686) $wall = 3;
    else if ($z = 3685) $wall = 4;
    else if ($z = 3684) $wall = 5;
}
if ($wall = 0) return;
@swan_patch_wall($wall);

[label,swan_patch_wall](int $wall)
if (%swansong_franklin < 3) {
    mes("Press the iron sheet before repairing a wall.");
    return;
}
if (%swansong_franklin >= 4) {
    mes("All five wall sections are already repaired.");
    return;
}
if (inv_total(inv, hammer) < 1) {
    mes("Ask Franklin for a replacement hammer.");
    return;
}
if (inv_total(inv, iron_sheet) < 1) return;
if ($wall = 1) {
    if (%swansong_wall_1 = 1) { mes("This wall section is already repaired."); return; }
    %swansong_wall_1 = 1;
} else if ($wall = 2) {
    if (%swansong_wall_2 = 1) { mes("This wall section is already repaired."); return; }
    %swansong_wall_2 = 1;
} else if ($wall = 3) {
    if (%swansong_wall_3 = 1) { mes("This wall section is already repaired."); return; }
    %swansong_wall_3 = 1;
} else if ($wall = 4) {
    if (%swansong_wall_4 = 1) { mes("This wall section is already repaired."); return; }
    %swansong_wall_4 = 1;
} else if ($wall = 5) {
    if (%swansong_wall_5 = 1) { mes("This wall section is already repaired."); return; }
    %swansong_wall_5 = 1;
} else {
    return;
}
inv_del(inv, iron_sheet, 1);
mes("You use an iron sheet to repair the wall.");
if (%swansong_wall_1 = 1 & %swansong_wall_2 = 1 & %swansong_wall_3 = 1 &
    %swansong_wall_4 = 1 & %swansong_wall_5 = 1) {
    %swansong_franklin = 4;
    mes("The five wall sections are now repaired.");
}
