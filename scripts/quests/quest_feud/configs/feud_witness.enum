// UNKNOWN FEUD-WITNESS-PERSON-01: visible original Feud/Pollnivneach people.
// Tip.It (27 April 2006) says "other NPC's" and "fellow citizens"; it does not
// settle animals or hidden server objects. Excluding both is an engineering
// choice, not a recovered original rule. NPC_TYPE resolves visible morphs;
// model-less multi bases and animal forms deliberately retain the default.
[feud_witness_people]
inputtype=npc
outputtype=int
default=0
