// VERIFIED entry prerequisites: Tip.It 28 Apr 2006; RuneHQ 24 Apr 2006.
// CANDIDATE failed-stakeout wording: Transcript:The Feud, revision 18411641.
// CANDIDATE persistent unlock and click: Old School transcript 15325427.
// UNKNOWN movement/open time: reuse the ordinary published key-door helper.
[oploc1,feud_closed_door_left] @feud_mayor_door(feud_open_door_left, false);
[oploc1,feud_closed_door_right] @feud_mayor_door(feud_open_door_right, false);

[oplocu,feud_closed_door_left]
if (last_useitem = feud_mayors_house_keys) @feud_mayor_door(feud_open_door_left, true);
~displaymessage(^dm_default);

[oplocu,feud_closed_door_right]
if (last_useitem = feud_mayors_house_keys) @feud_mayor_door(feud_open_door_right, true);
~displaymessage(^dm_default);

[label,feud_mayor_door](loc $replacement, boolean $key_used)
def_boolean $entering = ~check_axis(coord, loc_coord, loc_angle);
if ($entering = true & %feud_var_mayorsdoor = 0) {
    if (%feud_var < ^feud_burglary | %feud_var > ^feud_jewels_taken) return;
    if (%feud_var = ^feud_burglary) {
        mes("I had better stake the place out first, the mayor or some of his family may be in.");
        return;
    }
    if (~feud_burglary_disguised = false) return;
    if ($key_used = false) return;
}
if ($key_used = true & %feud_var_mayorsdoor = 0) {
    %feud_var_mayorsdoor = 1;
    mes("You hear a satisfying click as the door unlocks.");
}
~open_and_close_door($replacement, $entering, false);
