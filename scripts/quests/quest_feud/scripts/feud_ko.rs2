// Feud villager knock-out; period source establishes failure/attack but not its rate formula.

[opnpc5,feud_villager_1_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_ko;
    return;
}
if (%feud_var ! ^feud_villager_lured & %feud_var ! ^feud_villager_knocked_out) return;
if (inv_total(worn, blackjack_oak) < 1) { return; }
@feud_villager_ko;

[opnpc5,feud_villager_2_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_ko;
    return;
}
if (%feud_var ! ^feud_villager_lured & %feud_var ! ^feud_villager_knocked_out) return;
if (inv_total(worn, blackjack_oak) < 1) { return; }
@feud_villager_ko;

[opnpc5,feud_villager_3_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_ko;
    return;
}
if (%feud_var ! ^feud_villager_lured & %feud_var ! ^feud_villager_knocked_out) return;
if (inv_total(worn, blackjack_oak) < 1) { return; }
@feud_villager_ko;

[label,feud_villager_ko]
if (%feud_villager_state ! ^feud_villager_state_following) { return; }
if (%feud_villager_owner ! uid) { return; }
if (%feud_trial_villager ! npc_uid) return;
if (map_clock >= %feud_villager_deadline) {
    ~feud_villager_reset;
    return;
}
def_coord $spot = npc_coord;
def_npc_uid $target = npc_uid;
if (~feud_villager_has_witness($spot, $target) = true) {
    ~damage_self(^feud_villager_witness_damage);
    return;
}
if (npc_finduid($target) = false) { return; }
if (stat_random(thieving, ^feud_villager_ko_success_low, ^feud_villager_ko_success_high) = false) {
    ~npc_retaliate(0);
    return;
}
%feud_villager_state = ^feud_villager_state_unconscious;
%feud_villager_owner = uid;
%feud_villager_deadline = calc(map_clock + ^feud_villager_knockout_ticks);
%npc_attacking_uid = null;
npc_walk(npc_coord);
npc_setmode(none);
npc_anim(human_unconscious, 0);
npc_settimer(1);
if (%feud_var = ^feud_villager_lured) {
    %feud_var = ^feud_villager_knocked_out;
    stat_advance(thieving, ^feud_villager_ko_xp);
}
return;

[proc,feud_villager_has_witness](coord $spot, npc_uid $target)(boolean)
// npc_huntall excludes non-attackable types, including the original citizens.
// FEUD-WITNESS-PERSON-01 is the single data rule for visible-person eligibility.
def_int $x = coordx($spot);
def_int $z = coordz($spot);
def_int $zone_x = calc(($x - ^feud_villager_witness_radius) / 8 * 8);
def_int $first_zone_z = calc(($z - ^feud_villager_witness_radius) / 8 * 8);
def_int $last_x = calc($x + ^feud_villager_witness_radius);
def_int $last_z = calc($z + ^feud_villager_witness_radius);
while ($zone_x <= $last_x) {
    def_int $x_offset = calc($zone_x - $x);
    def_int $zone_z = $first_zone_z;
    while ($zone_z <= $last_z) {
        npc_findallzone(movecoord($spot, $x_offset, 0, calc($zone_z - $z)));
        while (npc_findnext = true) {
            def_coord $candidate = npc_coord;
            if (npc_uid ! $target & npc_getmode ! opplayer2 &
                enum(npc, int, feud_witness_people, npc_type) = 1 &
                distance($candidate, $spot) <= ^feud_villager_witness_radius &
                lineofsight($candidate, $spot) = true) {
                // The iterator made the witness active; consequences belong to the victim.
                return(npc_finduid($target));
            }
        }
        $zone_z = calc($zone_z + 8);
    }
    $zone_x = calc($zone_x + 8);
}
return(false);
