// VERIFIED: original 377 seller has Talk-to and Trade; Tip.It prices willow at 600.
// CANDIDATE greeting: Transcript:Rogue Trader; sale: Transcript:Blackjack seller,
// revision 36382238. Its Trade wording is unchanged in revision 36399950.

[opnpc1,feud_bjseller]
if (%feud_var = ^feud_complete & %roguetrader_blackjacks >= 1) { ~roguetrader_blackjack_supplier; return; }
if (%feud_var ! ^feud_complete) { return; }
~chatnpc("<p,neutral>Hello. Could I interest you in a Blackjack?");
return;

[opnpc3,feud_bjseller]
if (%feud_var ! ^feud_complete) { return; }
~chatnpc("<p,neutral>I've only got one model in stock at the moment. It's a willow black jack which I'd be willing to let go for 600 coins.");
if (~p_choice2("I'll take it.", 1, "No thanks.", 2) = 2) {
    ~chatplayer("<p,neutral>No thanks.");
    return;
}
~chatplayer("<p,neutral>I'll take it.");
def_int $coins = inv_total(inv, coins);
if ($coins < ^feud_repeat_willow_price) {
    mes("You can not afford that.");
    ~chatplayer("<p,neutral>Can I get that on credit?");
    ~chatnpc("<p,neutral>Get out of here!");
    return;
}
// UNKNOWN full-bag policy: the published candle seller checks the whole exchange.
// Removing the final coin stack frees its slot; no source supplies refusal words.
if (inv_freespace(inv) = 0 & $coins > ^feud_repeat_willow_price) { return; }
inv_del(inv, coins, ^feud_repeat_willow_price);
inv_add(inv, blackjack_willow, 1);
return;
