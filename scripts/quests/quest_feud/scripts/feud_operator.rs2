// The Feud — Ali the Operator Talk-to, chat only. Three trees:
// (a) join a gang (shipped, PASS feudosxtiyip), (b) after the first
// pickpocket, the progress advice tree (dump § Picking another pocket:
// "How is the pickpocketing going? Need a hand?" -> "Yeah, I could do with a
// bit of advice." -> distraction hint, then the help sub-menu; "Nah, no
// problems here..." goes straight to the flavour menu — no extra Yes line),
// and (c) after the second pickpocket, the oak blackjack tree (dump §
// Pickpocketing part three / Talking to Ali the Operator: "Having problems?"
// -> "Yeah, I could do with a bit of advice." -> distraction failing ->
// award blackjack_oak 4599; full-inv decline / already-has branches).
// CANDIDATE 2007-base (OSRS Transcript:The Feud § Joining a gang / Picking
// another pocket / Pickpocketing part three minus the 27 Apr 2022 lore
// pass). Gate: %feud_var >= 1 AND %feud_var_drink >= 3 AND
// %feud_var_comp_gangs = 3 else return. Oak tree when %feud_talk_villager
// >= 2; progress when >= 1; else the join tree.
// No stage write — %feud_var stays 1, %feud_talk_villager stays 1 (oak
// keeps count 2), no 28 (28 = blackjack seller vis, not complete). No
// %feud_npc_multi (lure/KO vis is the next hop). No willow. No dest /
// p_tele. No && / ||.
// Cite feud-operator-blackjack-377.md §7.4 §7.5 · osrs-wiki-changes-crawl-377.md.

[opnpc1,feud_egyptian_minder]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
if (%feud_talk_villager >= 2) {
    @feud_operator_oak;
}
if (%feud_talk_villager >= 1) {
    @feud_operator_progress;
}
~chatnpc("<p,neutral>You seem to be a man of action. We could do with more people like you to sort those despicable bandits out.");
~chatplayer("<p,neutral>Yeah, those pesky bandits!");
~chatnpc("<p,quiz>So will you join us in our fight to wipe them out?");
def_int $join = ~p_choice2("Yes, of course, those bandits should be taught a lesson.", 1, "Perhaps later, I'm quite busy at the moment.", 2);
if ($join = 2) {
    @feud_operator_notyet;
}
~chatplayer("<p,happy>Yes, of course, those pesky bandits should be taught a lesson.");
~chatnpc("<p,happy>Good choice my friend, together we will crush them.");
~chatplayer("<p,quiz>So when do we start?");
~chatnpc("<p,neutral>Slow down, slow down. First you must prove yourself capable and trustworthy.");
~chatplayer("<p,quiz>How will I manage that?");
~chatnpc("<p,neutral>Don't worry about that, I'll just set you a few jobs to do.");
~chatnpc("<p,neutral>As you might have gathered we have a less-than- sparkling reputation around here.");
~chatnpc("<p,neutral>So I want you to foster this reputation and grow it.");
~chatplayer("<p,quiz>What exactly does that mean?");
~chatnpc("<p,neutral>It means that I want you to go out into the town and pickpocket three villagers, then report back to me.");
~chatnpc("<p,neutral>If you have any problems don't be afraid to ask for some advice.");
~chatplayer("<p,neutral>Oh right, thanks.");
@feud_operator_help;

[label,feud_operator_progress]
~chatnpc("<p,quiz>How is the pickpocketing going? Need a hand?");
def_int $pp = ~p_choice2("Yeah, I could do with a bit of advice.", 1, "Nah, no problems here. I want to ask you about something else.", 2);
if ($pp = 1) {
    ~chatplayer("<p,neutral>Yeah, I could do with a bit of advice.");
    ~chatnpc("<p,neutral>If you can't achieve your goal directly, try adding another element into the equation, like a distraction.");
    ~chatnpc("<p,quiz>Do you know what I mean?");
    ~chatplayer("<p,neutral>I think so.");
    @feud_operator_help;
}
~chatplayer("<p,neutral>Nah no problems here. I actually wanted to ask you about something else.");
@feud_operator_help;

[label,feud_operator_notyet]
~chatplayer("<p,neutral>Perhaps later, I'm quite busy at the moment.");
~chatnpc("<p,neutral>Tell me when you are ready. This deed should not be undertaken lightly.");
@feud_operator_help;

[label,feud_operator_help]
~chatnpc("<p,neutral>Can I help you with anything else?");
def_int $h = ~p_choice2("Yes I'd like to ask you about something else.", 1, "No thanks.", 2);
if ($h = 2) {
    ~chatplayer("<p,neutral>No thanks.");
    return;
}
~chatplayer("<p,neutral>Yes I'd like to ask you about something else.");
@feud_operator_flavour;

[label,feud_operator_flavour]
def_int $t = ~p_choice3("Tell me about yourself.", 1, "Tell me about the other people in the town.", 2, "I'm looking for Ali.", 3);
if ($t = 1) {
    ~chatplayer("<p,neutral>Tell me about yourself.");
    ~chatnpc("<p,neutral>That information is available on a need to know basis and right now, you don't need to know.");
    @feud_operator_help;
}
if ($t = 2) {
    ~chatplayer("<p,neutral>Tell me about the other people in the town.");
    ~chatnpc("<p,neutral>Sheep, ready for the slau... hang on. I shouldn't be telling you that. Just forget I said anything.");
    @feud_operator_help;
}
~chatplayer("<p,neutral>I'm looking for Ali.");
~chatnpc("<p,quiz>Can you be a bit more specific? Everyone here is called Ali.");
~chatplayer("<p,neutral>So I noticed. Well, he has an uncle called Ali Morrisane, a market vendor in Al Kharid. That's all I really know about him.");
~chatnpc("<p,neutral>Say no more. I know just the Ali you mean - that little snake robbed me too! If we work together perhaps we can catch him and teach him a lesson.");
@feud_operator_help;

[label,feud_operator_oak]
~chatnpc("<p,quiz>Having problems?");
def_int $o = ~p_choice2("Yeah, I could do with a bit of advice.", 1, "Nah, no problems here. I want to ask you about something else.", 2);
if ($o = 1) {
    ~chatplayer("<p,neutral>Yeah, I could do with a bit of advice.");
    ~chatnpc("<p,neutral>The distraction tactic isn't working any more?");
    ~chatplayer("<p,neutral>No, they seem to have figured that one out already.");
    ~chatnpc("<p,neutral>It is a small town, news spreads fast. Perhaps using a spot of cunning and a bit of brute force might work better.");
    if (inv_freespace(inv) < 1) {
        ~chatnpc("<p,neutral>Here, take this, it might help.");
        mes("Ali the Operator motions as if to give you a Blackjack but you");
        mes("decline, as you have no room in your inventory.");
        return;
    }
    if (inv_total(inv, blackjack_oak) >= 1 | inv_total(worn, blackjack_oak) >= 1) {
        ~chatnpc("<p,neutral>I've already given you a Blackjack, try using it.");
        return;
    }
    inv_add(inv, blackjack_oak, 1);
    mes("Ali The Operator hands you a Blackjack made out of oak.");
    return;
}
~chatplayer("<p,neutral>No problems here. I actually wanted to ask you about something else.");
~chatplayer("<p,neutral>Yes I'd like to ask you about something else.");
@feud_operator_flavour;
