// Repeatable post-Feud blackjacking. Period rewards are in the sibling DB rows/constants.

[opnpc3,feud_arabian_guard1_1]
if (%feud_var ! ^feud_complete) { return; }
@feud_repeat_pickpocket;

[opnpc3,feud_arabian_guard1_2]
if (%feud_var ! ^feud_complete) { return; }
@feud_repeat_pickpocket;

[opnpc3,feud_arabian_guard2_1]
if (%feud_var ! ^feud_complete) { return; }
@feud_repeat_pickpocket;

[opnpc3,feud_arabian_guard2_2]
if (%feud_var ! ^feud_complete) { return; }
@feud_repeat_pickpocket;

[opnpc3,feud_egyptian_doorman_2]
if (%feud_var ! ^feud_complete) { return; }
@feud_repeat_pickpocket;

[opnpc4,feud_arabian_guard1_2]
if (%feud_var ! ^feud_complete) { return; }
~feud_repeat_start_lure;

[opnpc4,feud_arabian_guard2_2]
if (%feud_var ! ^feud_complete) { return; }
~feud_repeat_start_lure;

[opnpc4,feud_egyptian_doorman_2]
if (%feud_var ! ^feud_complete) { return; }
~feud_repeat_start_lure;

[opnpc5,feud_arabian_guard1_2]
if (%feud_var ! ^feud_complete) { return; }
if (inv_total(worn, blackjack_oak) < 1 & inv_total(worn, blackjack_willow) < 1) { return; }
~feud_repeat_blackjack_ko(^feud_repeat_bandit_ko_xp, false);

[opnpc5,feud_arabian_guard2_2]
if (%feud_var ! ^feud_complete) { return; }
if (inv_total(worn, blackjack_oak) < 1 & inv_total(worn, blackjack_willow) < 1) { return; }
~feud_repeat_blackjack_ko(^feud_repeat_bandit_ko_xp, false);

[opnpc5,feud_egyptian_doorman_2]
if (%feud_var ! ^feud_complete) { return; }
if (stat(thieving) < ^feud_repeat_thug_thieving_level) { return; }
if (inv_total(worn, blackjack_oak) < 1 & inv_total(worn, blackjack_willow) < 1) { return; }
~feud_repeat_blackjack_ko(^feud_repeat_thug_ko_xp, false);

[label,feud_repeat_pickpocket]
if (%feud_villager_state ! ^feud_villager_state_idle) {
    if (%feud_villager_owner ! uid) { return; }
    if (%feud_villager_state = ^feud_villager_state_unconscious & map_clock >= %feud_villager_deadline) {
        ~feud_villager_reset;
        ~npc_retaliate(0);
        return;
    }
}
@attempt_pick_pocket(npc_type);

[proc,feud_repeat_villager_pickpocket]
if (%feud_villager_state ! ^feud_villager_state_unconscious) {
    ~feud_villager_pickpocket_fail;
    return;
}
if (%feud_villager_owner ! uid) { return; }
if (map_clock >= %feud_villager_deadline) {
    ~feud_villager_reset;
    ~npc_retaliate(0);
    return;
}
// VERIFIED: villagers give a few coins, not Thieving XP, when picked after a KO.
inv_add(inv, coins, ^feud_villager_pickpocket_coins);
return;

[proc,feud_repeat_start_lure]()(boolean)
if (%feud_villager_state ! ^feud_villager_state_idle) { return(false); }
%feud_villager_state = ^feud_villager_state_following;
%feud_villager_owner = uid;
%feud_villager_deadline = calc(map_clock + ^feud_villager_follow_timeout);
%npc_attacking_uid = uid;
npc_setmode(playerfollow);
npc_queue(19, 0, ^feud_villager_follow_timeout);
return(true);

[proc,feud_repeat_villager_ko]
~feud_repeat_blackjack_ko(^feud_villager_ko_xp, true);
return;

[proc,feud_repeat_blackjack_ko](int $experience, boolean $villager)(boolean)
if (%feud_villager_state ! ^feud_villager_state_following) { return(false); }
if (%feud_villager_owner ! uid) { return(false); }
if (map_clock >= %feud_villager_deadline) {
    ~feud_villager_reset;
    return(false);
}
def_coord $spot = npc_coord;
def_npc_uid $target = npc_uid;
if (~feud_villager_has_witness($spot, $target) = true) {
    if ($villager = true) {
        ~damage_self(^feud_villager_witness_damage);
        return(false);
    }
    ~feud_repeat_witnessed_ko;
    return(false);
}
if (npc_finduid($target) = false) { return(false); }
if (stat_random(thieving, ^feud_villager_ko_success_low, ^feud_villager_ko_success_high) = false) {
    // VERIFIED for villagers; CANDIDATE for Bandits/Thugs: failure starts ordinary combat.
    // No unwitnessed Bandit/Thug damage or stun is supplied by the period source.
    ~npc_retaliate(0);
    return(false);
}
%feud_villager_state = ^feud_villager_state_unconscious;
%feud_villager_owner = uid;
%feud_villager_deadline = calc(map_clock + ^feud_villager_short_state_ticks);
%npc_attacking_uid = null;
npc_setmode(null);
npc_anim(human_unconscious, 0);
npc_queue(19, 0, ^feud_villager_short_state_ticks);
stat_advance(thieving, $experience);
return(true);

[proc,feud_repeat_witnessed_ko]
~feud_villager_reset;
spotanim_pl(stunned_thieving, 124, 0);
anim(%com_defendanim, 0);
npc_anim(npc_param(attack_anim), 0);
if (npc_param(attack_sound) ! null) {
    sound_synth(npc_param(attack_sound), 0, 0);
}
sound_synth(stunned, 1, 0);
~damage_self(^feud_repeat_witness_damage);
def_int $stun_end = calc(map_clock + ^feud_repeat_witness_stun_ticks);
%action_delay = $stun_end;
%stunned = $stun_end;
walktrigger(stunned);
~npc_retaliate(0);
return;

// Shared engine timeout/reset procedures are reused; these entrypoints cover all
// original Feud Bandit and Thug forms which can hold a lure or KO timer.
[ai_queue19,feud_arabian_guard_multi]
~feud_villager_timeout;

[ai_queue19,feud_arabian_guard1_1]
~feud_villager_timeout;

[ai_queue19,feud_arabian_guard1_2]
~feud_villager_timeout;

[ai_queue19,feud_arabian_guard2_multi]
~feud_villager_timeout;

[ai_queue19,feud_arabian_guard2_1]
~feud_villager_timeout;

[ai_queue19,feud_arabian_guard2_2]
~feud_villager_timeout;

[ai_queue19,feud_egyptian_doorman_multi]
~feud_villager_timeout;

[ai_queue19,feud_egyptian_doorman_1]
~feud_villager_timeout;

[ai_queue19,feud_egyptian_doorman_2]
~feud_villager_timeout;
