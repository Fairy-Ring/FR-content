// The Feud — Use the flute on an original wild desert snake.
// CANDIDATE current OSRS transcript and period guides: use the flute on a
// snake near Pollnivneach, then capture it in the empty basket.
// feud_desert_snake 1874 is distinct from the charmer's pet 1875.
// Gate on basket_for_snake 4606 and an in-range wild snake; range 1 is
// UNKNOWN. Success replaces the empty basket with basket_with_snake 4607.
// The transcript gives the success and failure messages; stage stays put.
// Hag handover is later. No teleport or quest-state mutation.

[opheld1,snake_flute]
if (~ratcatch_flute_open = true) return;
@feud_capture_snake;

[opnpcu,feud_desert_snake]
if (last_useitem ! snake_flute) {
    return;
}
@feud_capture_snake;

[label,feud_capture_snake]
if (inv_total(inv, basket_for_snake) < 1) {
    mes("Your snake charming skills are insufficient to pacify the creature.");
    return;
}
if (npc_find(coord, feud_desert_snake, ^feud_snake_use_range, 0) = false) {
    mes("Your snake charming skills are insufficient to pacify the creature.");
    return;
}
mes("You successfully charm and capture the snake!");
inv_del(inv, basket_for_snake, 1);
inv_add(inv, basket_with_snake, 1);
return;
