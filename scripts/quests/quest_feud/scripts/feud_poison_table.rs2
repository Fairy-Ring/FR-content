// The Feud — poison Hag's drink at the beer table.
// CANDIDATE current OSRS Transcript:The Feud; period RuneHQ places the
// Barman report before table use. Gate: stage 22, source-named drink_found
// varbit 321, and one poison_from_hag item.
// Success consumes one vial, sets boss_vis varbit 335, and advances to 23.
// Further item use at stage 23 repeats the sourced player line; no second vial
// is consumed. Barman wording remains in the town script.

[oplocu,feud_poison_beer_table]
if (%feud_var >= ^feud_poisoned_drink) {
    ~chatplayer("<p,neutral>I've poisoned the drink. I'd better leave it alone now in case someone notices.");
    return;
}
if (%feud_var ! ^feud_poison_obtained) {
    return;
}
if (%feud_var_drink_found < 1) {
    return;
}
def_obj $used = last_useitem;
if ($used ! poison_from_hag) {
    return;
}
mes("You poison the drink.");
inv_del(inv, poison_from_hag, 1);
%feud_boss_vis = 1;
%feud_var = ^feud_poisoned_drink;
return;
