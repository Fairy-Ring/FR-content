// CANDIDATE: pre-2022 RuneScape transcript 18411641, lines 383–416.
// Missing choice replies/state: Old School quest transcript 15325427.
// Ordinary random dialogues: Old School NPC transcript 15325429.
[opnpc1,feud_villager_1_1] @feud_villager_talk;
[opnpc1,feud_villager_1_2] @feud_villager_talk;
[opnpc1,feud_villager_1_3] @feud_villager_talk;
[opnpc1,feud_villager_2_1] @feud_villager_talk;
[opnpc1,feud_villager_2_2] @feud_villager_talk;
[opnpc1,feud_villager_2_3] @feud_villager_talk;
[opnpc1,feud_villager_3_1] @feud_villager_talk;
[opnpc1,feud_villager_3_2] @feud_villager_talk;
[opnpc1,feud_villager_3_3] @feud_villager_talk;

[label,feud_villager_talk]
if (%feud_var >= ^feud_bandits_defeated) @feud_villager_after;
if (%feud_var = ^feud_menaphites_defeated) @feud_villager_celebrate;
~chatplayer("<p,neutral>Hello, how's it going?");
switch_int (random(^feud_villager_greeting_count)) {
    case 0 : ~chatnpc("<p,neutral>Hello there! Nice weather we've been having.");
    case 1 :
        ~chatnpc("<p,neutral>All these newcomers - what are they up to?");
        ~chatplayer("<p,neutral>What are you talking about?");
        ~chatnpc("<p,neutral>Argh! Another one! No, I don't want to help with your scheme! I'm very busy!");
        ~chatplayer("<p,neutral>Ohhh kaaay... I'll leave you to it then.");
    case 2 :
        ~chatnpc("<p,neutral>I'm fine, how are you?");
        ~chatplayer("<p,neutral>Very well, thank you.");
    case 3 : @feud_villager_trade;
    case 4 :
        ~chatnpc("<p,shock>Argh! Don't rob me!");
        ~chatplayer("<p,neutral>What are you talking about?");
        ~chatnpc("<p,neutral>Sorry, I thought you were a bandit.");
        ~chatplayer("<p,neutral>There are a lot of them around here...");
    case 5 : ~chatnpc("<p,neutral>None of your business.");
    case 6 : ~chatnpc("<p,neutral>Get out of my way, I'm in a hurry!");
    case 7 : ~chatnpc("<p,neutral>Not too bad, thanks.");
    case 8 : @feud_villager_enemies;
    case 9 : @feud_villager_quest;
    case 10 :
        ~chatnpc("<p,neutral>How can I help you?");
        def_int $choice = ~p_choice3("Do you wish to trade?", 1, "I'm in search of a quest.", 2, "I'm in search of enemies to kill.", 3);
        if ($choice = 1) @feud_villager_trade;
        if ($choice = 2) @feud_villager_quest;
        @feud_villager_enemies;
    case 11 : ~chatnpc("<p,neutral>Do I know you? I'm in a hurry!");
    case 12 : ~chatnpc("<p,neutral>I'm very well thank you.");
    case 13 :
        ~chatnpc("<p,quiz>Who are you?");
        ~chatplayer("<p,neutral>I'm a bold adventurer.");
        ~chatnpc("<p,neutral>Ah, a most noble profession.");
}
return;

[label,feud_villager_trade]
~chatplayer("<p,neutral>Do you wish to trade?");
~chatnpc("<p,neutral>No, I have nothing I wish to get rid of. If you want to do some trading, there are plenty of shops and market stalls around though.");
return;

[label,feud_villager_quest]
~chatplayer("<p,neutral>I'm in search of a quest.");
~chatnpc("<p,neutral>I'm sorry, I can't help you there.");
return;

[label,feud_villager_enemies]
~chatplayer("<p,neutral>I'm in search of enemies to kill.");
~chatnpc("<p,neutral>The desert just outside of town is full of wolves, snakes, and even wild Ugthanki. Try there.");
return;

[label,feud_villager_celebrate]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,angry>Good job, you just made everything worse for us poor villagers!");
~chatplayer("<p,angry>What?! I just single-handedly took apart one of the gangs which was subjugating your village.");
~chatnpc("<p,neutral>You adventurers! You never think, you just act. You think that by killing a powerful bad person, RuneScape will become a better place.");
~chatnpc("<p,neutral>It's not that simple, things never are. A vacuum is created - power is available to the person best situated to take it.");
~chatnpc("<p,quiz>Who do you think is in the best position to take power, our good mayor or the leader of the bandits?");
~chatplayer("<p,neutral>Umm oops, sorry I was just trying to help. So are things really that much worse?");
~chatnpc("<p,neutral>Yes. Before your intervention the two gangs pretty much cancelled each other out. They spend most of their energy trying to kill each other.");
~chatnpc("<p,neutral>Now that the balance is lost, the Bandits reign unopposed! They no longer have to deal with the Menaphites and inflict nothing but more misery on us. You must finish the job that you have started.");
~chatplayer("<p,neutral>You know, this adventuring lark is a lot more complicated than I thought!");
%feud_talk_villager = 1;
%feud_bandit_boss_vis = 1;
~chatnpc("<p,neutral>If you're prepared to change something you must also be prepared to deal with the consequences! Now hurry up and fix this mess you created!");
if (~p_choice2("What do you mean by fix the mess I created?", 1, "Ok I'll get to it.", 2) = 1) {
    ~chatplayer("<p,neutral>What do you mean by fix the mess I created?");
    ~chatnpc("<p,quiz>Do I have to spell it out to you?");
    ~chatplayer("<p,neutral>Would you please?");
    ~chatnpc("<p,neutral>Just run the bandits out of town. Incidentally, I spotted their leader to the north-west just a few minutes ago.");
    return;
}
~chatplayer("<p,neutral>Ok I'll get to it.");
return;

[label,feud_villager_after]
~chatplayer("<p,neutral>Now are you satisfied?");
~chatnpc("<p,neutral>Oh it's you again!");
~chatplayer("<p,neutral>I have delivered you from two evil tyrants, let's see some gratitude.");
~chatnpc("<p,neutral>Gratitude? For what? You come into our town and rob, mug, burgle and kill and then expect respect and our gratitude? Look if it's praise and thanks you're looking for, talk to the mayor.");
%feud_talk_villager = 2;
%feud_mayor_invis = 0;
~chatplayer("<p,neutral>I wonder why I bother sometimes! Ungrateful layabouts! This place has been nothing but trouble and I still haven't found Ali's nephew.");
