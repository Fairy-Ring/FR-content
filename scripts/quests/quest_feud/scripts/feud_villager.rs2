if (%feud_var_menaboss < 1) { return; }
@feud_villager_celebrate;

[label,feud_villager_celebrate]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,angry>You! You're the one that just made everything worse for us poor villagers!");
~chatplayer("<p,angry>What?! I just single-handedly took apart one of the gangs that was ruining your town!");
~chatnpc("<p,neutral>You adventurers! You never think, you just act. You think that by killing a powerful bad person, Gielinor will become a better place.");
~chatnpc("<p,neutral>It's not that simple, things never are. You've created a vacuum, and now all that power will go to whoever's strong enough to take it.");
~chatnpc("<p,quiz>Who do you think is stronger? Our elderly mayor, or the leader of the bandits?");
~chatplayer("<p,neutral>Oops. Sorry, I was just trying to help. So are things really that much worse?");
~chatnpc("<p,neutral>Yes. Before your intervention the two gangs pretty much cancelled each other out. They spent most of their energy trying to kill each other.");
~chatnpc("<p,neutral>Now that the balance is lost, the Bandits reign unopposed! They no longer have to deal with the Menaphites and heap misery upon misery on us. You must finish the job that you have started.");
~chatplayer("<p,neutral>You know, this adventuring lark is a lot more complicated than I thought!");
~chatnpc("<p,neutral>If you're prepared to change something you must also be prepared to deal with the consequences! Now hurry up and fix this mess you created!");
def_int $fix = ~p_choice2("What do you mean by fix the mess I created?", 1, "Ok I'll get to it.", 2);
if ($fix = 1) {
    ~chatplayer("<p,neutral>What do you mean by fix the mess I created?");
    ~chatnpc("<p,quiz>Do I have to spell it out to you?");
    ~chatplayer("<p,neutral>Would you please?");
    ~chatnpc("<p,neutral>Just run the bandits out of town. Incidentally, I spotted their leader to the north-west just a few minutes ago.");
    return;
}
~chatplayer("<p,neutral>Okay, I'll get to it.");
return;

[label,feud_villager_after]
~chatplayer("<p,neutral>Now are you satisfied?");
~chatnpc("<p,neutral>Oh, it's you again!");
~chatplayer("<p,neutral>I have delivered you from two evil tyrants. Where's my thank you?");
~chatnpc("<p,neutral>Thank you? For what? You come into our town. You rob, mug, burgle and kill and then expect respect and gratitude? Look, if it's praise and thanks you're looking for, talk to the mayor.");
~chatplayer("<p,neutral>I wonder why I bother sometimes! This place has been nothing but trouble and I still haven't found Ali's nephew.");
return;
