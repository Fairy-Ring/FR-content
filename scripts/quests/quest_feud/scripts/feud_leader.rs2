// CANDIDATE: pre-2022 RuneScape transcript 18411641, lines 363–378.
// Repeat summon and original varbit transitions: Old School transcript 15325427.
[opnpc1,feud_menap_boss_vis]
if (%feud_var ! ^feud_leader_summons) return;
if (%feud_var_menaboss = 1) {
    npc_say("Guards!");
    ~feud_champion_spawn(feud_menap_toughguy);
    return;
}
~chatplayer("<p,neutral>Ali the operator told me that you wanted to see me.");
~chatnpc("<p,neutral>That's right, I have been keeping track of your progress. It was impressive.");
~chatplayer("<p,neutral>So what plans for the bandits?");
~chatnpc("<p,neutral>The bandits? A mere nuisance, insignificant in my overall plans.");
~chatplayer("<p,neutral>So if you're not warring with the bandits what then are you planning for?");
~chatnpc("<p,happy>World domination, first Pollnivneach, then Al Kharid then the whole of Runescape!");
~chatplayer("<p,shock>What?");
~chatnpc("<p,quiz>You do understand who 'We' are?");
~chatplayer("<p,neutral>Actually I thought you were a ragtag band of good for nothing thieves sucking the life out of this backwater excuse for a town.");
~chatnpc("<p,angry>Silence! We are the chosen, exiled from Menaphos for trying to overthrow the Pharaoh. Loyal servants of Amascut the Devourer, God of Destruction. We are regrouping to launch another offensive against the thrall of Tumeken, using Pollnivneach as a spawning ground for revolution!");
~chatplayer("<p,angry>That's it, I've had it! I'm just going to have to rid the world of you and your mob - I have this irrational hatred for megalomaniacal, despotic, religious zealots! Prepare to meet Icthy-aly-rin or whoever!");
%feud_var_menaboss = 1;
~chatnpc("<p,angry>Fool! You'll never get to me. Guards protect me. Guards!");
~feud_champion_spawn(feud_menap_toughguy);
