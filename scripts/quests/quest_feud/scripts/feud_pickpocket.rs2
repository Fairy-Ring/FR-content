    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_3_2]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_3_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[label,feud_villager_pick]
~feud_villager_reconcile;
if (%feud_var = ^feud_recruited) {
    // VERIFIED 30 Thieving minimum; this follows the normal pickpocket refusal pattern.
    if (stat(thieving) < ^feud_trial_thieving_level) {
        ~mesbox("You need level <tostring(^feud_trial_thieving_level)> thieving to pick the villager's pocket.");
        return;
    }
    if (%feud_villager_state ! ^feud_villager_state_idle) {
        @feud_villager_caught;
    }
    inv_add(inv, coins, ^feud_villager_pickpocket_coins);
    stat_advance(thieving, ^feud_villager_pickpocket_xp);
    %feud_npc_multi = 1;
    %feud_var = ^feud_first_pick;
    return;
}
if (%feud_var = ^feud_distraction_active) {
    if (%feud_villager_state ! ^feud_villager_state_distracted | %feud_villager_owner ! uid) {
        @feud_villager_caught;
    }
    inv_add(inv, coins, ^feud_villager_pickpocket_coins);
    stat_advance(thieving, ^feud_villager_pickpocket_xp);
    %feud_npc_multi = 2;
    %feud_var = ^feud_second_pick;
    ~feud_villager_reset;
    return;
}
if (%feud_var = ^feud_villager_lured) {
    @feud_villager_caught;
}
if (%feud_var = ^feud_villager_knocked_out) {
    if (%feud_villager_state ! ^feud_villager_state_unconscious) {
        @feud_villager_caught;
    }
    if (%feud_villager_owner ! uid) { return; }
    inv_add(inv, coins, ^feud_villager_pickpocket_coins);
    %feud_var = ^feud_third_pick;
    return;
}
@feud_villager_caught;

[label,feud_villager_caught]
~feud_villager_pickpocket_fail;
return;

[proc,feud_villager_pickpocket_fail]
npc_say("I know your tricks, thief.");
npc_say("You won't get my purse.");
~damage_self(^feud_villager_pickpocket_fail_damage);
return;

