// The Feud — first villager Pickpocket (op3) + dump refuse after.
// CANDIDATE 2007-base (OSRS Transcript:The Feud § Picking another pocket /
// walk 1st villager). Gate: %feud_var >= 1 AND %feud_var_drink >= 3 AND
// %feud_var_comp_gangs = 3 (joined the gang) else return — pre-Operator
// picks fail as the plain thieving skill (walk: "always fail unless spoken
// with Ali the Operator").
// Walk is NOT three identical successes: the 1st pick works (count 0->1);
// the 2nd pick works ONLY while the street urchin is distracting a villager
// (%feud_distracted = 1, count 1->2, then distracted clears — CANDIDATE);
// any other pick at count >= 1 is refused (dump *I know your tricks, thief.*
// / *You won't get my purse.* + 2 hit; stun skipped — no opcode). Count 3
// is the oak-blackjack lure+KO hop — never write 3 here.
// Count = %feud_talk_villager (pack varbit 343, bits 16-17 of main_feud_var,
// 0-3) — research doc §5.1 "Pickpocket count CANDIDATE 0-3". No dest /
// p_tele / 28 / blackjack. %feud_var stays 1. No && / ||.
// First-pick loot CANDIDATE (OSRS Villager table; dump silent on the amount):
// 5 coins + 80 thieving XP. Script-only — pickpocket.dbrow has no
// feud_villager_* row, so the skill proc is not callable without a dbrow.
// Cite feud-operator-blackjack-377.md §5.1 §7.4 · osrs-wiki-changes-crawl-377.md.

[opnpc3,feud_villager_1_1]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_1_2]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_1_3]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_2_1]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_2_2]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_2_3]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_3_1]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_3_2]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_3_3]
if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_comp_gangs ! 3) { return; }
@feud_villager_pick;

[label,feud_villager_pick]
if (%feud_talk_villager = 1 & %feud_distracted = 1) {
    mes("You pick the villager's pocket.");
    inv_add(inv, coins, 5); // CANDIDATE loot — OSRS Villager table (no dbrow skill proc)
    stat_advance(thieving, 80); // CANDIDATE xp — OSRS Villager table (man row 80 = 8.0)
    %feud_talk_villager = 2;
    %feud_distracted = 0; // CANDIDATE — third pick must refuse until the blackjack hop
    return;
}
if (%feud_talk_villager >= 1) {
    if (%feud_talk_villager >= 2) {
        if (inv_total(inv, blackjack_oak) >= 1 | inv_total(worn, blackjack_oak) >= 1) {
            if (%feud_npc_multi >= 1) {
                %feud_npc_multi = 2; // CANDIDATE — opens KO (vis 2); same flip pattern as Lure (0->1)
            } else {
                %feud_npc_multi = 1; // CANDIDATE — opens Lure (vis 1) after the oak award; engine rejects op4/op5 at lower vis
            }
        }
    }
    ~chatnpc("<p,angry>I know your tricks, thief.");
    ~chatnpc("<p,angry>You won't get my purse.");
    ~damage_self(2); // dump: villager hits the player for 2 damage. Stun skipped (no opcode).
    return;
}
mes("You pick the villager's pocket.");
inv_add(inv, coins, 5); // CANDIDATE loot — OSRS Villager table (no dbrow skill proc)
stat_advance(thieving, 80); // CANDIDATE xp — OSRS Villager table (man row 80 = 8.0)
%feud_talk_villager = 1;
return;
