// Feud villager theft trials. Quest progress is stage-based; NPC state is per target and owner.

[opnpc3,feud_villager_1_1]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_1_2]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_1_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_2_1]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_2_2]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_2_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_villager_pickpocket;
    return;
}
if (%feud_var < ^feud_recruited) { return; }
@feud_villager_pick;

[opnpc3,feud_villager_3_1]
if (%feud_var = ^feud_complete) {
