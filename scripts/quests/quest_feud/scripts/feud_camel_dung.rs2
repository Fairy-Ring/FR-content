// The Feud — red sauce on the original Pollnivneach camel trough.
// CANDIDATE current OSRS Dung scenery history: 2/25 green, 23/25 brown.
// RuneHQ says the camel drops dung a few seconds after it eats; the delay and
// 200-cycle temporary-loc lifetime are named UNKNOWN engineering values.
// Brown dung alone accepts bucket_empty; green remains uncollectable, so use
// the reusable sauce again. Dry dung has no sourced drying mechanic.
// VERIFIED cache: feud_ugthanki_pooh_8 exists as centrepiece_straight only.
// UNKNOWN FEUD-DUNG-REFUSAL-01: equal weights among each listed refusal set.

[oplocu,feud_foodtrough]
def_obj $used = last_useitem;
if ($used ! superhot_kebab_sauce) {
    return;
}
def_coord $trough = loc_coord;
if (npc_find($trough, feud_camel, ^feud_camel_trough_range, 0) = false) {
    return;
}
anim(feud_hot_sauce_poisoning, 0);
npc_anim(camel_eats_from_trough, 0);
p_delay(^feud_dung_spawn_delay);
npc_anim(camel_eat_from_trough, 0);
def_coord $spawn = ~feud_dung_spawn_tile(npc_coord, coord, $trough);
if ($spawn = null) {
    // Published default wording, not a new Feud line. Sauce remains reusable.
    ~displaymessage(^dm_default);
    return;
}
def_int $roll = random(100);
if ($roll < ^feud_dung_green_chance) {
    loc_add($spawn, feud_ugthanki_pooh_poisoned, 0, centrepiece_straight, ^feud_dung_lifetime);
} else {
    loc_add($spawn, feud_ugthanki_pooh, 0, centrepiece_straight, ^feud_dung_lifetime);
}
return;

// UNKNOWN FEUD-DUNG-PLACEMENT-01: sources give no tile. Use the eating camel's
// tile at spawn time, then N, NE, E, SE, S, SW, W, NW, never the trough tile.
// Require a standable tile and a clear line of walk from the trough-use side.
// Never replace any centrepiece-layer loc, including another player's pile.
[proc,feud_dung_spawn_tile](coord $camel, coord $access, coord $trough)(coord)
def_int $index = 0;
while ($index < ^feud_dung_candidate_count) {
    def_coord $candidate = $camel;
    switch_int ($index) {
        case 1 : $candidate = movecoord($camel, 0, 0, 1);
        case 2 : $candidate = movecoord($camel, 1, 0, 1);
        case 3 : $candidate = movecoord($camel, 1, 0, 0);
        case 4 : $candidate = movecoord($camel, 1, 0, -1);
        case 5 : $candidate = movecoord($camel, 0, 0, -1);
        case 6 : $candidate = movecoord($camel, -1, 0, -1);
        case 7 : $candidate = movecoord($camel, -1, 0, 0);
        case 8 : $candidate = movecoord($camel, -1, 0, 1);
    }
    if ($candidate ! $trough & map_blocked($candidate) = false) {
        def_boolean $occupied = false;
        loc_findallzone($candidate);
        while ($occupied = false & loc_findnext = true) {
            if (loc_coord = $candidate) {
                switch_locshape (loc_shape) {
                    case wall_diagonal, centrepiece_straight, centrepiece_diagonal,
                         roof_straight, roof_diagonal_with_roofedge, roof_diagonal,
                         roof_l_concave, roof_l_convex, roof_flat, roofedge_straight,
                         roofedge_diagonalcorner, roofedge_l, roofedge_squarecorner :
                        $occupied = true;
                }
            }
        }
        if ($occupied = false & lineofwalk($access, $candidate) = true) {
            return($candidate);
        }
    }
    $index = calc($index + 1);
}
return(null);

[oploc1,feud_ugthanki_pooh] @feud_dung_refuse_pickup;
[oploc1,feud_ugthanki_pooh_poisoned] @feud_dung_refuse_pickup;

[label,feud_dung_refuse_pickup]
switch_int (random(4)) {
    case 0 : mes("You're kidding me! I'm not picking that up.");
        return;
    case 1 : mes("Yuck! Im not touching that.");
        return;
    case 2 : mes("I wouldn't pick that up for all the runes in Gielinor.");
        return;
    case 3 : mes("I would rather wrestle a black dragon bare-handed.");
        return;
}
return;

[oplocu,feud_ugthanki_pooh]
def_obj $used = last_useitem;
if ($used ! bucket_empty) {
    return;
}
mes("You scoop up some camel dung into the bucket");
inv_del(inv, bucket_empty, 1);
inv_add(inv, feud_camel_pooh_bucket, 1);
loc_del(1);
return;

[oplocu,feud_ugthanki_pooh_poisoned]
def_obj $used = last_useitem;
if ($used ! bucket_empty) {
    return;
}
switch_int (random(2)) {
    case 0 : ~chatplayer("<p,neutral>I'm not going near that - it's just far too stinky!");
        return;
    case 1 : ~chatplayer("<p,neutral>Good gravy, that's some repulsively stinky stuff! I'm not going to go near that.");
        return;
}
return;
