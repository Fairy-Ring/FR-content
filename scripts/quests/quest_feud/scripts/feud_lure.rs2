// Feud villager lure; transcript dialogue is CANDIDATE.

// VERIFIED original middle-form Lure options; CANDIDATE earlier following from
// the period guide's unconditional Lure rule. No earlier stage or reward write.
[opnpc4,feud_villager_1_2]
if (%feud_var = ^feud_first_pick | %feud_var = ^feud_distraction_active) @feud_villager_lure;
return;

[opnpc4,feud_villager_2_2]
if (%feud_var = ^feud_first_pick | %feud_var = ^feud_distraction_active) @feud_villager_lure;
return;

[opnpc4,feud_villager_3_2]
if (%feud_var = ^feud_first_pick | %feud_var = ^feud_distraction_active) @feud_villager_lure;
return;

[opnpc4,feud_villager_1_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_start_lure;
    return;
}
if (%feud_var < ^feud_second_pick | %feud_var > ^feud_villager_knocked_out) return;
@feud_villager_lure;

[opnpc4,feud_villager_2_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_start_lure;
    return;
}
if (%feud_var < ^feud_second_pick | %feud_var > ^feud_villager_knocked_out) return;
@feud_villager_lure;

[opnpc4,feud_villager_3_3]
if (%feud_var = ^feud_complete) {
    ~feud_repeat_start_lure;
    return;
}
if (%feud_var < ^feud_second_pick | %feud_var > ^feud_villager_knocked_out) return;
@feud_villager_lure;

[label,feud_villager_lure]
if (~feud_trial_target_ready = false) return;
if (%feud_villager_state ! ^feud_villager_state_idle) { return; }
~chatplayer("<p,neutral>Psst. Come here, I want to show you something");
~chatnpc("<p,neutral>What is it?");
~chatplayer("<p,neutral>It's a surprise! Follow me.");
%feud_trial_villager = npc_uid;
%feud_villager_state = ^feud_villager_state_following;
%feud_villager_owner = uid;
%feud_villager_deadline = calc(map_clock + ^feud_villager_follow_timeout);
%npc_attacking_uid = uid;
npc_setmode(playerfollow);
npc_settimer(1);
if (%feud_var = ^feud_second_pick) %feud_var = ^feud_villager_lured;
return;
