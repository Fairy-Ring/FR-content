// CANDIDATE camel offer: Sal's period guide says 500 gp for two camels;
// RuneHQ says offer 500, then 1,000 if refused. Tip.It says 500 each.
// The retained transcript also accepts the 500 gp pair offer.

[opnpc1,feud_ali_the_discount_camel_seller]
if (%feud_var < ^feud_started) return;
if (%feud_var >= ^feud_mayor_reveal) @feud_camel_thanks;
if (%feud_var >= ^feud_camels_purchased) {
    ~chatnpc("<p,neutral>Hello! Welcome back to my discount camel store. How are those camels getting along?");
    @feud_camel_menu;
}
~chatnpc("<p,neutral>Welcome to my discount camel store. Can I help you with anything?");
@feud_camel_menu;

[label,feud_camel_menu]
def_int $m = 0;
if (%feud_var = ^feud_camels_purchased) {
    $m = ~p_choice5("About those camels. I've lost the receipt. Can I have another?", 1, "Tell me about this town.", 2, "Lovely day isn't it?", 3, "I decided to get rid of the camels.", 4, "I'm looking for Ali from Pollnivneach.", 5);
    if ($m = 1) @feud_camel_receipts;
} else if (%feud_var >= ^feud_camels_delivered) {
    $m = ~p_choice5("A discount camel store?", 1, "Tell me about this town.", 2, "Lovely day isn't it?", 3, "I decided to get rid of the camels.", 4, "I'm looking for Ali from Pollnivneach.", 5);
} else {
    $m = ~p_choice5("A discount camel store?", 1, "Tell me about this town.", 2, "Lovely day isn't it?", 3, "Are those camels around the side for sale?", 4, "I'm looking for Ali from Pollnivneach.", 5);
}
if ($m = 1) { @feud_camel_store; }
if ($m = 2) { @feud_camel_town; }
if ($m = 3) { @feud_camel_lovely; }
if ($m = 4) {
    if (%feud_var >= ^feud_camels_purchased) @feud_camel_disposed;
    @feud_camel_buy;
}
@feud_camel_ali;

[label,feud_camel_store]
~chatplayer("<p,quiz>A discount camel store?");
~chatnpc("<p,neutral>Yes - a great idea - selling camels at discounted prices so that the common man can experience the joys of owning a camel too. They're not just a source of kebab meat you know!");
def_int $s = ~p_choice5("So can I buy a camel then? I'm hungry!", 1, "Yes camels are beautiful creatures.", 2, "Filthy animals all they do is spit and ....", 3, "Actually I think I was a camel in a previous existence.", 4, "So is business good then?", 5);
if ($s = 1) {
    ~chatplayer("<p,happy>So can I buy a camel then? I'm hungry!");
    ~chatnpc("<p,angry>I would never sell one to the likes of you, they are beautiful majestic creatures not sandwich fillers! Get out of my shop.");
    return;
}
if ($s = 2) {
    ~chatplayer("<p,neutral>Yes camels are beautiful creatures.");
    ~chatnpc("<p,happy>Ah wondrous creatures, ships of the desert, far more useful than any horse or donkey. A man's best friend.");
    ~chatnpc("<p,neutral>Perhaps you'd like a camel of your own? You're in the right place, if so...");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    @feud_camel_menu;
}
if ($s = 3) {
    ~chatplayer("<p,neutral>Filthy animals all they do is spit and ....");
    ~chatnpc("<p,angry>Pah! You just do not know how to treat them. If you abuse them and treat them badly of course they're going to spit and bite.");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    @feud_camel_menu;
}
if ($s = 4) {
    ~chatplayer("<p,neutral>Actually I think I was a camel in a previous existence.");
    ~chatnpc("<p,neutral>You're teasing me now! You rogue!");
    ~chatnpc("<p,neutral>Everyone has a laugh at my expense, I'm just more enlightened than you!");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    @feud_camel_menu;
}
~chatplayer("<p,quiz>So is business good then?");
~chatnpc("<p,happy>Business is booming, Pollnivneach has never seen this number of visitors.");
~chatnpc("<p,neutral>In fact I'm thinking of expanding and trying to break into the camel hire market.");
~chatnpc("<p,neutral>If only I could figure out how to get people to return the camels...");
~chatnpc("<p,neutral>Is there anything else I can help you with?");
@feud_camel_menu;

[label,feud_camel_town]
~chatplayer("<p,neutral>Tell me about this town.");
~chatnpc("<p,neutral>Well Pollnivneach is a funny little place. It's a small town and you'd think it would be a quiet place.");
~chatnpc("<p,neutral>But those Menaphites and bandits are making this place quite unbearable.");
def_int $t = ~p_choice3("In what way?", 1, "Well the weak will always be trodden on. Why not stand up to them?", 2, "Perhaps I could help.", 3);
if ($t = 1) {
    ~chatplayer("<p,quiz>In what way?");
    ~chatnpc("<p,neutral>Well one group is as bad as the other, stealing from each other and the locals, fighting, and just the last day one of the bandits came looking for protection money");
    ~chatplayer("<p,neutral>Why don't the authorities stop this?");
    ~chatnpc("<p,neutral>If you haven't noticed this is a remote town, half way between Menaphos and Al Kharid, a place where neither exert any power.");
    ~chatnpc("<p,neutral>To tell the truth we live in hope that an objective outsider could broker a deal to halt the hostilities between them.");
    ~chatplayer("<p,neutral>Perhaps I will.");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    @feud_camel_menu;
}
if ($t = 2) {
    ~chatplayer("<p,neutral>Well the weak will always be trodden on. Why not stand up to them?");
    ~chatnpc("<p,neutral>That's a little unfair my friend. We can't all be brave adventurers. If we were, where would you go to get camels at discounted prices?");
    ~chatnpc("<p,neutral>You might think about that. Anyway isn't it the job of the brave adventurer to deliver the weak and innocent from evil and harm?");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    @feud_camel_menu;
}
~chatplayer("<p,neutral>Perhaps I could help.");
~chatnpc("<p,neutral>Yes perhaps you could.");
~chatplayer("<p,quiz>You know the politics better than I do. What would you recommend I do?");
~chatnpc("<p,neutral>That may be so, but you are also the brave adventurer and you should know!");
def_int $t2 = ~p_choice2("Indeed I should know, and indeed I do! I was just testing you!", 1, "Perhaps I should know, but offered advice should never be shunned.", 2);
if ($t2 = 1) {
    ~chatplayer("<p,happy>Indeed I should know, and indeed I do! I was just testing you!");
    ~chatnpc("<p,neutral>That is reassuring to hear. Too often one meets brainless adventurers whose solution to every problem is to hack, maim and murder.");
    ~chatnpc("<p,neutral>Glad to know you're not of that ilk.");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    @feud_camel_menu;
}
~chatplayer("<p,neutral>Perhaps I should know, but offered advice should never be shunned.");
~chatnpc("<p,neutral>The state of adventurers today. They need everything spelt out for them.");
~chatnpc("<p,neutral>What, you want me to put a little note in your quest journal?");
~chatnpc("<p,neutral>Well, ok I will help. Try and see if you can get the groups to agree to a truce by perhaps each offering a token gift as an act of reconciliation.");
~chatnpc("<p,neutral>If that fails to work, I would consider trying to influence the groups from within.");
~chatnpc("<p,neutral>Is there anything else I can help you with?");
@feud_camel_menu;

[label,feud_camel_lovely]
~chatplayer("<p,neutral>Lovely day isn't it?");
~chatnpc("<p,neutral>It's a beautiful day today but word has it that it will rain tomorrow.");
~chatplayer("<p,quiz>Really?");
~chatnpc("<p,neutral>No don't worry I'm only joking!");
~chatplayer("<p,neutral>Oh. Anyway...");
~chatnpc("<p,neutral>Is there anything else I can help you with?");
@feud_camel_menu;

[label,feud_camel_buy]
~chatplayer("<p,quiz>Are those camels around the side for sale?");
// CANDIDATE: the source's early-state branch and saved inquiry gate.
if (%feud_var_talk_gangs ! 3 | %feud_var < ^feud_camel_offer) {
    ~chatnpc("<p,neutral>Those two camels around the side are already sold.");
    ~chatnpc("<p,neutral>I've got new stock coming very soon though. Come back later if you're still interested.");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    if (~p_choice2("Well yes actually I'd like to ask you about something else.", 1, "No, but thanks for your time.", 2) = 1) @feud_camel_menu;
    ~chatplayer("<p,neutral>No, but thanks for your time.");
    return;
}
~chatnpc("<p,neutral>Those two camels around the side are already sold. But you are in luck - I have another two beautiful camels arriving in soon from the best stable in all of Al Kharid.");
~chatplayer("<p,neutral>Camels, beautiful? I worry about you.");
def_int $b = ~p_choice2("Can you tell me a little about them?", 1, "What price do you want for both of them?", 2);
if ($b = 1) {
    ~chatplayer("<p,neutral>Can you tell me a little about them?");
    ~chatnpc("<p,happy>Well Sandy, the female camel, is a placid beast. At 20 years of age she comes from a prestigious line of camels - her mother was part of the Emir's baggage train!");
    ~chatnpc("<p,neutral>Lumps, on the other hand, is a 15 year old male. He's a bit surly and prone to bouts of stubbornness. However, he more than makes up for this failing with his immense strength and stamina.");
    ~chatnpc("<p,neutral>Both of them are of the 'Camelus Horribleus' family, a rare breed only found in this area of Gielinor. It is...");
    ~chatplayer("<p,neutral>Ok, ok, that's enough! They're camels, I get it.");
    ~chatnpc("<p,neutral>Is there anything else I can help you with?");
    @feud_camel_menu;
}
@feud_camel_price;

[label,feud_camel_price]
~chatplayer("<p,quiz>What price do you want for both of them?");
~chatnpc("<p,neutral>One cannot put a price on life, they are precious beyond the worth of the crass value of gold coins!");
@feud_camel_price_menu;

[label,feud_camel_price_menu]
def_int $p = ~p_choice4("So can I have them for free then?", 1, "Would 200 gold coins for the pair of them do?", 2, "Would 500 gold coins for the pair of them do?", 3, "Would 1000 gold coins for the pair of them do?", 4);
if ($p = 1) {
    ~chatplayer("<p,neutral>So can I have them for free then?");
    ~chatnpc("<p,neutral>Are you trying to be funny?");
    ~chatplayer("<p,neutral>Perhaps I could make another offer?");
    @feud_camel_price_menu;
}
if ($p = 2) {
    ~chatplayer("<p,neutral>Would 200 gold coins for the pair of them do?");
    ~chatnpc("<p,angry>Pah! That might buy you a mangy, flea-infested sheep if you're lucky. Don't insult me.");
    ~chatplayer("<p,neutral>Perhaps I could make another offer?");
    @feud_camel_price_menu;
}
if ($p = 3) {
    ~chatplayer("<p,neutral>Would 500 gold coins for the pair of them do?");
    if (inv_freespace(inv) < 2) {
        ~chatnpc("<p,neutral>I would consider giving them to you if you were able to look after them. But it is abundantly clear that you've got your hands - and your inventory - full at the moment.");
        return;
    }
    if (inv_total(inv, coins) < ^feud_camel_pair_price) {
        ~chatnpc("<p,neutral>You don't even have that much money do you? Come back when you're able to make a proper offer and stop wasting my time.");
        return;
    }
    ~chatnpc("<p,neutral>I suppose I can silence my moral objections for that.");
    inv_del(inv, coins, ^feud_camel_pair_price);
    inv_add(inv, feud_camel_receipt, 2);
    if (%feud_var < ^feud_camels_purchased) %feud_var = ^feud_camels_purchased;
    ~objbox(feud_camel_receipt, "Ali the discount camel seller gives you a receipt for the camels in return for 500 gold coins.", 250, 0, 0);
    ~chatnpc("<p,neutral>Here are the receipts for the camels so that you can pick them up as soon as I get them in. Is there anything else I can help you with?");
    @feud_camel_menu;
}
~chatplayer("<p,neutral>Would 1000 gold coins for the pair of them do?");
if (inv_freespace(inv) < 2) {
    ~chatnpc("<p,neutral>I would consider giving them to you if you were able to look after them. But it is abundantly clear that you've got your hands - and your inventory - full at the moment.");
    return;
}
if (inv_total(inv, coins) < calc(^feud_camel_pair_price * 2)) {
    ~chatnpc("<p,neutral>You don't even have that much money do you? Come back when you're able to make a proper offer and stop wasting my time.");
    return;
}
~chatnpc("<p,neutral>You are too generous, I would have sold for half of that!");
inv_del(inv, coins, calc(^feud_camel_pair_price * 2));
inv_add(inv, feud_camel_receipt, 2);
if (%feud_var < ^feud_camels_purchased) %feud_var = ^feud_camels_purchased;
~objbox(feud_camel_receipt, "Ali the discount camel seller gives you a receipt for the camels in return for 1000 gold coins.", 250, 0, 0);
~chatnpc("<p,neutral>Here are the receipts for the camels so that you can pick them up as soon as I get them in. Is there anything else I can help you with?");
@feud_camel_menu;

[label,feud_camel_ali]
~chatplayer("<p,neutral>I'm looking for Ali from Pollnivneach.");
~chatnpc("<p,neutral>Well you've found your man.");
~chatplayer("<p,quiz>Really do you have an uncle called Ali?");
~chatnpc("<p,happy>Why yes - all my uncles are called Ali!");
~chatplayer("<p,neutral>Oh dear! Do any of them own a stall in the Al Kharid Bazaar?");
~chatnpc("<p,neutral>Well no, but one of them owns a camel hire franchise.");
~chatnpc("<p,neutral>Have you considered hiring a camel? Or perhaps purchasing one of your own? I can get you a discount.");
~chatplayer("<p,neutral>Never mind.");
return;

// CANDIDATE: the later transcript's purchase-state replacement branch.
[label,feud_camel_receipts]
~chatplayer("<p,neutral>About those camels. I've lost the receipt, can I have another?");
def_int $missing = calc(2 - inv_total(inv, feud_camel_receipt) - inv_total(bank, feud_camel_receipt));
if ($missing <= 0) {
    ~chatnpc("<p,neutral>I think you're trying to con me into giving you an extra receipt.");
    return;
}
if (inv_freespace(inv) < $missing) {
    ~chatnpc("<p,neutral>Come back to me when you're not so burdened.");
    return;
}
~chatnpc("<p,neutral>No problem, There you go.");
inv_add(inv, feud_camel_receipt, $missing);
return;

[label,feud_camel_disposed]
~chatnpc("<p,quiz>Why? did they not please you?");
def_int $reason = ~p_choice3("No, they didn't. I sold them as Kebab meat!", 1, "I'm not really a camel person, so I gave them to a better owner.", 2, "I decided to try and use them to end the hostilities between the two gangs.", 3);
if ($reason = 1) {
    ~chatplayer("<p,neutral>No, they didn't. I sold them as Kebab meat!");
    ~chatnpc("<p,angry>Nooooo! Not Sandy and Lumps! You beast! Get out of my shop this instant!");
    return;
}
if ($reason = 2) {
    ~chatplayer("<p,neutral>I'm not really a camel person, so I gave them to a better owner.");
    ~chatnpc("<p,neutral>That's very responsible of you. Too many people let their camels run feral through the desert, instead of sending them to happy homes.");
    ~chatnpc("<p,neutral>You want to watch out for those feral camels, you know.");
} else {
    ~chatplayer("<p,neutral>I decided to try and use them to end the hostilities between the two gangs.");
    ~chatnpc("<p,neutral>A noble purpose for two noble beasts! Did you succeed?");
    ~chatplayer("<p,neutral>Still working on that, I'm afraid.");
    ~chatnpc("<p,neutral>Well, I wish you the best of luck.");
}
~chatnpc("<p,neutral>Is there anything else I can help you with?");
@feud_camel_menu;

[label,feud_camel_thanks]
~chatnpc("<p,neutral>Hello! Welcome back to my discount camel store. How are those camels getting along?");
~chatplayer("<p,neutral>Hey Ali!");
~chatnpc("<p,neutral>Hello adventurer.");
~chatplayer("<p,neutral>Any news?");
~chatnpc("<p,neutral>Not much really, I just want to thank you for what you have done for this town. I might even stick around now that business is better!");
~chatplayer("<p,neutral>Any grand plans?");
~chatnpc("<p,neutral>Well I've been debating whether I should diversify into camel rental, too. Although I do have all these cages lying around... do you think there's a market for discount jackals?");
~chatplayer("<p,neutral>Maybe! Best of luck, in any case.");
~chatnpc("<p,neutral>Thank you.");
return;
