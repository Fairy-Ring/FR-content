[label,feud_gang_before]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>What do you want?");
~chatplayer("<p,neutral>Well nothing really, I'm new to town and wanted to get to know the locals.");
~chatnpc("<p,neutral>I'm too busy for chitchat. Come back if you have some business to discuss with us.");
return;

[label,feud_bandit_give]
~chatplayer("<p,neutral>Good news, the Menaphites have agreed to give you a camel in order to restore peace.");
mes("You hand the guard a sales receipt for the camel.");
inv_del(inv, feud_camel_receipt, 1);
if (%feud_var_comp_gangs = 0) {
    %feud_var_comp_gangs = 2;
} else {
    %feud_var_comp_gangs = 3;
}
if (%feud_var_comp_gangs = 3 & %feud_var < ^feud_camels_delivered) {
    %feud_var = ^feud_camels_delivered;
}
~chatnpc("<p,neutral>Really? I knew they were cowards. Tell them that we have changed our minds and demand 10 camels in return for our mercy.");
~chatplayer("<p,neutral>Ahhh why do I bother!");
if (%feud_var_comp_gangs = 3) {
    ~chatplayer("<p,neutral>This approach doesn't seem to be working, perhaps I should be more direct and try join one of the gangs.");
}
return;

[label,feud_bandit_after]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>Good day adventurer. Have you come with the Menaphite peace offering?");
~chatplayer("<p,neutral>Umm... no. Not yet. Actually I've come to ask about something else.");
~chatnpc("<p,neutral>We can talk once you bring back the Menaphites' full peace offering.");
return;

[label,feud_gang_ordinary]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>What do you want?");
return;

[label,feud_bandit_recruited]
~chatplayer("<p,neutral>Good day.");
~chatnpc("<p,neutral>Get out of here, you Menaphite dog!");
return;

[label,feud_bandit_talk]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>What do you want?");
~chatplayer("<p,neutral>I am trying to figure out the feud that exists between you and the Menaphites.");
~chatnpc("<p,neutral>What's it to you?");
~chatplayer("<p,neutral>Nothing much I'm just trying to understand why thieves of your repute would stoop to the level of the Menaphites.");
~chatnpc("<p,neutral>Well if memory serves me correctly, I think my granddad mentioned that they robbed one of our camels. A heinous crime.");
~chatplayer("<p,neutral>So if they offered a camel as a gesture of goodwill would you and the rest of the bandits cease your hostilities?");
~chatnpc("<p,neutral>Those Menaphites would never do that. They have no sense of honour.");
~chatplayer("<p,neutral>But if they did?");
~chatnpc("<p,neutral>Well I suppose so.");
// The musing follows both distinct inquiries, not the first conversation.
if (%feud_var_talk_gangs = 0) {
    %feud_var_talk_gangs = 2;
} else if (%feud_var_talk_gangs = 1) {
    %feud_var_talk_gangs = 3;
}
if (%feud_var_talk_gangs = 3) {
    if (%feud_var < ^feud_camel_offer) %feud_var = ^feud_camel_offer;
    ~chatplayer("<p,neutral>Maybe if I got both gangs a camel, I could use the mutual goodwill to find out what happened to Ali's nephew.");
}
return;

