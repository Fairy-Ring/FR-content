[opnpc1,feud_egyptian_doorman_1]
if (%feud_var < ^feud_started) { @feud_gang_before; }
if (%feud_var_drink < 3) { return; }
if (%feud_var >= ^feud_menaphites_defeated) {
    @feud_thug_avenge;
}
if (%feud_given_jewels >= 1) {
    @feud_thug_traitor;
}
if (%feud_var >= ^feud_recruited) {
    @feud_thug_recruited;
}
