[label,feud_thug_after]
~chatnpc("<p,neutral>Greetings Adventurer, Ali wants to have a word with you.");
~chatplayer("<p,quiz>Really? Which one?");
~chatnpc("<p,neutral>Ali, our Chief of Operations. He should be somewhere nearby the tent.");
~chatplayer("<p,neutral>Thanks.");
return;

[label,feud_thug_recruited]
~chatplayer("<p,neutral>Hi.");
~chatnpc("<p,neutral>Tumeken be praised, you have seen the error of your ways. May Elidinis the river goddess bless your lands.");
~chatplayer("<p,neutral>I was wondering if I could ask you about something.");
~chatnpc("<p,neutral>You're better off asking Ali the Operator. He's the brains behind the whole operation.");
return;

[label,feud_thug_talk]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>What do you want?");
~chatplayer("<p,neutral>I am trying to figure out the feud that exists between you and the Bandits.");
~chatnpc("<p,neutral>Not much to figure out there, the problem is those thieving bandits.");
~chatplayer("<p,neutral>In what way?");
~chatnpc("<p,neutral>They are always stealing, starting fights and causing disruption to the life of the people in this town.");
~chatplayer("<p,neutral>Word has it that the Menaphites are also involved in unsavoury behaviour.");
~chatnpc("<p,neutral>Admittedly, we are far better than them at that sort of thing, but they did start the cycle.");
~chatplayer("<p,neutral>How did 'they' start it?");
~chatnpc("<p,neutral>I cannot remember, as it's been going on for so long.");
~chatplayer("<p,neutral>Go on try.");
~chatnpc("<p,neutral>I think our leader once mentioned that they robbed one of our camels. A heinous crime around here, worthy of a stoning.");
~chatplayer("<p,neutral>So if they offered a camel as a gesture of goodwill would the Menaphites cease hostilities?");
~chatnpc("<p,neutral>Those bandits would never agree to that. They're such bad thieves they couldn't afford to buy even the mangiest excuse of a camel, never mind the desert traversing four legged beauty that we would demand.");
~chatplayer("<p,neutral>But if they did?");
~chatnpc("<p,neutral>Well I suppose so.");
if (%feud_var_talk_gangs = 0) {
    %feud_var_talk_gangs = 1;
} else if (%feud_var_talk_gangs = 2) {
    %feud_var_talk_gangs = 3;
}
if (%feud_var_talk_gangs = 3) {
    if (%feud_var < ^feud_camel_offer) %feud_var = ^feud_camel_offer;
    ~chatplayer("<p,neutral>Maybe if I got both gangs a camel, I could use the mutual goodwill to find out what happened to Ali's nephew.");
}
return;

[label,feud_thug_traitor]
~chatplayer("<p,neutral>I was wondering if you could help me?");
~chatnpc("<p,neutral>Tell me what your problem is and I'll know if I can.");
~chatplayer("<p,neutral>I'm investigating the possibility of a betrayal in the Menaphites, do you know anything about this?");
~chatnpc("<p,neutral>It wasn't me, I honestly swear.");
~chatplayer("<p,neutral>Really? So do you know anything about this?");
~chatnpc("<p,neutral>I just can't believe one of my friends could be a traitor.");
~chatnpc("<p,neutral>Well there is Traitorous Ali.");
~chatplayer("<p,quiz>Who is he then?");
~chatnpc("<p,neutral>Possibly the most untrustworthy backstabbing fiend to ever walk Tumeken's fair desert. He'd sell his mother to slavers if he hadn't already betrayed her and had her locked up for the last job he pulled.");
~chatplayer("<p,neutral>I suppose the name is a bit of a give-away then.");
~chatplayer("<p,neutral>That was a little too simple, are you sure it was him?");
~chatnpc("<p,neutral>Positive, he was turned by the offer of a set of waterproofs and a ride on a camel.");
~chatplayer("<p,neutral>I see he drives a hard bargain.");
~chatnpc("<p,neutral>Well what can I say, he doesn't have that name for being loyal!");
%feud_found_trait = 1;
return;

[label,feud_thug_avenge]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>You treacherous jackal! I should never have trusted you.");
~chatplayer("<p,neutral>What can I say, you live and learn.");
~chatnpc("<p,angry>I will avenge my master!");
npc_setmode(opplayer2);
return;
