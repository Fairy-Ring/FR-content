// Gang inquiries and separate camel hand-ins: VERIFIED period quest guides.
// Wording: CANDIDATE pre-2022 RuneScape transcript 18411641; restored state
// branches and quest-stage notes: CANDIDATE Old School transcript 15325427.
// Pre-quest greeting: CANDIDATE RuneScape NPC transcript histories retained in
// gang-npc-transcripts-history-r1.json (latest revisions dated April 2024).
// Inquiry/receipt bits retain the published server encoding: Menaphites 1,
// Bandits 2. Only the combined value 3 follows the Old School notes literally.

[opnpc1,feud_arabian_guard1_1]
if (%feud_var < ^feud_started) { @feud_gang_before; }
if (%feud_var_drink < 3) { return; }
if (%feud_var >= ^feud_menaphites_defeated) {
    @feud_gang_ordinary;
}
if (%feud_var >= ^feud_recruited) {
    @feud_bandit_recruited;
}
if (%feud_var_comp_gangs = 3) {
    @feud_bandit_after;
}
if (%feud_var_comp_gangs = 2) {
    @feud_bandit_talk;
}
if (inv_total(inv, feud_camel_receipt) >= 1) {
    @feud_bandit_give;
}
@feud_bandit_talk;

