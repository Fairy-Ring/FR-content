[label,feud_bandit_give]
~chatplayer("<p,neutral>Good news, the Menaphites have agreed to give you a camel in order to restore peace.");
mes("You hand the guard a sales receipt for the camel.");
inv_del(inv, feud_camel_receipt, 1);
if (%feud_var_comp_gangs = 0) {
    %feud_var_comp_gangs = 2;
} else {
    %feud_var_comp_gangs = 3;
}
~chatnpc("<p,neutral>What's this? A mere promise of a camel? From a discount camel store? I knew those Menaphites were cowards. Tell them that we have changed our minds and demand 10 full-price camels in return for our mercy.");
~chatplayer("<p,neutral>Oh no... why do I bother?");
~chatplayer("<p,neutral>The camel approach doesn't seem to be working. Perhaps I should be more direct and try to join one of the gangs.");
return;

[label,feud_bandit_after]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>Good day adventurer. Have you come with the Menaphite peace offering?");
~chatplayer("<p,neutral>Umm... no. Not yet. Actually I've come to ask about something else.");
~chatnpc("<p,neutral>We can talk once you bring back the Menaphites' full peace offering.");
return;

[label,feud_bandit_celebrate]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>Welcome! Your actions surprise me.");
~chatplayer("<p,neutral>What do you mean?");
~chatnpc("<p,neutral>It was brilliant the way you got rid of the Menaphite leader.");
~chatplayer("<p,neutral>Er... yes. Thank you.");
~chatnpc("<p,neutral>So will you run the rest of them out of town now?");
~chatplayer("<p,neutral>I don't know.");
return;

[label,feud_bandit_talk]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>What do you want?");
~chatplayer("<p,neutral>I am trying to get to the bottom of this feud between you and the Menaphites.");
~chatnpc("<p,neutral>What's it to you?");
~chatplayer("<p,neutral>I'm just trying to understand why thieves of your repute would stoop to their level.");
~chatnpc("<p,neutral>Well, if memory serves me correctly, I think the hostilities began when they robbed one of our camels. A heinous crime.");
~chatplayer("<p,neutral>So if they offered a camel back as a gesture of goodwill, would you and the rest of the bandits cease your hostilities?");
~chatnpc("<p,neutral>Those Menaphites would never do that. They have no sense of honour.");
~chatplayer("<p,neutral>But if they did?");
~chatnpc("<p,neutral>I suppose so.");
return;

