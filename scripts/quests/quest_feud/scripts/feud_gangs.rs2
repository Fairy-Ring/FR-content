if (%feud_var < 1) { return; }
if (%feud_var_drink < 3) { return; }
if (%feud_var_menaboss >= 1) {
    @feud_thug_avenge;
}
if (%feud_given_jewels >= 1) {
    @feud_thug_traitor;
}
if (%feud_var_comp_gangs = 3) {
    @feud_thug_after;
}
if (%feud_var_comp_gangs = 1) {
    @feud_thug_talk;
}
