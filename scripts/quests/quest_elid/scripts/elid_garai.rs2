[opnpc1,elid_villager3]
~chatplayer("<p,neutral>Hi, I am trying to find the cause of the curse on your town.");
~chatnpc("<p,quiz>What curse is that?");
~chatplayer("<p,neutral>Don't you know? The curse that has stopped your fountain working and made all the water dry up when you bring it back from the river?");
~chatnpc("<p,neutral>Ohh that's because of a curse? I didn't think of that.");
~chatplayer("<p,quiz>So any ideas about the cause of the curse?");
~chatnpc("<p,neutral>Absolutely none.");
return;
