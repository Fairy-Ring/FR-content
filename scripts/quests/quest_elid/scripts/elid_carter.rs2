// Spirits of the Elid — Ali the Carter curse Talk-to + waterskin buy. New file.
// CANDIDATE 2007-base (OSRS Transcript:Spirits of the Elid § Ali the Carter,
// dump §2.1). NPC ali_the_carter 3030 @ 3421,2914 L0 (m53_45 0 29 34,
// display Ali the Carter). Greeting verbatim. The quest option "That's
// extortionate! Why so much?" tree verbatim (cheapest -> curse -> exploiting
// -> true Pollnivneachian spirit). Buy (Ok, I'll buy some!): coins >= 1000 ->
// consume 1000 + water_skin4 1823, mes from Transcript:Ali the Carter
// (quest dump silent on both non-quest options). No coins -> CANDIDATE mes.
// Miss (I think I'll give it a miss.) = dump-silent return CANDIDATE.
// No shop IF. Stay %elidquest 1. No dest. No && / ||.
// Cite osrs-wiki-changes-crawl-377.md elid row · Transcript:Spirits of the
// Elid · Transcript:Ali the Carter.

[opnpc1,ali_the_carter]
~chatnpc("<p,neutral>Water, water get your fresh water here, 1000 coins a waterskin, a bargain in these difficult times.");
def_int $c = ~p_choice3("That's extortionate! Why so much?", 1, "Ok, I'll buy some!", 2, "I think I'll give it a miss.", 3);
if ($c = 1) {
    ~chatplayer("<p,neutral>That's extortionate! Why so much?");
    ~chatnpc("<p,neutral>Well it's the cheapest water you'll find in this town.");
    ~chatplayer("<p,quiz>Would you happen to know anything about the curse?");
    ~chatnpc("<p,neutral>Yes the people round here can't seem to get the water themselves. It's an ideal business opportunity for one such as myself.");
    ~chatplayer("<p,neutral>It does seem to be slightly exploiting their unfortunate situation.");
    ~chatnpc("<p,neutral>I don't see it like that. Without me they'd be in even more of a mess. I'm doing them a favour and in true Pollnivneachian spirit making a profit along the way.");
    return;
}
if ($c = 2) {
    if (inv_total(inv, coins) < 1000) {
        mes("You don't have 1000 coins to buy the water with."); // CANDIDATE 2007-base
        return;
    }
    inv_del(inv, coins, 1000);
    inv_add(inv, water_skin4, 1);
    mes("You buy a full waterskin for 1000 coins!"); // CANDIDATE 2007-base
    return;
}
return; // miss = dump-silent return CANDIDATE (no quest dump lines)
