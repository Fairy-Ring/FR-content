// No water-channel retouch. No dest onto door tiles. No && / ||.
// Cite elid-lake-door-leftover-377.md · elid-dest-from-maps-377.md.

[oploc1,elid_underground_lake_door] @elid_lake_door_open;
[oploc1,elid_underground_lake_door_mirror] @elid_lake_door_open;

[label,elid_lake_door_open]
if (coordz(coord) <= coordz(loc_coord)) {
    p_telejump(0_52_149_26_23); // CANDIDATE north dest-side 3354,9559 L0
    return;
}
p_telejump(0_52_149_26_21); // CANDIDATE south dest-side 3354,9557 L0
