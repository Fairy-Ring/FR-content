// Spirits of the Elid — lake door Open (golem hall <-> lake side).
// 377 locs 10423/10425 and their channel bits are recorded in the subject
// facts. Map-derived north/south destinations remain CANDIDATE.
// UNKNOWN engineering gate: require all three channels before entering the
// north/lake side; keep the return crossing open. No elidquest stage write.
// Research: spirits-of-the-elid.lake-door-product,
// .lake-door-destination, .lake-door-gate-unknown.

[oploc1,elid_underground_lake_door] @elid_lake_door_open;
[oploc1,elid_underground_lake_door_mirror] @elid_lake_door_open;

[label,elid_lake_door_open]
if (coordz(coord) <= coordz(loc_coord)) {
    if (%elid_miningchannel < 1 | %elid_thievingchannel < 1 | %elid_rangingchannel < 1) {
        mes("All three water channels must be flowing before this door will open."); // UNKNOWN functional wording
        return;
    }
    p_telejump(0_52_149_26_23); // CANDIDATE north/lake side 3354,9559
    return;
}
p_telejump(0_52_149_26_21); // CANDIDATE south/hall side 3354,9557
