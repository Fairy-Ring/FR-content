// Spirits of the Elid — Rokuh curse Talk-to + buys + melting Talk-to. New file.
// CANDIDATE 2007-base (OSRS Transcript:Spirits of the Elid § Rokuh, dump
// §2.2; melting tree from Transcript:Rokuh — quest dump marks it quest=no
// silent). NPC elid_choc_ice_seller 3045 @ 3430,2914 L0 (m53_45 0 38 34,
// display Rokuh). Greeting verbatim. The quest option "I am trying to find
// out the cause of this town's curse." tree verbatim. Buy option (Cool I'd
// like to buy some.): choc ice price 50 CANDIDATE 2007-base _unpack/727/all.inv
// [chociceshopnardah] stock1=elid_choc_ice,30,50; already-has-choc-ice ->
// chocolate bar price 20 CANDIDATE same shop stock2=chocolate_bar,25,20
// (greeting leftover chocolate; no chocolate menu line in any dump). No
// coins -> CANDIDATE mes. No thanks = player line verbatim. Melting
// option 3 verbatim (magic ice box). op3=Trade shop IF later (no 377 shop
// IF — 727 only). Stay %elidquest 1. No dest. No && / ||.
// Cite osrs-wiki-changes-crawl-377.md elid row · Transcript:Spirits of the
// Elid · Transcript:Rokuh · _unpack/727/all.inv [chociceshopnardah].

[opnpc1,elid_choc_ice_seller]
~chatnpc("<p,neutral>Come one, come all, buy my amazing choc ice invention here! Chocolate on the outside. Iced cream on the inside. Oh I also have some chocolate left over from making choc ices which I'm selling too.");
def_int $r = ~p_choice4("Cool I'd like to buy some.", 1, "No thanks, I'm not interested.", 2, "How do you stop your icy snacks melting?", 3, "I am trying to find out the cause of this town's curse.", 4);
if ($r = 4) {
    ~chatplayer("<p,neutral>I am trying to find out the cause of this town's curse.");
    ~chatnpc("<p,neutral>I really have no idea. It's most regrettable. Fortunately my innovation with my choc ice invention is helping people stay at least slightly cool.");
    return;
}
if ($r = 1) {
    if (inv_total(inv, elid_choc_ice) >= 1) {
        if (inv_total(inv, coins) < 20) {
            mes("You don't have 20 coins to buy the chocolate with."); // CANDIDATE
            return;
        }
        inv_del(inv, coins, 20);
        inv_add(inv, chocolate_bar, 1);
        mes("You buy a chocolate bar for 20 coins!"); // CANDIDATE 2007-base stock2
        return;
    }
    if (inv_total(inv, coins) < 50) {
        mes("You don't have 50 coins to buy the choc ice with."); // CANDIDATE
        return;
    }
    inv_del(inv, coins, 50);
    inv_add(inv, elid_choc_ice, 1);
    mes("You buy a choc ice for 50 coins!"); // CANDIDATE 2007-base price
    return;
}
if ($r = 3) {
    ~chatplayer("<p,neutral>How do you stop your icy snacks melting? The middle of the desert is the last place I'd expect to see ice.");
    ~chatnpc("<p,neutral>It's quite a surprise, isn't it, my friend. I actually have this special magic box of ice, which I bought for a princely sum, from a strange man while adventuring in lands far away. He said it is imbued with some sort of");
    ~chatnpc("<p,neutral>powerful ice magic which keeps it cold all the time. I had never seen any ice magic before, it's clearly very rare and powerful, so I felt I had to buy it.");
    return;
}
if ($r = 2) {
    ~chatplayer("<p,neutral>No thanks, I'm not interested.");
    return;
}
return; // all options handled; op3 Trade shop IF = LATER
