// Spirits of the Elid — golem doors (white / black / grey).
// 377 cache locs/NPC identities and bits are recorded in the subject facts.
// Combat stats are CANDIDATE Old School data injected into the content unpack,
// not cache stats; retain that existing simple combat config.
// The period guide recommends stab for white, crush for black, slash for grey;
// numeric style modifiers are UNKNOWN and none are added.
// Each unset bit spawns its golem only if one is not nearby. Range 4 is an
// UNKNOWN local guard value copied from the established Restless Ghost pattern.
// UNKNOWN engineering spawn offsets: one tile back from the opener, on the
// opener's side of the closed wall. The period guide gives no precise tiles.
// Packed collision and real melee-hit tests cover all three on both sides.
// After the golem bit is set, each door telejumps both ways using map-derived
// CANDIDATE hall/room destinations. Death credit keeps the Feud p_finduid guard.
// This script writes only the color bit; it never writes elidquest.
// Research: spirits-of-the-elid.golem-door-product,
// .golem-door-destinations, .golem-door-hall-return-destinations.

[oploc1,elid_whitegolem_door]
if (%elid_whitegolem < 1) {
    if (npc_find(loc_coord, elid_golem_white, 4, 0) = false) {
        def_coord $golem_spawn = movecoord(coord, 0, 0, 1);
        if (coordz(coord) <= coordz(loc_coord)) {
            $golem_spawn = movecoord(coord, 0, 0, -1);
        }
        npc_add($golem_spawn, elid_golem_white, 500); // UNKNOWN duration; retained from existing handler
        npc_setmode(opplayer2);
    }
    return;
}
if (coordz(coord) <= coordz(loc_coord)) {
    p_telejump(0_52_149_37_7); // CANDIDATE hall side 3365,9543
    return;
}
p_telejump(0_52_149_37_5); // CANDIDATE room side 3365,9541

[oploc1,elid_blackgolem_door]
if (%elid_blackgolem < 1) {
    if (npc_find(loc_coord, elid_golem_black, 4, 0) = false) {
        def_coord $golem_spawn = movecoord(coord, -1, 0, 0);
        if (coordx(coord) >= coordx(loc_coord)) {
            $golem_spawn = movecoord(coord, 1, 0, 0);
        }
        npc_add($golem_spawn, elid_golem_black, 500); // UNKNOWN duration; retained from existing handler
        npc_setmode(opplayer2);
    }
    return;
}
if (coordx(coord) < coordx(loc_coord)) {
    p_telejump(0_52_149_45_20); // CANDIDATE room side 3373,9556
    return;
}
p_telejump(0_52_149_43_20); // CANDIDATE hall side 3371,9556

[oploc1,elid_greygolem_door]
if (%elid_greygolem < 1) {
    if (npc_find(loc_coord, elid_golem_grey, 4, 0) = false) {
        def_coord $golem_spawn = movecoord(coord, -1, 0, 0);
        if (coordx(coord) >= coordx(loc_coord)) {
            $golem_spawn = movecoord(coord, 1, 0, 0);
        }
        npc_add($golem_spawn, elid_golem_grey, 500); // UNKNOWN duration; retained from existing handler
        npc_setmode(opplayer2);
    }
    return;
}
if (coordx(coord) < coordx(loc_coord)) {
    p_telejump(0_52_149_47_11); // CANDIDATE room side 3375,9547
    return;
}
p_telejump(0_52_149_45_11); // CANDIDATE hall side 3373,9547

[ai_queue3,elid_golem_white]
gosub(npc_death);
if (p_finduid(%npc_aggressive_player) = true) {
    %elid_whitegolem = 1;
}
return;

[ai_queue3,elid_golem_black]
gosub(npc_death);
if (p_finduid(%npc_aggressive_player) = true) {
    %elid_blackgolem = 1;
}
return;

[ai_queue3,elid_golem_grey]
gosub(npc_death);
if (p_finduid(%npc_aggressive_player) = true) {
    %elid_greygolem = 1;
}
return;
