[opheldu,elid_shoes]
if (last_useitem ! knife) {
    ~displaymessage(^dm_default);
    return;
}
~mesbox("You remove the soles from the shoes."); // CANDIDATE dump tbox
inv_del(inv, elid_shoes, 1);
inv_add(inv, elid_sole, 1);
