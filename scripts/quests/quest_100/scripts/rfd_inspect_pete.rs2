// VERIFIED Inspect-first route and 31 Cooking: RuneHQ capture 15 April 2006.
// UNKNOWN plain functional wording and engineering stages.
[oploc1,hundred_pirate_base]
if (%hundred_main_quest_var < ^rfd_frozen) return;
if (%100_pirate_quest_var = ^rfd_guest_complete) return;
if (stat(cooking) < ^rfd_pete_cooking) {
    mes("You need a Cooking level of 31 to help Pirate Pete.");
    return;
}
if (%100_pirate_quest_var = 0) %100_pirate_quest_var = ^rfd_pete_inspected;
~mesbox("Pirate Pete needs a fishcake. Ask the cook how to make one.");

[oplocu,hundred_pirate_base]
if (last_useitem ! hundred_pirate_fishcake | %hundred_main_quest_var < ^rfd_frozen) return;
if (%100_pirate_quest_var < ^rfd_pete_pen_access | %100_pirate_quest_var = ^rfd_guest_complete) return;
if (stat(cooking) < ^rfd_pete_cooking) return;
inv_del(inv, hundred_pirate_fishcake, 1);
%100_pirate_quest_var = ^rfd_guest_complete;
~rfd_guest_reward(3);
