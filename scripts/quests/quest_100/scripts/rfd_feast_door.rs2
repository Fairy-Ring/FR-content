// VERIFIED north-door feast route; UNKNOWN map-derived destinations and functional wording.
[oploc1,hundred_lumbridge_door] @rfd_feast_door;
[aploc1,hundred_lumbridge_door]
// UNKNOWN engineering approach: the original wall door faces away from the banquet.
if (distance(coord, loc_coord) > 1) {
    p_aprange(1);
    return;
}
@rfd_feast_door;

[label,rfd_feast_door]
if (%hundred_main_quest_var < ^rfd_feast_ready) {
    mes("The cook has not invited you to the feast.");
    return;
}
if (coordx(coord) < 2000) {
    p_telejump(^rfd_kitchen_landing);
    return;
}
if (%hundred_main_quest_var = ^rfd_feast_ready) {
    %100dwarfvisible = 1;
    %100goblinsvisible = 1;
    %100piratevisible = 1;
    %100guidevisible = 1;
    %100davevisible = 1;
    %100ogrevisible = 1;
    %100amikvisible = 1;
    %100monkeyvisible = 1;
    %100culinaromancervisible = 1;
    %hundred_main_quest_var = ^rfd_frozen;
    // Settle the safe room and its exit before either cancellable message pause.
    ~rfd_prepare_banquet;
    p_telejump(^rfd_banquet_landing);
    ~mesbox("The guests gather for the cook's banquet.");
    ~mesbox("The Culinaromancer attacks. The gypsy stops time to protect the guests.");
    return;
}
~rfd_prepare_banquet;
p_telejump(^rfd_banquet_landing);

[oploc1,hundred_portal_door1]
if (%hundred_main_quest_var >= ^rfd_frozen) p_telejump(^rfd_kitchen_landing);

[oploc1,hundred_portal_door2]
if (%hundred_main_quest_var >= ^rfd_frozen) p_telejump(^rfd_kitchen_landing);

[oploc1,hundred_portal_door3]
if (%hundred_main_quest_var >= ^rfd_frozen) p_telejump(^rfd_kitchen_landing);
