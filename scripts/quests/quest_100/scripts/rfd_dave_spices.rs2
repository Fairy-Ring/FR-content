// Fixed named cache objects: no generated pack IDs or object arithmetic.
[opheldu,hundred_dave_spice_red_4]
if (last_useitem = stew | last_useitem = hundred_dave_stew) { @rfd_dave_mix(last_item, last_useitem); return; }
~displaymessage(^dm_default);

