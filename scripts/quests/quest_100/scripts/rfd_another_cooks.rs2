// Recipe for Disaster — Another Cook's start. CANDIDATE last-resort 2007-base
// (OSRS Transcript:Another Cook's Quest minus overlay / RS3 Overview).
// Hunt 289? no. Called from cook.rs2 after Cook's Assistant complete.
// Accept: %hundred_main_quest_var 0→1 + 100 coins. No leftover 18436. No feast.

[label,rfd_another_cooks_start]
~chatplayer("<p,quiz>Do you have any other quests for me? That last one of yours was so much fun, I was hoping you would!");
~chatnpc("<p,sad>Ooooh dear, I might have, but it's all very embarrassing...");
~chatplayer("<p,quiz>Embarrassing? How do you mean?");
~chatnpc("<p,confused>Weeellll... You know I told you that it was the Duke's birthday?");
~chatplayer("<p,neutral>Yup, that's why I had to go and collect you things to make a cake with wasn't it?");
~chatnpc("<p,sad>Yeeeesssss... Weeeelllll...");
~chatnpc("<p,shock>It isn't. I don't even know when his birthday is!");
def_int $feel = ~p_choice2("Angry! It makes me angry!", 1, "I don't really care to be honest.", 2);
if ($feel = 1) {
    ~chatplayer("<p,angry>GRRRR! Why did you have me running around finding ingredients for you then?!?!");
} else {
    ~chatplayer("<p,neutral>So you lied to me to get me to do you a favour?");
    ~chatplayer("<p,neutral>Fair enough, you're not the first, but why lie? You could have just asked me, I'd have been happy to help.");
}
~chatnpc("<p,sad>I needed to test you and see if I could trust you...");
~chatnpc("<p,sad>I am in a terrible pickle, and I desperately need somebody trustworthy to help me out!");
def_int $help = ~p_choice3("What seems to be the problem?", 1, "No thanks, I don't want to help.", 2, "How do you still have a job?", 3);
if ($help = 2) {
    ~chatplayer("<p,neutral>You know... Thinking about it...");
    ~chatplayer("<p,neutral>I just can't be bothered to help you out. You'll have to find some other adventurer to do your little quest for you.");
    ~chatnpc("<p,sad>I guess I don't have anything more to say to you then.");
    ~chatplayer("<p,neutral>I guess you don't.");
    return;
} else if ($help = 3) {
    ~chatplayer("<p,quiz>I'm curious... How exactly do you still have a job?");
    ~chatnpc("<p,confused>I'm sorry? How do you mean?");
    ~chatplayer("<p,neutral>It's just surprising that you would still have employment as head cook of Lumbridge castle, given how obviously bad at your job you are.");
    ~chatnpc("<p,shock>WHAT?");
    ~chatplayer("<p,neutral>Well, things you would expect every kitchen to have... Eggs, milk, flour... You know... But you don't.");
    ~chatplayer("<p,angry>And what is worse, you don't even go off and get them yourself, you expect people like me to run around after you!");
    ~chatnpc("<p,sad>I know I'm such a failure... I bring shame to my honourable ancestor, and now I need help again...");
    ~chatplayer("<p,quiz>Help again?");
    ~chatplayer("<p,quiz>You need help AGAIN? Well, what seems to be the problem?");
} else {
    ~chatplayer("<p,quiz>You need help AGAIN? Well, what seems to be the problem?");
}
@rfd_another_cooks_pitch;

[label,rfd_another_cooks_pitch]
~chatnpc("<p,neutral>Well, you're obviously trustworthy, I guess I could tell you...");
~chatplayer("<p,happy>Please do. The suffering of others always seems to turn out very profitable for me.");
~chatnpc("<p,sad>Well... It's like this...");
~chatnpc("<p,quiz>Did you ever hear of Franizzard Van Lumbcook?");
~chatplayer("<p,confused>Erm... Can't say I have.");
~chatplayer("<p,neutral>And with a name like that, I'm sure I would remember.");
~chatnpc("<p,happy>Well, he was a great chef, and also my ancestor.");
~chatnpc("<p,neutral>One hundred years ago there was a very important meeting held here in Lumbridge Castle, and he cooked a banquet for the meeting, which was so stupendously amazing that he was offered a job for life, along with all of his descendants.");
~chatplayer("<p,neutral>So you have your job because a hundred years ago your ancestor was a very good cook.");
~chatplayer("<p,quiz>I don't see how that's much of a problem for you...");
~chatplayer("<p,happy>In fact I would say you are a VERY LUCKY man indeed. Frankly, I'd have fired you by now if you worked for me.");
~chatnpc("<p,sad>Oooooh no.... You don't understand...");
~chatnpc("<p,shock>This big important secret meeting that Franizzard cooked for is held here in Lumbridge castle every 10 years, and tonight will be the tenth anniversary of it!");
~chatplayer("<p,quiz>Still not seeing the problem...");
~chatnpc("<p,sad>Well, I have always felt like a failure as a cook, and that my job here is down to the skills of my ancestor.");
~chatnpc("<p,happy>I want to prove to the world that I am a great cook too!");
~chatnpc("<p,sad>But to do that... (sigh) No, it just won't work...");
~chatplayer("<p,angry>What won't? Come on man, pull yourself together and speak to me!");
~chatnpc("<p,sad>(sniff) Weeeeelll... I thought that I would recreate the meal Franizzard cooked all of those years ago, the one that impressed everybody so much... There's just this small problem though...");
~chatplayer("<p,quiz>Let me take a wild guess: You have the recipe but you don't have any of the ingredients, and OBVIOUSLY you can't just go and get them yourself?");
~chatnpc("<p,shock>Yes! However did you know?");
~chatplayer("<p,neutral>Call it a hunch.");
~chatplayer("<p,quiz>Okay, tell me what you're after and then I'll decide if I want to help you or not.");
~chatnpc("<p,neutral>Well, they are common enough ingredients, although I must admit the recipe I am following is very strange indeed...");
~chatnpc("<p,happy>I will pay you upfront for any expenses you may incur while obtaining them, and of course you may keep the change for being so helpful to me.");
~chatnpc("<p,sad>Please can you help me? The feast is scheduled to start very soon, and I simply cannot leave!");
def_int $yes = ~p_choice2("Yes", 1, "No", 2);
if ($yes = 2) {
    ~chatplayer("<p,neutral>To be honest... I just can't be bothered.");
    ~chatplayer("<p,sad>Sorry about that.");
    ~chatnpc("<p,sad>Oh nooooo... What am I going to do now?");
    ~chatplayer("<p,neutral>Dunno. Maybe I'll change my mind and come back later and help you.");
    ~chatnpc("<p,sad>Oooohhh... I really hope you do...");
    return;
}
~chatplayer("<p,happy>I would love to help you! What do I have to do?");
~chatnpc("<p,neutral>Well, I have an incredibly important banquet that I have to prepare for, and I am using an ancient cookbook to recreate the meal my famous ancestor made a hundred years ago.");
~chatnpc("<p,sad>Most of the ingredients I was able to obtain fairly easily, but there were some... oddities... that I have been unable to lay my hands on.");
~chatplayer("<p,quiz>Like what?");
~chatnpc("<p,neutral>I need the following ingredients as soon as possible!");
~chatnpc("<p,neutral>One Eye Of Newt|A freshly made 'Dirty Blast'|A rotten tomato|And a glass of greenman's ale.");
~chatnpc("<p,happy>I have given you 100 coins to cover any expenses you may incur, feel free to keep the change.");
~chatplayer("<p,happy>I'll go look for those for you then!");
inv_add(inv, coins, 100);
%hundred_main_quest_var = 1;
return;

[label,rfd_another_cooks_pointer]
if (%hundred_main_quest_var >= 2) {
    @rfd_another_cooks_feast_nag;
}
// CANDIDATE Déjà vu. Keep the first two shipped lines.
~chatplayer("<p,quiz>About those ingredients you wanted for the banquet...");
~chatnpc("<p,quiz>Did you bring them? Remember, I need an eye of newt, a glass of greenman's ale, a rotten tomato, and a 'Dirty Blast'!");
def_int $newt = 0;
def_int $ale = 0;
def_int $tom = 0;
def_int $blast = 0;
if (inv_total(inv, eye_of_newt) > 0) {
    $newt = 1;
}
if (inv_total(inv, greenmans_ale) > 0) {
    $ale = 1;
}
if (inv_total(inv, rotten_tomato) > 0) {
    $tom = 1;
}
if (inv_total(inv, hundred_fruit_blast) > 0) {
    $blast = 1;
}
def_int $have = calc($newt + $ale + $tom + $blast);
if ($have = 4) {
    @rfd_another_cooks_handin;
}
if ($have = 0) {
    ~chatplayer("<p,sad>Erm... Sorry, I don't have any of that with me...");
    ~chatnpc("<p,angry>Well come back when you have all of them! And hurry! It is a VERY important meeting!");
    @rfd_another_cooks_where;
}
if ($have = 3) {
    @rfd_another_cooks_missing_one;
}
~chatplayer("<p,sad>Weeelll... I have some of that stuff with me, but not all of it...");
~chatnpc("<p,neutral>Come back and see me when you've got everything I need!");
@rfd_another_cooks_where;

[label,rfd_another_cooks_missing_one]
if (inv_total(inv, eye_of_newt) < 1) {
    ~chatplayer("<p,neutral>I've got a 'Dirty Blast', a Greenman's ale and a rotten tomato, I just need to get the eye of newt!");
} else if (inv_total(inv, rotten_tomato) < 1) {
    ~chatplayer("<p,neutral>I've got the 'Dirty Blast', a Greenman's ale and the eye of newt, I just have to find myself a rotten tomato...");
} else if (inv_total(inv, greenmans_ale) < 1) {
    ~chatplayer("<p,neutral>I managed to find a 'Dirty Blast', a rotten tomato and an eye of newt, but I didn't manage to get a hold of a Greenman's ale yet...");
} else {
    ~chatplayer("<p,neutral>I've got you a Greenman's ale, the rotten tomato and the eye of newt, but haven't had any luck on the 'Dirty Blast' yet...");
}
~chatnpc("<p,neutral>Come back and see me when you've got everything I need!");
@rfd_another_cooks_where;

[label,rfd_another_cooks_where]
def_int $ask = ~p_choice5("Okay then.", 1, "Where do I get an eye of newt?", 2, "Where do I get a rotten tomato?", 3, "Where do I get a greenman's ale?", 4, "Where do I get a 'Dirty Blast'?", 5);
if ($ask = 1) {
    ~chatplayer("<p,neutral>Okay then. I'll get on it.");
    return;
}
if ($ask = 2) {
    @rfd_another_cooks_where_newt;
}
if ($ask = 3) {
    @rfd_another_cooks_where_tomato;
}
if ($ask = 4) {
    @rfd_another_cooks_where_ale;
}
@rfd_another_cooks_where_blast;

[label,rfd_another_cooks_where_newt]
~chatplayer("<p,quiz>Where would I find an eye of newt?");
~chatnpc("<p,quiz>I don't know. A newt's face?");
~chatplayer("<p,neutral>Thank you so much for that help.");
~chatnpc("<p,neutral>Ah, I don't know where they get them, they usually have them at herblore and magic shops.");
@rfd_another_cooks_where;

[label,rfd_another_cooks_where_tomato]
~chatplayer("<p,quiz>Where would I find a rotten tomato?");
~chatnpc("<p,neutral>I'm not entirely sure, but I hear they're sold for public spectacles.");
~chatplayer("<p,quiz>Public spectacles?");
~chatnpc("<p,neutral>Yeah. Pre-arranged combats, caught thieves on show, that sort of thing.");
@rfd_another_cooks_where;

[label,rfd_another_cooks_where_ale]
~chatplayer("<p,quiz>Where would I find a greenman's ale?");
~chatnpc("<p,neutral>Well, as the official sponsored drink of Castle Wars it might be worth looking around there.");
@rfd_another_cooks_where;

[label,rfd_another_cooks_where_blast]
~chatnpc("<p,quiz>Do you know how to make a Fruit Blast?");
def_int $know = ~p_choice2("Yes", 1, "No", 2);
if ($know = 1) {
    ~chatplayer("<p,quiz>A Fruit Blast? Sure, like they sell at Blurberry's Bar, right?");
    ~chatnpc("<p,neutral>Ah, so you've heard of it then? But for this recipe I'd need a fresh one; you can't just buy me one from a shop or from your friends.");
    ~chatnpc("<p,neutral>Well, a 'Dirty Blast' is a freshly made Fruit Blast, but then for some reason you add ash at the end!");
    ~chatplayer("<p,quiz>Freshly made? Why did you specify that?");
    ~chatnpc("<p,neutral>Apparently the ash reacts with the freshly squeezed juice in the glass. It means you can't just buy one Blurberry made earlier, you'll have to make it yourself.");
    ~chatplayer("<p,neutral>Oh. Well, it shouldn't take that long.");
    ~chatnpc("<p,happy>That's the spirit!");
    @rfd_another_cooks_where;
}
~chatplayer("<p,confused>A Fruit Blast? Can't say I've ever heard of it...");
~chatnpc("<p,neutral>Ah, well, they're a popular Gnomic delicacy served at the Blurberry bar. But for this recipe I'd need a fresh one; you can't just buy me one from a shop or from your friends.");
~chatnpc("<p,neutral>Basically, what you do is juice a pineapple, an orange and a lemon, then put them all into a cocktail shaker.");
~chatnpc("<p,neutral>Pour that into a glass, then top with a slice of lemon.");
~chatplayer("<p,quiz>Okaaaay... So what's a 'Dirty Blast'?");
~chatnpc("<p,neutral>Well, apparently after you have done the above then by adding ashes you create a unique new drink.");
~chatplayer("<p,sad>Sounds horrible..");
~chatnpc("<p,neutral>I agree, but it's what the recipe specifically needs.");
~chatnpc("<p,neutral>Bear in mind it will only work with very fresh ingredients, so you will have to make your own cocktail, not rely on one of the pre made ones Blurberry sells.");
@rfd_another_cooks_where;

[label,rfd_another_cooks_handin]
~chatplayer("<p,happy>You will be happy to know... I have all of that with me!");
inv_del(inv, eye_of_newt, 1);
inv_del(inv, greenmans_ale, 1);
inv_del(inv, rotten_tomato, 1);
inv_del(inv, hundred_fruit_blast, 1);
%hundred_main_quest_var = 2;
~chatnpc("<p,happy>You absolutely MUST go through into the dining room just there and see the feast I have prepared.");
~chatnpc("<p,shock>I simply won't take no for an answer!");
return;

[label,rfd_another_cooks_feast_nag]
~chatplayer("<p,quiz>How's that banquet going?");
~chatnpc("<p,angry>Why haven't you gone and looked at the feast I have prepared yet? Trust me, it will be a sight the likes of which you will never see again!");
~chatplayer("<p,sad>I don't know... I'm just... quite busy, I guess...");
~chatnpc("<p,angry>No, honestly, you MUST go in there!");
~chatnpc("<p,shock>GO IN THERE!");
return;

// Ashes on a fresh fruit blast only after Another Cook's start. Not premade.
[opheldu,ashes]
if (last_useitem = fruit_blast & %hundred_main_quest_var >= 1) {
    @rfd_make_dirty_blast;
}
~displaymessage(^dm_default);

[opheldu,fruit_blast]
if (last_useitem = ashes & %hundred_main_quest_var >= 1) {
    @rfd_make_dirty_blast;
}
~displaymessage(^dm_default);

[label,rfd_make_dirty_blast]
~chatplayer("<p,confused>That looks disgusting, but it's what the cook asked for...");
inv_del(inv, ashes, 1);
inv_del(inv, fruit_blast, 1);
inv_add(inv, hundred_fruit_blast, 1);
return;

[opheld1,hundred_fruit_blast]
~chatplayer("<p,shock>No thanks, that looks DISGUSTING! I won't drink that!");
return;
