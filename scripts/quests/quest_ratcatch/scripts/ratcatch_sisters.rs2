[label,ratcatch_sisters_refuse]
~chatnpc_specific("Grimesquit", vc_grimesquit, "<p,quiz>What's you want?");
~chatnpc_specific("Phingspet", vc_phingspet, "<p,quiz>Ya what's zey want?");
~chatnpc_specific("Grimesquit", vc_grimesquit, "<p,confused>I don't know it's why I is asking 'em.");
