// CANDIDATE pre-2024 refusal: Transcript:Grimesquit 12562212 / Phingspet 12562214.
// VERIFIED eight rats, pole and Jimmy handoff: Tip.It q127, 27 April 2006, lines181-185.
// Other messages are UNKNOWN functional wording, not reconstructed dialogue.

[opnpc1,vc_phingspet]
@ratcatch_sisters;

[opnpc1,vc_grimesquit]
@ratcatch_sisters;

[label,ratcatch_sisters]
if (%ratcatch_var = 0) @ratcatch_sisters_refuse;
if (%ratcatch_var = 1) {
    if (~ratcatch_require_cat = false) return;
    %ratcatch_ometer = 0;
    ~ratcatch_stage(2);
}
if (%ratcatch_var = 2) {
    if (%ratcatch_ometer < 8) {
        mes("Your cat must catch eight rats in these sewers.");
        return;
    }
    if (inv_freespace(inv) = 0) {
        mes("Make room for a rat pole.");
        return;
    }
    ~ratcatch_stage(3);
}
~ratcatch_recover_pole;
mes("Speak to Jimmy Dazzler in East Ardougne.");
return;

[label,ratcatch_sisters_refuse]
~chatnpc_specific("Grimesquit", vc_grimesquit, "<p,quiz>What's you want?");
~chatnpc_specific("Phingspet", vc_phingspet, "<p,quiz>Ya what's zey want?");
~chatnpc_specific("Grimesquit", vc_grimesquit, "<p,confused>I don't know it's why I is asking 'em.");
~chatnpc_specific("Phingspet", vc_phingspet, "<p,neutral>Why do we care what zey wants let's get back to rat splattin'.");
~chatnpc_specific("Grimesquit", vc_grimesquit, "<p,happy>Ya good plan.");
~chatplayer("<p,confused>Em... Ahemm.. Excuse me?");
return;
