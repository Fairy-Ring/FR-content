// VERIFIED: Jimmy's mansion rats, guards, directions and cat requirement.
// Tip.It q127, 27 April 2006, lines 173-185. Intermediate stages and the guard route are UNKNOWN.

[opnpc1,vc_jimmy_dazzler]
if (%ratcatch_var = ^ratcatch_mansion_stage_start) {
    if (~ratcatch_require_cat = false) return;
    if (inv_total(inv, ratcatchers_party_directions) = 0 & inv_freespace(inv) = 0) {
        mes("Make room for Jimmy's directions."); // UNKNOWN functional message.
        return;
    }
    if (inv_total(inv, ratcatchers_party_directions) = 0) {
        inv_add(inv, ratcatchers_party_directions, 1);
    }
    ~ratcatch_stage(^ratcatch_mansion_stage_active);
    ~ratcatch_mansion_recover_pole;
    mes("Jimmy gives you directions to the mansion."); // UNKNOWN presentation; no period wording is claimed.
    return;
}
if (%ratcatch_var = ^ratcatch_mansion_stage_active) {
    ~ratcatch_mansion_recover_directions;
    ~ratcatch_mansion_recover_pole;
    return;
}
if (%ratcatch_var = ^ratcatch_mansion_stage_complete) {
    if (~ratcatch_mansion_count < 6) return;
    ~ratcatch_mansion_recover_directions;
    ~ratcatch_mansion_recover_pole;
    ~ratcatch_stage(^ratcatch_mansion_stage_next);
    return;
}
if (%ratcatch_var > ^ratcatch_mansion_stage_start) ~ratcatch_recover_pole;

[opheld1,ratcatchers_party_directions]
if (%ratcatch_var < ^ratcatch_mansion_stage_active | %ratcatch_var > ^ratcatch_mansion_stage_complete) return;
// UNKNOWN functional route text; the map and loc interactions below implement this route.
mes("Enter by the ladder beside Jimmy's house, avoid the guards' sight, and use the trellises to change floors.");
mes("The west mansion door returns to Jimmy.");

[oploc1,vc_ladder_down]
if (loc_coord ! ^ratcatch_mansion_town_ladder | %ratcatch_var ! ^ratcatch_mansion_stage_active) return;
if (inv_total(inv, ratcatchers_party_directions) = 0) {
    mes("Ask Jimmy for his directions."); // UNKNOWN functional message.
    return;
}
if (~ratcatch_require_cat = false) return;
p_telejump(^ratcatch_mansion_entry);
~ratcatch_mansion_watch_start;

[oploc1,vc_trellis_base]
if (~ratcatch_mansion_in_area(loc_coord) = false | coordy(loc_coord) ! 0) return;
if (%ratcatch_var < ^ratcatch_mansion_stage_active | %ratcatch_var > ^ratcatch_mansion_stage_complete) return;
p_telejump(movecoord(loc_coord, 0, 1, -1));

[oploc1,vc_blank_trellis_top_trigger]
if (~ratcatch_mansion_in_area(loc_coord) = false | coordy(loc_coord) ! 1) return;
if (%ratcatch_var < ^ratcatch_mansion_stage_active | %ratcatch_var > ^ratcatch_mansion_stage_complete) return;
p_telejump(movecoord(loc_coord, 0, -1, 1));

[oploc1,vc_elfdoor]
if (~ratcatch_mansion_in_area(loc_coord) = false) return;
if ((%ratcatch_var = ^ratcatch_mansion_stage_active | %ratcatch_var = ^ratcatch_mansion_stage_complete) & loc_coord = ^ratcatch_mansion_exit_door) {
    ~ratcatch_mansion_watch_stop;
    ~open_and_close_door(vc_elfdooropen, ~check_axis(coord, loc_coord, loc_angle), false);
    p_telejump(^ratcatch_mansion_town_exit);
    return;
}
~open_and_close_door(vc_elfdooropen, ~check_axis(coord, loc_coord, loc_angle), false);

[oploc1,vc_elfdooropen]
if (~ratcatch_mansion_in_area(loc_coord) = false) return;
// The generated open loc expires after the ordinary door animation window.
loc_change(inviswall, 3);

[proc,ratcatch_mansion_recover_directions]()(boolean)
if (%ratcatch_var < ^ratcatch_mansion_stage_active | %ratcatch_var > ^ratcatch_mansion_stage_complete) return(false);
if (inv_total(inv, ratcatchers_party_directions) > 0) return(true);
if (inv_freespace(inv) = 0) {
    mes("Make room for Jimmy's directions."); // UNKNOWN functional capacity message.
    return(false);
}
inv_add(inv, ratcatchers_party_directions, 1);
return(true);

[proc,ratcatch_mansion_recover_pole]
~ratcatch_recover_pole;
~ratcatch_mansion_fill_pole;

[proc,ratcatch_mansion_has_carried_pole]()(boolean)
if (calc(~ratcatch_poles(inv) + ~ratcatch_poles(worn)) > 0) return(true);
return(false);

[proc,ratcatch_mansion_fill_pole]
def_int $caught = ~ratcatch_mansion_count;
def_namedobj $filled = vc_rat_pole;
switch_int($caught) {
    case 1 : $filled = vc_rat_pole_1;
    case 2 : $filled = vc_rat_pole_2;
    case 3 : $filled = vc_rat_pole_3;
    case 4 : $filled = vc_rat_pole_4;
    case 5 : $filled = vc_rat_pole_5;
    case 6 : $filled = vc_rat_pole_6;
}
~ratcatch_mansion_fill_container(inv, $filled);
~ratcatch_mansion_fill_container(worn, $filled);
~ratcatch_mansion_fill_container(bank, $filled);

[proc,ratcatch_mansion_fill_container](inv $container, namedobj $filled)
~ratcatch_mansion_replace_pole($container, vc_rat_pole, $filled);
~ratcatch_mansion_replace_pole($container, vc_rat_pole_1, $filled);
~ratcatch_mansion_replace_pole($container, vc_rat_pole_2, $filled);
~ratcatch_mansion_replace_pole($container, vc_rat_pole_3, $filled);
~ratcatch_mansion_replace_pole($container, vc_rat_pole_4, $filled);
~ratcatch_mansion_replace_pole($container, vc_rat_pole_5, $filled);
~ratcatch_mansion_replace_pole($container, vc_rat_pole_6, $filled);

[proc,ratcatch_mansion_replace_pole](inv $container, namedobj $old, namedobj $filled)
if ($old = $filled) return;
def_int $remaining = inv_total($container, $old);
def_int $slot;
while ($remaining > 0) {
    $slot = ~inv_getslot($container, $old);
    if ($slot = null) return;
    inv_setslot($container, $slot, $filled, 1);
    $remaining = sub($remaining, 1);
}
if ($container = worn) buildappearance(worn);

[proc,ratcatch_mansion_count]()(int)
def_int $caught = 0;
if (%vc_raton_off1 = 1) $caught = add($caught, 1);
if (%vc_raton_off2 = 1) $caught = add($caught, 1);
if (%vc_raton_off3 = 1) $caught = add($caught, 1);
if (%vc_raton_off4 = 1) $caught = add($caught, 1);
if (%vc_raton_off5 = 1) $caught = add($caught, 1);
if (%vc_raton_off6 = 1) $caught = add($caught, 1);
return($caught);

[proc,ratcatch_mansion_rat_done](int $rat)(boolean)
switch_int($rat) {
    case 1 : if (%vc_raton_off1 = 1) return(true);
    case 2 : if (%vc_raton_off2 = 1) return(true);
    case 3 : if (%vc_raton_off3 = 1) return(true);
    case 4 : if (%vc_raton_off4 = 1) return(true);
    case 5 : if (%vc_raton_off5 = 1) return(true);
    case 6 : if (%vc_raton_off6 = 1) return(true);
}
return(false);

[proc,ratcatch_mansion_mark_rat](int $rat)
switch_int($rat) {
    case 1 : %vc_raton_off1 = 1;
    case 2 : %vc_raton_off2 = 1;
    case 3 : %vc_raton_off3 = 1;
    case 4 : %vc_raton_off4 = 1;
    case 5 : %vc_raton_off5 = 1;
    case 6 : %vc_raton_off6 = 1;
}

[proc,ratcatch_mansion_chase]()(boolean)
if (%ratcatch_var ! ^ratcatch_mansion_stage_active | ~ratcatch_mansion_in_area(coord) = false) return(false);
if (~ratcatch_mansion_has_carried_pole = false) {
    ~ratcatch_mansion_recover_pole;
    if (~ratcatch_mansion_has_carried_pole = false) {
        mes("Bring your rat pole to catch the mansion rats."); // UNKNOWN functional requirement message.
        return(true);
    }
}

// CANDIDATE: preserve the existing pet chase's ten-tile target search radius.
def_npc_uid $cat = npc_uid;
.npc_findallany(coord, 10, 0);
while (.npc_findnext = true) {
    if (.npc_type = vc_party_rat & lineofwalk(coord, .npc_coord) = true) {
        // npc_param's compiler intrinsic uses the primary pointer; restore the cat before pouncing.
        npc_finduid(.npc_uid);
        def_int $rat = npc_param(ratcatch_mansion_rat_index);
        npc_finduid($cat);
        if ($rat > 0 & ~ratcatch_mansion_rat_done($rat) = false) {
            ~ratcatch_mansion_pounce($rat);
            return(true);
        }
    }
}
mes("There aren't any rats or mice around.");
return(true);

[proc,ratcatch_mansion_pounce](int $rat)
// CANDIDATE: preserve the existing pet.rs2 draw order, chances and pounce delays exactly.
def_int $chance = random(2);
def_int $vermin = getbit_range(%cat_growth, 20, 26);
say("Go on kitty...kill that rat!");
p_delay(0);
npc_say("Meeeeeoooowww!");
p_delay(0);
.npc_say("Eek!");
sound_synth(rat_hit, 1, 0);
if (lineofwalk(coord, .npc_coord) = false) {
    mes("Your cat cannot get to its prey.");
    return;
}
npc_setmode(none);
npc_walk(.npc_coord);
p_delay(1);
npc_anim(cat_pounce, 0);
p_delay(1);
npc_setmode(playerfollow);
if (oc_category(nc_param(npc_type, pet_item_id)) = kitten) $chance = random(10);
if ($chance ! 0) {
    mes("The rat manages to get away!");
    return;
}
if (%ratcatch_var ! ^ratcatch_mansion_stage_active | ~ratcatch_mansion_in_area(coord) = false | ~ratcatch_mansion_rat_done($rat) = true) return;
~ratcatch_mansion_mark_rat($rat);
~ratcatch_mansion_fill_pole;
.npc_say("Eek!");
npc_say("MeeeoooooW!");
say("Hey well done kitty, you got it!");
%cat_growth = setbit_range_toint(%cat_growth, min(100, max(calc($vermin + 1), -1)), 20, 26);
if (~ratcatch_mansion_count = 6) {
    ~ratcatch_stage(^ratcatch_mansion_stage_complete);
    ~ratcatch_mansion_watch_stop;
}

[proc,ratcatch_mansion_in_area](coord $at)(boolean)
return(inzone(^ratcatch_mansion_min, ^ratcatch_mansion_max, $at));

[proc,ratcatch_mansion_watch_start]
settimer(ratcatch_mansion_guard_watch, ^ratcatch_mansion_guard_poll);
walktrigger(ratcatch_mansion_guard_watch);

[proc,ratcatch_mansion_watch_stop]
cleartimer(ratcatch_mansion_guard_watch);
walktrigger(null);

// UNKNOWN engineering patrol: one-tile north/south steps on the four-cycle guard timer.
[ai_spawn,ratcatcher_staticguard] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_chiefguard] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_left_front] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_left_mid] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_left_back] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_left_fullback] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_right_front] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_right_mid] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_right_back] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_right_fullback] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_left_inside] @ratcatch_mansion_guard_spawn;
[ai_spawn,ratcatcher_guard_right_inside] @ratcatch_mansion_guard_spawn;

[ai_timer,ratcatcher_staticguard] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_chiefguard] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_left_front] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_left_mid] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_left_back] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_left_fullback] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_right_front] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_right_mid] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_right_back] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_right_fullback] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_left_inside] @ratcatch_mansion_guard_patrol;
[ai_timer,ratcatcher_guard_right_inside] @ratcatch_mansion_guard_patrol;

[label,ratcatch_mansion_guard_spawn]
%npc_int = ^ratcatch_mansion_face_north;
%npc_int2 = 0;
npc_facesquare(movecoord(npc_coord, 0, 0, 1));
npc_settimer(^ratcatch_mansion_guard_poll);

[label,ratcatch_mansion_guard_patrol]
def_coord $destination = npc_destination();
if ($destination ! null & $destination ! npc_coord) return;
def_int $dz = 1;
if (%npc_int2 = 1) {
    $dz = -1;
    %npc_int = ^ratcatch_mansion_face_south;
    %npc_int2 = 0;
} else {
    %npc_int = ^ratcatch_mansion_face_north;
    %npc_int2 = 1;
}
def_coord $next = movecoord(npc_coord, 0, 0, $dz);
npc_facesquare($next);
npc_walk($next);

[timer,ratcatch_mansion_guard_watch] @ratcatch_mansion_guard_watch;
[walktrigger,ratcatch_mansion_guard_watch] @ratcatch_mansion_guard_watch;

[label,ratcatch_mansion_guard_watch]
if (%ratcatch_var ! ^ratcatch_mansion_stage_active | ~ratcatch_mansion_in_area(coord) = false) {
    cleartimer(ratcatch_mansion_guard_watch);
    walktrigger(null);
    return;
}
if (~ratcatch_mansion_guard_detected = true) {
    def_int $caught = ~ratcatch_mansion_count;
    def_coord $checkpoint = ~ratcatch_mansion_checkpoint($caught);
    cleartimer(ratcatch_mansion_guard_watch);
    walktrigger(null);
    p_stopaction;
    p_telejump($checkpoint);
    // UNKNOWN grace prevents an immediate second reset at the safe checkpoint.
    settimer(ratcatch_mansion_guard_watch, ^ratcatch_mansion_guard_reset_grace);
    return;
}
settimer(ratcatch_mansion_guard_watch, ^ratcatch_mansion_guard_poll);
walktrigger(ratcatch_mansion_guard_watch);

[proc,ratcatch_mansion_guard_detected]()(boolean)
npc_findallany(coord, ^ratcatch_mansion_guard_sight, 0);
while (npc_findnext = true) {
    if (~ratcatch_mansion_is_guard(npc_type) = true) {
        if (~ratcatch_mansion_in_guard_view(npc_coord, %npc_int) = true) return(true);
    }
}
return(false);

[proc,ratcatch_mansion_is_guard](npc $type)(boolean)
switch_npc($type) {
    case ratcatcher_staticguard,
         ratcatcher_chiefguard,
         ratcatcher_guard_left_front,
         ratcatcher_guard_left_mid,
         ratcatcher_guard_left_back,
         ratcatcher_guard_left_fullback,
         ratcatcher_guard_right_front,
         ratcatcher_guard_right_mid,
         ratcatcher_guard_right_back,
         ratcatcher_guard_right_fullback,
         ratcatcher_guard_left_inside,
         ratcatcher_guard_right_inside : return(true);
}
return(false);

// UNKNOWN engineering sight model: an eight-tile 90-degree cone with native line-of-walk.
[proc,ratcatch_mansion_in_guard_view](coord $guard, int $facing)(boolean)
if (coordy(coord) ! coordy($guard) | distance(coord, $guard) > ^ratcatch_mansion_guard_sight) return(false);
if (lineofwalk(coord, $guard) = false) return(false);
def_int $dx = calc(coordx(coord) - coordx($guard));
def_int $dz = calc(coordz(coord) - coordz($guard));
def_int $forward;
switch_int($facing) {
    case ^ratcatch_mansion_face_north :
        if ($dz > 0 & $dx <= $dz & $dx >= sub(0, $dz)) return(true);
    case ^ratcatch_mansion_face_east :
        if ($dx > 0 & $dz <= $dx & $dz >= sub(0, $dx)) return(true);
    case ^ratcatch_mansion_face_south :
        if ($dz < 0) {
            $forward = sub(0, $dz);
            if ($dx <= $forward & $dx >= sub(0, $forward)) return(true);
        }
    case ^ratcatch_mansion_face_west :
        if ($dx < 0) {
            $forward = sub(0, $dx);
            if ($dz <= $forward & $dz >= sub(0, $forward)) return(true);
        }
}
return(false);

[proc,ratcatch_mansion_checkpoint](int $caught)(coord)
if ($caught < ^ratcatch_mansion_checkpoint_mid_count) return(^ratcatch_mansion_checkpoint_early);
if ($caught < ^ratcatch_mansion_checkpoint_late_count) return(^ratcatch_mansion_checkpoint_mid);
return(^ratcatch_mansion_checkpoint_late);
