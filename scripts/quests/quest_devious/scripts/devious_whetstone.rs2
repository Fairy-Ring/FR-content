// CANDIDATE action: devious-minds.bow-sword-build.
// UNKNOWN functional messages and confirmation: no original Use text survives.
[oplocu,devious_whetstone]
if (last_useitem ! mithril_2h_sword | %devious_main ! ^devious_crafting) {
    ~displaymessage(^dm_default);
    return;
}
if (stat(smithing) < ^devious_smithing_level) {
    mes("You need 65 Smithing to grind the blade.");
    return;
}
def_int $go = ~p_choice2("Grind down the mithril two-handed sword.", 1, "Leave it alone.", 2);
if ($go = 2) return;
if (inv_total(inv, mithril_2h_sword) = 0 | stat(smithing) < ^devious_smithing_level) return;
anim(devious_human_whetstone, 0);
inv_del(inv, mithril_2h_sword, 1);
inv_add(inv, devious_slenderblade, 1);
mes("You grind the blade until it's slender and flexible.");
