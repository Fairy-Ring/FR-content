// CANDIDATE action: devious-minds.bow-sword-build.
// Both directions share the existing bow_string dispatcher.

[opheldu,devious_slenderblade]
if (last_useitem ! bow_string) {
    ~displaymessage(^dm_default);
    return;
}
@devious_bowstring;

[label,devious_bowstring]
if (%devious_main ! ^devious_crafting | inv_total(inv, bow_string) = 0 | inv_total(inv, devious_slenderblade) = 0) {
    ~displaymessage(^dm_default);
    return;
}
if (stat(fletching) < ^devious_fletching_level) {
    // UNKNOWN functional refusal wording.
    mes("You need 50 Fletching to string the blade.");
    return;
}
inv_del(inv, bow_string, 1);
inv_del(inv, devious_slenderblade, 1);
mes("You attach a bow string to the slender blade."); // UNKNOWN functional wording.
inv_add(inv, devious_bowsword, 1);
