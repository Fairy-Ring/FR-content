// VERIFIED cache op slots; UNKNOWN endpoints and native admission radii are engineering choices.
[oploc3,mdaughter_lake_tree] @mdaughter_cross_lake_tree;
[aploc3,mdaughter_lake_tree]
if (distance(coord, loc_coord) > 5) {
    p_aprange(5);
    return;
}
@mdaughter_cross_lake_tree;

[label,mdaughter_cross_lake_tree]
if (%mdaughter_mud_var ! 1 | stat(agility) < 20) {
    ~displaymessage(^dm_default);
    return;
}
if (coordx(coord) >= coordx(^mdaughter_tree_island) & coordz(coord) >= coordz(^mdaughter_tree_island)) {
    ~mdaughter_travel_cross(^mdaughter_tree_island, ^mdaughter_tree_shore);
} else {
    ~mdaughter_travel_cross(^mdaughter_tree_shore, ^mdaughter_tree_island);
}

// The visible Jump-across operation also works from the packed dry approach tiles.
[oploc1,mdaughter_polerocks] @mdaughter_try_pole;
[aploc1,mdaughter_polerocks]
if (distance(coord, loc_coord) > 3) {
    p_aprange(3);
    return;
}
@mdaughter_try_pole;
[oplocu,mdaughter_polerocks] @mdaughter_use_pole;
[aplocu,mdaughter_polerocks]
if (distance(coord, loc_coord) > 3) {
    p_aprange(3);
    return;
}
@mdaughter_use_pole;

[label,mdaughter_try_pole]
if (inv_total(inv, mdaughter_stick) = 0 & inv_total(worn, mdaughter_stick) = 0 & inv_totalcat(inv, weapon_staff) = 0 & inv_totalcat(worn, weapon_staff) = 0) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_cross_pole;

[label,mdaughter_use_pole]
if (last_useitem ! mdaughter_stick & oc_category(last_useitem) ! weapon_staff) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_cross_pole;

[label,mdaughter_cross_pole]
if (coordz(coord) >= coordz(^mdaughter_pole_second_island)) {
    ~mdaughter_travel_cross(^mdaughter_pole_second_island, ^mdaughter_pole_first_island);
} else {
    ~mdaughter_travel_cross(^mdaughter_pole_first_island, ^mdaughter_pole_second_island);
}

// The plank is a temporary bridge loc; keep both original Jump-across ops visible.
[oplocu,mdaughter_flatstone1] @mdaughter_place_plank;
[aplocu,mdaughter_flatstone1] @mdaughter_place_plank_ap;
[oplocu,mdaughter_flatstone2] @mdaughter_place_plank;
[aplocu,mdaughter_flatstone2] @mdaughter_place_plank_ap;
[oploc1,mdaughter_flatstone1] @mdaughter_cross_flatstones;
[aploc1,mdaughter_flatstone1] @mdaughter_cross_flatstones_ap;
[oploc1,mdaughter_flatstone2] @mdaughter_cross_flatstones;
[aploc1,mdaughter_flatstone2] @mdaughter_cross_flatstones_ap;

[label,mdaughter_place_plank_ap]
if (distance(coord, loc_coord) > 4) {
    p_aprange(4);
    return;
}
@mdaughter_place_plank;

[label,mdaughter_cross_flatstones_ap]
if (distance(coord, loc_coord) > 4) {
    p_aprange(4);
    return;
}
@mdaughter_cross_flatstones;

[label,mdaughter_place_plank]
if (last_useitem ! woodplank | loc_find(^mdaughter_plank_bridge, mdaughter_short_plank) = true) {
    ~displaymessage(^dm_default);
    return;
}
// VERIFIED grounddecor (22), matching the packed flatstone rows.
loc_add(^mdaughter_plank_bridge, mdaughter_short_plank, 0, grounddecor, ^mdaughter_travel_loc_lifetime);
inv_del(inv, woodplank, 1);
@mdaughter_cross_flatstones;

[label,mdaughter_cross_flatstones]
if (loc_find(^mdaughter_plank_bridge, mdaughter_short_plank) = false) {
    ~displaymessage(^dm_default);
    return;
}
if (coordx(coord) >= coordx(^mdaughter_stone_center_island)) {
    ~mdaughter_travel_cross(^mdaughter_stone_center_island, ^mdaughter_stone_west_island);
} else {
    ~mdaughter_travel_cross(^mdaughter_stone_west_island, ^mdaughter_stone_center_island);
}

[proc,mdaughter_travel_cross](coord $start, coord $landing)
if (coord ! $start) {
    p_walk($start);
    weakqueue*(mdaughter_travel_approach, 0)($start, $landing);
    return;
}
p_telejump($landing);

[queue,mdaughter_travel_approach](coord $start, coord $landing)
~mdaughter_travel_cross($start, $landing);

// Chop the path tree with the ordinary woodcutting axe checker; it returns to cache state later.
[oploc1,mdaughter_impassable_tree2] @mdaughter_chop_cave_tree;
[aploc1,mdaughter_impassable_tree2]
if (distance(coord, loc_coord) > 1) {
    p_aprange(1);
    return;
}
@mdaughter_chop_cave_tree;

[label,mdaughter_chop_cave_tree]
def_namedobj $axe = ~woodcutting_axe_checker(true);
if ($axe = null) {
    ~displaymessage(^dm_default);
    return;
}
loc_change(mdaughter_passable_tree, ^mdaughter_travel_loc_lifetime);

[oploc1,mdaughter_caveentrance] @mdaughter_enter_cave;
[aploc1,mdaughter_caveentrance]
if (distance(coord, loc_coord) > 2) {
    p_aprange(2);
    return;
}
@mdaughter_enter_cave;

[label,mdaughter_enter_cave]
if (loc_find(^mdaughter_cave_tree, mdaughter_impassable_tree2) = true) {
    ~displaymessage(^dm_default);
    return;
}
p_telejump(^mdaughter_cave_inside);

[oploc1,mdaughter_caveexit] @mdaughter_exit_cave;
[aploc1,mdaughter_caveexit]
if (distance(coord, loc_coord) > 4) {
    p_aprange(4);
    return;
}
@mdaughter_exit_cave;

[label,mdaughter_exit_cave]
p_telejump(^mdaughter_cave_surface);
