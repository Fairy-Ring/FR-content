// CANDIDATE wording: retained OSRS Transcript:Mountain Daughter.
// VERIFIED task order and rewards: Tip.It guide, 27 April 2006.

[opnpc1,mdaughter_hamal]
if (%mdaughter_quest_var >= ^mdaughter_complete) {
    @mdaughter_hamal_complete;
}
if (%mdaughter_quest_var >= ^mdaughter_kendal_dead) {
    @mdaughter_hamal_body;
}
if (%mdaughter_quest_var >= ^mdaughter_tasks) {
    @mdaughter_hamal_tasks;
}
if (%mdaughter_quest_var > 0) {
    @mdaughter_hamal_progress;
}
@mdaughter_hamal_start;

[label,mdaughter_hamal_start]
~chatnpc("<p,neutral>Greetings, outerlander, I am Hamal. I am the chieftain of this tribe.");
if (%viking >= ^viking_complete) {
    ~chatplayer("<p,neutral>And my name is <~get_viking_name>, honourable chieftain.");
} else {
    ~chatplayer("<p,neutral>And my name is <displayname>, honourable chieftain.");
}
~chatnpc("<p,happy>Ah, an outerlander with manners.");
~chatnpc("<p,quiz>So tell me what you want from us.");
if (%viking >= ^viking_complete) {
    def_int $open3 = ~p_choice3("Why is everyone so hostile?", 1, "I'm looking for a quest!", 2, "Actually, I'm a Fremennik.", 3);
    if ($open3 = 3) {
        @mdaughter_hamal_fremennik;
    } else if ($open3 = 2) {
        @mdaughter_hamal_quest_joke;
    }
    @mdaughter_hamal_hostile;
}
def_int $open2 = ~p_choice2("Why is everyone so hostile?", 1, "I'm looking for a quest!", 2);
if ($open2 = 2) {
    @mdaughter_hamal_quest_joke;
}
@mdaughter_hamal_hostile;

[label,mdaughter_hamal_hostile]
~chatplayer("<p,quiz>Why is everyone being so hostile to me?");
~chatnpc("<p,neutral>We are a solitary group, outerlander, and have little experience or interest in outside contact.");
~chatnpc("<p,neutral>It is also our custom not to talk to outerlanders without my sanction. And I see no reason to sanction it for you.");
def_int $camp = ~p_choice2("So what are you doing up here?", 1, "Oh, I'll stop talking to you then.", 2);
if ($camp = 2) {
    ~chatplayer("<p,neutral>Oh, I'll stop talking to you then.");
    ~chatnpc("<p,neutral>As you wish, outerlander.");
    return;
}
@mdaughter_hamal_camp_story;

[label,mdaughter_hamal_camp_story]
~chatplayer("<p,quiz>So what are you lot all doing up here in the mountains?");
~chatnpc("<p,neutral>We left Rellekka because we wanted to live closer to nature. We feel that the people of Rellekka have grown complacent and rely too much on their tools rather than their skill. And while they share our view on the sanctity of the runestones, they still employ and actively use magic.");
~chatnpc("<p,angry>Their Seer is an affront to the gods!");
if (%viking >= ^viking_complete) {
    ~chatplayer("<p,happy>And you haven't even seen what he did to his house!");
    ~chatnpc("<p,quiz>What?");
}
~chatnpc("<p,neutral>Anyway.");
~chatnpc("<p,neutral>We do not recognise the council of Rellekka and want nothing more to do with them. We live on rock and stone now, pure and hard.");
~chatnpc("<p,neutral>We move on to another part of the mountain slope when the rough land cannot sustain us anymore.");
~chatnpc("<p,sad>That said, we have tarried at this location for too long and should be moving on.");
~chatplayer("<p,quiz>So why are you still here?");
~chatnpc("<p,neutral>For one thing, this side of the mountain is mostly free from the menace of the trolls and the delvings of the deformed dwarves.");
~chatplayer("<p,quiz>And?");
~chatnpc("<p,sad>Well, you see...");
~chatnpc("<p,sad>My daughter has gone missing. We have been looking for her and cannot go on without her.");
@mdaughter_hamal_offer;

[label,mdaughter_hamal_offer]
def_int $offer = ~p_choice3("I will search for her!", 1, "I'm sorry to hear that.", 2, "Maybe the trolls got her?", 3);
if ($offer = 2) {
    ~chatplayer("<p,sad>I'm sorry to hear that.");
    ~chatnpc("<p,angry>We do not need your sympathy, outerlander.");
    return;
} else if ($offer = 3) {
    ~chatplayer("<p,quiz>Maybe the trolls got her?");
    ~chatnpc("<p,angry>Do not say such things in jest, outerlander.");
    ~chatnpc("<p,neutral>Besides, stealth and kidnapping is not their way.");
    def_int $after = ~p_choice2("I will search for her!", 1, "Forget it then, you can figure it out on your own.", 2);
    if ($after = 2) {
        ~chatplayer("<p,neutral>Forget it then, you can figure it out on your own.");
        return;
    }
}
@mdaughter_hamal_accept;

[label,mdaughter_hamal_accept]
~chatplayer("<p,happy>A damsel in distress! I will search for her!");
if (%viking >= ^viking_complete) {
    ~chatnpc("<p,laugh>Haha, you have spirit, <~get_viking_name>.");
} else {
    ~chatnpc("<p,laugh>Haha, you have spirit, <displayname>.");
}
~chatnpc("<p,neutral>But we do not employ outerlanders.");
~chatplayer("<p,happy>You don't need to employ me! Just let me look for her.");
~chatnpc("<p,confused>Hmmm.");
~chatnpc("<p,happy>That seems acceptable to me. Very well, I will allow you to look for her.");
~chatnpc("<p,neutral>I will instruct my people to let you roam about the area freely, and give limited consent to them to talk to you.");
~chatplayer("<p,happy>Great! I'll be back with her soon. Just wait here.");
~chatnpc("<p,neutral>Oh, I'll be waiting here alright.");
%mdaughter_quest_var = ^mdaughter_search;
~send_quest_progress(questlist:mdaughter, %mdaughter_quest_var, ^mdaughter_complete);
return;

[label,mdaughter_hamal_quest_joke]
~chatplayer("<p,quiz>I'm looking for a quest! Do you have any for me?");
~chatnpc("<p,neutral>We do not employ outerlanders.");
~chatplayer("<p,quiz>Okay, I know the drill, where do I sign up for the trials to join your tribe?");
~chatnpc("<p,angry>And we certainly don't let them join us!");
return;

[label,mdaughter_hamal_fremennik]
~chatplayer("<p,happy>Actually, I'm a Fremennik, not an outerlander.");
~chatnpc("<p,neutral>We are not Fremennik, outerlander.");
~chatplayer("<p,quiz>But you look like Fremennik!");
~chatnpc("<p,neutral>And you do not look like a Fremennik, but still claim to be one.");
~chatnpc("<p,neutral>But I will not deceive you. We were part of the Fremennik once, but left the village of Rellekka long ago.");
def_int $more = ~p_choice2("So what are you doing up here?", 1, "That's fascinating, but I'm afraid I have other things to do at the moment.", 2);
if ($more = 2) {
    ~chatplayer("<p,neutral>That's fascinating, but I'm afraid I have other things to do at the moment.");
    return;
}
@mdaughter_hamal_camp_story;

[label,mdaughter_hamal_progress]
def_int $look = ~p_choice2("Any idea on where I should start looking?", 1, "What does your daughter look like?", 2);
if ($look = 1) {
    ~chatplayer("<p,quiz>Uhm... any idea on where I should start looking for your daughter?");
    ~chatnpc("<p,neutral>There is a large pool of water beyond the camp. She used to go there often, it was her favourite spot.");
    ~chatnpc("<p,neutral>Ragnar, her fiance, is probably there as well. I will give him my permission to talk to you.");
} else {
    ~chatplayer("<p,quiz>What does your daughter look like?");
    ~chatnpc("<p,neutral>She is the fairest maiden of all our tribe, and I daresay of all the northern lands. She has flowing black hair, and when last we saw her, she was wearing a brown dress.");
    ~chatnpc("<p,neutral>Perhaps you should speak to the man she is to marry, tribesman Ragnar. He can probably tell you more.");
    ~chatnpc("<p,neutral>You can find him out by the pool beyond the camp, where my daughter used to go so often.");
}
return;

[label,mdaughter_hamal_tasks]
if (%mdaughter_hamal_heardofdeath = 0) {
    ~chatplayer("<p,happy>I have found your daughter!");
    ~chatnpc("<p,quiz>Where is she? Tell me, outerlander!");
    ~chatplayer("<p,sad>Well, er, she is dead.");
    ~chatnpc("<p,angry>Do not play games with me. I gave you leave to walk about our camp, not to trick us.");
    %mdaughter_hamal_heardofdeath = 1;
} else {
    ~chatnpc("<p,quiz>What is it, outerlander?");
}
def_int $task = ~p_choice3("Never mind.", 1, "About the people of Rellekka...", 2, "About your food supplies...", 3);
if ($task = 1) return;
if ($task = 2) @mdaughter_hamal_relations;
@mdaughter_hamal_food;

[label,mdaughter_hamal_relations]
~chatplayer("<p,neutral>About the people of Rellekka...");
if (%mdaughter_relations_var >= 5) {
    ~chatplayer("<p,happy>I did it, I persuaded Brundt to speak to your representative!");
    ~chatnpc("<p,quiz>Indeed, outerlander, and how did you accomplish that without giving him our rock?");
    ~chatplayer("<p,neutral>Well, yeah, I need to talk to you about that...");
    ~chatnpc("<p,happy>Worry not, you made a wise decision and your boldness is impressive.");
    ~chatnpc("<p,neutral>It does not matter, after all, how large the rock is, or what its shape is. And perhaps the two halves of the rock will have extra symbolism now, representing the two halves of the Fremennik culture.");
    ~chatnpc("<p,happy>I understand that Svidi's meeting with Brundt went quite well. I must thank you for your assistance, outerlander.");
    %mdaughter_hamal_relations_done = 1;
    return;
}
if (%mdaughter_relations_var >= 3) {
    ~chatplayer("<p,neutral>Chieftain Brundt says that he won't meet with Svidi unless you give him back some rock or other.");
    ~chatnpc("<p,quiz>What, do you mean our ancient rock that our fathers took with them when they left the ignorants of Rellekka?");
    ~chatplayer("<p,neutral>Yes, that's the one.");
    ~chatnpc("<p,angry>Out of the question. That rock belongs to us. It symbolises what we stand for. What would Brundt want with it anyway?");
    ~chatplayer("<p,quiz>So I can't persuade you to part with the rock?");
    ~chatnpc("<p,angry>Did you not hear me the first time, outerlander? It belongs to us, we will not part with it.");
    return;
}
~chatplayer("<p,quiz>Why do you hate them so much?");
~chatnpc("<p,neutral>We do not hate them, outerlander, but we do not approve of their ways either.");
~chatplayer("<p,quiz>But don't you basically believe in the same things?");
~chatnpc("<p,neutral>It is true that our beliefs are not all that different, but we have a different way of applying them, a stricter way.");
~chatplayer("<p,quiz>So you've never considered, say, making peace with them?");
~chatnpc("<p,neutral>We are not at war with them, outerlander, but we try to ignore each other.");
~chatnpc("<p,neutral>But I must admit that I have, in fact, sent out a representative to Rellekka to talk about improving relations and perhaps setting up a basic trade route.");
~chatplayer("<p,happy>Great! Well, that was easy.");
~chatnpc("<p,neutral>Unfortunately we have not heard from Svidi, our representative, for a few days.");
~chatplayer("<p,quiz>Shall I go looking for him as well then?");
~chatnpc("<p,neutral>Do as you wish, outerlander.");
if (%mdaughter_relations_var = 0) %mdaughter_relations_var = 1;
return;

[label,mdaughter_hamal_food]
~chatplayer("<p,neutral>About your food supplies...");
if (%mdaughter_food_var >= 3) {
    ~chatnpc("<p,happy>This is a great gift, <displayname>, which I humbly accept.");
    return;
}
if (inv_total(inv, mdaughter_white_pearl_seed) > 0) {
    ~chatplayer("<p,happy>I've found this seed that may be of interest to you.");
    ~chatnpc("<p,quiz>Interesting, what is it?");
    ~chatplayer("<p,neutral>It's the seed of the White Pearl fruit. It grows on White Wolf mountain, even in the snow.");
    ~chatplayer("<p,happy>With luck, you'll be able to grow it here as well.");
    ~chatnpc("<p,happy>This is a great gift, <displayname>, which I humbly accept.");
    inv_del(inv, mdaughter_white_pearl_seed, 1);
    %mdaughter_food_var = 3;
    return;
}
if (inv_total(inv, mdaughter_white_pearl_fruit) > 0) {
    ~chatplayer("<p,happy>Here, I have something that might interest you.");
    ~chatplayer("<p,neutral>It's White Pearl fruit, which grows in even the hardiest circumstances. I found this growing on White Wolf Mountain.");
    ~chatnpc("<p,quiz>And what use is one piece of fruit to us, outerlander? It won't feed our tribe for even a day.");
    ~chatplayer("<p,neutral>Oops, I hadn't thought of that.");
    return;
}
~chatplayer("<p,quiz>From what I understand you're starting to run out?");
~chatnpc("<p,quiz>Where did you get that idea from, outerlander?");
~chatplayer("<p,neutral>Er, I just happened to overhear it.");
~chatnpc("<p,neutral>There is some truth to it, yes. If it were not for my missing daughter, we would have moved on already, and finding food would be easier again for a while.");
~chatplayer("<p,quiz>Can I help you with finding a new supply of food?");
~chatnpc("<p,neutral>I would be interested to see how you would manage that, outerlander. But if you insist on trying, go ahead.");
if (%mdaughter_food_var = 0) %mdaughter_food_var = 1;
return;

[label,mdaughter_hamal_body]
if (%mdaughter_quest_var >= ^mdaughter_burial) {
    ~chatnpc("<p,neutral>Only then are the burial rites complete.");
    return;
}
~chatplayer("<p,neutral>I killed the bearman! He really was just a man after all, like I said!");
~chatnpc("<p,shock>You have? Then we made an enormous mistake.");
~chatnpc("<p,neutral>As did he. Impersonating a god bears the highest penalty imaginable, but I did not think that kind of justice would be delivered by the hand of an outerlander.");
~chatplayer("<p,sad>I also found your daughter. The bearman killed her.");
~chatnpc("<p,sad>So it is true then, after all? Let me see her body please.");
if (inv_total(inv, mdaughter_daughter_corpse) = 0) {
    ~chatplayer("<p,neutral>I didn't bring it with me, I'll go and look for it.");
    return;
}
~chatplayer("<p,neutral>Of course.");
~chatnpc("<p,sad>Yes, I see it is her. So it is also true that you spoke to her spirit at the pool?");
~chatplayer("<p,neutral>Yes, it's true.");
~chatnpc("<p,neutral>Then she must be buried there, on the island at the center of the pool... to bring peace to her spirit. This is a most unusual situation, but will you bury her, <displayname>?");
def_int $bury = ~p_choice2("I will.", 1, "I won't.", 2);
if ($bury = 2) {
    ~chatplayer("<p,neutral>I won't.");
    ~chatplayer("<p,neutral>I... ehm...");
    ~chatplayer("<p,neutral>Errr...");
}
~chatplayer("<p,neutral>I will.");
~chatnpc("<p,neutral>Then please listen closely. If she is given a proper burial, she is to be buried with some of her possessions. I see she's still wearing her dress, so you will need one more item.");
~chatnpc("<p,neutral>When she has been buried, you must build a cairn on top. It is our tradition to build these cairns in the shape of our longboats that we use when we need to cross the seas. You can use rocks for this purpose, about five or so should be enough.");
~chatnpc("<p,neutral>Only then are the burial rites complete.");
~chatplayer("<p,quiz>So I need to bury her with one of her possessions, and build a cairn on top made out of rocks. So where do I get another one of her possessions?");
~chatnpc("<p,neutral>Asleif had little possessions in life and none that have survived the years. I do not know where you might find such a thing, but perhaps Ragnar does, out by the pool.");
%mdaughter_hamal_heardofbear = 1;
%mdaughter_hamal_heardofburial = 1;
%mdaughter_quest_var = ^mdaughter_burial;
return;

[label,mdaughter_hamal_complete]
~chatnpc("<p,happy>You have my thanks, in any case.");
~chatplayer("<p,quiz>So what are you all going to do now? Are you finally going to move to another location?");
~chatnpc("<p,neutral>No, I've decided to set up a permanent camp here.");
~chatnpc("<p,neutral>There is no need to move now with our new supply of food. Also, there is a protective spirit looking after us now.");
return;
