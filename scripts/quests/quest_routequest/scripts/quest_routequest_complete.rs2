// Thin complete queue — 377 uses 6-arg send_quest_complete (not 289 send_quest_complete2)
[queue,routequest_complete]
%routequest = ^routequest_complete;
stat_advance(attack, 6000);
stat_advance(defence, 6000);
stat_advance(strength, 6000);
stat_advance(hitpoints, 6000);
stat_advance(crafting, 6000);
session_log(^log_adventure, "Quest complete: In Search of the Myreque");
// 289 complete2 title. Amounts = this queue's stat_advance(6000) tenths.
~send_quest_complete(questlist:routequest, steel_sword, 200, ^routequest_questpoints, "'In Search of the Myreque' completed.", "600 Attack, Defence, Strength XP|600 Hitpoints, Crafting XP|Quick Route to Mort'ton");
