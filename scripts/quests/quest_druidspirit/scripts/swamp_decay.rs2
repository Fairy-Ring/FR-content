// UNKNOWN engineering bounds from the 377 collision map. Exclude both river banks
// and Mort'ton's northern tip, without omitting swamp-side arrival components.
// One definition serves map-square entry and the timer's leaving check.
[proc,in_swamp_decay_area]()(boolean)
if(inzone(0_53_52_8_2, 0_54_53_56_63, coord) = true |
   inzone(0_53_52_35_0, 0_53_52_43_1, coord) = true |
   inzone(0_54_52_40_0, 0_54_52_50_1, coord) = true |
   inzone(0_54_52_57_47, 0_54_53_63_63, coord) = true) {
    return(true);
}
return(false);

[proc,start_swampdecay_timer]
if(%mortmyre = ^true | ~in_swamp_decay_area = false) { // don't start another timer if already in mort myre
    return;
}
%mortmyre = ^true;
settimer(swamp_decay, ^swamp_decay_interval);

[timer,swamp_decay]
// CANDIDATE: grotto protection, RuneScape wiki Nature Spirit, 29 April 2007.
// UNKNOWN engineering bounds: island (3434,3330)..(3448,3344),
// interior (3434,9730)..(3448,9744), plane 0.
if(inzone(0_53_52_42_2, 0_53_52_56_16, coord) = true | inzone(0_53_152_42_2, 0_53_152_56_16, coord) = true) {
    return;
}
if(~in_swamp_decay_area = false) {
    %mortmyre = ^false;
    cleartimer(swamp_decay);
    // CANDIDATE: Old School Swamp decay, revision 14222486 (30 December 2021).
    mes("The swamp decay effect is now over.");
    return;
}
// CANDIDATE: carried or worn, RuneScape wiki Silver sickle (b), 21 June 2007.
if(inv_total(inv, silver_sickle_blessed) > 0 | inv_total(worn, silver_sickle_blessed) > 0) {
    return;
}
// CANDIDATE: Old School Swamp decay, revision 14222398 (30 December 2021).
mes("The swamp decays you!");
// CANDIDATE: Lost City 289 uses the ordinary defend reaction to damage.
anim(%com_defendanim, 30);
// CANDIDATE: Old School's green damaging bubble; 377 recolour 14273 is yellow-green.
spotanim_pl(mortmyre_swampstench, 0, 30);
~damage_self(~random_range(^swamp_decay_damage_min, ^swamp_decay_damage_max));
