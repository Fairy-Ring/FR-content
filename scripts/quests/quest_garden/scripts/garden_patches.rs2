// Garden of Tranquillity palace patches: cache forms 9165-9240.
// VERIFIED stage identities: garden-of-tranquillity.loc-patches and patch-* facts.
// UNKNOWN engineering growth: one original stage per shared five-minute Farming
// window, capped at the cache's mature/fruit forms. No disease or death is added.
// Call farming_reconcile before planting/watering so earlier windows cannot
// advance a crop or shoot which did not yet exist in that state.

// Patch kind ids are private to this script: 1 delphinium, 2 white rose,
// 3 red rose, 4 pink rose, 5 pink orchid, 6 yellow orchid, 7 snowdrop,
// 8 White Tree, 9 vine.
[proc,garden_patch_kind]()(int)
def_coord $coord = loc_coord;
def_int $x = coordx($coord);
def_int $z = coordz($coord);
// Shared rose children (seedling and first growth) and orchid pot children
// cannot identify their parent from the visible child id. Use the map tile.
if ($z >= 3471 & $z <= 3472) {
    if ($x >= 3226 & $x <= 3227) return(4);
    if ($x >= 3229 & $x <= 3230) return(3);
    if ($x >= 3232 & $x <= 3233) return(2);
}
if ($z = 3486) {
    if ($x = 3229) return(5);
    if ($x = 3231) return(6);
}
switch_loc (loc_type) {
    case garden_delphinium_patch : return(1);
    case garden_delphiniums_weeds_3 : return(1);
    case garden_delphiniums_weeds_2 : return(1);
    case garden_delphiniums_weeds_1 : return(1);
    case garden_delphiniums_weeded : return(1);
    case garden_delphiniums_seed : return(1);
    case garden_delphiniums_1 : return(1);
    case garden_delphiniums_2 : return(1);
    case garden_delphiniums_fullygrown : return(1);
    case garden_rosebush_patch_white : return(2);
    case garden_rosebush_white_weeds_3 : return(2);
    case garden_rosebush_white_weeds_2 : return(2);
    case garden_rosebush_white_weeds_1 : return(2);
    case garden_rosebush_white_weeded : return(2);
    case garden_rosebush_white_2 : return(2);
    case garden_rosebush_white_fullygrown : return(2);
    case garden_rosebush_patch_red : return(3);
    case garden_rosebush_red_weeds_3 : return(3);
    case garden_rosebush_red_weeds_2 : return(3);
    case garden_rosebush_red_weeds_1 : return(3);
    case garden_rosebush_red_weeded : return(3);
    case garden_rosebush_red_2 : return(3);
    case garden_rosebush_red_fullygrown : return(3);
    case garden_rosebush_patch_pink : return(4);
    case garden_rosebush_pink_weeds_3 : return(4);
    case garden_rosebush_pink_weeds_2 : return(4);
    case garden_rosebush_pink_weeds_1 : return(4);
    case garden_rosebush_pink_weeded : return(4);
    case garden_rosebush_pink_2 : return(4);
    case garden_rosebush_pink_fullygrown : return(4);
    case garden_orchid_pink_patch : return(5);
    case garden_orchids_seed : return(5);
    case garden_orchids_1 : return(5);
    case garden_orchids_2 : return(5);
    case garden_orchids_fullygrown : return(5);
    case garden_orchid_yellow_patch : return(6);
    case garden_orchids_seed_yellow : return(6);
    case garden_orchids_1_yellow : return(6);
    case garden_orchids_2_yellow : return(6);
    case garden_orchids_fullygrown_yellow : return(6);
    case garden_snowdrop_patch : return(7);
    case garden_snowdrops_weeds_3 : return(7);
    case garden_snowdrops_weeds_2 : return(7);
    case garden_snowdrops_weeds_1 : return(7);
    case garden_snowdrops_weeded : return(7);
    case garden_snowdrops_seed : return(7);
    case garden_snowdrops_1 : return(7);
    case garden_snowdrops_2 : return(7);
    case garden_snowdrops_fullygrown : return(7);
    case garden_white_tree_patch : return(8);
    case garden_white_tree_weeds_3 : return(8);
    case garden_white_tree_weeds_2 : return(8);
    case garden_white_tree_weeds_1 : return(8);
    case garden_white_tree_weeded : return(8);
    case garden_white_tree_seedling : return(8);
    case garden_white_tree_1 : return(8);
    case garden_white_tree_2 : return(8);
    case garden_white_tree_3 : return(8);
    case garden_white_tree_fullygrown : return(8);
    case garden_white_tree_fruit_1 : return(8);
    case garden_white_tree_fruit_2 : return(8);
    case garden_white_tree_fruit_3 : return(8);
    case garden_white_tree_fruit_4 : return(8);
    case garden_vine_patch : return(9);
    case garden_vines_weeds_3 : return(9);
    case garden_vines_weeds_2 : return(9);
    case garden_vines_weeds_1 : return(9);
    case garden_vines_weeded : return(9);
    case garden_vines_seed : return(9);
    case garden_vines_1 : return(9);
    case garden_vines_2 : return(9);
    case garden_vines_fullygrown : return(9);
    case default : return(-1);
}

[proc,garden_patch_stage](int $kind)(int)
switch_int ($kind) {
    case 1 : return(%garden_delphiniums_varbit);
    case 2 : return(%garden_rosebush_white_varbit);
    case 3 : return(%garden_rosebush_red_varbit);
    case 4 : return(%garden_rosebush_pink_varbit);
    case 5 : return(%garden_orchids_pink_varbit);
    case 6 : return(%garden_orchids_yellow_varbit);
    case 7 : return(%garden_snowdrops_varbit);
    case 8 : return(%garden_white_tree_varbit);
    case 9 : return(%garden_vines_varbit);
}
return(-1);

[proc,garden_patch_set_stage](int $kind, int $stage)
switch_int ($kind) {
    case 1 : %garden_delphiniums_varbit = $stage;
    case 2 : %garden_rosebush_white_varbit = $stage;
    case 3 : %garden_rosebush_red_varbit = $stage;
    case 4 : %garden_rosebush_pink_varbit = $stage;
    case 5 : %garden_orchids_pink_varbit = $stage;
    case 6 : %garden_orchids_yellow_varbit = $stage;
    case 7 : %garden_snowdrops_varbit = $stage;
    case 8 : %garden_white_tree_varbit = $stage;
    case 9 : %garden_vines_varbit = $stage;
}

[proc,garden_patch_seed_kind](obj $seed)(int)
switch_obj ($seed) {
    case garden_delphinium_seed : return(1);
    case garden_rosebush_seed_white : return(2);
    case garden_rosebush_seed_red : return(3);
    case garden_rosebush_seed_pink : return(4);
    case garden_orchid_pink_seed : return(5);
    case garden_orchid_yellow_seed : return(6);
    case garden_snowdrop_seed : return(7);
    case garden_vine_seed : return(9);
}
return(0);

[proc,garden_patch_seed_count](int $kind)(int)
// UNKNOWN engineering full-bundle costs are shared with the quest trade config.
if ($kind = 1) return(^garden_delphinium_bundle);
if ($kind = 2 | $kind = 3 | $kind = 4) return(^garden_rose_bundle);
if ($kind = 5 | $kind = 6) return(^garden_orchid_bundle);
if ($kind = 7) return(^garden_snowdrop_bundle);
if ($kind = 9) return(^garden_vine_bundle);
return(0);


// Called by the shared Farming growth DB row (handler 15, period 5).
[proc,garden_patch_advance_all](int $steps, int $window)
if ($steps <= 0) return;
def_int $kind = 1;
while ($kind <= 9) {
    def_int $stage = ~garden_patch_stage($kind);
    if ($kind = 8) {
        // White Tree: 4 sapling, 5-7 growing, 8 mature, 9-12 fruit.
        if ($stage >= 4 & $stage < 8) {
            def_int $needed = sub(8, $stage);
            if ($steps >= $needed) {
                $stage = 8;
                def_int $fruit_steps = sub($steps, $needed);
                if ($fruit_steps > 0) $stage = add(8, min($fruit_steps, 4));
            } else {
                $stage = add($stage, $steps);
            }
            ~garden_patch_set_stage($kind, $stage);
        } else if ($stage >= 8 & $stage < 12) {
            $stage = add($stage, min($steps, sub(12, $stage)));
            ~garden_patch_set_stage($kind, $stage);
        }
    } else if ($stage >= 4 & $stage < 7) {
        if ($steps >= sub(7, $stage)) {
            $stage = 7;
        } else {
            $stage = add($stage, $steps);
        }
        ~garden_patch_set_stage($kind, $stage);
    }
    $kind = add($kind, 1);
}
// A watered White Tree shoot in a pot becomes a sapling after one eligible
// five-minute window; its inventory object persists across logout.
def_int $slot = 0;
while ($slot < inv_size(inv)) {
    if (inv_getobj(inv, $slot) = garden_white_tree_plantpot_shoot_watered) {
        inv_setslot(inv, $slot, garden_white_tree_plantpot_sapling, 1);
    }
    $slot = add($slot, 1);
}

[proc,garden_all_grown]()(boolean)
if (~garden_patch_stage(1) ! 7) return(false);
if (~garden_patch_stage(2) ! 7) return(false);
if (~garden_patch_stage(3) ! 7) return(false);
if (~garden_patch_stage(4) ! 7) return(false);
if (~garden_patch_stage(5) ! 7) return(false);
if (~garden_patch_stage(6) ! 7) return(false);
if (~garden_patch_stage(7) ! 7) return(false);
def_int $tree_stage = ~garden_patch_stage(8);
if ($tree_stage < 8 | $tree_stage > 12) return(false);
if (~garden_patch_stage(9) ! 7) return(false);
return(true);

// Rake: each click starts the original three weed stages; the pending op3
// continues at the shared Farming two-tick cadence (UNKNOWN engineering).
[oplocu,garden_delphinium_patch] @garden_patch_use;
[oplocu,garden_delphiniums_weeds_3] @garden_patch_use;
[oplocu,garden_delphiniums_weeds_2] @garden_patch_use;
[oplocu,garden_delphiniums_weeds_1] @garden_patch_use;
[oploc3,garden_delphiniums_weeds_3] @garden_patch_rake_continue;
[oploc3,garden_delphiniums_weeds_2] @garden_patch_rake_continue;
[oploc3,garden_delphiniums_weeds_1] @garden_patch_rake_continue;
