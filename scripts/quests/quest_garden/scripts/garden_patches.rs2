[oploc3,garden_white_tree_weeds_2] @garden_patch_rake_continue;
[oploc3,garden_white_tree_weeds_1] @garden_patch_rake_continue;
[oploc1,garden_white_tree_fruit_1] @garden_white_tree_pick;
[oploc1,garden_white_tree_fruit_2] @garden_white_tree_pick;
[oploc1,garden_white_tree_fruit_3] @garden_white_tree_pick;
[oploc1,garden_white_tree_fruit_4] @garden_white_tree_pick;

[label,garden_patch_use]
def_int $kind = ~garden_patch_kind;
if ($kind < 1 | $kind > 9) {
    ~displaymessage(^dm_default);
    return;
}
def_int $stage = ~garden_patch_stage($kind);
if (%garden_quest < 1 | %garden_quest >= 60) {
    ~displaymessage(^dm_default);
    return;
}
if (last_useitem = rake) {
    ~garden_patch_rake($kind, false);
    return;
}
if (oc_category(last_useitem) = watering_can) {
    // CANDIDATE transcript: palace soil is fertile; no can dose is spent.
    mes("These don't really need watering - the soil seems to be extremely fertile.");
    return;
}
if (last_useitem = bucket_compost | last_useitem = bucket_supercompost) {
    if ($kind = 5 | $kind = 6) {
        if ($stage ! 0) {
            ~displaymessage(^dm_default);
            return;
        }
        // UNKNOWN mapping: both orchid colours share the cache's post-fill form.
        inv_setslot(inv, last_useslot, bucket_empty, 1);
        ~garden_patch_set_stage($kind, 1);
        return;
    }
    // CANDIDATE transcript: all non-orchid palace soil needs no compost.
    mes("This patch doesn't really need treating with compost - the soil seems to be extremely fertile.");
    return;
}
if (last_useitem = plantpot_compost | last_useitem = plantpot_supercompost) {
    if ($kind = 5 | $kind = 6) {
        // CANDIDATE transcript: the Orchid pots take compost, not soil.
        mes("You need to fill it with compost rather than soil.");
    } else {
        ~displaymessage(^dm_default);
    }
    return;
}
def_obj $seed = last_useitem;
def_int $seed_kind = ~garden_patch_seed_kind($seed);
if ($seed_kind > 0) {
    if (($kind = 5 | $kind = 6) & ($seed_kind = 5 | $seed_kind = 6) & $seed_kind ! $kind) {
        // CANDIDATE transcript: the two colours belong in different pots.
        mes("These seeds need to be planted in the other plantpot.");
        return;
    }
    if ($seed_kind ! $kind) {
        ~displaymessage(^dm_default);
        return;
    }
    if ($kind = 5 | $kind = 6) {
        if ($stage = 0) {
            // CANDIDATE transcript; seeds do not consume the empty pot.
            mes("This plantpot needs some compost in it first.");
            return;
        }
        if ($stage ! 1) {
            ~displaymessage(^dm_default);
            return;
        }
    } else if ($stage ! 3) {
        ~displaymessage(^dm_default);
        return;
    }
    if (inv_total(inv, dibber) < 1) {
        ~displaymessage(^dm_farming_dibber);
        return;
    }
    def_int $count = ~garden_patch_seed_count($kind);
    if (inv_total(inv, $seed) < $count) {
        ~displaymessage(^dm_default);
        return;
    }
    ~farming_reconcile(false);
    anim(farming_seed_dibbing, 0);
    inv_del(inv, $seed, $count);
    ~garden_patch_set_stage($kind, 4);
    return;
}
if (last_useitem = garden_white_tree_plantpot_sapling) {
    if ($kind ! 8 | $stage ! 3) {
        ~displaymessage(^dm_default);
        return;
    }
    if (inv_total(inv, garden_white_tree_plantpot_sapling) < 1) {
        ~displaymessage(^dm_default);
        return;
    }
    ~farming_reconcile(false);
    inv_del(inv, garden_white_tree_plantpot_sapling, 1);
    ~garden_patch_set_stage(8, 4);
    return;
}
~displaymessage(^dm_default);
return;

[label,garden_patch_rake_continue]
def_int $kind = ~garden_patch_kind;
if ($kind >= 1 & $kind <= 9) ~garden_patch_rake($kind, true);
return;

[proc,garden_patch_rake](int $kind, boolean $repeat)
if (%garden_quest < 1 | %garden_quest >= 60) return;
def_int $stage = ~garden_patch_stage($kind);
if ($stage < 0 | $stage > 2 | inv_total(inv, rake) < 1) return;
if ($repeat = true & %action_delay > map_clock) {
    p_oploc(3);
    return;
}
anim(farming_raking, 0);
def_int $next = add($stage, 1);
~garden_patch_set_stage($kind, $next);
if ($next < 3) {
    %action_delay = calc(map_clock + ^farming_rake_step_ticks);
    p_oploc(3);
}

// White Tree shoot → empty pot → watered pot → sapling.
[opheldu,plantpot_empty] @garden_white_tree_pot;
[opheldu,garden_white_tree_shoot] @garden_white_tree_pot;
[opheldu,garden_white_tree_plantpot_shoot] @garden_white_tree_water;

[label,garden_white_tree_pot]
if (%garden_quest < 1 | %garden_quest >= 60) {
    ~displaymessage(^dm_default);
    return;
}
def_int $pot_slot = last_slot;
def_int $shoot_slot = last_useslot;
if (last_item = garden_white_tree_shoot) {
    $pot_slot = last_useslot;
    $shoot_slot = last_slot;
}
if (inv_getobj(inv, $pot_slot) ! plantpot_empty | inv_getobj(inv, $shoot_slot) ! garden_white_tree_shoot) {
    ~displaymessage(^dm_default);
    return;
}
~farming_reconcile(false);
inv_setslot(inv, $pot_slot, garden_white_tree_plantpot_shoot, 1);
inv_del(inv, garden_white_tree_shoot, 1);
return;

[label,garden_white_tree_water]
if (%garden_quest < 1 | %garden_quest >= 60) {
    ~displaymessage(^dm_default);
    return;
}
def_obj $can = last_useitem;
def_int $can_slot = last_useslot;
def_int $pot_slot = last_slot;
if (oc_category($can) ! watering_can | $can = watering_can_0) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_getobj(inv, $pot_slot) ! garden_white_tree_plantpot_shoot) {
    ~displaymessage(^dm_default);
    return;
}
def_namedobj $next_can = oc_param($can, next_obj_stage);
if ($next_can = null) {
    ~displaymessage(^dm_default);
    return;
}
~farming_reconcile(false);
anim(farming_watering, 0);
inv_setslot(inv, $pot_slot, garden_white_tree_plantpot_shoot_watered, 1);
inv_setslot(inv, $can_slot, $next_can, 1);
return;


[label,garden_white_tree_pick]
if (%garden_quest ! 60) {
    ~displaymessage(^dm_default);
    return;
}
def_int $stage = ~garden_patch_stage(8);
if ($stage < 9 | $stage > 12) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You don't have enough inventory space.");
    return;
}
inv_add(inv, garden_white_tree_fruit, 1);
stat_advance(farming, ^garden_fruit_farming_xp);
~garden_patch_set_stage(8, sub($stage, 1));
return;

[opheld1,garden_white_tree_fruit]
mes("You eat the <lowercase(oc_name(last_item))>.");
sound_synth(eat, 1, 0);
anim(human_eat, 0);
inv_delslot(inv, last_slot);
// CANDIDATE OSRS fruit effects; exact period healing is UNKNOWN.
stat_heal(hitpoints, ^garden_fruit_heal, 0);
healenergy(^garden_fruit_energy);
return;
