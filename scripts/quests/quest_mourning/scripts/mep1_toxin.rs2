[oploc1,mourning_orchard_applepile] @mep1_take_apples;
[oplocu,mourning_orchard_applebarrel_empty] @mep1_mash_apples;
[opheldu,mourning_applebarrel_mush] @mep1_mix_naphtha;
[opheldu,mourning_applebarrel_naphtha_mush] @mep1_sieve_naphtha;
[opheldu,mourning_sieve] @mep1_sieve_naphtha;
[oplocu,grain_sacks] @mep1_poison_m39;
[oplocu,grain_sacks_8802] @mep1_poison_m39;
[oplocu,grain_sacks_8803] @mep1_poison_m38;
[oplocu,grain_sacks_8804] @mep1_poison_m39;
[oplocu,grain_sacks_8805] @mep1_poison_m39;
[oplocu,grain_sacks_8806] @mep1_poison_m38;

[label,mep1_elena]
if (%mourning_quest = ^mep1_toxin_task) {
    if (inv_total(inv, applebarrel_full) < 1) return;
    if (inv_total(inv, mourning_sieve) < 1) {
        if (inv_freespace(inv) < 1) return;
        inv_add(inv, mourning_sieve, 1);
    }
    %mourning_quest = ^mep1_toxin_recipe;
    return;
}
if (%mourning_quest >= ^mep1_toxin_recipe & %mourning_quest < ^mourning_complete & inv_total(inv, mourning_sieve) < 1 & inv_freespace(inv) > 0) {
    inv_add(inv, mourning_sieve, 1);
}

[label,mep1_take_apples]
if (%mourning_quest < ^mep1_toxin_task | %mourning_quest >= ^mep1_food_poisoned) return;
inv_add(inv, applebarrel_full, 1);

[label,mep1_mash_apples]
if (%mourning_quest ! ^mep1_toxin_recipe) return;
if (last_useitem ! applebarrel_full) return;
if (inv_total(inv, applebarrel_full) < 1) return;
inv_del(inv, applebarrel_full, 1);
inv_add(inv, mourning_applebarrel_mush, 1);

[label,mep1_mix_naphtha]
if (%mourning_quest ! ^mep1_toxin_recipe) return;
if (last_useitem = regicide_barrel_naphtha & inv_total(inv, mourning_applebarrel_mush) > 0) {
    inv_del(inv, regicide_barrel_naphtha, 1);
    inv_del(inv, mourning_applebarrel_mush, 1);
    inv_add(inv, mourning_applebarrel_naphtha_mush, 1);
    return;
}
if (last_useitem = mourning_applebarrel_mush & inv_total(inv, regicide_barrel_naphtha) > 0) {
    inv_del(inv, mourning_applebarrel_mush, 1);
    inv_del(inv, regicide_barrel_naphtha, 1);
    inv_add(inv, mourning_applebarrel_naphtha_mush, 1);
}

[label,mep1_sieve_naphtha]
if (%mourning_quest ! ^mep1_toxin_recipe) return;
if (inv_total(inv, mourning_sieve) < 1 | inv_total(inv, mourning_applebarrel_naphtha_mush) < 1) return;
if (last_useitem ! mourning_sieve & last_useitem ! mourning_applebarrel_naphtha_mush) return;
inv_del(inv, mourning_applebarrel_naphtha_mush, 1);
inv_add(inv, mourning_toxic_naphtha, 1);

[label,mep1_heat_toxin]
if (%mourning_quest ! ^mep1_toxin_recipe) return;
if (inv_total(inv, mourning_toxic_naphtha) < 1) return;
inv_del(inv, mourning_toxic_naphtha, 1);
inv_add(inv, mourning_apple_toxin, 1);

[label,mep1_fire_toxin]
if (%mourning_quest ! ^mep1_toxin_recipe) return;
if (inv_total(inv, mourning_toxic_naphtha) < 1) return;
inv_del(inv, mourning_toxic_naphtha, 1);
~damage_self(^mep1_fire_damage);

// UNKNOWN bookkeeping: the four m39_51 sacks use flag 1, the two m38_51 sacks use flag 2,
// and flag 3 marks both actual regions poisoned.
[label,mep1_poison_m39]
if (%mourning_quest ! ^mep1_toxin_recipe) return;
if (last_useitem ! mourning_apple_toxin) return;
if (getbit_range(%mourning_quest_bits, 22, 22) = 1) return;
if (inv_total(inv, mourning_apple_toxin) < 1) return;
inv_del(inv, mourning_apple_toxin, 1);
%mourning_quest_bits = setbit(%mourning_quest_bits, 22);
if (getbit_range(%mourning_quest_bits, 23, 23) = 1) {
    %mourning_quest_bits = setbit(%mourning_quest_bits, 24);
    %mourning_quest = ^mep1_food_poisoned;
}

[label,mep1_poison_m38]
if (%mourning_quest ! ^mep1_toxin_recipe) return;
if (last_useitem ! mourning_apple_toxin) return;
if (getbit_range(%mourning_quest_bits, 23, 23) = 1) return;
if (inv_total(inv, mourning_apple_toxin) < 1) return;
inv_del(inv, mourning_apple_toxin, 1);
%mourning_quest_bits = setbit(%mourning_quest_bits, 23);
if (getbit_range(%mourning_quest_bits, 22, 22) = 1) {
    %mourning_quest_bits = setbit(%mourning_quest_bits, 24);
    %mourning_quest = ^mep1_food_poisoned;
}
