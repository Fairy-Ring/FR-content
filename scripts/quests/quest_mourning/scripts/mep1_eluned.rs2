// MEP1 access — roving Eluned (roving_female_woodelf 1679) @ 2289,3145.
// CANDIDATE last-resort pre-SoE dump: RS3 Transcript 18 Aug 2013 / 2 May 2018
// minus Quest Overview glue / 8-charge / Essyllt / SoE / dest / camp crystal.
// Period camp first-talk Still missing. VERIFIED crystal line is Lletya after fade.
// Hunt 289? no. Do not splice Islwyn / 1202 / 2372. Do not write 518 / 574.
// Accept: %mourning_quest 0→1 then "Well, let us go then." return — no dest.
// Roving Elves later-case (inline — no new ops / labels): Consecrating the
// Tomb first briefing when %roving_elves_quest = 1 and %mourning_quest < 1
// (seed from old tomb SE of Baxtorian Falls, defeat a guardian, return) —
// write 1→2 CANDIDATE (not complete). At >= 2 and mourning < 1: again-talk
// "any luck finding the consecration seed?" (no inv). MEP1 branches preserved.
// Cite mep1-eluned-period-media-377.md §4 / §6 + red-19-start-impl-377.md §1.

[opnpc1,roving_female_woodelf]
if (%roving_elves_quest = 1) {
    if (%mourning_quest < 1) {
        ~chatplayer("<p,neutral>Hey there, Islwyn said you might be able to help me. He told me you'd know how to consecrate ground for an elven burrial. I need to consecrate Glarial's new resting place.");
        ~chatnpc("<p,neutral>That I do... It is also elvish tradition to plant a specially enchanted crystal seed at the graves of our ancestors. The seed will create guardians to protect the area. Unfortunately the crystal seed must be tuned to the person it's protecting... a new seed won't do. But you should be able to recover the seed from her old tomb. I'm not very familiar with the lands to the east so I couldn't tell you where her old tomb is I'm afraid.");
        ~chatplayer("<p,neutral>That's okay, I've been there before. It's just south east of Baxtorian Falls.");
        ~chatnpc("<p,neutral>Excellent. Now, the tomb's guardians will be protecting the seed, you'll need to defeat one of them to get it. Once you have it, return to me and I will re-enchant it.");
        ~chatplayer("<p,neutral>Okay, I'll be back as soon as I have it.");
        %roving_elves_quest = 2;
        return;
    }
}
if (%roving_elves_quest >= 2) {
    if (%mourning_quest < 1) {
        // no seed yet — reminder (later rows add the seed / enchant stages)
        ~chatnpc("<p,neutral>Hello, any luck finding the consecration seed?");
        ~chatplayer("<p,neutral>No not yet.");
        ~chatnpc("<p,neutral>You should be able to find it in her old resting place, I think you said it was south east of Baxtorian Falls. You'll need to defeat one of the old tomb's guardians to obtain it. Bring it to me as soon as you find it, then I can re-enchant it.");
        ~chatplayer("<p,neutral>Okay, I'll see what I can do.");
        return;
    }
}
if (%mourning_quest >= 1) {
    @mep1_eluned_go;
}
@mep1_eluned_hello;

[label,mep1_eluned_hello]
~chatplayer("<p,happy>Hi there.");
~chatnpc("<p,happy>Hi... I hear you finished consecrating Glarial's tomb. Well done.");
~chatplayer("<p,neutral>It was a worthy deed.");
~chatnpc("<p,quiz>Oh... I have been asked to inform you, Arianwyn requests a meeting with you in Lletya.");
~chatplayer("<p,confused>Lletya?? I know nothing of this place.");
~chatnpc("<p,neutral>I will take you there if you like.");
def_int $go = ~p_choice2("Yes, I should go see him now.", 1, "I have a few things to do right now.", 2);
if ($go = 2) {
    @mep1_eluned_refuse;
}
~chatplayer("<p,happy>Yes, I should go see him now.");
if (%mourning_quest = 0) {
    %mourning_quest = 1;
}
~chatnpc("<p,happy>Well, let us go then.");
// Dest UNKNOWN — skip fade / crystal / Lletya stand.
return;

[label,mep1_eluned_refuse]
~chatplayer("<p,shifty>I have a few things to do right now.");
~chatnpc("<p,neutral>Sure thing, but he will not wait long.");
return;

[label,mep1_eluned_go]
~chatplayer("<p,happy>Hello again.");
~chatnpc("<p,quiz>Hello again... Arianwyn is requesting a meeting with you in Lletya. Do you want to go there now?");
def_int $again = ~p_choice2("Yes, I should go see him now.", 1, "I have a few things to do right now.", 2);
if ($again = 2) {
    @mep1_eluned_refuse;
}
~chatplayer("<p,happy>Yes, I should go see him now.");
~chatnpc("<p,happy>Well, let us go then.");
return;
