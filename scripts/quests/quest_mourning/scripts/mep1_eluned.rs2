// VERIFIED start and initial four-charge crystal: retained RuneHQ / Tip.It 2005–06.
// CANDIDATE dialogue: retained RS3 2013/2018, without later era additions.
// UNKNOWN refusal/service wording and escort presentation: mep1-runtime-defaults.

[opnpc1,roving_female_woodelf]
if (~roving_eluned = true) {
    return;
}
if (%mourning_quest = 0 & (%chompybird < ^chompybird_complete | %sheepherderquest < ^sheepherder_complete | stat_base(ranged) < 60 | stat_base(thieving) < 50)) {
    ~chatnpc("<p,neutral>You must complete Big Chompy Bird Hunting, Roving Elves and Sheep Herder, and have 60 Ranged and 50 Thieving before I can take you to Lletya.");
    return;
}
if (%mourning_quest > 0 & inv_total(inv, elf_crystal_tiny) > 0) {
    ~mep1_crystal_recharge;
    return;
}
if (%mourning_quest >= 1) {
    @mep1_eluned_go;
}
@mep1_eluned_hello;

[label,mep1_eluned_hello]
~chatplayer("<p,happy>Hi there.");
~chatnpc("<p,happy>Hi... I hear you finished consecrating Glarial's tomb. Well done.");
~chatplayer("<p,neutral>It was a worthy deed.");
~chatnpc("<p,quiz>Oh... I have been asked to inform you, Arianwyn requests a meeting with you in Lletya.");
~chatplayer("<p,confused>Lletya?? I know nothing of this place.");
~chatnpc("<p,neutral>I will take you there if you like.");
def_int $go = ~p_choice2("Yes, I should go see him now.", 1, "I have a few things to do right now.", 2);
if ($go = 2) {
    @mep1_eluned_refuse;
}
~chatplayer("<p,happy>Yes, I should go see him now.");
~chatnpc("<p,happy>Well, let us go then.");
~mep1_escort;
return;

[label,mep1_eluned_refuse]
~chatplayer("<p,shifty>I have a few things to do right now.");
~chatnpc("<p,neutral>Sure thing, but he will not wait long.");
return;

[label,mep1_eluned_go]
~chatplayer("<p,happy>Hello.");
~chatnpc("<p,quiz>Hello again, how is it going?");
~chatplayer("<p,neutral>Not bad, thank you.");
~chatnpc("<p,neutral>Oh... I have been asked to inform you, Arianwyn requests a meeting with you in Lletya. Do you want to go there now?");
def_int $again = ~p_choice2("Yes, I should go see him now.", 1, "I have a few things to do right now.", 2);
if ($again = 2) {
    @mep1_eluned_refuse;
}
~chatplayer("<p,happy>Yes, I should go see him now.");
~chatnpc("<p,happy>Well, let us go then.");
~mep1_escort;
return;
