// Main's explicit U1 defaults of 21 November; not recovered period algorithms.
// CANDIDATE ANCIENT_SMOKE_PROC: 2020/2025 Old School wiki, no Jagex source for Smoke.
// Period guides state poison without a chance; continuity to 2006 is not established.
^ancient_smoke_proc = 8
// VERIFIED RuneHQ (updated 7 April 2006): 10% for all four Shadow spells.
// Tip.It (updated 4 September 2005): 15% for Barrage only; the operator question is open.
// METHOD Conflicts selects the newest period value, 10%. Non-stacking threshold is CANDIDATE.
^ancient_shadow_drain_rule = 10
// UNKNOWN ANCIENT_SHADOW_ROUNDING: truncate base percentage, as stat_sub does.
^ancient_shadow_rounding = 100
// UNKNOWN ANCIENT_BLOOD_HEAL_RULE: ceil one quarter once per cast, base-HP cap.
^ancient_blood_heal_rule = 4
// UNKNOWN ANCIENT_ICE_IMMUNITY_POLICY: reuse Standard's post-freeze interval.
^ancient_ice_immunity_policy = 5
// UNKNOWN ANCIENT_ICE_IMMUNITY_POLICY: reuse Standard's protection divisor.
^ancient_ice_protection_divisor = 2
// CANDIDATE Standard and later Old School cast interval.
^ancient_cast_cooldown = 5

// VERIFIED 3x3 guide width; UNKNOWN ANCIENT_AREA_POLICY centre and tile membership.
^ancient_area_radius = 1
