// ANCIENT_STAFF_COMBAT_ROW: original staff_of_zaros (4675) fields kept below.
// VERIFIED bonuses: desert-treasure.ancient-staff-combat-row.
// CANDIDATE: existing weapon_staff combat-style route, not a recovered item field.
[staff_of_zaros]
name=Ancient staff
desc=A magical staff of ancient origin...
members=yes
model=obj_staff_of_zaros
2dxof=-5
2dyof=2
2dzoom=1490
2dyan=1400
2dxan=148
iop2=Wield
manwear=obj_staff_of_zaros_manwear,0
womanwear=obj_staff_of_zaros_manwear,6
cost=100000
wearpos=righthand
weight=5lb
category=weapon_staff
param=stabattack,10
param=slashattack,-1
param=crushattack,40
param=magicattack,15
param=rangeattack,0
param=stabdefence,2
param=slashdefence,3
param=crushdefence,1
param=magicdefence,15
param=rangedefence,0
param=strengthbonus,50
param=prayerbonus,-1
// UNKNOWN: Zybez gives plain/Iban/Ancient the same 2.5-second label; it cannot choose 4 or 5 ticks.
// Main's player-favourable default; research: desert-treasure.ancient-staff-melee-rate-1122.
param=attackrate,4
// UNKNOWN: no source read gives this staff's animations or sounds.
// It is a staff, so Main's engineering row uses the plain staff's named assets.
// Research: desert-treasure.ancient-staff-presentation-row.
param=ready_baseanim,human_staffready
param=crushattack_anim,human_staff_pummel
param=defend_anim,human_staff_block
param=crush_sound,staff_hit
param=walk_f_baseanim,human_halberdwalk_f
param=walk_b_baseanim,human_halberdwalk_b
param=walk_l_baseanim,human_halberdwalk_l
param=walk_r_baseanim,human_halberdwalk_r
param=running_baseanim,human_halberdrunning
param=turnonspot_baseanim,human_halberdturnonspot
