[mud_battlestaff]
name=Mud battlestaff
desc=It's a slightly magical stick.
cost=17000
model=obj_mud_battlestaff
2dxof=-2
2dyof=-3
2dzoom=1950
2dyan=560
2dxan=1816
iop2=Wield
manwear=obj_mud_battlestaff_manwear,0
womanwear=obj_mud_battlestaff_manwear,6
members=yes
wearpos=righthand
weight=5lb
// VERIFIED: RuneHQ Magic, captured 24 and 28 April 2006.
param=stabattack,7
param=slashattack,-1
param=crushattack,28
param=magicattack,10
param=rangeattack,0
param=stabdefence,2
param=slashdefence,3
param=crushdefence,1
param=magicdefence,10
param=rangedefence,0
param=strengthbonus,35
param=prayerbonus,0
// CANDIDATE: matching water and earth battlestaff rows; no combat-field difference.
category=weapon_staff
param=attackrate,5
param=ready_baseanim,human_staffready
param=crushattack_anim,human_stafforb_pummel
param=defend_anim,human_stafforb_block
param=crush_sound,staff_hit
param=walk_f_baseanim,human_halberdwalk_f
param=walk_b_baseanim,human_halberdwalk_b
param=walk_l_baseanim,human_halberdwalk_l
param=walk_r_baseanim,human_halberdwalk_r
param=running_baseanim,human_halberdrunning
param=turnonspot_baseanim,human_halberdturnonspot

