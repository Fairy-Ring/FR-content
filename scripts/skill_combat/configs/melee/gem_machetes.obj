[machette_opal]
name=Opal machete
desc=A jungle specific slashing device.
recol1s=23254
recol1d=29587
recol2s=17969
recol2d=12684
cost=500
model=obj_machette
2dxof=-2
2dyof=-12
2dzoom=770
2dyan=88
2dxan=200
iop2=Wield
manwear=obj_machette_manwear,0
womanwear=obj_machette_manwear,6
members=yes
wearpos=righthand
weight=3lb
// CANDIDATE: own Old School item page, revision 278950; equipment-data records conflicts.
param=stabattack,0
param=slashattack,8
param=crushattack,-2
param=magicattack,0
param=rangeattack,0
param=stabdefence,0
param=slashdefence,1
param=crushdefence,1
param=magicdefence,0
param=rangedefence,0
param=strengthbonus,4
param=prayerbonus,0
category=weapon_slash
// CANDIDATE: earliest numeric item speed, converted from the old speed-bar scale.
param=attackrate,5
// CANDIDATE: published plain machete and scimitar combat route.
// human_machette_chop and machete_slash belong to jungle chopping, not this combat route.
param=slashattack_anim,human_sword_slash
param=stabattack_anim,human_sword_stab
param=defend_anim,human_sword_def
param=slash_sound,hacksword_slash
param=stab_sound,hacksword_stab

