[ai_timer,_] ~npc_poison_timer;

[proc,npc_poison_timer]
// damage npc
%npc_poison = sub(%npc_poison, 1);
if (%npc_poison > 0) {
    if (npc_stat(hitpoints) = 0) { // already dead
        return;
    }
    npc_damage(^hitmark_poison, divide(add(%npc_poison, 4), 5));
    // They died
    if (npc_stat(hitpoints) = 0){
        npc_queue(3, 0, 0);
    }
} else {
    ~npc_poison_clear;
    return;
}

// Opt-in engineering: the caller invokes this once per run of its own timer.
// Poison keeps the published countdown, damage and lethal queue.
[proc,npc_poison_counted_timer](int $interval)
%npc_owned_timer_interval = $interval;
npc_settimer($interval);
if (%npc_poison <= 0) {
    %npc_poison_timer_runs = 0;
    return;
}
%npc_poison_timer_runs = add(%npc_poison_timer_runs, 1);
if (modulo(%npc_poison_timer_runs, 30) ! 0) return;
~npc_poison_timer;






[proc,npc_poison_clear]
%npc_poison = 0;
if (%npc_owned_timer_interval > 0) {
    npc_settimer(%npc_owned_timer_interval);
    %npc_poison_timer_runs = 0;
} else {
    npc_settimer(0); // npc_cleartimer?
}


[proc,npc_poison_start](int $severity)
if (~npc_is_attackable() = false) {
    return;
}
if (map_members = ^false) {
    return;
}

if ($severity > %npc_poison) {
    if (%npc_owned_timer_interval > 0) {
        npc_settimer(%npc_owned_timer_interval);
        %npc_poison_timer_runs = 0;
    } else {
        npc_settimer(30);
    }
    %npc_poison = $severity;
}
