// returns the calculated max hit for this npc
[proc,npc_melee_maxhit]()(int)
def_int $strengthbonus = npc_param(strengthbonus);
//npcs are essentially always on controlled
def_int $effective_strength = ~combat_effective_stat(npc_stat(strength), 100); // no prayerbonus
$effective_strength = add($effective_strength, 9); // 'style bonus' of 1
def_int $melee_strength = ~combat_stat($effective_strength, $strengthbonus);
return(~combat_maxhit($melee_strength));

// returns the npc attack roll for this npc
// npcs only have one attackbonus.
[proc,npc_melee_attack_roll]()(int)
if (~check_protect_prayer(^melee_style) = true) {
    return(0);
}
def_int $attackbonus = npc_param(attackbonus);
def_int $effective_attack = ~combat_effective_stat(npc_stat(attack), 100); // no prayerbonus
$effective_attack = add($effective_attack, 9); // 'style bonus' of 1
//npcs are essentially always on controlled
return(~combat_stat($effective_attack, $attackbonus));

// returns the npc attack roll for this npc, doesn't account for prot melee
// npcs only have one attackbonus.
[proc,npc_melee_attack_roll_typeless]()(int)
def_int $attackbonus = npc_param(attackbonus);
def_int $effective_attack = ~combat_effective_stat(npc_stat(attack), 100); // no prayerbonus
$effective_attack = add($effective_attack, 9); // 'style bonus' of 1
//npcs are essentially always on controlled
return(~combat_stat($effective_attack, $attackbonus));

// perform a basic melee attack from the npc to the player.
[proc,npc_meleeattack]
def_int $attack_roll = ~npc_melee_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(npc_param(damagetype));
def_int $maxhit = ~npc_melee_maxhit;

// CANDIDATE poison.successful-roll-trigger: only poisonous NPCs roll through
// the prayer. Keep every other attack's published accuracy and visible hit.
def_int $poison_prayer = 0;
if (npc_param(poison_severity) > 0 & ~check_protect_prayer(^melee_style) = true) {
    $attack_roll = ~npc_melee_attack_roll_typeless;
    $poison_prayer = 1;
}

~npc_meleeattack_resolve($attack_roll, $defence_roll, $maxhit, $poison_prayer);

// Policies: 0 ordinary, 1 ignore equipment but retain level/prayer/style,
// 2 unconditional accuracy (the caller supplies its protected maximum).
// Readiness and presentation remain at the caller's melee boundary.
[proc,npc_meleeattack_outcome](int $maxhit, int $defence_policy, boolean $protected_roll)(boolean, int, int, int, int)
if ($defence_policy = 2) {
    return(~npc_meleeattack_hit($maxhit, 0));
}
def_int $attack_roll = ~npc_melee_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(npc_param(damagetype));
if ($defence_policy = 1) {
    def_int $attack_bonus;
    def_int $strength_bonus;
    def_int $defence_bonus;
    def_int $ranged_bonus;
    $attack_bonus, $strength_bonus, $defence_bonus, $ranged_bonus = ~combat_get_damagestyle_bonuses(%damagestyle);
    def_int $effective_defence = ~combat_effective_stat(stat(defence), ~check_defence_prayer);
    $defence_roll = ~combat_stat(add(add($effective_defence, 8), $defence_bonus), 0);
}
def_int $poison_prayer = 0;
if (npc_param(poison_severity) > 0 & ~check_protect_prayer(^melee_style) = true) {
    $attack_roll = ~npc_melee_attack_roll_typeless;
    $poison_prayer = 1;
} else if ($protected_roll = true & ~check_protect_prayer(^melee_style) = true) {
    $attack_roll = ~npc_melee_attack_roll_typeless;
    $poison_prayer = 1;
}
return(~npc_meleeattack_resolve($attack_roll, $defence_roll, $maxhit, $poison_prayer));

[proc,npc_meleeattack_resolve](int $attack_roll, int $defence_roll, int $maxhit, int $poison_prayer)(boolean, int, int, int, int)
if (randominc($attack_roll) > randominc($defence_roll)) {
    return(~npc_meleeattack_hit($maxhit, $poison_prayer));
}
~playerhit_n_melee(0, npc_param(attackrate));
return(true, 0, 0, 0, 0);

[proc,npc_meleeattack_hit](int $maxhit, int $poison_prayer)(boolean, int, int, int, int)
def_int $rolled = randominc($maxhit);
def_int $damage = $rolled;
if ($poison_prayer = 1) {
    $damage = 0;
}
def_int $delivered = ~playerhit_n_melee($damage, npc_param(attackrate));
if ($damage = 0 & npc_param(poison_severity) > 0 & npc_stat(hitpoints) > 0) {
    ~npc_poison_player;
}
return(true, 1, $rolled, $delivered, 0);

[proc,playerhit_n_melee](int $damage, int $delay)(int)
if_close; // close the player interface when taking a hit.
// not sure if this is correct
~npc_set_attack_vars;
%npc_action_delay = add(map_clock, $delay);
if (npc_stat(hitpoints) = 0) {
    return(0); // melee npc's on 0 health play the hit animation but dont actually damage you
    // but ranged/mage npcs do! This is unique to melee!
}
queue(combat_damage_player, 0, $damage);
if (npc_param(poison_severity) > 0 & $damage > 0) {
    queue(poison_player, 0, npc_param(poison_severity));
}
queue*(playerhit_n_retaliate, 0)(npc_uid);
return($damage);
