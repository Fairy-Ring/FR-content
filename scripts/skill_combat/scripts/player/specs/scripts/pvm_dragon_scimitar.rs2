[label,pvm_dragon_scimitar_sa]
// VERIFIED: Sever costs 55% energy (2006 Special attacks, revision 3803).
~set_sa_vars(oc_param(inv_getobj(worn, ^wearpos_rhand), sa_energy));
def_int $damage = 0;
def_int $maxhit = ~player_npc_salve_scale(%com_maxhit);
// CANDIDATE: 125% accuracy against slash defence; ordinary maximum damage.
def_int $attack_roll = scale(^dragon_scimitar_accuracy, 100, ~player_npc_salve_scale(~player_attack_roll_specific(%damagetype)));
def_int $defence_roll = ~npc_defence_roll_specific(^slash_style);
if (npc_type = tbwt_beast) $attack_roll = 0;
if (randominc($attack_roll) > randominc($defence_roll)) {
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    if (npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth) {
        $maxhit = 0;
    }
    $damage = randominc(~npc_max_dealt($maxhit, 0));
    $damage = ~soulbane_rage_hit($damage, false);
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
// VERIFIED 377 resource identities; UNKNOWN original binding, height and delays.
anim(sp_attack_dragon_scimitar, 0);
sound_synth(sever, 1, 0);
spotanim_pl(sp_attack_dragon_scimitar_trail_spotanim, 96, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
if (npc_param(defend_anim) ! null) npc_anim(npc_param(defend_anim), 20);
if (npc_param(defend_sound) ! null) sound_synth(npc_param(defend_sound), 0, 20);
// NPCs receive only the accurate hit: protection-prayer prevention is PvP-only.
