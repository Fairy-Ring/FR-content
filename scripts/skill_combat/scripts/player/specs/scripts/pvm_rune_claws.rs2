// VERIFIED: Impale costs 25% and is slower/stronger (2006 Special attacks, revision 3803).
// CANDIDATE: 110% damage and one extra tick. UNKNOWN: original accuracy; preserve ordinary 289 roll.
[label,pvm_rune_claws_sa]
~set_sa_vars(oc_param(inv_getobj(worn, ^wearpos_rhand), sa_energy));
def_int $damage = 0;
def_int $maxhit = scale(110, 100, ~player_npc_salve_scale(%com_maxhit));
def_int $damage_capped = 0;
if (~player_npc_melee_hit_roll(%damagetype) = true) {
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    if (npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth) {
        $maxhit = 0;
    }
    $damage = randominc(~npc_max_dealt($maxhit, 0));
    $damage = ~soulbane_rage_hit($damage, false);
    $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
anim(impale, 0);
sound_synth(impale, 1, 0);
%action_delay = add(%action_delay, 1);
spotanim_pl(sp_attack_impale_spotanim, 96, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
if (npc_param(defend_anim) ! null) npc_anim(npc_param(defend_anim), 20);
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 0, 20); // delay npc this tick
}
