[if_button,questscroll_itgronigen:com_184] @set_autocast_spell(^shadow_barrage);

[label,open_autocast_interface]
if_close;
if (p_finduid(uid) = false) { // cant open autocast interface if delayed
    return;
}
~player_autocast_validate;
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if ($weapon = null | oc_category($weapon) ! weapon_staff) return;
%autocast_set = 0;
if (%alternate_spells = ^dt_spellbook_ancient) {
    // UNKNOWN engineering rule: an ineligible staff silently opens no picker.
    if ($weapon = staff_of_zaros & %deserttreasure = ^dt_stage_complete) {
        if_settab(questscroll_itgronigen, 0);
    }
} else {
    if_settab(staff_spells, 0);
}

[if_button,questscroll_itgronigen:com_6]
if_close;
~initalltabs;

[if_button,staff_spells:cancelspell]
if_close;
~initalltabs;

// todo: allow setting autocast to go through delays.
[label,set_autocast_spell](int $spell)
if_close;
if (p_finduid(uid) = true) {
    def_dbrow $spell_data = ~get_spell_data($spell);
    if (~player_autocast_allowed($spell, inv_getobj(worn, ^wearpos_rhand), %alternate_spells, %deserttreasure) = false) return;
    if (~check_spell_requirements($spell_data) = false) {
        return;
    }
    // set auto cast varp
    %autocast_spell = $spell;
    if_settext(combat_staff_2:auto_spell, db_getfield($spell_data, magic_spell_table:name, 0));

    ~initalltabs;
}

[proc,player_autocast_enabled]()(boolean)
if (testbit(%autocast_set, 0) = ^true & %autocast_spell > 0) {
    return(true);
}
return(false);

// Selection compatibility only. Per-cast level/rune checks stay in the resolver.
[proc,player_autocast_allowed](int $spell, obj $weapon, int $book, int $quest)(boolean)
if ($spell <= 0) return(true);
if ($weapon = null | oc_category($weapon) ! weapon_staff) return(false);
if (map_members = ^false & oc_members($weapon) = true) return(false);
def_dbrow $spell_data = ~get_spell_data($spell);
if (db_getfield($spell_data, magic_spell_table:ancient_effect, 0) ! null) {
    if ($weapon = staff_of_zaros & $book = ^dt_spellbook_ancient & $quest = ^dt_stage_complete) return(true);
    return(false);
}
if ($book ! ^dt_spellbook_standard) return(false);
if ($weapon = staff_of_zaros) return(^ancient_staff_standard_autocast);
return(true);

// UNKNOWN engineering rule: discard an incompatible selection on validation.
[proc,player_autocast_validate]
if (%autocast_spell <= 0) return;
if (~player_autocast_allowed(%autocast_spell, inv_getobj(worn, ^wearpos_rhand), %alternate_spells, %deserttreasure) = false) {
    ~player_autocast_reset;
}

[proc,.player_autocast_validate]
if (.%autocast_spell <= 0) return;
if (~player_autocast_allowed(.%autocast_spell, .inv_getobj(worn, ^wearpos_rhand), .%alternate_spells, .%deserttreasure) = false) {
    ~.player_autocast_reset;
}

[proc,player_autocast_reset]
%autocast_set = 0;
%autocast_spell = null;

[proc,.player_autocast_reset]
.%autocast_set = 0;
.%autocast_spell = null;
