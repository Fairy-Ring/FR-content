[proc,macro_capn_hand_spawn]
%npc_macro_event_target = uid;
%macro_event = ^macro_capn_hand;
%macro_event_uid = npc_uid;
%npc_int = 0;
npc_setmode(playerfollow);
npc_settimer(1);

[ai_timer,macro_pirate]
if (finduid(%npc_macro_event_target) = false) {
    npc_del;
    return;
}
if (~macro_overworld_owned(^macro_capn_hand) = false) {
    npc_del;
    return;
}
if (stat(hitpoints) = 0 | ~macro_event_area(coord) = false) {
    ~macro_overworld_finish(^macro_capn_hand);
    return;
}
if (%npc_int = ^macro_event_attack) {
    if (~macro_event_lost_hostile = true) {
        ~macro_overworld_finish(^macro_capn_hand);
    }
    return;
}
if (~macro_event_lost = true) {
    ~macro_overworld_finish(^macro_capn_hand);
    return;
}
%npc_int = add(%npc_int, 1);
if (%npc_int < ^macro_capn_attention_ticks) return;
%npc_int = ^macro_event_attack;
%aggressive_npc = npc_uid;
npc_setmode(applayer2);

[ai_applayer2,macro_pirate]
if (finduid(%npc_macro_event_target) = false) {
    npc_del;
    return;
}
if (~macro_overworld_owned(^macro_capn_hand) = false) {
    npc_del;
    return;
}
if (stat(hitpoints) = 0 | ~macro_event_area(coord) = false) {
    ~macro_overworld_finish(^macro_capn_hand);
    return;
}
if (npc_inrange = false) return;
~npc_rangeattack_outcome(npc_param(max_dealt), false, false);

[opnpc1,macro_pirate]
if (uid ! %npc_macro_event_target) return;
if (~macro_overworld_owned(^macro_capn_hand) = false) return;
~macro_event_capn_hand_reward;
~macro_overworld_finish(^macro_capn_hand);

[proc,macro_event_capn_hand_reward]
// CANDIDATE: Zybez post 14-Aug-2006 lists 120gp and 160gp; UNKNOWN: equal weights for gifts and coin amounts.
def_int $roll = random(^macro_capn_gift_outcomes);
if ($roll = 0) {
    def_int $coin_amount = random(^macro_capn_coin_amount_outcomes);
    if ($coin_amount = 0) inv_add(inv, coins, 120);
    else inv_add(inv, coins, 160);
    return;
}
switch_int($roll) {
    case 1 : inv_add(inv, uncut_sapphire, 1);
    case 2 : inv_add(inv, uncut_emerald, 1);
    case 3 : inv_add(inv, uncut_ruby, 1);
    case 4 : inv_add(inv, uncut_diamond, 1);
    case 5 : inv_add(inv, kebab, 1);
    case 6 : inv_add(inv, spinach_roll, 1);
    case 7 : inv_add(inv, keyhalf1, 1);
    case 8 : inv_add(inv, keyhalf2, 1);
}
