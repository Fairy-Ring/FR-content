// timer is initiated on login, in scripts\player\scripts\global.rs2
[timer,general_macro_events]
// make sure this is before afk_event is called, to retain the 'queueing' behavior for random event spawning
if (~macro_event_allowed = false) { 
    return;
}
if (afk_event = ^true) {
    // random events arent restricted in wildy? https://youtu.be/uPKaH7yg4To?t=421
    // Not restricted in banks: https://youtu.be/1Rz9Eg4ZHhA
    ~macro_event_general_spawn(~macro_event_set_random);
}


// this is called during:
// - alching. Confirmed: https://youtu.be/2nqpZoHUjSc?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT
// - teleporting. Confirmed: https://youtu.be/ZtnrEwb0n48?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=51
// (probably every spell)
// - cooking. Confirmed: https://youtu.be/Brq99Bdl0aI?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=198
// - cooking on a range: https://youtu.be/Tix1wbx3YCc?t=343
// - using flax wheel. Confirmed: https://youtu.be/sW48OR1I86M (early osrs)
// - using anvil? Cant find a video, not implemented.
// - fletching? Cant find a video, not implemented.
// - flax picking? Cant find a video, but it is implemented.
// - smithing at furnace. Confirmed? https://youtu.be/a6NobmSGBYw
// - crafting at furnace. Confirmed: https://youtu.be/7pS6s5rvvEY
[proc,macro_event_general_spawn](int $event)
if (~macro_event_allowed = false) { 
    return;
}
if (($event >= ^macro_drill & $event <= ^macro_leo) |
    ($event >= ^macro_maze & $event <= ^macro_quiz)) {
    if (~macro_arena_allowed = false) return;
}
// Registry dispatch precedes follower-square acquisition: arenas have no follower actor.
switch_int ($event) {
    case ^macro_arnav : { ~macro_arnav_start; return; }
    case ^macro_drill : { ~macro_drill_start; return; }
    case ^macro_bob : { ~macro_bob_start(fishing); return; } // UNKNOWN general-spawn skill default.
    case ^macro_forester : { ~macro_forester_start; return; }
    case ^macro_leo : { ~macro_leo_start; return; }
    case ^macro_maze : { ~macro_maze_start; return; }
    case ^macro_mime : { ~macro_mime_start; return; }
    case ^macro_pillory : { ~macro_pillory_start; return; }
    case ^macro_prison_pete : { ~macro_prison_pete_start; return; }
    case ^macro_quiz : { ~macro_quiz_start; return; }
}
if (~macro_event_npc($event) = null) return;
def_coord $event_coord = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk);
if ($event_coord = null) {
    return;
}
// A fresh frog admission writes its departure; login recreates without changing it.
if ($event = ^macro_frogs) %macro_event_origin_coord = coord;
~macro_event_general_create($event, $event_coord);

// The actor must exist before either encounter token is published.
[proc,macro_event_general_create](int $event, coord $event_coord)
def_npc $event_npc = ~macro_event_npc($event);
if ($event_npc = null) return;
npc_add($event_coord, $event_npc, 1000);
%macro_event = $event;
%macro_event_uid = npc_uid;
session_log(^log_moderator, "Random event spawned: <nc_debugname(npc_type)>");
// A lot of people say candlelight was rarer but maybe just bias since it didn't last long
switch_int ($event) {
    case ^macro_swarm : ~macro_swarm_spawn;
    case ^macro_triffidseed : ~macro_event_triffid_spawn;
    case ^macro_dwarf : ~macro_dwarf_spawn;
    case ^macro_geni : ~macro_geni_spawn;
    case ^macro_mysterious_old_man : ~macro_mysterious_old_man_spawn;
    case ^macro_candlelight : ~macro_candlelight_spawn;
    case ^macro_capn_hand : ~macro_capn_hand_spawn;
    case ^macro_rick_turpentine : ~macro_rick_turpentine_spawn;
    case ^macro_jekyll : ~macro_jekyll_spawn;
    case ^macro_evil_chicken : ~macro_evil_chicken_spawn;
    case ^macro_frogs : ~macro_frogs_spawn;
    case ^macro_certers : ~macro_certers_spawn;
    case ^macro_sandwich_lady : ~macro_sandwich_lady_spawn;
}

// this proc is used for random events teleing to follow the player
[proc,macro_event_area](coord $coord)(boolean)
if (~in_duel_arena($coord) = true) {
    return(false);
}
if (~inzone_coord_pair_table(gnomeball_zones, $coord) = true) {
    return(false);
}
if (~inzone_coord_pair_table(trawler_game_zones, $coord) = true | ~inzone_coord_pair_table(trawler_wreck_zones, $coord) = true) { // allowed on boat in pre-game https://youtu.be/7-gUR40Nr8M
    return(false);
}
if (~in_tutorial_island($coord) = true) {
    return(false);
}
return(true);

// Admission-only exclusions. Following into Castle Wars retains the accepted U01 fault.
[proc,macro_event_target_area](coord $where)(boolean)
if (region_findbycoord($where) = true) return(false);
if (~macro_event_area($where) = false) return(false);
// UNKNOWN admission policy: concrete private scenes, not a blanket underground band.
if (~inzone_coord_pair_table(macro_arena_protected_scenes, $where) = true) return(false);
if (~mta_room_at($where) ! 0) return(false);
if (~barrows_inside($where) = true | ~tog_inside($where) = true) return(false);
if (~inzone_coord_pair_table(games_room_zones, $where) = true) return(false);
if (~inzone_coord_pair_table(mining_camp_zones, $where) = true) return(false);
if (~inzone_coord_pair_table(mage_arena, $where) = true) return(false);
if (~in_castlewars_game($where) = true | ~in_castlewars_waitingroom($where) = true) return(false);
if (~fightpits_in_waiting($where) = true | ~fightpits_in_arena($where) = true) return(false);
if (~roguesden_maze_inside($where) = true) return(false);
return(true);

// this proc is only used for spawning randoms
[proc,macro_event_allowed]()(boolean)
if (~macro_event_target_area(coord) = false) {
    return(false);
}
// Original cutscene/transformation state is never a random-event admission point.
if (%cutscene_var ! 0 | %mm_cutscene_part ! 0 | p_gettransmogrify ! null) return(false);
if (inv_total(inv, thanainabarrel) > 0 | inv_total(inv, mm_monkey_in_backpack) > 0) return(false);
if (~champions_in_arena = true | ~bf_inside = true | ~tbw_in_village = true) return(false);
if (~inzone_coord_pair_table(random_event_mime_zones, coord) = true |
    ~inzone_coord_pair_table(random_event_maze_zones, coord) = true |
    ~inzone_coord_pair_table(random_event_lost_and_found_zones, coord) = true) {
    return(false);
}
// this goes here to allow this bug: https://youtu.be/c0HABEQe41s
// - bug desc: random events will follow you into castle wars
if (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) {
    return(false);
}
// if this var isnt reset on npc delete, then youll never get a random event: https://youtu.be/vRlOfkCCGkw
if (%macro_event > 0) {
    return(false);
}
return(true);

// called when the player logs in
[queue,macro_event_login]
// DECISION: an old save's zero slot is an unknown O, never a return to 0,0.
if (%macro_event ! ^no_macro_event & %macro_event_origin_coord = 0_0_0_0_0) {
    %macro_event_origin_coord = null;
}
// All arena lifecycle work remains in one integration hook.
if (~macro_event_arenas2_dispatch = true) return;
// DECISION: a task's identity, departure and intended destination are persistent.
if (%macro_event = ^macro_lost_and_found) {
    if (~inzone_coord_pair_table(random_event_lost_and_found_zones, coord) = true) {
        ~macro_events_hide_tabs;
    } else {
        ~macro_event_cleanup(%macro_event, %macro_event_uid);
    }
    return;
}
if (%macro_event = ^no_macro_event) {
    return;
}
// Candlelight owns its church, taper and departure lifecycle (plan U21).
// Do not treat its priest as a disposable non-restoring follower.
if (%macro_event = ^macro_candlelight) {
    if (~macro_candlelight_inside_church(coord) = true) {
        ~macro_events_hide_tabs;
        cam_reset;
    } else {
        ~macro_event_cleanup(^macro_candlelight, %macro_event_uid);
    }
    return;
}
if (~macro_event_arenas1_dispatch(0) = true) return;
if (nc_param(~macro_event_npc(%macro_event), follow_player_on_logout) = ^true) {
    if (~macro_event_area(coord) = false |
        ~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) {
        %macro_event = ^no_macro_event;
        return;
    }
    if (npc_finduid(%macro_event_uid) = true) {
        if (%npc_macro_event_target = uid) {
            if (%macro_event = ^macro_frogs) ~macro_frogs_login;
            return;
        }
    }
    def_coord $event_coord = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk);
    if ($event_coord ! null) {
        ~macro_event_general_create(%macro_event, $event_coord);
        if (%macro_event = ^macro_frogs) ~macro_frogs_login;
    }
} else {
    // Preserve published non-restoring event login: clear only the identity.
    %macro_event = ^no_macro_event;
}

[proc,macro_event_logout]
if (%macro_event = ^macro_candlelight) {
    // UNKNOWN engineering decision: retain inherited saved candles; remove only taper and camera.
    cam_reset;
    if (npc_finduid(%macro_event_uid) = true) {
        if (%npc_macro_event_target = uid) npc_del;
    }
    %macro_event_uid = null;
}
if (%macro_event = ^macro_maze) ~macro_maze_logout;
if (%macro_event = ^macro_mime) ~macro_mime_cleanup;
if (%macro_event = ^macro_quiz) ~macro_quiz_cleanup;
if (%macro_event = ^macro_prison_pete) ~macro_prison_pete_sync;
if (%macro_event >= ^macro_maze & %macro_event <= ^macro_quiz) return;
if (%macro_event = ^macro_frogs) ~macro_frogs_cleanup;
if (~macro_event_arenas1_dispatch(1) = true) return;
if (npc_finduid(%macro_event_uid) = true) {
    if (%npc_macro_event_target = uid) {
        %npc_macro_event_target = null;
    }
}

[proc,macro_event_npc](int $event)(npc)
switch_int ($event) {
    case ^macro_capn_hand : return(macro_pirate);
    case ^macro_rick_turpentine : return(macro_highwayman);
    case ^macro_jekyll : return(macro_jekyll);
    case ^macro_evil_chicken : return(macro_evil_chicken_1);
    case ^macro_frogs : return(macro_frog_royal);
    case ^macro_certers : return(macro_niles);
    case ^macro_sandwich_lady : return(macro_sandwich_lady_npc);
}
def_npc $event_npc;
if (map_members = ^true) {
    $event_npc = enum(int, npc, general_macro_events_members, $event);
} else {
    $event_npc = enum(int, npc, general_macro_events_free, $event);
}
return($event_npc);

[proc,macro_event_set_random]()(int)
def_enum $pool = ~macro_event_pool;
return(enum(int, int, $pool, add(random(enum_getoutputcount($pool)), 1)));

// used for skilling random events
[proc,macro_event_general_count]()(int)
return(enum_getoutputcount(~macro_event_pool));

[proc,macro_event_pool]()(enum)
if (map_members = ^false) return(macro_registry_free);
if (~macro_arena_combat_allowed = false) return(macro_registry_members_combat);
return(macro_registry_members);

// teleports the player to a random location, using the coords in configs/macro_events_teleports.enum
[queue,macro_event_fail_teleport](int $event, npc_uid $actor)
// The actor already released its identity; a newer encounter owns neither token.
if (%macro_event ! $event | %macro_event_uid ! $actor) {
    return;
}
session_log(^log_adventure, "Failed random event and got teleported");
def_coord $teleport_coord;
if (map_members = ^true) {
    $teleport_coord = enum(int, coord, macro_event_fail_teleports_members, random(enum_getoutputcount(macro_event_fail_teleports_members)));
} else {
    $teleport_coord = enum(int, coord, macro_event_fail_teleports_free, random(enum_getoutputcount(macro_event_fail_teleports_free)));
}
// https://youtu.be/MS7ADB-hh18
// doesnt if_close
p_delay(1);
// A delay is another boundary: never move a newer encounter.
if (%macro_event ! $event | %macro_event_uid ! $actor) {
    return;
}
if ($event >= ^macro_maze & $event <= ^macro_quiz) ~macro_event_cleanup($event, $actor);
%macro_event = ^no_macro_event;
%macro_event_uid = null;
%macro_event_target_coord = null;
%macro_event_origin_coord = null;
// https://youtu.be/g5k3XuXxyYQ?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=37
spotanim_map(smokepuff, coord, 124, 0);
sound_synth(smokepuff2, 1, 0);
//--
~tele_checks;
~p_telejump_safe($teleport_coord); // todo: Confirm this

// called when the npc needs to be poofed away
[proc,macro_event_disappear]
if (npc_findhero = ^true) {
    sound_synth(smokepuff2, 1, 0);
}
spotanim_map(smokepuff, npc_coord, 124, 0);
npc_del;

[proc,macro_event_lost]()(boolean)
if (finduid(%npc_macro_event_target) = true) {
    if (%macro_event_uid ! npc_uid) {
        return(true);
    }
    if (~macro_event_area(coord) = false) {
        return(true);
    }
    // https://youtu.be/vRlOfkCCGkw?t=87
    if (coordy(coord) ! coordy(npc_coord) | npc_range(coord) > 15) {
        npc_tele(map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk));
        spotanim_map(smokepuff, npc_coord, 124, 0);
        sound_synth(smokepuff, 1, 0);
    }
    npc_setmode(playerfollow);
    return(false);
}
return(true);

[proc,macro_event_lost_hostile]()(boolean)
if (finduid(%npc_macro_event_target) = true) {
    if (npc_getmode = wander & (npc_range(coord) > 3 | coordy(npc_coord) ! coordy(coord))) { // seems like distance of 3? https://www.youtube.com/watch?v=GoRX3cp58eo&list=PLn23LiLYLb1am4weMQzkWn5m9b3m9fXv9&t=38s
        return(true);
    }
    return(false);
}
return(true);
// based off https://web.archive.org/web/20060814111255/http://www.zybez.net/misc.php?id=11
[proc,macro_event_combat_level]()(int)
def_int $combat_level = ~player_combat_level;
if ($combat_level < 11) {
    return(^macro_event_cmb_14);
}
if ($combat_level < 21) {
    return(^macro_event_cmb_29);
}
if ($combat_level < 41) {
    return(^macro_event_cmb_49);
}
if ($combat_level < 61) {
    return(^macro_event_cmb_79);
}
if ($combat_level < 91) {
    return(^macro_event_cmb_120);
}

return(^macro_event_cmb_159);

// for 2x2 npcs
[proc,macro_event_coord_2x2]()(coord)
def_int $i = 0;
def_coord $sw;
def_coord $nw;
def_coord $se;
def_coord $ne;
// basically prevent the npc from spawning into anything it shouldnt. and so it doesnt spawn ontop of player
while ($i < 50) {
    $sw = movecoord(coord, ~random_range(-2, 2), 0, ~random_range(-2, 2));
    $nw = movecoord($sw, 1, 0, 0);
    $se = movecoord($sw, 0, 0, 1);
    $ne = movecoord($sw, 1, 0, 1);
    if (map_blocked($sw) = false & map_blocked($nw) = false & map_blocked($se) = false & map_blocked($ne) = false
        & $sw ! coord & $se ! coord & $nw ! coord & $ne ! coord
        & lineofwalk($sw, coord) = true
        ){
        return($sw);
    }
    $i = calc($i + 1);
}
return(null);

[proc,macro_events_hide_tabs]
// Native slots 8/9/10/11/13 retain friends, ignore, Logout, Options and music.
if_settab(null, 0);
if_settab(null, 1);
if_settab(null, 2);
if_settab(null, 3);
if_settab(null, 4);
if_settab(null, 5);
if_settab(null, 6);
if_settab(null, 12);

// Existing Candlelight exit caller; it must not erase a different encounter.
[proc,macro_events_varps_reset]
~macro_event_cleanup(^macro_candlelight, %macro_event_uid);

// DECISION: compare the caller's exact identity before releasing any state.
[proc,macro_event_cleanup](int $event, npc_uid $actor)
if ($event = ^no_macro_event | %macro_event ! $event | %macro_event_uid ! $actor) {
    return;
}
if ($event = ^macro_frogs) ~macro_frogs_cleanup;
if ($event >= ^macro_maze & $event <= ^macro_quiz) ~macro_event_arenas2_cleanup($event);
if (~macro_event_arenas1_dispatch(2) = true) ~initalltabs;
if ($event = ^macro_candlelight) {
    %macro_transmit = 0;
    if_close;
    cam_reset;
    ~initalltabs;
}
if (npc_finduid($actor) = true) {
    if (%npc_macro_event_target = uid) {
        npc_del;
    }
}
if ($event = ^macro_lost_and_found) {
    %macro_transmit = 0;
    ~initalltabs;
}
%macro_event = ^no_macro_event;
%macro_event_target_coord = null;
%macro_event_origin_coord = null;
%macro_event_uid = null;

