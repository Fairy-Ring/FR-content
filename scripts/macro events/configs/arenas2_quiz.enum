// VERIFIED 377 antimacro.obj quiz items grouped by their five native categories
// (food, weapon, armour, tool, jewel), two variants each, carrying native 2dzoom/2dxan/2dyan/recol.
[macro_quiz_item_models]
inputtype=int
outputtype=namedobj
val=0,macro_quiz_food1
val=1,macro_quiz_food2
val=2,macro_quiz_weapon1
val=3,macro_quiz_weapon2
val=4,macro_quiz_armour1
val=5,macro_quiz_armour2
val=6,macro_quiz_tool1
val=7,macro_quiz_tool2
val=8,macro_quiz_jewel1
val=9,macro_quiz_jewel2

// CANDIDATE pre-target Tip.It: a valuable uncut gem may appear in the box.
// The four-species selection and equal draw are UNKNOWN engineering defaults.
[macro_quiz_box_gems]
inputtype=int
outputtype=namedobj
val=0,uncut_sapphire
val=1,uncut_emerald
val=2,uncut_ruby
val=3,uncut_diamond
