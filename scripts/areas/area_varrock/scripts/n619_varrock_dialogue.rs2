// CANDIDATE wording from retained Old School transcript revisions cited in west-east-source.md.

[opnpc1,canoeing_tarquin]
~chatplayer("<p,happy>Hello there.");
~chatnpc("<p,happy>Hello old bean. Is there something I can help you with?");
def_int $option = ~p_choice2("Who are you?", 1, "Can you teach me about Canoeing?", 2);
if ($option = 1) {
    ~chatplayer("<p,quiz>Who are you?");
    ~chatnpc("<p,neutral>My name is Tarquin Marjoribanks.");
    ~chatnpc("<p,neutral>I'd be surprised if you haven't already heard of me?");
    ~chatplayer("<p,quiz>Why would I have heard of you Mr. Marjoribanks?");
    ~chatnpc("<p,neutral>It's pronounced 'Marchbanks'!");
    ~chatnpc("<p,neutral>You should know of me because I am a member of the royal family of Misthalin!");
    ~chatplayer("<p,quiz>Are you related to King Roald?");
    ~chatnpc("<p,neutral>Oh yes! Quite closely actually.");
    ~chatnpc("<p,neutral>I'm his 4th cousin, once removed on his mothers side.");
    ~chatplayer("<p,quiz>Er... Okay. What are you doing here then?");
    ~chatnpc("<p,happy>I'm canoeing on the river! It's enormous fun! Would you like to know how?");
    def_int $teach = ~p_choice2("Yes", 1, "No", 2);
    if ($teach = 1) {
        @n619_tarquin_teach("Could you teach me about canoes?");
    } else {
        ~chatplayer("<p,bored>No thanks, not right now.");
    }
} else {
    @n619_tarquin_teach("Can you teach me about canoes?");
}

[label,n619_tarquin_teach](string $question)
~chatplayer($question);
if (stat(woodcutting) < 12) {
    ~chatnpc("<p,neutral>Well, you don't look like you have the skill to make a canoe.");
    ~chatnpc("<p,neutral>You need to have at least level 12 woodcutting.");
    ~chatnpc("<p,neutral>Once you are able to make a canoe it makes travel along the river much quicker!");
    return;
}
~chatnpc("<p,neutral>It's really quite simple. Just walk down to that tree on the bank and chop it down.");
~chatnpc("<p,neutral>When you have done that you can shape the log further with your axe to make a canoe.");
~chatnpc("<p,neutral>My personal favourite is the Stable Dugout canoe. A finer craft you'll never see old bean!");
~chatnpc("<p,neutral>A Stable Dugout canoe will take you pretty much the length of the Lum river.");
~chatnpc("<p,neutral>Of course there are other canoes.");
if (stat(woodcutting) < 27) {
    ~chatnpc("<p,neutral>Further up river, near the Barbarian Village, I saw some darned fool 'canoeing' on a log!");
    ~chatnpc("<p,neutral>Unfortunately, you don't have the skill to create anything more than one of those logs. I dare say it will only get 1 stop down the river!");
    ~chatnpc("<p,neutral>Still, I'm sure it will satisfy one such as yourself.");
    ~chatplayer("<p,quiz>What's that supposed to mean?");
    ~chatnpc("<p,angry>Do not profane the royal house of Varrock by engaging me in further discourse you knave!");
    ~chatplayer("<p,angry>Pfft! I doubt he even knows the King!");
} else if (stat(woodcutting) < 42) {
    ~chatnpc("<p,neutral>You seem to be quite handy with an axe though!");
    ~chatnpc("<p,neutral>I'm sure you can build a Dugout canoe. Not as fine as a Stable Dugout but it will carry you 2 stops on the river.");
    ~chatnpc("<p,neutral>I should imagine it would suit your limited means.");
    ~chatplayer("<p,quiz>What do you mean when you say 'limited means'?");
    ~chatnpc("<p,neutral>Well, you're just an itinerant adventurer!");
    ~chatnpc("<p,angry>What possible reason would you have for cluttering up my river with your inferior water craft!");
} else if (stat(woodcutting) < 57) {
    ~chatnpc("<p,neutral>Ah! Perfect! You can make a Stable Dugout canoe! One of those will carry you to any civilised place on the river.");
    ~chatnpc("<p,neutral>If you were of good pedigree I'd let you join my boat club. You seem to be one of those vagabond adventurers though.");
    ~chatplayer("<p,neutral>Charming!");
    ~chatnpc("<p,angry>Be off with you rogue!");
} else {
    ~chatnpc("<p,neutral>Well ... erm. You seem to be able to make a Waka!");
    ~chatplayer("<p,quiz>Sounds fun, what's a Waka.");
    ~chatnpc("<p,neutral>I've only ever seen one man on the river who uses a Waka. A big, fearsome looking fellow up near Edgeville.");
    ~chatnpc("<p,neutral>People say he was born in the Wilderness and that he is looking for a route back.");
    ~chatplayer("<p,quiz>Is that true!");
    ~chatnpc("<p,neutral>How should I know? I would not consort with such a base fellow!");
}

[opnpc1,vc_pox]
~chatplayer("<p,happy>Hi cat!");
~chatnpc("<p,happy>Miaooow!");

[opnpc1,vc_hooknosed_jack]
if (~ratcatch_jack_hook = true) return;
~chatplayer("<p,happy>Hello.");
~chatnpc("<p,neutral>What?");
~chatnpc("<p,neutral>Actually I've got no time for this. I don't want to talk to you.");
