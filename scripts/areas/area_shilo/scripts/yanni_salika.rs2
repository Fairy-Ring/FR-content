// Shop path is live Shilo antiques (RuneHQ city-guide). OSF favour branch is
// CANDIDATE last-resort 2007-base (Transcript:One Small Favour minus ~Feb 2022
// overlay / RS3 Overview / hatchet). Hunt 289? no. Accept %onesmallfavour 0→1.
// Mahogany-return leftover (cite osf-yanni-mahogany-return-377.md): prefix only
// when >= 42 + inv 4445. Consume 4445. 42→43.
// Key ring award leftover (cite osf-key-ring-award-377.md): inv_add 4446 once
// on the same rant. 43→44. Name-only 4447. No dest / leftover 12346 /
// Check-keys / lamps grant / shop rewrite.

[opnpc1,shiloantiques]
~chatplayer("<p,neutral>Hello there!");
if (%onesmallfavour > 0) {
    @yanni_osf_progress_menu;
}
@yanni_osf_start_menu;

[label,yanni_osf_start_menu]
~chatnpc("<p,happy>Greetings Bwana! My name is Yanni and I buy and sell antiques.");
def_int $start = ~p_choice4("Tell me about this antiques business.", 1, "Is there anything else interesting to do around here?", 2, "Do you have any interesting items for sale?", 3, "Hmm, sorry, not interested.", 4);
if ($start = 1) {
    ~chatplayer("<p,quiz>Tell me about this antiques business.");
    @yanni_antiques_quote;
} else if ($start = 2) {
    @yanni_osf_offer;
} else if ($start = 3) {
    @yanni_items_for_sale;
}
~chatplayer("<p,neutral>Hmm, sorry, not interested.");
~chatnpc("<p,neutral>Fair enough, come back if you change your mind.");
return;

[label,yanni_osf_offer]
~chatplayer("<p,quiz>Is there anything else interesting to do around here?");
~chatnpc("<p,quiz>You sound a bit bored of Shilo Village...what's wrong?");
~chatplayer("<p,neutral>Nothing, I was just wondering if there was anything else to do?");
~chatnpc("<p,neutral>Well, if you're bored, you could do me a small favour and nip to see the jungle forester. I need a piece of red mahogany to resurface an antique wardrobe.");
@yanni_osf_fiveway;

[label,yanni_osf_fiveway]
def_int $fav = ~p_choice5("You want me to do you a favour?", 1, "An adventurer of my calibre, isn't that overkill.", 2, "What are you going to give me if I do it?", 3, "Nah thanks, I've got bigger fish to fry.", 4, "Ok, see you in a tick!", 5);
if ($fav = 1) {
    ~chatplayer("<p,quiz>You want me to do you a favour?");
    ~chatnpc("<p,neutral>Well, if you've got nothing better to do...I mean, you looked bored.");
    @yanni_osf_fiveway;
} else if ($fav = 2) {
    ~chatplayer("<p,happy>An adventurer of my calibre, isn't that overkill.");
    ~chatnpc("<p,shock>Coooiii! Sorry your most amazingness, didn't realise you were too above it all to do someone a favour!");
    @yanni_osf_fiveway;
} else if ($fav = 3) {
    ~chatplayer("<p,quiz>What are you going to give me if I do it?");
    ~chatnpc("<p,angry>Give you? I don't think you heard me...I asked for a favour! It means that I'll 'owe you one' when you need something doing. That's what a favour is!");
    @yanni_osf_fiveway;
} else if ($fav = 4) {
    ~chatplayer("<p,neutral>Nah thanks, I've got bigger fish to fry.");
    ~chatnpc("<p,neutral>Fair enough! Hope it all goes well...but, you know, you looked bored so I just thought I'd suggest it.");
    return;
}
@yanni_osf_accept;

[label,yanni_osf_accept]
~chatplayer("<p,happy>Ok, see you in a tick!");
~chatnpc("<p,happy>Great, nice of you to do it for me.");
%onesmallfavour = 1;
def_int $go = ~p_choice2("I'll get going then!", 1, "Where do I meet this jungle forester?", 2);
if ($go = 2) {
    ~chatplayer("<p,quiz>Where do I meet this jungle forester?");
    ~chatnpc("<p,neutral>Oh, sorry, I thought you knew the area. You'll find a jungle forester in between the southern edge of Shilo Village and the Kharazi Jungle.");
    ~chatnpc("<p,neutral>They're always trying to find ways into that place.");
    ~chatnpc("<p,neutral>I hear that some old timer from the Legends Guild keeps sending new recruits down there..only Zamorak knows why.");
    return;
}
~chatplayer("<p,happy>I'll get going then!");
~chatnpc("<p,happy>That'd be helpful!");
return;

[label,yanni_osf_progress_menu]
~chatnpc("<p,happy>Greetings Bwana! My name is Yanni and I buy and sell antiques.");
if (%onesmallfavour >= 42) {
    if (%onesmallfavour < 43) {
        if (inv_total(inv, favour_mahogany_log) >= 1) {
            @yanni_osf_mahogany_menu;
        }
    }
}
def_int $prog = ~p_choice3("Tell me about this antiques business.", 1, "What was I supposed to do again?", 2, "Do you have any interesting items for sale?", 3);
if ($prog = 1) {
    ~chatplayer("<p,quiz>Tell me about this antiques business.");
    @yanni_antiques_quote;
} else if ($prog = 2) {
    @yanni_osf_reminder;
}
@yanni_items_for_sale;

[label,yanni_osf_mahogany_menu]
// Prefix only. Keep shop / reminder / sale. Exact index vs live 3-way = UNKNOWN.
def_int $mh = ~p_choice4("Here's the red mahogany you asked for.", 1, "Tell me about this antiques business.", 2, "What was I supposed to do again?", 3, "Do you have any interesting items for sale?", 4);
if ($mh = 1) {
    @yanni_osf_mahogany_return;
} else if ($mh = 2) {
    ~chatplayer("<p,quiz>Tell me about this antiques business.");
    @yanni_antiques_quote;
} else if ($mh = 3) {
    @yanni_osf_reminder;
}
@yanni_items_for_sale;

[label,yanni_osf_mahogany_return]
// CANDIDATE Returning to Yanni with the red mahogany minus Quest complete /
// toolbelt / topic / 2022 overlay. Grant 4446 once. Name-only two lamps.
~chatplayer("<p,happy>Here's the red mahogany you asked for.");
~chatnpc("<p,happy>Well, that's absolutely wonderful my friend! Many thanks!");
~chatplayer("<p,quiz>What, that's it?");
~chatnpc("<p,quiz>Well...what were you expecting? I mean, it took you so long I could have gone and got it myself!");
~chatplayer("<p,angry>What! I've traipsed halfway around Gielinor...");
~chatplayer("<p,angry>I've negociated with fanatics, dwarven gangsters and arrogant gnomes.");
~chatplayer("<p,angry>I've fixed ancient weather vanes and gnomish landing lights and fought supernatural rock monsters...");
~chatplayer("<p,angry>I've filled stodgy mattresses with feathers, made pot lids to help cure an ailing metal-smith...and that's all the thanks I get? 'Thanks!'");
~chatnpc("<p,neutral>Well, you didn't have to go to so much trouble...");
~chatplayer("<p,angry>Raarrrhhhh!");
~chatnpc("<p,neutral>Look, I can see that you're quite upset about this...so here, have this.");
~objbox(favour_key_ring, "Yanni shows you a small metallic ring.", 250, 0, 0);
~chatplayer("<p,quiz>What is it?");
~chatnpc("<p,neutral>It's a key ring, you can store some of your most valuable keys on it...helps to keep things organised!");
~chatplayer("<p,quiz>A key ring? That's it?");
~chatnpc("<p,neutral>Well, I only asked you to do me one small favour...");
~chatplayer("<p,sad>Groan! Yeah, so did everyone else!");
~chatnpc("<p,neutral>Oh....ok, I guess I could offer you these lamps...I'm not sure what they're worth, but you can have them.");
~objbox(thosf_reward_lamp, "Yanni offers you two unusual looking lamps.", 250, 0, 0);
inv_del(inv, favour_mahogany_log, 1);
if (%onesmallfavour = 42) {
    %onesmallfavour = 43;
}
if (inv_total(inv, favour_key_ring) < 1) {
    inv_add(inv, favour_key_ring, 1);
}
if (%onesmallfavour = 43) {
    %onesmallfavour = 44;
}
return;

[label,yanni_osf_reminder]
~chatnpc("<p,quiz>What do you mean?");
def_int $rem = ~p_choice4("I've forgotten what to do, can you remind me?", 1, "This is taking longer than I expected!", 2, "Is there an easier way of getting this exotic wood?", 3, "Ok, thanks.", 4);
if ($rem = 1) {
    ~chatplayer("<p,confused>I've forgotten what to do, can you remind me?");
    ~chatnpc("<p,neutral>Tsk....It's only a little job bwana, I ask you to do me one small favour! Go to the jungle forester and get me a piece of red mahogany. It can't be that difficult can it?");
} else if ($rem = 2) {
    ~chatplayer("<p,sad>This is taking longer than I expected!");
    ~chatnpc("<p,angry>You're telling me bwana, I was supposed to have this wardrobe finished before now! Hurry it up will you, I don't have all day!");
} else if ($rem = 3) {
    ~chatplayer("<p,quiz>Is there an easier way of getting this exotic wood?");
    ~chatnpc("<p,angry>Huh! You make it sound like a major undertaking! I should have just done it myself!");
    ~chatplayer("<p,sad>Everyone is asking me to do them favours now! It seems like I've opened the floodgates!");
    ~chatnpc("<p,quiz>Well, can't you just do my favour and forget about theirs?");
} else {
    ~chatplayer("<p,neutral>Ok, thanks.");
}
return;

[label,yanni_items_for_sale]
// CANDIDATE: OSRS sale-restock of Beads is later / incomplete on the transcript.
// Do not invent stock. Keep opnpcu sells.
~chatplayer("<p,quiz>Do you have any interesting items for sale?");
~chatnpc("<p,neutral>Sorry, <text_gender("Sir", "Madam")>, I have nothing that you need.");
return;

[label,yanni_antiques_quote]
// https://web.archive.org/web/20050204071450im_/http://www.runehq.com//images/cityguides/shilo9.jpg
~chatnpc("<p,neutral>I buy antiques and other interesting items.|If you have any interesting items that you might want to sell me, please let me see them and I'll offer you a fair price.");
~chatnpc("<p,neutral>Would you like me to have a look at your items|and give you a quote?");
switch_int(~p_choice2("Yes please!", 1, "Maybe some other time?", 2)) {
    case 1 :
        ~chatplayer("<p,neutral>Yes please!");
        ~mesbox("Yanni looks through your items...");
        def_int $item_count = 0;
        if(inv_total(inv, zqbonekey) > 0) {
            ~chatnpc("<p,neutral>I'll give you 100 Gold for the Bone Key.");
            $item_count = add($item_count,1);
        }
        if(inv_total(inv, zqplaque) > 0) {
            ~chatnpc("<p,neutral>I'll give you 100 Gold for the Stone Plaque.");
            $item_count = add($item_count,1);
        }
        if(inv_total(inv, zqberviriusscroll) > 0) {
            ~chatnpc("<p,neutral>I'll give you 100 Gold for the tattered scroll.");
            $item_count = add($item_count,1);
        }
        if(inv_total(inv, zqrashiliyiascroll) > 0) {
            ~chatnpc("<p,neutral>I'll give you 100 Gold for the crumpled scroll.");
            $item_count = add($item_count,1);
        }
        if(inv_total(inv, zqberviriusscroll2) > 0) {
            ~chatnpc("<p,neutral>I'll give you 100 Gold for the crumpled scroll."); // intentional
            $item_count = add($item_count,1);
        }
        if(inv_total(inv, zqcrystal) > 0) {
            ~chatnpc("<p,neutral>I'll give you 500 Gold for your locating crystal.");
            $item_count = add($item_count,1);
        }
        if(inv_total(inv, zqdeadbeads) > 0) {
            ~chatnpc("<p,neutral>I'll give you 1000 Gold for your 'Beads of the Dead'.");
            $item_count = add($item_count,1);
        }
        if($item_count = 0) {
            ~chatnpc("<p,neutral>Sorry Bwana, you have nothing I am interested in.");
        } else if($item_count = 1) {
            ~chatnpc("<p,neutral>And that's the only item I am interested in.|If you want to sell me that item, simply show it to me.");
        } else {
            ~chatnpc("<p,neutral>Those are the items I am interested in Bwana. If you want to sell me those items, simply show them to me.");
        }
    case 2 :
        ~chatplayer("<p,neutral>Maybe some other time?");
        ~chatnpc("<p,neutral>Sure thing.|Have a nice day Bwana.");
}
return;

[opnpcu,shiloantiques]
switch_obj(last_useitem) {
    case zqbonekey :
        ~chatnpc("<p,neutral>That's a great bone key. here's 100 Gold for it.");
        mes("You sell the bone key for 100 gold.");
        inv_del(inv, zqbonekey, ^max_32bit_int);
        inv_del(bank, zqbonekey, ^max_32bit_int);
        inv_add(inv, coins, 100);
    case zqplaque :
        ~chatnpc("<p,neutral>That's a great stone-plaque. here's 100 Gold for it.");
        mes("You sell the stone-plaque for 100 gold.");
        inv_del(inv, zqplaque, ^max_32bit_int);
        inv_del(bank, zqplaque, ^max_32bit_int);
        inv_add(inv, coins, 100);
    case zqberviriusscroll :
        ~chatnpc("<p,neutral>That's a great tattered scroll. here's 100 Gold for it.");
        mes("You sell the tattered scroll for 100 gold.");
        inv_del(inv, zqberviriusscroll, ^max_32bit_int);
        inv_del(bank, zqberviriusscroll, ^max_32bit_int);
        inv_add(inv, coins, 100);
    case zqrashiliyiascroll :
        ~chatnpc("<p,neutral>That's a great crumpled scroll. here's 100 Gold for it.");
        mes("You sell the crumpled scroll for 100 gold.");
        inv_del(inv, zqrashiliyiascroll, ^max_32bit_int);
        inv_del(bank, zqrashiliyiascroll, ^max_32bit_int);
        inv_add(inv, coins, 100);
    case zqberviriusscroll2 :
        ~chatnpc("<p,neutral>That's a great copy of Bervirius notes. here's 100 Gold for it.");
        mes("You sell the Bervirius notes for 100 gold.");
        inv_del(inv, zqberviriusscroll2, ^max_32bit_int);
        inv_del(bank, zqberviriusscroll2, ^max_32bit_int);
        inv_add(inv, coins, 100);
    case zqcrystal :
        ~chatnpc("<p,neutral>That's a great Locating Crystal. Here's 500 Gold for it.");
        mes("You sell the locating crystal for 500 gold.");
        inv_del(inv, zqcrystal, ^max_32bit_int);
        inv_del(bank, zqcrystal, ^max_32bit_int);
        inv_add(inv, coins, 500);
    case zqdeadbeads :
        ~chatnpc("<p,neutral>Impressive necklace there, here's 1000 Gold for it.");
        mes("You sell the 'Beads of the Dead' for 1000 gold.");
        inv_del(inv, zqdeadbeads, ^max_32bit_int);
        inv_del(bank, zqdeadbeads, ^max_32bit_int);
        inv_add(inv, coins, 1000);
    case default :
        ~chatnpc("<p,neutral>I'm sorry Bwana but I just don't have a use for that!");
}
