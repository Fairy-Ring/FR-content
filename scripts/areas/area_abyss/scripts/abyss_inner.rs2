[oploc1,abyss_exit_to_law]
// CANDIDATE: Law_rift access requirement; subtract the November 2026 equipment relaxation.
if (%troll_quest < ^troll_complete) {
    mes("You need to have completed Troll Stronghold to use this rift.");
    return;
}
// CANDIDATE: 2006-07-26 Abyss guide explicitly retains Entrana's equipment rule.
if (~has_entrana_restricted_items = true) {
    // CANDIDATE wording: OSRS Transcript:Law_rift.
    mes("The power of Saradomin prevents you taking armour or weaponry to Entrana.");
    return;
}
// UNKNOWN exact historical landing: use the existing law altar entrance on the 377 map.
p_telejump(0_38_75_32_19);

[oploc1,abyss_exit_to_death]
// CANDIDATE: Death_rift requires MEP2; reuse the registry's candidate completion predicate.
if (%mourning_quest_main < ^mourning2_complete) {
    // CANDIDATE wording: OSRS Transcript:Death_rift.
    mes("A strange power blocks your exit.");
    return;
}
// UNKNOWN exact historical landing: use the existing death altar entrance on the 377 map.
p_telejump(0_34_75_32_29);

