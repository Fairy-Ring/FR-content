[opnpc1,ardounge_wizard]
~chatnpc("<p,neutral>Hello there.|My name is Cromperty.|I am a Wizard, and an inventor.");
// One Small Favour leftover after Petra Search 16→17. Keep inventor / essence.
// CANDIDATE last-resort 2007-base (OSRS Transcript:One Small Favour Cromperty).
// No dest / oxide grant / 12346. Hunt 289? no.
if (%onesmallfavour >= 17) {
    def_int $osf = 0;
    if (%onesmallfavour >= 18) {
        $osf = ~p_choice2("What did you want me to do again?", 1, "Something else.", 2);
    } else {
        $osf = ~p_choice2("I need to talk to you about a girl stuck in some rock!", 1, "Something else.", 2);
    }
    if ($osf = 1) {
        @osf_cromperty_rock;
    }
}
if(%runemysteries = ^runemysteries_complete) {
@multi3("Two jobs? That's got to be tough.", cromperty_two_jobs, "So what have you invented?", cromperty_what_invented, "Can you teleport me to the Rune Essence?", cromperty_ess);
} else {
@multi2("Two jobs? That's got to be tough.", cromperty_two_jobs, "So what have you invented?", cromperty_what_invented);
}

[opnpc3,ardounge_wizard]
@teleport_to_essence_mine(^essence_mine_to_cromperty);

[label,cromperty_two_jobs]
~chatplayer("<p,neutral>Two jobs? That's got to be tough.");
~chatnpc("<p,happy>Not when you combine them it isn't!|I invent MAGIC things!");
def_int $option = ~p_choice2("So what have you invented?", 1, "Well, I shall leave you to your inventing.", 2);
if($option = 1) {
    @cromperty_what_invented;
} else if($option = 2) {
    ~chatplayer("<p,confused>Well, I shall leave you to your inventing.");
    ~chatnpc("<p,neutral>Thank you for dropping by! Stop again anytime!");
}

[label,cromperty_what_invented]
~chatplayer("<p,quiz>So what have you invented?");
~chatnpc("<p,happy>Ah! My latest invention is my patent pending teleportation block! It emits a low level magical signal, that will allow me to locate it anywhere in the world, and teleport anything");
~chatnpc("<p,happy>directly to it! I hope to revolutionise the entire teleportation system! Don't you think I'm great? Uh, I mean it's great?");
def_int $option = ~p_choice3("So where is the other block?", 1, "Can I be teleported please?", 2, "Well done, that's very clever.", 3);
if($option = 1) {
    ~chatplayer("<p,quiz>So where is the other block?");
    ~chatnpc("<p,confused>Well... Hmm. I would guess somewhere between here and the Wizards' Tower in Misthalin. All I know is that it hasn't got there yet as the wizards there would have contacted me.");
    ~chatnpc("<p,sad>I'm using the RPDT for delivery. They assured me it would be delivered promptly.");
    $option = ~p_choice2("Can I be teleported please?", 1, "Who are the RPDT?", 2);
    if($option = 1) {
        @cromperty_teleport;
    } else if($option = 2) {
        ~chatplayer("<p,quiz>Who are the RPDT?");
        ~chatnpc("<p,happy>The RuneScape Parcel Delivery Team. They come very highly recommended. Their motto is: 'We aim to deliver your stuff at some point after you have paid us!'");
    }
} else if($option = 2) {
    @cromperty_teleport;
} else if($option = 3) {
    ~chatplayer("<p,neutral>Well done, that's very clever.");
    ~chatnpc("<p,happy>Yes it is isn't it? Forgive me for feeling a little smug, this is a major breakthrough in the field of teleportation!");
}

[label,cromperty_ess]
~chatplayer("<p,quiz>Can you teleport me to the Rune Essence?");
@teleport_to_essence_mine(^essence_mine_to_cromperty);

[label,cromperty_teleport]
~chatplayer("<p,quiz>Can I be teleported please?");
~chatnpc("<p,neutral>By all means! I'm afraid I can't give you any specifics as to where you will come out however. Presumably wherever the other block is located.");
def_int $option = ~p_choice2("Yes, that sounds good. Teleport me!", 1, "That sounds dangerous. Leave me here.", 2);
if($option = 1) {
    ~chatplayer("<p,neutral>Yes, that sounds good. Teleport me!");
    ~chatnpc("<p,happy>Okey dokey! Ready?");
    if(%totemquest < ^totem_complete) {
        @rpdt_teleport;
    }
    ~chatnpc("<p,confused>Hmm.... that's odd... I can't seem to get a signal...");
} else if($option = 2) {
    ~chatplayer("<p,shock>That sounds dangerous. Leave me here.");
    ~chatnpc("<p,neutral>As you wish.");
}

[label,rpdt_teleport]
if_close;
npc_say("Dipsolum sententa sententi!");
spotanim_pl(curse_impact, 124, 70);
spotanim_npc(curse_casting, 92, 0);
// IncompleteProjectile(id = 109, startHeight = 31, endHeight = 31, delay = 61, angle = 16, distOffset = 128)	
sound_synth(curse_all, 0, 0);
p_delay(4);
def_coord $coord = 0_41_51_25_7;
if (%totemquest >= ^totem_crate_delivered) {
    $coord = 0_41_51_14_57;
    if(%totemquest = ^totem_crate_delivered) {
        %totemquest = ^totem_teleported; // Not sure why this needs to be a stage, but it updates the varp on OSRS
    }
}
p_telejump($coord);

[label,osf_cromperty_rock]
if (%onesmallfavour >= 18) {
    ~chatplayer("<p,quiz>What did you want me to do again?");
    ~chatnpc("<p,neutral>Go to Port Khazard and get me some iron oxide from Tindel Marchant.");
    return;
}
~chatplayer("<p,neutral>I need to talk to you about a girl stuck in some rock!");
~chatnpc("<p,shock>Eh!");
~chatnpc("<p,shock>What? I have no clue what you're talking about! Now, please excuse me! I need to get back to my experiments!");
~chatplayer("<p,angry>Hey! Not so fast! I've seen a young girl encased in rock, a note in her belt led me to you.");
~chatnpc("<p,sad>Oh dear, it's such a bother getting them back out of the rock walls and I do loathe the trip to Port Khazard for the components.");
~chatplayer("<p,shock>What the demonikin are you talking about?");
~chatnpc("<p,neutral>Well, it's not the first time someone's been teleported into a rock face, just the slightest miscalculation and bang...they're in the wall!");
~chatnpc("<p,neutral>It's fairly straightforward to cast a spell and fish them out again - but it requires a spell component from a chap in Port Khazard.");
~chatnpc("<p,quiz>I don't suppose you could do me a small favour could you?");
~chatnpc("<p,happy>Just one small favour? Pop along to Port Khazard and get some iron oxide, it's a component of the spell.");
def_int $yes = ~p_choice2("Oh! Ok, one more 'small favour' isn't going to kill me...I hope!", 1, "No way am I going to Port Khazard for you!", 2);
if ($yes = 2) {
    ~chatplayer("<p,angry>No way am I going to Port Khazard for you!");
    ~chatnpc("<p,sad>Oh dear, what a shame...I just don't have time to deal with this now...she's safe where she is for now, and I'm sure I'll get to it sooner or later.");
    return;
}
~chatplayer("<p,happy>Oh! Ok, one more 'small favour' isn't going to kill me...I hope!");
~chatnpc("<p,happy>Waaahaaay! Great! I'd never suspect you'd be so helpful!");
~chatnpc("<p,neutral>You need to talk to a chap called Tindel Marchant in Port Khazard, he's sort of like an antiques dealer.");
~chatnpc("<p,happy>Well, off you go then! A journey of a thousand miles starts with the first step and all that!");
~chatplayer("<p,shock>What? Are you saying I have to travel a thousand miles?");
~chatnpc("<p,neutral>Of course not...you silly...just...you know...the sooner you start the sooner you can get back...that's all I was saying.");
if (%onesmallfavour = 17) {
    %onesmallfavour = 18;
}
return;
