[proc,apply_chill]
def_int $i = 1;
def_stat $stat;
while ($i <= enum_getoutputcount(stats)) {
    $stat = enum(int, stat, stats, $i);
    // Only subtract if the current value is greater than 1
    if (stat($stat) > 1) {
        if ($stat ! hitpoints) {
            stat_sub($stat, 1, 0);
        } else {
            queue(damage_player, 0, 1);
        }
    }
    $i = calc($i + 1);
}
if (p_finduid(uid) = true) {
    %sa_energy = 0;
    healenergy(-10000);
}

[proc,refresh_chill]
settimer(chill, 10);

[proc,clear_chill_timer]
if (inzone(0_44_58_0_24, 0_44_58_15_39, coord) = false) {
    cleartimer(chill);
}

[timer,chill]
// Native player timers repeat at their interval until cleared.
if (~inzone_coord_pair_table(chill_zones, coord) = true) {
    ~apply_chill;
}

// The cold rectangle spans four 8x8 zones. Keep the exact effect bounds in the table.
[zone,0_44_58_0_24]
~refresh_chill;
[zone,0_44_58_8_24]
~refresh_chill;
[zone,0_44_58_0_32]
~refresh_chill;
[zone,0_44_58_8_32]
~refresh_chill;

[zoneexit,0_44_58_0_24]
~clear_chill_timer;
[zoneexit,0_44_58_8_24]
~clear_chill_timer;
[zoneexit,0_44_58_0_32]
~clear_chill_timer;
[zoneexit,0_44_58_8_32]
~clear_chill_timer;

[mapzone,0_44_58]
if_openoverlay(overlay_atmosphere_snow_flakes);
@music_playbyregion(coord);

[mapzoneexit,0_44_58]
if_openoverlay(null);
cleartimer(chill);
