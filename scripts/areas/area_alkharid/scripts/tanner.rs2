[opnpc1,ellis_tanner]
// Treasure Trail
if(map_members = ^true & inv_total(inv, trail_clue_easy_simple008) = 1) {
    @trail_tanner;
}
~chatnpc("<p,happy>Greetings friend. I am a manufacturer of leather.");
def_int $total = calc(inv_total(inv, cow_hide) + inv_total(inv, dragonhide_green) + inv_total(inv, dragonhide_blue) + inv_total(inv, dragonhide_red) + inv_total(inv, dragonhide_black));
if($total > 0) {
    if ($total = 1) {
        ~chatnpc("<p,happy>I see you have brought me a hide.|Would you like me to tan it for you?");
    } else {
        ~chatnpc("<p,happy>I see you have brought me some hides.|Would you like me to tan them for you?");
    }
    switch_int(~p_choice2_header("Yes please.", 1, "No thanks.", 2, "What would you like to say?")) {
        case 1 : @tan_leather_choices;
        case 2 :
            ~chatplayer("<p,bored>No thanks.");
            ~chatnpc("<p,neutral>Very well, <text_gender("sir", "madam")>, as you wish.");
            return;
    }
}
switch_int (~p_choice2_header("Can I buy some leather then?", 1, "Leather is rather weak stuff.", 2, "What would you like to say?")) {
    case 1 :
        ~chatplayer("<p,quiz>Can I buy some leather then?");
        ~chatnpc("<p,neutral>I make leather from animal hides. Bring me some|cowhides and one gold coin per hide, and I'll tan them|into soft leather for you.");
    case 2 :
        ~chatplayer("<p,neutral>Leather is rather weak stuff.");
        ~chatnpc("<p,happy>Normal leather may be quite weak, but it's very cheap - I make it from cowhides for only 1 gp per hide - and it's so easy to craft that anyone can work with it.");
        ~chatnpc("<p,happy>Alternatively you could try hard leather. It's not so easy to craft, but I only charge 3 gp per cowhide to prepare it, and it makes much sturdier armour.");
        ~chatnpc("<p,happy>I can also tan dragonhides, suitable for crafting into the highest quality armour for rangers.");
        ~chatplayer("<p,bored>Thanks, I'll bear it in mind.");
}

[opnpcu,ellis_tanner]
switch_obj(last_useitem) {
    case cow_hide, dragonhide_green, dragonhide_blue, dragonhide_red, dragonhide_black : @tan_leather_choices;
    case leather, hard_leather, dragon_leather, dragon_leather_blue, dragon_leather_red, dragon_leather_black : ~chatnpc("<p,confused>Err... I have no use for that, I make the stuff!");
    case default : ~chatnpc("<p,confused>Er... Thanks, but no thanks!");
}

[opnpc3,ellis_tanner]
@tan_leather_choices;

// 377 leftover inter_306 (now tanner 14670): 8 Tan 1/5/X/All slots.
// 289 button comps are a different layout — do not copy those ids.
[label,tan_leather_choices]
def_int $soft = ^tanner_soft_leather_cost;
def_int $hard = ^tanner_hard_leather_cost;
def_int $hide = ^tanner_dragonhide_cost;
if (npc_find(coord, werewolftanner, 8, 0) = true) {
    $soft = ^werewolftanner_soft_leather_cost;
    $hard = ^werewolftanner_hard_leather_cost;
    $hide = ^werewolftanner_dragonhide_cost;
}
if_settext(tanner:com_106, "Soft leather");
if_settext(tanner:com_114, "<tostring($soft)> gp");
if_settext(tanner:com_107, "Hard leather");
if_settext(tanner:com_115, "<tostring($hard)> gp");
if_settext(tanner:com_108, "Green");
if_settext(tanner:com_116, "<tostring($hide)> gp");
if_settext(tanner:com_109, "Blue");
if_settext(tanner:com_117, "<tostring($hide)> gp");
if_settext(tanner:com_110, "Red");
if_settext(tanner:com_118, "<tostring($hide)> gp");
if_settext(tanner:com_111, "Black");
if_settext(tanner:com_119, "<tostring($hide)> gp");
if_setobject(tanner:com_98, leather, 250);
if_setobject(tanner:com_99, hard_leather, 250);
if_setobject(tanner:com_100, dragonhide_green, 250);
if_setobject(tanner:com_101, dragonhide_blue, 250);
if_setobject(tanner:com_102, dragonhide_red, 250);
if_setobject(tanner:com_103, dragonhide_black, 250);
if_openmain(tanner);

[if_button,tanner:com_146] @tan_soft_leather(1);
[if_button,tanner:com_138] @tan_soft_leather(5);
[if_button,tanner:com_130]
p_countdialog;
if (last_int <= 0) return;
@tan_soft_leather(last_int);
[if_button,tanner:com_122] @tan_soft_leather(inv_total(inv, cow_hide));

[if_button,tanner:com_147] @tan_hard_leather(1);
[if_button,tanner:com_139] @tan_hard_leather(5);
[if_button,tanner:com_131]
p_countdialog;
if (last_int <= 0) return;
@tan_hard_leather(last_int);
[if_button,tanner:com_123] @tan_hard_leather(inv_total(inv, cow_hide));

[if_button,tanner:com_148] @tan_dragonhide(dragonhide_green, dragon_leather, 1);
[if_button,tanner:com_140] @tan_dragonhide(dragonhide_green, dragon_leather, 5);
[if_button,tanner:com_132]
p_countdialog;
if (last_int <= 0) return;
@tan_dragonhide(dragonhide_green, dragon_leather, last_int);
[if_button,tanner:com_124] @tan_dragonhide(dragonhide_green, dragon_leather, inv_total(inv, dragonhide_green));

[if_button,tanner:com_149] @tan_dragonhide(dragonhide_blue, dragon_leather_blue, 1);
[if_button,tanner:com_141] @tan_dragonhide(dragonhide_blue, dragon_leather_blue, 5);
[if_button,tanner:com_133]
p_countdialog;
if (last_int <= 0) return;
@tan_dragonhide(dragonhide_blue, dragon_leather_blue, last_int);
[if_button,tanner:com_125] @tan_dragonhide(dragonhide_blue, dragon_leather_blue, inv_total(inv, dragonhide_blue));

[if_button,tanner:com_150] @tan_dragonhide(dragonhide_red, dragon_leather_red, 1);
[if_button,tanner:com_142] @tan_dragonhide(dragonhide_red, dragon_leather_red, 5);
[if_button,tanner:com_134]
p_countdialog;
if (last_int <= 0) return;
@tan_dragonhide(dragonhide_red, dragon_leather_red, last_int);
[if_button,tanner:com_126] @tan_dragonhide(dragonhide_red, dragon_leather_red, inv_total(inv, dragonhide_red));

[if_button,tanner:com_151] @tan_dragonhide(dragonhide_black, dragon_leather_black, 1);
[if_button,tanner:com_143] @tan_dragonhide(dragonhide_black, dragon_leather_black, 5);
[if_button,tanner:com_135]
p_countdialog;
if (last_int <= 0) return;
@tan_dragonhide(dragonhide_black, dragon_leather_black, last_int);
[if_button,tanner:com_127] @tan_dragonhide(dragonhide_black, dragon_leather_black, inv_total(inv, dragonhide_black));

[label,tan_soft_leather](int $hides)
def_int $cost = ^tanner_soft_leather_cost;
if (npc_find(coord, werewolftanner, 8, 0) = true) $cost = ^werewolftanner_soft_leather_cost;
def_int $total_hides = min($hides, inv_total(inv, cow_hide));
if ($total_hides < 1) {
    mes("You don't have any cowhides to tan."); // osrs
    return;
}
def_int $coins = inv_total(inv, coins);
if ($coins < $cost) {
    mes("You haven't got enough coins to pay for soft leather."); // osrs
    return;
}
def_int $hides_to_be_tanned = min(divide($coins, $cost), $total_hides);
~tan_leather(cow_hide, leather, $cost, $hides_to_be_tanned);
if ($hides_to_be_tanned = 1) {
    mes("The tanner tans your cowhide."); // osrs
} else {
    mes("The tanner tans <tostring($hides_to_be_tanned)> cowhides for you.");
}
if (inv_total(inv, coins) < $cost & $hides > $hides_to_be_tanned) {
    mes("You haven't got enough coins to pay for more soft leather."); // https://youtu.be/Ta4z2QML0jc?t=37
}

[label,tan_hard_leather](int $hides)
def_int $cost = ^tanner_hard_leather_cost;
if (npc_find(coord, werewolftanner, 8, 0) = true) $cost = ^werewolftanner_hard_leather_cost;
def_int $total_hides = min($hides, inv_total(inv, cow_hide));
if ($total_hides < 1) {
    mes("You don't have any cowhide to tan."); // osrs
    return;
}
def_int $coins = inv_total(inv, coins);
if ($coins < $cost) {
    mes("You haven't got enough coins to pay for hard leather."); // osrs
    return;
}
def_int $hides_to_be_tanned = min(divide($coins, $cost), $total_hides);
~tan_leather(cow_hide, hard_leather, $cost, $hides_to_be_tanned);
if ($hides_to_be_tanned = 1) {
    mes("The tanner tans your cowhide."); // osrs
} else {
    mes("The tanner tans <tostring($hides_to_be_tanned)> cowhide for you.");
}
if (inv_total(inv, coins) < $cost & $hides > $hides_to_be_tanned) {
    mes("You haven't got enough coins to pay for more hard leather.");
}

[label,tan_dragonhide](namedobj $dragonhide, namedobj $dragon_leather, int $count)
if (map_members = ^false) {
    mes("You need to be on a members' server to do that."); // guess
    return;
}
def_int $cost = ^tanner_dragonhide_cost;
if (npc_find(coord, werewolftanner, 8, 0) = true) $cost = ^werewolftanner_dragonhide_cost;
def_int $total_dragon_hides = min($count, inv_total(inv, $dragonhide));
if ($total_dragon_hides < 1) {
    mes("You don't have any dragonhides to tan."); // guess
    return;
}
if (inv_total(inv, coins) < $cost) {
    mes("You haven't got enough coins to pay for dragon leather."); // osrs
    return;
}
def_int $hides_to_be_tanned = min(divide(inv_total(inv, coins), $cost), $total_dragon_hides);
def_string $hides_to_be_tanned_message = "The tanner tans <tostring($hides_to_be_tanned)> dragonhides for you."; // osrs
if ($hides_to_be_tanned = 1) {
    $hides_to_be_tanned_message = "The tanner tans your dragonhide."; // osrs
}
~tan_leather($dragonhide, $dragon_leather, $cost, $hides_to_be_tanned);
if (inv_total(inv, coins) < $cost & $count > $hides_to_be_tanned) {
    mes($hides_to_be_tanned_message);
    mes("You haven't got enough coins to pay for more dragon leather.");
    return;
}
mes($hides_to_be_tanned_message);

[proc,tan_leather](namedobj $hide, namedobj $leather, int $cost, int $tan_count)
if_close;
if ($tan_count < 1) return;
inv_del(inv, $hide, $tan_count);
inv_del(inv, coins, multiply($tan_count, $cost));
inv_add(inv, $leather, $tan_count);

[label,trail_tanner]
// https://www.youtube.com/watch?v=M8lX77a6Mt8, https://www.youtube.com/watch?v=CFDUdiUYzJY
~chatnpc("<p,happy>Here you go!");
~progress_clue_easy(trail_clue_easy_simple008, "The tanner has given you another clue!");
