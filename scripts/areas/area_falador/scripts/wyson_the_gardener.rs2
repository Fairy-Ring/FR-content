[opnpc1,wyson] 
// CANDIDATE Old School exchange branch; remove later noted parts and nest boxes.
if (inv_total(inv, mole_claw) > 0 | inv_total(inv, mole_skin) > 0) {
    ~chatnpc("<p,neutral>If I'm not mistaken, you've got some body parts from a big mole there! I'll trade it for bird nests if ye likes. Or was ye wantin' some woad leaves instead?");
    def_int $trade = ~p_choice3("Okay, I will trade the mole parts.", 1, "Yes please, I need woad leaves.", 2, "Sorry, but I'm not interested.", 3);
    if ($trade = 1) {
        ~chatplayer("<p,neutral>Okay, I will trade the mole parts.");
        while (inv_total(inv, mole_claw) > 0) ~wyson_mole_exchange(mole_claw);
        while (inv_total(inv, mole_skin) > 0) ~wyson_mole_exchange(mole_skin);
        return;
    }
    if ($trade = 3) {
        ~chatplayer("<p,neutral>Sorry, but I'm not interested.");
        ~chatnpc("<p,neutral>Fair enough.");
        return;
    }
    ~chatplayer("<p,neutral>Yes please, I need woad leaves.");
}
~chatnpc("<p,neutral>I'm the gardener around here.|Do you have any gardening that needs doing?");
def_int $option = ~p_choice2("I'm looking for woad leaves.", 1, "Not right now, thanks.", 2);
if($option = 1) {
    ~chatplayer("<p,neutral>I'm looking for woad leaves.");
    ~chatnpc("<p,shifty>How much are you willing to pay?");
    $option = ~p_choice4("How about 5 coins?", 1, "How about 10 coins?", 2, "How about 15 coins?", 3, "How about 20 coins?", 4);
    if($option = 1) {
        ~chatplayer("<p,neutral>How about 5 coins?");
        ~chatnpc("<p,angry>No no, that's far too little.|Woad leaves are hard to get.|I used to have plenty but someone|kept stealing them off me!");
    } else if($option = 2) {
        ~chatplayer("<p,neutral>How about 10 coins?");
        ~chatnpc("<p,angry>No no, that's far too little.|Woad leaves are hard to get.|I used to have plenty but someone|kept stealing them off me!");
    } else if($option = 3) {
        ~chatplayer("<p,neutral>How about 15 coins?");
        ~chatnpc("<p,neutral>Mmmm... okay, sounds fair.");
        if(inv_total(inv, coins) < 15) {
            ~chatplayer("<p,sad>I don't have enough coins to buy the leaves.|I'll come back later.");
        } else {
            inv_del(inv, coins, 15);
            inv_add(inv, woadleaf, 1);
            mes("You give Wyson 15 coins.");
            mes("Wyson the gardener gives you a woad leaf.");
        }
    } else if($option = 4) {
        ~chatplayer("<p,neutral>How about 20 coins?");
        ~chatnpc("<p,happy>Okay, that's more than fair.");
        if(inv_total(inv, coins) < 20) {
            ~chatplayer("<p,sad>I don't have enough coins to buy the leaves.|I'll come back later.");
        } else {
            ~chatnpc("<p,happy>Here, have two, you're a generous person.");
            inv_del(inv, coins, 20);
            inv_add(inv, woadleaf, 2);
            mes("You give Wyson 20 coins.");
            mes("Wyson the gardener gives you some woad leaves.");
        }
    }
} else if($option = 2) {
    ~chatplayer("<p,neutral>Not right now, thanks.");
}

[opnpcu,wyson]
if (last_useitem ! mole_claw & last_useitem ! mole_skin) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_getobj(inv, last_useslot) ! last_useitem) return;
~wyson_mole_exchange(last_useitem);

[proc,wyson_mole_exchange](obj $part)
if ($part ! mole_claw & $part ! mole_skin) return;
if (inv_total(inv, $part) = 0) return;
// VERIFIED one nest per part, 8 March 2006 guide. Nonstackable input frees
// the output's slot even with a full inventory. Noted acceptance is 2014.
inv_del(inv, $part, 1);
// CANDIDATE Old School nest ratio. Period news replaces eggs with vegetables,
// retaining tree seeds. No egg nests, modern seed nests or nest boxes.
def_int $roll = random(100);
if ($roll < 72) inv_add(inv, bird_nest_cheapseeds, 1);
else if ($roll < 92) inv_add(inv, bird_nest_ring, 1);
else inv_add(inv, bird_nest_empty, 1);
