[label,n619_barbarian]
// UNKNOWN engineering: six replies are equally weighted; no source gives weights.
switch_int(random(6)) {
    case 0 :
    ~chatnpc("<p,angry>Wanna fight?");
    case 1 :
    ~chatnpc("<p,angry>Ah, you come for fight, ja?");
    case 2 :
    ~chatnpc("<p,angry>You look funny.");
    case 3 :
    ~chatnpc("<p,angry>Grrr!");
    case 4 :
    ~chatnpc("<p,angry>What you want?");
    case 5 :
    ~chatnpc("<p,angry>Go Away!");
}
npc_setmode(opplayer2);
