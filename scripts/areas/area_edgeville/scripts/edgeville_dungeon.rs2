[oploc1,brasskeydoor]
mes("The door is locked.");

[oplocu,brasskeydoor]
switch_obj(last_useitem) {
    case edgevilledungeonkey : @open_edgeville_dungeon_door;
    case favour_key_ring :
        if (~osf_key_ring_has(edgevilledungeonkey) = true) {
            @open_edgeville_from_ring;
        }
        ~displaymessage(^dm_default);
    case default : ~displaymessage(^dm_default);
}


[label,open_edgeville_dungeon_door]
if (inv_total(inv, edgevilledungeonkey) > 0) {
    mes("You unlock the door.");
    sound_synth(locked, 0, 0);
    def_coord $loc_coord = loc_coord;
    def_int $angle = loc_angle;
    def_locshape $shape = loc_shape;
    def_loc $replacement = loc_param(next_loc_stage);
    def_int $x;
    def_int $z;
    $x, $z = ~door_open($angle, loc_shape);

    // walk through door, but if entering, walk next to door and then through
    def_boolean $entering = ~check_axis(coord,  $loc_coord, $angle);
    def_coord $dest = $loc_coord;
    if ($entering = true) {
        if (coord ! $loc_coord) {
            p_delay(0);
            p_teleport($loc_coord);
            sound_synth(door_open, 0, 0);
            p_delay(1);
        } else {
            p_delay(0);
            sound_synth(door_open, 0, 0);
        }
        $dest = movecoord($loc_coord, $x, 0, $z);
    } else {
        p_delay(0);
        sound_synth(door_open, 0, 0);
    }

    p_teleport($dest);

    // Temp note: dur updated
    loc_add($loc_coord, inviswall, $angle, $shape, 3);
    loc_add(movecoord($loc_coord, $x, 0, $z), $replacement, modulo(add($angle, 1), 4), $shape, 3);
} else {
    mes("The door is locked.");
}

[label,open_edgeville_from_ring]
// OSF leftover Use-ring. Cite osf-key-ring-doors-rest-377.md.
// Do not require inv brass key. Do not dest.
mes("You use your keyring to unlock the door.");
sound_synth(locked, 0, 0);
def_coord $rloc = loc_coord;
def_int $rangle = loc_angle;
def_locshape $rshape = loc_shape;
def_loc $rnext = loc_param(next_loc_stage);
def_int $rx;
def_int $rz;
$rx, $rz = ~door_open($rangle, loc_shape);
def_boolean $rentering = ~check_axis(coord, $rloc, $rangle);
def_coord $rdest = $rloc;
if ($rentering = true) {
    if (coord ! $rloc) {
        p_delay(0);
        p_teleport($rloc);
        sound_synth(door_open, 0, 0);
        p_delay(1);
    } else {
        p_delay(0);
        sound_synth(door_open, 0, 0);
    }
    $rdest = movecoord($rloc, $rx, 0, $rz);
} else {
    p_delay(0);
    sound_synth(door_open, 0, 0);
}
p_teleport($rdest);
loc_add($rloc, inviswall, $rangle, $rshape, 3);
loc_add(movecoord($rloc, $rx, 0, $rz), $rnext, modulo(add($rangle, 1), 4), $rshape, 3);

[oploc1,oddwall_r] ~open_and_close_double_door2(~check_axis_locactive(coord), ^right, coffin_open);
[oploc1,oddwall_l] ~open_and_close_double_door2(~check_axis_locactive(coord), ^left, coffin_open);
