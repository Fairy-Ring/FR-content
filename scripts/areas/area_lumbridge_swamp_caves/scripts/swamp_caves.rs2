// CANDIDATE numeric-brightness, darkness-insects and measured-darkness-thresholds.
// Bounds, busy-clock pause and monotone overlay selection are engineering policy.
[proc,swamp_cave_inside](coord $tile)(boolean)
switch_int (coordy($tile)) {
    case 0 :
        if (inzone(^swamp_cave_main_sw, ^swamp_cave_main_ne, $tile) = true | inzone(^swamp_cave_mine_sw, ^swamp_cave_mine_ne, $tile) = true) return(true);
    case 2 :
        if (inzone(^swamp_cave_tears_sw, ^swamp_cave_tears_ne, $tile) = true) return(true);
}
return(false);

[proc,swamp_cave_light_value](obj $source)(int)
switch_obj ($source) {
    case lit_candle, lit_black_candle, torch_lit, candle_lantern_lit, candle_lantern_black_lit : return(1);
    case oil_lamp_lit, oil_lantern_lit, tog_sapphire_lantern_lit, cave_goblin_mining_helmet_lit : return(2);
    case bullseye_lantern_lit : return(3);
}
// Bug lanterns, empty containers and every unlit form contribute nothing.
return(0);

[proc,swamp_cave_light]()(int)
def_int $light = 0;
def_int $slot = 0;
while ($slot < inv_size(inv)) {
    $light = add($light, ~swamp_cave_light_value(inv_getobj(inv, $slot)));
    if ($light >= 3) return(3);
    $slot = add($slot, 1);
}
$slot = 0;
while ($slot < inv_size(worn)) {
    def_obj $source = inv_getobj(worn, $slot);
    if ($source ! null) {
        if (oc_wearpos($source) = $slot | oc_wearpos2($source) = $slot | oc_wearpos3($source) = $slot) {
            $light = add($light, ~swamp_cave_light_value($source));
            if ($light >= 3) return(3);
        }
    }
    $slot = add($slot, 1);
}
return($light);

[proc,swamp_cave_can_attack]()(boolean)
if (~swamp_cave_inside(coord) = false) return(true);
if (~swamp_cave_light > 0) return(true);
return(false);

[proc,swamp_cave_overlay](int $light, interface $owned_overlay)(interface)
// Original components VERIFIED; their selection is CANDIDATE, not recovered.
def_interface $root = inter_387;
switch_int ($light) {
    case 1 : $root = inter_248;
    case 2 : $root = inter_250;
    case 3 : $root = inter_249;
}
if ($root ! $owned_overlay) if_openoverlay($root);
return($root);

[proc,swamp_cave_start]
if (~swamp_cave_inside(coord) = false | %darkness_level ! 0) return;
// SC-03 ruling 6: original 278 is ownership, not a stored brightness value.
%darkness_level = 1;
def_interface $root = ~swamp_cave_overlay(~swamp_cave_light, null);
def_obj $gas_source = null;
softtimer(swamp_cave_environment, 1, 0, $root, -1, $gas_source, 0);

[proc,swamp_cave_release]
if (%darkness_level = 0) return;
// One transmitted update clears original 278 (bits 1-2) and 282 (bits 6-8).
// Every durable and otherwise-unassigned bit of the parent stays unchanged.
%goblin_caves = clearbit_range(clearbit_range(%goblin_caves, 1, 2), 6, 8);
clearsofttimer(swamp_cave_environment);
if_openoverlay(null);

[proc,swamp_cave_exit]
if (%darkness_level ! 0 & ~swamp_cave_inside(coord) = false) ~swamp_cave_release;

// The gas arguments carry pending-source identity across the shared controller.
// SC-04 owns their countdown and effects; SC-03 preserves/discards them with it.
[softtimer,swamp_cave_environment](int $dark_ticks, interface $owned_overlay, int $gas_slot, obj $gas_source, int $gas_ticks)
// No outside hazard action, even when a missed exit leaves the player busy.
// Ruling 7: retain ownership until protected access permits the one release.
if (~swamp_cave_inside(coord) = false) {
    $dark_ticks = 0;
    $gas_slot = -1;
    $gas_source = null;
    $gas_ticks = 0;
    if (p_finduid(uid) = true) {
        ~swamp_cave_release;
        return;
    }
} else if (busy() = false) {
    // Engineering clock: both clocks pause without catch-up when unavailable.
    if (p_finduid(uid) = true) {
        def_int $light = ~swamp_cave_light;
        $owned_overlay = ~swamp_cave_overlay($light, $owned_overlay);
        if ($light > 0) {
            $dark_ticks = 0;
        } else {
            if ($dark_ticks < ^swamp_cave_bite_ticks) {
                $dark_ticks = add($dark_ticks, 1);
                if ($dark_ticks = ^swamp_cave_warning_ticks) mes("You hear tiny insects skittering over the ground...");
                if ($dark_ticks = ^swamp_cave_bite_ticks) mes("Tiny biting insects swarm all over you!");
            }
            if ($dark_ticks >= ^swamp_cave_bite_ticks) {
                damage(uid, 1, ^swamp_cave_bite_damage);
                if (stat(hitpoints) = 0) ~player_die;
                else ~ring_of_life_check;
            }
        }
    }
}
// A protected effect can suspend and release ownership before returning here.
if (%darkness_level ! 0) softtimer(swamp_cave_environment, 1, $dark_ticks, $owned_overlay, $gas_slot, $gas_source, $gas_ticks);

