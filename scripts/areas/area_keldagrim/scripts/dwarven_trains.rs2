// CANDIDATE: OSRS conductor transcripts, with their complete retained histories.
// 377 owns the four directional tickets and three Ride locs. GE was added in
// 2009 (RS Wiki system history), so it is not a destination here. No Dorgesh-Kaan.
// UNKNOWN engineering assignment of the transcript's unnamed hub variants:
// forms 3/5 keep traffic/break dialogue; 1/2/4/8 are the ticket vendors.
[opnpc1,dwarf_city_train_conductor1]
~chatnpc("<p,neutral>Yes <text_gender("sir", "m'am")>? Can I help you at all?");
~dwarven_train_station;

[opnpc1,dwarf_city_train_conductor2]
~chatnpc("<p,neutral>Anything I can help you with?");
~dwarven_train_station;

[opnpc1,dwarf_city_train_conductor3]
~chatnpc("<p,neutral>Out of the way human!");
~chatplayer("<p,neutral>Why, what's happening?");
~chatnpc("<p,neutral>There's important traffic coming through here and I don't want any stray humans distracting me.");

[opnpc1,dwarf_city_train_conductor4]
~chatnpc("<p,neutral>Tickets, tickets, get your tickets here!");
~dwarven_train_station;

[opnpc1,dwarf_city_train_conductor5]
~chatnpc("<p,neutral>Wot you want?");
def_int $option = ~p_choice4("What is this place?", 1, "Where can you take me?", 2, "I'd like to buy a ticket.", 3, "I have to go.", 4);
if ($option = 4) {
    ~chatplayer("<p,neutral>I have to go.");
    ~chatnpc("<p,neutral>Then why did ya waste my time?");
} else {
    if ($option = 1) {
        ~chatplayer("<p,neutral>What is this place?");
    } else if ($option = 2) {
        ~chatplayer("<p,neutral>Where can you take me?");
    } else {
        ~chatplayer("<p,neutral>I'd like to buy a ticket.");
    }
    ~chatnpc("<p,neutral>Can't you see I'm 'aving a lil' break?");
    ~chatplayer("<p,neutral>Now that you mention it, yes.");
}

[opnpc1,dwarf_city_train_conductor6] ~dwarven_train_station;
[opnpc1,dwarf_city_train_conductor7] ~dwarven_train_station;
[opnpc1,dwarf_city_train_conductor8] ~dwarven_train_station;

[proc,dwarven_train_station]()
def_boolean $whitewolf = false;
def_boolean $ice = false;
if (npc_type = dwarf_city_train_conductor6) {
    $whitewolf = true;
}
if (npc_type = dwarf_city_train_conductor7) {
    $ice = true;
}
while (true = true) {
    def_int $choice;
    if ($whitewolf = true | $ice = true) {
        $choice = ~p_choice4("Who are you?", 1, "Where can you take me?", 2, "I'd like to buy a ticket.", 3, "I have to go.", 4);
    } else {
        $choice = ~p_choice4("What is this place?", 1, "Where can you take me?", 2, "I'd like to buy a ticket.", 3, "I have to go.", 4);
    }
    if ($choice = 4) {
        ~chatplayer("<p,neutral>I have to go.");
        if ($whitewolf = true) {
            ~chatnpc("<p,neutral>Just remember, wherever you go... ehm... *hic* oh, forget it.");
        } else {
            ~chatnpc("<p,neutral>Just remember, wherever you go, you go there faster through Keldagrim Carts.");
        }
        return;
    }
    if ($choice = 1) {
        if ($whitewolf = true) {
            ~chatplayer("<p,neutral>Who are you?");
            ~chatnpc("<p,neutral>Whooooo? Meeeee? Oh, I make sure *hic* the cart traffic proceedsh *hic* in an orderly fishion. Fashion. Yes.");
        } else if ($ice = true) {
            ~chatplayer("<p,neutral>Who are you?");
            ~chatnpc("<p,neutral>I'm an employee of Keldagrim Carts. I make sure the carts in this area run on time and that people pay their fares.");
        } else {
            ~chatplayer("<p,neutral>What is this place?");
            ~chatnpc("<p,neutral>This is the Keldagrim Carts-station, human.");
            ~chatplayer("<p,neutral>Cart-station? What goes on here then?");
            ~chatnpc("<p,neutral>Keldagrim is the hub of all the traffic of the dwarven realm. Almost every dwarven outpost has railtracks leading to Keldagrim, connecting them all for easy travel and transportation of goods.");
            ~chatplayer("<p,neutral>Amazing! And what powers the carts? Magic?");
            ~chatnpc("<p,neutral>Oh, no no, we dwarves don't use magic. No, all of this is powered by steam engines, developed during the past few centuries after the Consortium came to power.");
            ~chatplayer("<p,neutral>Thanks for the info.");
        }
    } else if ($choice = 2) {
        ~chatplayer("<p,neutral>Where can you take me?");
        if (%giantdwarf_quest = 0) {
            ~dwarven_train_access_refusal;
        } else if ($whitewolf = true) {
            ~chatnpc("<p,neutral>North, north, north *hic* north to Keldagrim!");
        } else if ($ice = true) {
            ~chatnpc("<p,neutral>This track leads right up to Keldagrim. Only stop.");
        } else {
            // CANDIDATE era subtraction: remove the later Grand Exchange clause.
            ~chatnpc("<p,neutral>Let's see, we could let you travel to Ice Mountain.");
            if (%fishingcompo = ^fishingcompo_complete) {
                ~chatnpc("<p,neutral>I could also let you go to White Wolf Mountain, since you've befriended our brothers there.");
            }
        }
    } else {
        ~chatplayer("<p,neutral>I'd like to buy a ticket.");
        if (%giantdwarf_quest = 0) {
            ~dwarven_train_access_refusal;
            return;
        }
        if ($whitewolf = true) {
            if (~dwarven_train_whitewolf_access = false) {
                return;
            }
            ~chatnpc("<p,neutral>One ticket to ehm... *hic* Keldagrim. That's 2... 3.... *hic* 100 glittering gold coins!");
            ~dwarven_train_ticket(dwarf_minecart_ticket_whitewolf_kelda, ^dwarven_train_whitewolf_fare);
            return;
        }
        if ($ice = true) {
            ~chatnpc("<p,neutral>One ticket to Keldagrim, that's 150 coins then.");
            ~dwarven_train_ticket(dwarf_minecart_ticket_ice_kelda, ^dwarven_train_ice_fare);
            return;
        }
        ~chatnpc("<p,neutral>And where would you like to go?");
        def_int $destination;
        if (%fishingcompo = ^fishingcompo_complete) {
            $destination = ~p_choice3("To Ice Mountain.", 1, "To White Wolf Mountain.", 2, "Nowhere.", 3);
        } else {
            $destination = ~p_choice2("To Ice Mountain.", 1, "Nowhere.", 3);
        }
        if ($destination = 3) {
            return;
        }
        if ($destination = 1) {
            ~chatplayer("<p,neutral>I'd like to buy a ticket to Ice Mountain.");
            ~chatnpc("<p,neutral>That'll be 150 gold coins please.");
            ~dwarven_train_ticket(dwarf_minecart_ticket_kelda_ice, ^dwarven_train_ice_fare);
        } else {
            ~chatplayer("<p,neutral>I'd like to buy a ticket to White Wolf Mountain.");
            ~chatnpc("<p,neutral>That'll be 100 gold coins please.");
            ~dwarven_train_ticket(dwarf_minecart_ticket_kelda_whitewolf, ^dwarven_train_whitewolf_fare);
        }
        return;
    }
}

[proc,dwarven_train_ticket](namedobj $ticket, int $fare)
def_int $buy;
if (inv_total(worn, ring_of_charos_unlocked) > 0) {
    $buy = ~p_choice3("Buy.", 1, "Don't buy.", 2, "[Charm] Only pay half.", 3);
} else {
    $buy = ~p_choice2("Buy.", 1, "Don't buy.", 2);
}
if ($buy = 2) {
    ~chatplayer("<p,neutral>No thanks, I changed my mind.");
    return;
}
if ($buy = 3) {
    $fare = calc($fare / 2);
}
if (inv_total(inv, coins) < $fare) {
    ~chatplayer("<p,neutral>I'm sorry, I've run out of money.");
    return;
}
if (inv_freespace(inv) = 0 & inv_total(inv, coins) > $fare) {
    ~chatnpc("<p,neutral>I'm sorry, <text_gender("sir", "madam")>, but I don't believe you can hold the ticket.");
    return;
}
inv_del(inv, coins, $fare);
inv_add(inv, $ticket, 1);
if ($ticket = dwarf_minecart_ticket_kelda_ice) {
    if ($buy = 3) {
        ~chatnpc("<p,neutral>You're alright, I suppose... I can let you go for 75 coins. And remember, carts to Ice Mountain depart from track 1.");
    } else {
        ~chatnpc("<p,neutral>Thanks, carts to Ice Mountain depart from track 1.");
    }
} else if ($ticket = dwarf_minecart_ticket_kelda_whitewolf) {
    if ($buy = 3) {
        ~chatnpc("<p,neutral>You're a decent human, I suppose... I can let you go for 50 coins. Go to track 4 for the carts heading to White Wolf Mountain.");
    } else {
        ~chatnpc("<p,neutral>Thanks. Go to track 4 for carts heading to White Wolf Mountain.");
    }
} else if ($ticket = dwarf_minecart_ticket_ice_kelda) {
    if ($buy = 3) {
        ~chatnpc("<p,neutral>This is only 75 coins, I can't let you have a ticket for that.");
        ~chatplayer("<p,neutral>Oh, don't worry. I'll pay you another 75 coins for the next ticket I buy, alright?");
        ~chatnpc("<p,neutral>Well... I suppose so.");
    } else {
        ~chatnpc("<p,neutral>Thanks for your custom!");
    }
} else if ($buy = 3) {
    ~chatnpc("<p,neutral>Waith a shecond... that'sh only 50 coinsh!");
    ~chatplayer("<p,neutral>No it's not, you're seeing double from all that drinking, remember? So it's actually 100 coins.");
    ~chatnpc("<p,neutral>Errr... yesh, I shuppose you're right.");
} else {
    ~chatnpc("<p,neutral>Thanksh a lot human! Remember to come back for more shtout whenever you want! *hic*");
}

[proc,dwarven_train_access_refusal]()
~chatnpc("<p,neutral>I don't think I'm allowed to take you into the city of Keldagrim, human. Perhaps when you find another way into the city and talk to someone of importance there you will be allowed to.");

[proc,dwarven_train_whitewolf_access]()(boolean)
if (%fishingcompo ! ^fishingcompo_complete) {
    // UNKNOWN plain functional wording: the source gives the gate, not its refusal.
    ~mesbox("You must complete Fishing Contest to travel to White Wolf Mountain.");
    return(false);
}
return(true);

[oploc1,keldagrim_train_cart]
// UNKNOWN engineering berth mapping: original Ride loc on tracks 1 and 4.
if (coordx(loc_coord) < ^dwarven_train_berth_split_x) {
    ~dwarven_train_ride(dwarf_minecart_ticket_kelda_ice, ^dwarven_train_ice, false);
} else {
    ~dwarven_train_ride(dwarf_minecart_ticket_kelda_whitewolf, ^dwarven_train_whitewolf, true);
}

[oploc1,icemountain_train_cart]
~dwarven_train_ride(dwarf_minecart_ticket_ice_kelda, ^dwarven_train_city, false);

[oploc1,whitewolfmountain_train_cart]
~dwarven_train_ride(dwarf_minecart_ticket_whitewolf_kelda, ^dwarven_train_city, true);

[proc,dwarven_train_ride](obj $ticket, coord $destination, boolean $whitewolf)
if (%giantdwarf_quest = 0) {
    // UNKNOWN plain functional wording for the source-backed first-visit gate.
    ~mesbox("You must visit Keldagrim by boat before using these carts.");
    return;
}
if ($whitewolf = true) {
    if (~dwarven_train_whitewolf_access = false) {
        return;
    }
}
if (inv_total(inv, $ticket) = 0) {
    // UNKNOWN plain functional wording, original ticket required by route.
    ~mesbox("You need a ticket for this journey. Buy one from a cart conductor.");
    return;
}
inv_del(inv, $ticket, 1);
~dwarven_transport_fade($destination);
