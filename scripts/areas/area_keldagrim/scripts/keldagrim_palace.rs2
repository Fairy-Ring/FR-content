// CANDIDATE: Transcript:The Giant Dwarf, before enough secretary tasks.
[opnpc1,dwarf_city_director_purple_pewter]
if (%giantdwarf_quest >= 5) {
    ~giantdwarf_company_director(1);
    return;
}
~keldagrim_director("<p,neutral>My secretary will deal with any inquiries you have about the Purple Pewter.");
