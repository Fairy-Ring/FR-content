// CANDIDATE: ordinary shopkeeper dialogue follows the OSRS Wiki transcripts.
// Transcript histories begin in 2020-2023 and do not prove revision-377 wording.
// Keldagrim task exchanges and named quest or non-NPC interactions are excluded.

[opnpc1,smithing_guild_buyer]
~chatnpc("<p,neutral>Do you want to trade?");
def_int $choice = ~p_choice2("What are you selling?", 1, "No thanks.", 2);
if ($choice = 1) {
    ~chatplayer("<p,neutral>What are you selling?");
    ~chatnpc("<p,neutral>The finest smiths from all over Gielinor come here to work, and I buy the fruit of their craft. Armour made from the higher metals!");
    def_int $nested_choice = ~p_choice2("Let's have a look then.", 1, "No thanks.", 2);
    if ($nested_choice = 1) {
        ~chatplayer("<p,neutral>Let's have a look then.");
        ~openshop_activenpc;
        return;
    }
}
~chatplayer("<p,neutral>No thanks.");
~chatnpc("<p,neutral>You just don't appreciate the beauty of fine metalwork.");

[opnpc3,smithing_guild_buyer]
~openshop_activenpc;

[opnpc1,dwarf_city_shop_warhammer]
~chatnpc("<p,neutral>What do you want, human?");
~chatplayer("<p,neutral>Ehm, anything on offer?");
~chatnpc("<p,neutral>Can you wield a warhammer? If not, then go away.");
def_int $choice = ~p_choice2("Of course I can.", 1, "I can, but I won't.", 2);
if ($choice = 1) {
    ~chatplayer("<p,neutral>Of course I can.");
    ~openshop_activenpc;
    return;
}
~chatplayer("<p,neutral>I can, but I won't.");
~chatnpc("<p,neutral>Yeah, right.");

[opnpc3,dwarf_city_shop_warhammer]
~openshop_activenpc;

