// Sal 29 Apr 2006, line 195: only the opposite combat style can hurt a King.
// The own-style zero is VERIFIED wording; the third-style zero is the CANDIDATE
// stricter reading of line 195, rather than the narrower statement at line 224.
// One value per King and incoming style; 1 permits ordinary damage, 0 caps it.
[waterbirth_king_melee_damage]
inputtype=npc
outputtype=int
default=1
val=dagcave_ranged_boss,1
val=dagcave_magic_boss,0
val=dagcave_melee_boss,0

[waterbirth_king_ranged_damage]
inputtype=npc
outputtype=int
default=1
val=dagcave_ranged_boss,0
val=dagcave_magic_boss,1
val=dagcave_melee_boss,0

[waterbirth_king_magic_damage]
inputtype=npc
outputtype=int
default=1
val=dagcave_ranged_boss,0
val=dagcave_magic_boss,0
val=dagcave_melee_boss,1
