// Original 377 client declarations moved unchanged from all.npc.
// CANDIDATE exact Old School skills/bonuses; post-377 changes are excluded.
[dagcave_ranged_boss]
name=Dagannoth Supreme
desc=The dagannoth king responsible for the death of the Bukalla.
model1=npc_2881
model2=npc_2881i2
vislevel=303
hitpoints=255
attack=255
strength=255
defence=128
size=3
walkanim=dagannoth_meganoth_walk
readyanim=dagannoth_meganoth_ready
resizeh=167
resizev=165
contrast=30
ambient=30
op2=Attack
param=slayer_category,^slayer_dagannoth
magic=255
ranged=255
param=stabdefence,10
param=slashdefence,10
param=crushdefence,10
param=magicdefence,255
// 255 before the explicitly dated 19 Jan 2017 increase to 550.
param=rangedefence,255
param=damagetype,^ranged_style
param=attackrate,^wbk_attack_ticks
attackrange=^wbk_distance_attack_range
huntmode=aggressive_ranged
huntrange=^wbk_distance_hunt_radius
wanderrange=^wbk_wander_radius
maxrange=^wbk_pursuit_radius
respawnrate=^wbk_respawn_ticks
param=attack_anim,^wbk_supreme_attack_anim
