// Remaining placed Waterbirth non-crab, non-Kings monsters. Original 377 client fields are kept in their source order.
[jb_baby_dagganoth]
name=Dagannoth fledgeling
desc=A knee-high horror from the ocean depths...
model1=npc_2880
model2=npc_2880i2
size=2
resizeh=69
resizev=69
contrast=30
ambient=30
walkanim=slayer_lizard_walk
readyanim=slayer_lizard_ready
resizeh=60
resizev=60
op2=Attack
vislevel=70
hitpoints=100
attack=50
strength=50
defence=50
// CANDIDATE exact-variant OSRS values; the first article revision differs on speed.
magic=1
ranged=1
param=attackbonus,0
param=strengthbonus,0
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
param=magicdefence,0
param=rangedefence,0
param=damagetype,^stab_style
param=attackrate,4
param=attack_anim,slayer_lizard_attack
param=defend_anim,slayer_lizard_defend
param=death_anim,slayer_lizard_death
param=death_drop,bones
// CANDIDATE current exact-variant OSRS article says this creature gives no combat or Slayer XP.
param=combat_xp_multiplier,0
// CANDIDATE exact-variant OSRS respawn. No Slayer category is assigned: the source says 0 Slayer XP.
respawnrate=30

[dagannoth_rock_lobster_2x2]
name=Rock lobster
desc=It wasn't a rock... it was a rock lobster!
model1=npc_2889
model2=npc_2889i2
size=2
resizeh=85
resizev=85
contrast=15
ambient=15
walkanim=dagannoth_rock_lobster_walk
readyanim=dagannoth_rock_lobster_ready
op2=Attack
vislevel=127
hitpoints=150
attack=100
strength=100
defence=100
// CANDIDATE current exact-variant OSRS melee profile; the 2014 first revision conflicts on speed and max hit.
magic=1
ranged=1
param=attackbonus,0
param=strengthbonus,0
param=stabdefence,100
param=slashdefence,100
param=crushdefence,50
param=magicdefence,50
// CANDIDATE native generic ranged defence maps to current light/standard ranged defence; heavy defence differs.
param=rangedefence,150
param=damagetype,^crush_style
param=attackrate,2
param=attack_anim,dagannoth_rock_lobster_attack
param=defend_anim,dagannoth_rock_lobster_defend
param=death_anim,dagannoth_rock_lobster_death
param=death_drop,raw_lobster
huntmode=aggressive_melee
// UNKNOWN engineering hunt/leash radii; no period measurements were found.
huntrange=^waterbirth_other_rock_active_radius
wanderrange=0
maxrange=^waterbirth_other_rock_pursuit_radius
// UNKNOWN native respawn interval; the exact-variant article does not supply one.
respawnrate=^waterbirth_other_rock_respawn_ticks

[dagannoth_rock_lobster_2x2_loc]
