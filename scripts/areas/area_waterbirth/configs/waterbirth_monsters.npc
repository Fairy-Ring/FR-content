// Waterbirth ordinary monsters. Client fields moved unchanged from 377 all.npc.
[dungeon_dagganoth_mainroom]
name=Dagannoth
desc=A darkened horror from the ocean depths...
model1=poh_dagganoth_8
recol1s=13740
recol1d=12650
recol2s=12683
recol2d=11593
recol3s=11626
recol3d=10536
recol4s=10569
recol4d=9479
resizeh=69
resizev=69
walkanim=horror_dagannoth_walk
readyanim=horror_dagannoth_ready
op2=Attack
vislevel=90
// CANDIDATE WBMON_MELEE_HITPOINTS: Tip.It 27 Apr 2006 (97), nearer than RuneHQ (99); OSRS 95 rejected.
hitpoints=97
attack=76
strength=78
defence=65
param=slayer_category,^slayer_dagannoth
// CANDIDATE Old School skills, bonuses and four-cycle stab attack.
magic=1
ranged=1
param=attackbonus,50
param=strengthbonus,50
param=stabdefence,50
param=slashdefence,50
param=crushdefence,50
param=magicdefence,50
param=rangedefence,50
param=damagetype,^stab_style
param=attackrate,4
// CANDIDATE original named animation/sound family, inherited lighthouse binding.
param=attack_anim,horror_dagannoth_attack
param=defend_anim,horror_dagannoth_defend
param=death_anim,horror_dagannoth_death
param=attack_sound,dagganoth_attack
param=defend_sound,dagganoth_hit
param=death_sound,dagganoth_death
huntmode=aggressive_melee
// UNKNOWN engineering radii; no recovered period numbers.
huntrange=5
wanderrange=5
maxrange=16
// CANDIDATE Old School respawn interval.
respawnrate=30

[dungeon_dagganoth_lighter]
name=Dagannoth
desc=A spiney horror from the ocean depths...
model1=poh_dagganoth_8
recol1s=13740
