resizev=69
walkanim=horror_dagannoth_walk
readyanim=horror_dagannoth_ready
op2=Attack
vislevel=88
hitpoints=85
attack=10
strength=10
defence=75
param=slayer_category,^slayer_dagannoth
// CANDIDATE Old School ranged skill, bonuses and three-cycle ranged attack.
magic=1
ranged=100
param=stabdefence,10
param=slashdefence,10
param=crushdefence,90
param=magicdefence,200
param=rangedefence,150
param=damagetype,^ranged_style
param=attackrate,3
attackrange=4
param=attack_anim,horror_dagannoth_rangeattack
param=defend_anim,horror_dagannoth_defend
param=death_anim,horror_dagannoth_death
param=defend_sound,dagganoth_hit
param=death_sound,dagganoth_death
param=rangeattack_sound,dagganoth_spines
param=proj_travel,horror_spines_travel
huntmode=aggressive_ranged
// UNKNOWN engineering hunt/leash/wander numbers.
huntrange=4
wanderrange=5
maxrange=16
// CANDIDATE Old School respawn interval.
respawnrate=30

[dungeon_dagganoth_magic_monster]
name=Wallasalki
desc=A fearsome magical water creature.
model1=npc_2457
walkanim=wallasalki_walk
readyanim=wallasalki_ready
resizeh=110
resizev=110
op2=Attack
vislevel=98
// CANDIDATE WBMON_MAGIC_HITPOINTS: RuneHQ 8 Jan 2006 (130) outranks later Old School (120).
hitpoints=130
attack=1
strength=1
defence=80
// CANDIDATE Old School magic skill, bonuses and six-cycle Water Wave attack.
magic=100
ranged=1
param=stabdefence,100
param=slashdefence,150
param=crushdefence,175
param=magicdefence,250
param=rangedefence,-10
param=damagetype,^magic_style
param=attackrate,6
param=magicattack_anim,wallasalki_attack
param=defend_anim,wallasalki_defend
param=death_anim,wallasalki_death
huntmode=aggressive_ranged
// UNKNOWN engineering hunt/attack/leash/wander numbers.
attackrange=6
huntrange=6
wanderrange=5
maxrange=16
// CANDIDATE Old School respawn interval.
respawnrate=25

