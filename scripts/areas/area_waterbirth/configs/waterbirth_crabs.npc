[giant_rockcrab]
name=Giant Rock Crab
desc=No one likes crabs... especially really big ones!
model1=npc_2452
model2=npc_2452i2
size=2
resizeh=250
resizev=250
walkanim=horror_crab_walk
readyanim=horror_crab_ready
op2=Attack
vislevel=137
// CANDIDATE server HP/attack/strength/defence copied from the old all.npc row; those values are not cache authority.
hitpoints=180
attack=50
strength=80
defence=200
// CANDIDATE exact-variant OSRS/retained Lost City combat stats; 2025 earth weakness and heavy-defence reduction excluded.
magic=1
ranged=1
param=attackbonus,0
param=strengthbonus,0
param=stabdefence,225
param=slashdefence,200
param=crushdefence,175
param=magicdefence,-10
param=rangedefence,250
param=damagetype,^crush_style
param=attackrate,4
param=retreat,^wbmon_giant_retreat_hp
// CANDIDATE same crab animation/sound family as the original 377 regular forms.
param=attack_anim,horror_crab_attack
param=defend_anim,horror_crab_defend
param=death_anim,horror_crab_hide
param=attack_sound,insect_attack
param=defend_sound,insect_hit
param=death_sound,insect_death
// CANDIDATE exact-variant melee aggression and 50-tick respawn; UNKNOWN 2-tile hunt radius covers 2x2 edge contacts from native SW-origin distance.
huntmode=aggressive_melee
huntrange=^wbcrab_giant_hunt_radius
attackrange=1
respawnrate=50

[giant_rockcrab_hidden]
name=Boulder
