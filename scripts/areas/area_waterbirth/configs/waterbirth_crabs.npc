// Waterbirth rock crab forms. Original 377 fields below are preserved verbatim.

[horror_rockcrab]
name=Rock Crab
desc=No one likes crabs...
model1=npc_1265
model2=npc_1265i2
walkanim=horror_crab_walk
readyanim=horror_crab_ready
minimap=no
op2=Attack
vislevel=13
wanderrange=7
hitpoints=50
respawnrate=100
param=death_drop,null
param=damagetype,^crush_style
param=attack_anim,horror_crab_attack
param=defend_anim,horror_crab_defend
param=death_anim,horror_crab_hide
param=attack_sound,insect_attack
param=defend_sound,insect_hit
param=death_sound,insect_death
maxrange=9

[horror_rockcrab_inactive]
name=Rocks
desc=A rocky outcrop.
model1=npc_1265
model2=npc_1265i2
vislevel=hide
walkanim=horror_crab_walk
readyanim=horror_crab_hide_ready
minimap=no
wanderrange=0
hitpoints=50
huntrange=1
respawnrate=100
huntmode=aggressive_ranged
param=death_drop,null
param=attack_anim,horror_crab_attack
param=defend_anim,horror_crab_defend
param=death_anim,horror_crab_hide
param=attack_sound,insect_attack
param=defend_sound,insect_hit
param=death_sound,insect_death
maxrange=9
attackrange=1
moverestrict=nomove
defaultmode=none

