[label,waterbirth_traversal_ladder_options](coord $up, coord $down)
def_int $option = ~p_choice2_header("Climb Up.", 1, "Climb Down.", 2, "Climb up or down the ladder?");
if_close;
anim(human_reachforladder, 0);
p_delay(1);
if ($option = 1) {
    p_telejump($up);
} else if ($option = 2) {
    p_telejump($down);
}
