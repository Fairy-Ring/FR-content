// The ordinary Rock Crab handlers remain in quest_viking/scripts/horror_rockcrab.rs2.
// Giant boulders use the same native proximity and visible attack dispatch.
[ai_applayer2,giant_rockcrab_hidden]
npc_changetype(giant_rockcrab, ^wbcrab_giant_awake_ticks);
npc_setmode(opplayer2);

[ai_applayer2,giant_rockcrab_hidden_deeper]
npc_changetype(giant_rockcrab_deeper, ^wbcrab_giant_awake_ticks);
npc_setmode(opplayer2);

[ai_queue3,giant_rockcrab] @wbcrab_giant_death;
[ai_queue3,giant_rockcrab_deeper] @wbcrab_giant_death;

[label,wbcrab_giant_death]
gosub(npc_death);
if (npc_findhero = ^false) return;
obj_add(npc_coord, bones, 1, ^lootdrop_duration);
~trail_mediumcluedrop(^wbcrab_giant_clue_rarity, npc_coord);
def_namedobj $item;
def_int $count;
$item, $count = ~wbcrab_giant_loot;
if ($item ! null) obj_add(npc_coord, $item, $count, ^lootdrop_duration);

// CANDIDATE exact-variant OSRS 128-slot primary table; post-377 items excluded.
[proc,wbcrab_giant_loot]()(namedobj, int)
def_int $roll = random(^wbcrab_giant_primary_rolls);
if ($roll < 5) return(steel_platebody, 1);
else if ($roll < 10) return(black_claws, 1);
else if ($roll < 15) return(black_platebody, 1);
else if ($roll < 25) return(mithril_axe, 1);
else if ($roll < 27) return(dagganoth_melee_gloves, 1);
else if ($roll < 29) return(dagganoth_melee_feet, 1);
else if ($roll < 34) return(black_warhammer, 1);
else if ($roll < 39) return(adamant_longsword, 1);
else if ($roll < 49) return(waterrune, add(random(40), 1));
else if ($roll < 59) return(earthrune, add(random(40), 1));
else if ($roll < 67) return(~randomherb);
else if ($roll < 68) return(~wbmon_rare_seed);
else if ($roll < 78) return(~wbmon_talisman);
else if ($roll < 88) return(coins, add(random(140), 1));
else if ($roll < 98) return(raw_lobster, 1);
else if ($roll < 108) return(raw_bass, 1);
else if ($roll < 118) return(tinderbox, 1);
else if ($roll < 120) return(casket, 1);
else if ($roll < 122) return(dagganoth_melee_leg_part, 1);
else if ($roll < 124) return(dagganoth_melee_head_part, 1);
else if ($roll < 126) return(dagganoth_melee_body_part, 1);
else if ($roll < 127) return(~wbmon_gem);
return(null, 0);
