[proc,waterbirth_king_uncut_gem]()(namedobj, int)
def_int $roll = random(^wbk_uncut_gem_total_weight);
if ($roll < ^wbk_uncut_sapphire_end) return(uncut_sapphire, ^wbk_unstated_loot_quantity);
else if ($roll < ^wbk_uncut_emerald_end) return(uncut_emerald, ^wbk_unstated_loot_quantity);
else if ($roll < ^wbk_uncut_ruby_end) return(uncut_ruby, ^wbk_unstated_loot_quantity);
return(uncut_diamond, ^wbk_unstated_loot_quantity);

[proc,waterbirth_king_key_half]()(namedobj, int)
if (random(2) = 0) return(keyhalf1, ^wbk_unstated_loot_quantity);
return(keyhalf2, ^wbk_unstated_loot_quantity);

[proc,waterbirth_king_herb_seed]()(namedobj, int)
def_int $roll = random(^wbk_herb_seed_total_weight);
if ($roll < ^wbk_herb_seed_end_toadflax_seed) return(toadflax_seed, ^wbk_unstated_loot_quantity);
if ($roll < ^wbk_herb_seed_end_irit_seed) return(irit_seed, ^wbk_unstated_loot_quantity);
