// Rex: VERIFIED whole 27 April 2006 Tip.It list and stated quantities.
// Prime/Supreme: CANDIDATE own 27 June 2006 lists, eight weeks after the cutoff.
// Rex retains Mud Staff and Seercull: the later per-King unique split is not imported.
// All items are original 377 objects; no later pet, elite clue, key, head or limb.
// UNKNOWN weights and unstated singleton quantities live only in waterbirth_kings_loot.constant.
// Certificates explicitly stated in the period lists are preserved. For Rex steel bars
// and Prime essence, notation is CANDIDATE from the exact later King, not given by Tip.It.
[ai_queue3,dagcave_ranged_boss] @waterbirth_kings_death;
[ai_queue3,dagcave_magic_boss] @waterbirth_kings_death;
[ai_queue3,dagcave_melee_boss] @waterbirth_kings_death;

[label,waterbirth_kings_death]
gosub(npc_death);
if (npc_findhero = ^false) return;
obj_add(npc_coord, dagannoth_king_bones, 1, ^lootdrop_duration);
obj_add(npc_coord, dagganoth_hide, 1, ^lootdrop_duration);
def_namedobj $item;
def_int $count;
if (npc_type = dagcave_ranged_boss) {
    $item, $count = ~waterbirth_supreme_loot;
} else if (npc_type = dagcave_magic_boss) {
    $item, $count = ~waterbirth_prime_loot;
} else {
    $item, $count = ~waterbirth_rex_loot;
}
if ($count = -1) {
    // The slot already won; native eligibility chooses/suppresses the actual hard clue.
    ~trail_hardcluedrop(1, npc_coord);
} else if ($item ! null) {
    obj_add(npc_coord, $item, $count, ^lootdrop_duration);
}

