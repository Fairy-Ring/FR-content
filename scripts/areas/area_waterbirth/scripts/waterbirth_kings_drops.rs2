if ($roll < ^wbk_herb_seed_end_lantadyme_seed) return(lantadyme_seed, ^wbk_unstated_loot_quantity);
if ($roll < ^wbk_herb_seed_end_dwarf_weed_seed) return(dwarf_weed_seed, ^wbk_unstated_loot_quantity);
return(torstol_seed, ^wbk_unstated_loot_quantity);
