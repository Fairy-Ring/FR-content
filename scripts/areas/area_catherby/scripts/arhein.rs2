[opnpc1,arhein]
if(inv_total(inv, trail_clue_easy_simple025) = 1) {
    @trail_arhein;
}
~chatnpc("<p,happy>Hello! Would you like to trade?");
// One Small Favour leftover after Bleemadge 13→14 + weather-report return
// after Phantuwti grant 29. Keep shop / ship / trail / 14→15.
// CANDIDATE last-resort heading-back Arhein minus Hello again / duck / topic.
// Show 4435 only. inv_del UNKNOWN — do not invent. No dest / 12346 / hawser.
// Hunt 289? no.
def_int $option = 0;
if (%onesmallfavour >= 14) {
    if (%onesmallfavour >= 30) {
        $option = ~p_choice4("Yes.", 1, "No thank you.", 2, "Is that your ship?", 3, "Is that T.R.A.S.H. all sorted?", 4);
        if ($option = 4) {
            @osf_arhein_trash_done;
        }
    } else if (%onesmallfavour >= 29 & inv_total(inv, favour_weather_report) > 0) {
        $option = ~p_choice4("Yes.", 1, "No thank you.", 2, "Is that your ship?", 3, "I have the weather report for you.", 4);
        if ($option = 4) {
            @osf_arhein_weather;
        }
    } else if (%onesmallfavour >= 15) {
        $option = ~p_choice4("Yes.", 1, "No thank you.", 2, "Is that your ship?", 3, "What did you want me to do again?", 4);
        if ($option = 4) {
            @osf_arhein_trash;
        }
    } else {
        $option = ~p_choice4("Yes.", 1, "No thank you.", 2, "Is that your ship?", 3, "I need to talk T.R.A.S.H. to you.", 4);
        if ($option = 4) {
            @osf_arhein_trash;
        }
    }
} else {
    $option = ~p_choice3("Yes.", 1, "No thank you.", 2, "Is that your ship?", 3);
}
if($option = 1) {
    ~chatplayer("<p,neutral>Sure.");
    ~openshop_activenpc;
} else if($option = 2) {
    ~chatplayer("<p,neutral>No thank you.");
} else if($option = 3) {
    ~chatplayer("<p,quiz>Is that your ship?");
    ~chatnpc("<p,happy>Yes, I use it to make deliveries to my customers up and down the coast. These crates here are all ready for my next trip.");
    if(%arthur = ^arthur_spoken_lancelot) {
        @multi3("Do you deliver to the fort just down the coast?", arhein_fort, "Where do you deliver to?", arhein_deliver, "Are you rich then?", arhein_rich);
    }
    @multi2("Where do you deliver to?", arhein_deliver, "Are you rich then?", arhein_rich);
}

[label,arhein_deliver]
~chatplayer("<p,neutral>Where do you deliver to?");
~chatnpc("<p,happy>Oh, various places up and down the coast.|Mostly Karamja and Port Sarim.");
def_int $option = ~p_choice2("I don't suppose I could get a lift anywhere?", 1, "Well, good luck with your business.", 2);
if($option = 1) {
    ~chatplayer("<p,neutral>I don't suppose I could get a lift anywhere?");
    ~chatnpc("<p,happy>Sorry pal, but I'm afraid I'm not quite ready to sail yet.");
    // https://web.archive.org/web/20050521020137im_/http://www.runeweb.net/fireball/Merlin%20Crystal%20Images/merlin8.PNG
    ~chatnpc("<p,happy>I'm waiting on a big delivery of candles|which I need to deliver further along the coast.");
} else if($option = 2) {
    ~chatplayer("<p,neutral>Well, good luck with your business.");
    ~chatnpc("<p,happy>Thanks buddy!");
} 

[label,arhein_rich]
~chatplayer("<p,neutral>Are you rich then?");
~chatnpc("<p,happy>Business is going reasonably well...|I wouldn't say I was the richest of merchants ever,|but I'm doing fairly well all things considered.");

[label,arhein_fort]
~chatplayer("<p,neutral>Do you deliver to the fort just down the coast?");
~chatnpc("<p,happy>Yes, I do have orders to deliver there from time to time. I think I may have some bits and pieces for them when I leave here next actually.");
switch_int(~p_choice2("Can you drop me off on the way down please?", 1, "Aren't you worried about supplying evil knights?", 2)) {
    case 1 :
        ~chatplayer("<p,neutral>Can you drop me off on the way down please?");
        ~chatnpc("<p,happy>I don't think Sir Mordred would like that.|He wants as few outsiders visiting as possible.|I wouldn't want to lose his business.");
    case 2 :
        ~chatplayer("<p,neutral>Aren't you worried about supplying evil knights?");
        ~chatnpc("<p,happy>Hey, you gotta take business where you can find it these days! Besides, if I didn't supply them, someone else would.");
}

[label,trail_arhein]
// https://www.youtube.com/watch?v=oLqbhQX1HpM
~chatnpc("<p,happy>Well done, matey!");
~progress_clue_easy(trail_clue_easy_simple025, "Arhein has given you another clue scroll!");

[label,osf_arhein_trash]
if (%onesmallfavour >= 15) {
    ~chatplayer("<p,quiz>What did you want me to do again?");
    ~chatnpc("<p,neutral>I just need you to pop along to Seers Village and ask those philosophers of foresight for a weather report. I believe a new seer there called Phantuwti can help you.");
    return;
}
~chatplayer("<p,neutral>I need to talk T.R.A.S.H. to you.");
~chatnpc("<p,quiz>Oh yes, well it won't be the first time...but just so I'm sure can you explain what you mean?");
~chatplayer("<p,neutral>Yes, of course. There's a Gnome on White Wolf mountain who needs some T.R.A.S.H...for his glider...do you have some?");
~chatnpc("<p,neutral>Well, I've done a lot of research into Triple Redundant Aero Super Hawsers and it seems to have paid off, but answer me this one question. Why are you asking me this rather than the Gnome?");
~chatplayer("<p,neutral>Well, I'm sort of doing him a favour.");
~chatnpc("<p,quiz>Hmm, really, is that so? Well, I do have some Triple Redundant Aero Super Hawser and I'll let you have some if you do me just one small favour.");
~chatplayer("<p,angry>How totally unpredictable!");
~chatnpc("<p,happy>No, this is a really quick thing and shouldn't take you longer than a few minutes.");
~chatplayer("<p,sad>Yeah, I've heard that before! Go on...tell me anyway.");
~chatnpc("<p,neutral>I'm funding a rather expensive trade run to Brimhaven soon and I want to be sure that the weather isn't going to change and cause my ships any trouble.");
~chatnpc("<p,neutral>The last thing I need is a load of goods going straight to the bottom of the ocean.");
~chatplayer("<p,neutral>Well, I can understand that.");
~chatnpc("<p,neutral>I just need you to pop along to Seers Village and ask those philosophers of foresight for a weather report. I believe a new seer there called Phantuwti can help you.");
def_int $yes = ~p_choice2("Yes, Ok, I'll do it!", 1, "No way...I've had enough of this wild goose chase.", 2);
if ($yes = 2) {
    ~chatplayer("<p,angry>No way...I've had enough of this wild goose chase.");
    return;
}
~chatplayer("<p,happy>Yes, Ok, I'll do it!");
~chatnpc("<p,happy>That's great, many thanks.");
if (%onesmallfavour = 14) {
    %onesmallfavour = 15;
}
return;

// CANDIDATE last-resort With the weather report minus Changes. Show only.
// Consume not leftover-proven. Write 29→30.
[label,osf_arhein_weather]
if (inv_total(inv, favour_weather_report) < 1) {
    @osf_arhein_trash;
}
~chatplayer("<p,happy>I have the weather report for you.");
~chatnpc("<p,happy>Fantastic...let's see it!");
mes("You show the weather report to Arhein.");
~chatnpc("<p,neutral>Wonderful...well the weather report is slightly unspecific, but I feel much better anyway for getting it. Hopefully now the Seers will take some responsibility if my ships go down to the bottom of the ocean.");
~chatnpc("<p,happy>I'll get one of my associates to take some T.R.A.S.H to your Gnome Glider Pilot friend on White Wolf mountain. Once again, many thanks for your help.");
~chatplayer("<p,happy>Thanks!");
if (%onesmallfavour = 29) {
    %onesmallfavour = 30;
}
return;

[label,osf_arhein_trash_done]
~chatplayer("<p,quiz>Is that T.R.A.S.H. all sorted?");
~chatnpc("<p,happy>Indeed it is. One of my associates has taken some to your Gnome Glider Pilot friend on White Wolf mountain. Once again, many thanks for your help.");
~chatplayer("<p,happy>Thanks!");
return;
