// Period guides list possible drops but no weights, partition or resolved quantity rules.
// UNKNOWN: one equal slot per expanded item row; all remaining table slots are no-drop.
[ai_queue3,chaoselemental]
gosub(npc_death);
if (npc_findhero = ^false) return;

def_int $main_roll = random(^chaoselem_drop_main_roll_slots);
def_int $secondary_roll = random(^chaoselem_drop_secondary_roll_slots);
def_namedobj $main_item = null;
def_int $main_count = 0;
def_namedobj $secondary_item = null;
def_int $secondary_count = 0;

// Main row order (13): dragon 2h, rune javelin, rune 2h, rune spear,
// rune square shield, dragon med helm, four uncut gems, two key halves,
// dragon shield left half.
if ($main_roll = 0) {
    $main_item = dragon_2h_sword;
    $main_count = 1;
} else if ($main_roll = 1) {
    $main_item = rune_javelin;
    $main_count = 5;
} else if ($main_roll = 2) {
    $main_item = rune_2h_sword;
    $main_count = 1;
} else if ($main_roll = 3) {
    $main_item = rune_spear;
    $main_count = 1;
} else if ($main_roll = 4) {
    $main_item = rune_sq_shield;
    $main_count = 1;
} else if ($main_roll = 5) {
    $main_item = dragon_med_helm;
    $main_count = 1;
} else if ($main_roll = 6) {
    $main_item = uncut_sapphire;
    $main_count = 1;
} else if ($main_roll = 7) {
    $main_item = uncut_emerald;
    $main_count = 1;
} else if ($main_roll = 8) {
    $main_item = uncut_ruby;
    $main_count = 1;
} else if ($main_roll = 9) {
    $main_item = uncut_diamond;
    $main_count = 1;
} else if ($main_roll = 10) {
    $main_item = keyhalf1;
    $main_count = 1;
} else if ($main_roll = 11) {
    $main_item = keyhalf2;
    $main_count = 1;
} else if ($main_roll = 12) {
    $main_item = dragonshield_a;
    $main_count = 1;
}

// Secondary row order (26): coins, darts, runes, bones, arrows, fruit,
// potions, poison, food, herb, then the remaining bones and food.
if ($secondary_roll = 0) {
    $secondary_item = coins;
    $secondary_count = add(random(^chaoselem_drop_coin_quantity_draws), ^chaoselem_drop_coins_min);
} else if ($secondary_roll = 1) {
    $secondary_item = mithril_dart;
    $secondary_count = 400;
} else if ($secondary_roll = 2) {
    $secondary_item = airrune;
    $secondary_count = 500;
} else if ($secondary_roll = 3) {
    $secondary_item = deathrune;
    if (random(^chaoselem_drop_two_quantity_choices) = 0) $secondary_count = 30;
    else $secondary_count = 40;
} else if ($secondary_roll = 4) {
    $secondary_item = big_bones;
    $secondary_count = add(random(^chaoselem_drop_two_quantity_choices), 2);
} else if ($secondary_roll = 5) {
    $secondary_item = iron_arrow;
    $secondary_count = add(random(^chaoselem_drop_iron_arrow_quantity_draws), ^chaoselem_drop_iron_arrows_min);
} else if ($secondary_roll = 6) {
    $secondary_item = macro_triffidfruit;
    $secondary_count = add(random(^chaoselem_drop_two_quantity_choices), 1);
} else if ($secondary_roll = 7) {
    $secondary_item = babydragon_bones;
    $secondary_count = add(random(^chaoselem_drop_two_quantity_choices), 2);
} else if ($secondary_roll = 8) {
    $secondary_item = bloodrune;
    if (random(^chaoselem_drop_two_quantity_choices) = 0) $secondary_count = 40;
    else $secondary_count = 50;
} else if ($secondary_roll = 9) {
    $secondary_item = chaosrune;
    $secondary_count = 100;
} else if ($secondary_roll = 10) {
    $secondary_item = 1dose1attack;
    $secondary_count = 1;
} else if ($secondary_roll = 11) {
    $secondary_item = weapon_poison;
    $secondary_count = 1;
} else if ($secondary_roll = 12) {
    $secondary_item = bat_bones;
    $secondary_count = add(random(^chaoselem_drop_bat_bone_quantity_choices), 2);
} else if ($secondary_roll = 13) {
    $secondary_item = plain_pizza;
    $secondary_count = 3;
} else if ($secondary_roll = 14) {
    $secondary_item = 4doseantipoison;
    $secondary_count = 1;
} else if ($secondary_roll = 15) {
    $secondary_item = 1dose1defense;
    $secondary_count = 1;
} else if ($secondary_roll = 16) {
    $secondary_item = tuna;
    $secondary_count = 5;
} else if ($secondary_roll = 17) {
    $secondary_item, $secondary_count = ~randomherb;
    if (map_members = ^true) {
        $secondary_count = add(random(^chaoselem_drop_herb_quantity_choices), 1);
    }
} else if ($secondary_roll = 18) {
    $secondary_item = rune_arrow;
    $secondary_count = 200;
} else if ($secondary_roll = 19) {
    $secondary_item = mithril_arrow;
    $secondary_count = 400;
} else if ($secondary_roll = 20) {
    $secondary_item = bones;
    $secondary_count = 3;
} else if ($secondary_roll = 21) {
    $secondary_item = wolf_bones;
    $secondary_count = 5;
} else if ($secondary_roll = 22) {
    $secondary_item = dragon_bones;
    $secondary_count = add(random(^chaoselem_drop_two_quantity_choices), 1);
} else if ($secondary_roll = 23) {
    $secondary_item = meat_pizza;
    $secondary_count = 3;
} else if ($secondary_roll = 24) {
    $secondary_item = 1dose1strength;
    $secondary_count = 1;
} else if ($secondary_roll = 25) {
    $secondary_item = 1dose2defense;
    $secondary_count = 1;
}

// The period guides report no guaranteed drop; no cache death_drop is added.
if ($main_item ! null) obj_add(npc_coord, $main_item, $main_count, ^lootdrop_duration);
if ($secondary_item ! null) obj_add(npc_coord, $secondary_item, $secondary_count, ^lootdrop_duration);
