// Public test world only (NODE_PUBLIC_TEST): every obj stocked by public_test.inv, mapped to the
// namedobj the 0gp shop gives with inv_add (which takes a namedobj), so a purchase never moves
// the shop's own stock. Bulk supplies (essence, compost, plant pots, ores, bars, uncut gems,
// crafting/fletching/glass materials, logs, herbs, secondaries, vials, food and potions) are
// given in their cert_ (noted) form; tools, gear, rares and already-stackable objs map to
// themselves. UNKNOWN: engineering choice for the test world.
// tests/test_public_test_shop.mjs keeps the keys equal to the inv stock.
[public_test_shop_obj]
inputtype=obj
outputtype=namedobj
