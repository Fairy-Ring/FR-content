// CANDIDATE: finished Lost City 274 stealing.rs2, 65b754f768b79b941b21b2a1eb3b0d1ecae3cdfe.
[oploc2,viking_fur_market]
if (%viking < ^viking_complete) {
    ~mesbox("The fur trader is staring at you suspiciously. You cannot steal from his stall while he distrusts you.");
    return;
}
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

[oploc2,dwarf_market_gems]
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

[oploc2,dwarf_market_silver]
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

// CANDIDATE: the same reference's successful Rellekka theft hooks and existing constants.
// Every published stall falls through without changing state or starting a queue.
[proc,regional_stall_stolen]
switch_loc (loc_type) {
    case viking_fur_market :
        longqueue(stolen_from_stall_vikingfur, ^vikingfur_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^vikingfur_stall_index);
    case viking_fish_market :
        longqueue(stolen_from_stall_vikingfish, ^vikingfish_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^vikingfish_stall_index);
}
