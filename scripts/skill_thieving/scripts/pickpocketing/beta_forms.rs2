// VERIFIED requirement: Tip.It Thieving Guide, 27 April 2006, table footer.
[label,attempt_fremennik_pickpocket]
if (%viking < ^viking_complete) {
    // CANDIDATE message: period guide's requirement, not a surviving in-game transcript.
    mes("You must complete the Fremennik Trials quest to thieve from the citizens of Rellekka.");
    return;
}
@attempt_pick_pocket(npc_type);
