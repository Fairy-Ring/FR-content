// CANDIDATE: finished Lost City 274 spinning/pottery choosers and weak-queue batches.
// Shared published phases own every item exchange, XP award and result message.
[oploc2,spinningwheel] @ordinary_spin_chooser;
[oploc2,elf_village_spinning_wheel] @ordinary_spin_chooser;

[oploc2,viking_spinningwheel]
if (%viking < ^viking_complete) {
    ~mesbox("Only Fremenniks may use this spinning wheel.");
    return;
}
@ordinary_spin_chooser;

[label,ordinary_spin_chooser]
def_namedobj $item;
def_int $remaining;
$item, $remaining = ~skill_multi2_header(
    "What would you like to spin?",
    wool, 0, -2, 200, "\\n\\n\\n\\nWool",
    flax, 0, -3, 200, "\\n\\n\\n\\nFlax"
);
if_close;
if ($item = null | $remaining < 1) {
    return;
}
if ($item = flax & map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
def_int $held = inv_total(inv, $item);
if ($held = 0) {
    mes("You'll need <lowercase(oc_name($item))> to make that.");
    return;
}
@ordinary_spin_start($item, $remaining, loc_type, loc_coord, coord, 4);

// UNKNOWN batch timing: first finish at tick 4, then every 4 ticks.
// The initial input queues before processQueues; a queued finish queues after it.
// CANDIDATE shape: finished 274 spinning.rs2:84-111, cleared by walking.
[label,ordinary_spin_start](namedobj $item, int $remaining, loc $station, coord $tile, coord $origin, int $delay)
def_struct $recipe = oc_param($item, crafting_spinning_struct);
if (~craft_spinning_check($recipe) = false) return;
if (coord ! $origin) return;
if (loc_find($tile, $station) = false) return;
~craft_spinning_start;
weakqueue*(ordinary_spin_finish, $delay)($item, $recipe, $remaining, $station, $tile, $origin);

[queue,ordinary_spin_finish](namedobj $item, struct $recipe, int $remaining, loc $station, coord $tile, coord $origin)
if (~ordinary_station_present($station, $tile, $origin) = false) return;
~craft_spinning_finish($recipe);
$remaining = sub($remaining, 1);
if ($remaining < 1) return;
if (inv_total(inv, $item) = 0) {
    mes("You have run out of <lowercase(oc_name($item))>.");
    return;
}
@ordinary_spin_start($item, $remaining, $station, $tile, $origin, 3);

[oploc1,potteryoven] @ordinary_fire_chooser;
[oploc1,fai_barbarian_pottery_oven] @ordinary_fire_chooser;

[oploc1,viking_potteryoven]
if (%viking < ^viking_complete) {
    mes("Only Fremenniks may use this pottery oven.");
    return;
}
@ordinary_fire_chooser;

[label,ordinary_fire_chooser]
def_namedobj $item;
def_int $remaining;
$item, $remaining = ~skill_multi3(
    pot_unfired, 0, 2, 185, "\\n\\n\\n\\nPot",
    piedish_unfired, 0, -4, 190, "\\n\\n\\n\\nPie Dish",
    bowl_unfired, 0, 0, 200, "\\n\\n\\n\\nBowl"
);
if_close;
if ($item = null | $remaining < 1) {
    return;
}
// CANDIDATE: finished 274 pottery.struct supplies these existing chooser names.
def_string $plural = "pots";
if ($item = piedish_unfired) {
    $plural = "pie dishes";
} else if ($item = bowl_unfired) {
    $plural = "bowls";
}
if (inv_total(inv, $item) = 0) {
    ~mesbox("You don't have any <$plural> which need firing.");
    return;
}
@ordinary_fire_start($item, $remaining, $plural, loc_type, loc_coord, coord, 3);

// UNKNOWN batch timing: harden at tick 3, finish at tick 6; repeat every 6 ticks.
// CANDIDATE staged weak-queue shape: finished 274 pottery.rs2:122-154.
// Delays are 3 from input and 2 from a queue, so no stage can run this tick.
[label,ordinary_fire_start](namedobj $item, int $remaining, string $plural, loc $station, coord $tile, coord $origin, int $delay)
if (~ordinary_station_present($station, $tile, $origin) = false) return;
def_struct $recipe = oc_param($item, crafting_pottery_struct);
~fire_pottery_start($recipe);
weakqueue*(ordinary_fire_harden, $delay)($item, $recipe, $remaining, $plural, $station, $tile, $origin);

[queue,ordinary_fire_harden](namedobj $item, struct $recipe, int $remaining, string $plural, loc $station, coord $tile, coord $origin)
if (~ordinary_station_present($station, $tile, $origin) = false) return;
~fire_pottery_harden($recipe);
weakqueue*(ordinary_fire_finish, 2)($item, $recipe, $remaining, $plural, $station, $tile, $origin);

[queue,ordinary_fire_finish](namedobj $item, struct $recipe, int $remaining, string $plural, loc $station, coord $tile, coord $origin)
if (~ordinary_station_present($station, $tile, $origin) = false) return;
~fire_pottery_finish($item, $recipe);
$remaining = sub($remaining, 1);
if ($remaining < 1) return;
if (inv_total(inv, $item) = 0) {
    mes("You don't have any more <$plural> which need firing.");
    return;
}
@ordinary_fire_start($item, $remaining, $plural, $station, $tile, $origin, 2);

// UNKNOWN engineering guard: a raw teleport must not finish a remote station item.
[proc,ordinary_station_present](loc $station, coord $tile, coord $origin)(boolean)
if (coord ! $origin) return(false);
return(loc_find($tile, $station));

// CANDIDATE: both original 377 copies offer Fill-bucket and are water sources.
[oploc1,blast_furnace_sink]
if (inv_total(inv, bucket_empty) = 0) {
    ~displaymessage(^dm_default);
    return;
}
@fill_container_water(bucket_empty);

// CANDIDATE: finished Lost City 274 assigns all three top exits to one action.
// These two original forms join the published middle exit; no entrance gate changes.
[oploc1,troll_stronghold_top_exit_left] @troll_stronghold_top_exit;
[oploc1,troll_stronghold_top_exit_right] @troll_stronghold_top_exit;
