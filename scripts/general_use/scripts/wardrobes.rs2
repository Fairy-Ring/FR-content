[oploc1,spookywardrobe] @open_wardrobe(spookywardrobe_open, spookywardrobe_open_skeleton);

[label,open_wardrobe](loc $open, loc $skeleton)
p_arrivedelay;
anim(human_openbigcupboard, 0);
p_delay(0);
// todo - Sound
if ($skeleton = null) {
    loc_change($open, 500);
    return;
}

// 1/21 of spooky wardrobe, https://archive.is/FPJBA
if (random(21) = 0) {
    // Temp note: dur does not need updated
    loc_change($skeleton, 500);
} else {
    // Temp note: dur does not need updated
    loc_change($open, 500);
}

[oploc2,spookywardrobe_open] @search_wardrobe;

[label,search_wardrobe]
p_arrivedelay;
if (random(^findsomethingnice_chance) = 0 & ~in_tutorial_island(coord) = false) { // complete guess
    mes("You search the wardrobe..."); // guess
    p_delay(2);
    ~findsomethingnice;
    return;
}
mes("The wardrobe is empty.");

[oploc3,spookywardrobe_open] @close_wardrobe(spookywardrobe);
[oploc3,spookywardrobe_open_skeleton] @close_wardrobe(spookywardrobe);

[label,close_wardrobe](loc $closed)
p_arrivedelay;
anim(human_closechest, 0);
p_delay(0);
// todo - Sound
// Temp note: dur does not need updated
loc_change($closed, 500);

[oploc2,spookywardrobe_open_skeleton]
p_arrivedelay;
mes("Eek! There's a skeleton in there.");

