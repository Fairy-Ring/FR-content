[label,brewing_consume]
db_find(brewing_drink:item, last_item);
def_dbrow $row = db_findnext;
def_obj $effect = db_getfield($row, brewing_drink:effect, 0);
inv_setslot(inv, last_slot, db_getfield($row, brewing_drink:next, 0), 1);
anim(human_eat, 0);
~consume_effect_apply($effect, false);
