// VERIFIED normal flat effects: Tip.It Beer & Wines guide, 5 November 2005.
// CANDIDATE Chef's percentage, healing and mature effects: OSRS Brewing rev15364563.
// A formula applies to every grouped stat icon in the same table cell.
// VERIFIED cider +2/+3 Farming and normal Slayer +1 override conflicting current values.

[brewing_axemans_folly_effect]
table=consume_table
data=consumable,axemans_folly
data=stat_change,woodcutting,1,0
data=stat_change,attack,-3,0
data=stat_change,strength,-3,0
data=stat_heal,hitpoints,1,0

