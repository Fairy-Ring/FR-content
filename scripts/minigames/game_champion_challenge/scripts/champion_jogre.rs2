// Jogre Champion leftover fight after Larxus accept.
// Combat stats VERIFIED unpack all.npc (size=2 vislevel=107 hitpoints=120 attack=86 strength=86 defence=86).
// XP CANDIDATE 2007-base minus Changes (480/480). Banner varbit 1458.
// Do not open leftover 15831 / 2804.

[label,champions_spawn_jogre]
if (npc_find(^champions_imp_spawn, champions_jogre, 8, 0) = true) {
    return;
}
npc_add(map_findsquare(^champions_imp_spawn, 0, 2, ^map_findsquare_lineofwalk), champions_jogre, 1000);

[ai_queue3,champions_jogre]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (p_finduid(uid) = true) {
    @champions_jogre_victory;
    return;
}
queue(queue_champions_jogre_victory, 0, 0);

[queue,queue_champions_jogre_victory]
@champions_jogre_victory;

[label,champions_jogre_victory]
%champions_defeated_jogre = 1;
if (inv_total(inv, champions_challenge_jogre) > 0) {
    inv_del(inv, champions_challenge_jogre, 1);
}
// Leftover 15831 parchment stays closed. Leftover title lines as mes only.
mes("Well done, you defeated the Champion!");
mes("You are awarded: 480 Slayer Xp, 480 Hitpoint Xp.");
stat_advance(slayer, ^champions_jogre_xp);
stat_advance(hitpoints, ^champions_jogre_xp);
