// Ghoul Champion leftover fight after Larxus accept.
// Combat stats VERIFIED unpack all.npc (vislevel=85 hitpoints=100 attack=0 strength=0 defence=0).
// XP CANDIDATE 2007-base minus Changes (400/400). Banner varbit 1453.
// Do not open leftover 15831 / 2804.

[label,champions_spawn_ghoul]
if (npc_find(^champions_imp_spawn, champions_ghoul, 8, 0) = true) {
    return;
}
npc_add(map_findsquare(^champions_imp_spawn, 0, 2, ^map_findsquare_lineofwalk), champions_ghoul, 1000);

[ai_queue3,champions_ghoul]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (p_finduid(uid) = true) {
    @champions_ghoul_victory;
    return;
}
queue(queue_champions_ghoul_victory, 0, 0);

[queue,queue_champions_ghoul_victory]
@champions_ghoul_victory;

[label,champions_ghoul_victory]
%champions_defeated_ghoul = 1;
if (inv_total(inv, champions_challenge_ghoul) > 0) {
    inv_del(inv, champions_challenge_ghoul, 1);
}
// Leftover 15831 parchment stays closed. Leftover title lines as mes only.
mes("Well done, you defeated the Champion!");
mes("You are awarded: 400 Slayer Xp, 400 Hitpoint Xp.");
stat_advance(slayer, ^champions_ghoul_xp);
stat_advance(hitpoints, ^champions_ghoul_xp);
