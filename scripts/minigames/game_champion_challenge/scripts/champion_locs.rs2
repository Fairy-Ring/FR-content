// CANDIDATE travel: original 377 trapdoor/ladder pairs, not z +/- 6400.
[oploc1,champions_trap_door_closed]
mes("The trapdoor opens...");
sound_synth(door_open, 1, 0);
loc_change(champions_trap_door_open, 500);

[oploc1,champions_trap_door_open]
mes("You climb down through the trapdoor...");
anim(human_pickupfloor, 0);
p_delay(0);
p_telejump(^champions_basement_ladder);

[oploc2,champions_trap_door_open]
mes("You close the trapdoor.");
sound_synth(door_close, 1, 0);
loc_change(champions_trap_door_closed, 500);

[oploc1,champions_ladderup]
mes("You climb up the ladder...");
anim(human_reachforladder, 0);
p_delay(0);
~champions_leave;
p_telejump(^champions_surface);

[oploc1,champions_statue_trap] ~champions_enter;
[oploc1,champions_statue_trap_open] ~champions_enter;

[proc,champions_enter]
def_int $id = ~champions_current;
if ($id = 0) {
    // UNKNOWN functional refusal: no period wording is retained.
    ~chatnpc_specific("Larxus", champions_doorman, "<p,neutral>You need to arrange a challenge with me before you enter the arena.");
    return;
}
if (~champions_won($id) = true) return;
if ($id = 11) {
    if (~champions_ready_for_leon = false) return;
} else {
    if (inv_total(inv, enum(int, obj, champions_scroll, $id)) = 0) return;
}
if (~champions_entry_check($id) = false) return;
p_delay(0);
def_int $other = 1;
while ($other <= 11) {
    if (npc_find(^champions_imp_spawn, enum(int, npc, champions_npc, $other), 24, 0) = true) {
        // UNKNOWN functional refusal for the arena's single shared floor.
        mes("The arena is in use.");
        return;
    }
    $other = add($other, 1);
}
if ($id = 2) {
    inv_del(inv, champions_challenge_ghoul, 1);
    ~champions_set_scroll_escrow(1);
}
if ($id = 6) %sa_attack = ^false;
mes("You climb down through the trapdoor...");
anim(human_pickupfloor, 0);
p_telejump(^champions_arena_ladder);
// UNKNOWN engineering spawn square: inside the packed arena, not a cache dest.
npc_add(^champions_imp_spawn, enum(int, npc, champions_npc, $id), 1000);
%npc_macro_event_target = uid;

[oploc1,champions_portcullis]
sound_synth(bigdoor_open, 1, 0);
// UNKNOWN exact crossing animation; use the gate's two adjacent floor squares.
if (coordx(coord) >= coordx(loc_coord)) {
    p_telejump(movecoord(loc_coord, -1, 0, 0));
} else {
    p_telejump(movecoord(loc_coord, 1, 0, 0));
}

[oploc1,champions_arenaladder]
mes("You climb up the ladder...");
anim(human_reachforladder, 0);
p_delay(0);
~champions_leave;
p_telejump(^champions_gallery_stand);
