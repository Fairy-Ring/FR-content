// Champions’ Challenge leftover locs.
// Surface dest = period trapdoor z±6400 (trapdoors.rs2).
// Pit dest CANDIDATE leftover pit-loc centroid m49_152.
// Do not open leftover 15831 / 2804.

[oploc1,champions_trap_door_closed]
mes("The trapdoor opens...");
sound_synth(door_open, 0, 0);
loc_change(champions_trap_door_open, 500);

[oploc1,champions_trap_door_open]
mes("You climb down through the trapdoor...");
anim(human_pickupfloor, 0);
p_delay(0);
p_telejump(movecoord(coord(), 0, 0, 6400));

[oploc2,champions_trap_door_open]
mes("You close the trapdoor.");
sound_synth(door_close, 0, 0);
loc_change(champions_trap_door_closed, 500);

[oploc1,champions_ladderup]
mes("You climb up the ladder...");
anim(human_reachforladder, 0);
p_delay(0);
p_telejump(movecoord(coord(), 0, 0, -6400));

[oploc1,champions_statue_trap]
~chatnpc_specific("Larxus", champions_doorman, "<p,neutral>You need to arrange a challenge with me before you enter the arena.");

[oploc1,champions_statue_trap_open]
mes("You climb down through the trapdoor...");
anim(human_pickupfloor, 0);
p_delay(0);
p_telejump(^champions_imp_spawn);
if (inv_total(inv, champions_challenge_goblin) > 0) {
    @champions_spawn_goblin;
    return;
}
@champions_spawn_imp;

[oploc1,champions_arenaladder]
mes("You climb up the ladder...");
anim(human_reachforladder, 0);
p_delay(0);
p_telejump(^champions_gallery_stand);
