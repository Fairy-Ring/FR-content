// CANDIDATE wording: OSRS Transcript:Larxus, without later lamps or cape.
// The ten restrictions and Leon progression are VERIFIED by Tip.it, 30 Apr 2006.

[opnpc1,champions_doorman]
if (~champions_ready_for_leon = true) {
    ~chatnpc("<p,neutral>Leon d'Cour has issued you a challenge. <enum(int, string, champions_rule, 11)> Do you want to accept the challenge?");
    if (~p_choice2("Yes, let me at him!", 1, "No thanks, I'll pass.", 2) = 1) {
        ~champions_accept(11);
    }
    return;
}
def_int $choice = ~p_choice2("What is this place?", 1, "Nothing thanks.", 2);
if ($choice = 1) {
    ~chatnpc("<p,neutral>This is the champions' arena. The champions of various races use it to duel those they deem worthy of the honour. If you find a challenge scroll in your travels, bring it here to face your challenger.");
} else {
    ~chatplayer("<p,neutral>Nothing thanks.");
}

[opnpcu,champions_doorman]
def_int $id = 1;
while ($id <= 10) {
    if (last_useitem = enum(int, obj, champions_scroll, $id)) {
        if (~champions_won($id) = true) {
            ~chatnpc("<p,neutral>You've already defeated this Champion. The challenge is void.");
            inv_del(inv, enum(int, obj, champions_scroll, $id), 1);
            return;
        }
        if (~champions_current > 0) {
            ~chatnpc("<p,neutral>You've already got a champion waiting for you.");
            return;
        }
        ~chatnpc("<p,neutral>So you want to accept the challenge huh? Well there are some specific rules for these Champion fights. <enum(int, string, champions_rule, $id)> Do you still want to proceed?");
        if (~p_choice2("Yes, let me at him!", 1, "No thanks, I'll pass.", 2) = 1) {
            ~champions_accept($id);
        } else {
            ~chatplayer("<p,neutral>No thanks, I'll pass.");
        }
        return;
    }
    $id = add($id, 1);
}
~chatnpc("<p,neutral>That's great, now go show who's interested.");

[proc,champions_accept](int $id)
if (~champions_won($id) = true) return;
if ($id = 11) {
    if (~champions_ready_for_leon = false) return;
} else {
    if (inv_total(inv, enum(int, obj, champions_scroll, $id)) = 0) return;
}
~champions_set_current($id);
if (loc_find(^champions_statue, champions_statue_trap) = true) {
    // UNKNOWN engineering open duration: retain the inherited 1000 ticks.
    loc_change(champions_statue_trap_open, 1000);
}
~chatnpc("<p,neutral>Your challenger is ready! Please go down through the trapdoor when you're ready.");
