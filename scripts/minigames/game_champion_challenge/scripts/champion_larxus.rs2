[proc,champions_statue_is_open]()(boolean)
if (loc_find(^champions_statue, champions_statue_trap_open) = true) return(true);
if (loc_find(^champions_statue_l1, champions_statue_trap_open) = true) return(true);
return(false);

[proc,champions_open_statue]
if (loc_find(^champions_statue, champions_statue_trap) = true) {
    loc_change(champions_statue_trap_open, 1000);
    return;
}
if (loc_find(^champions_statue_l1, champions_statue_trap) = true) {
    loc_change(champions_statue_trap_open, 1000);
}
