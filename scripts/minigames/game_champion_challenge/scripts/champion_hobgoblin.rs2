// Hobgoblin Champion leftover fight after Larxus accept.
// Combat stats VERIFIED unpack all.npc (vislevel=56 hitpoints=58 attack=44 strength=48 defence=48).
// XP CANDIDATE 2007-base minus Changes (232/232). Banner varbit 1456.
// Do not open leftover 15831 / 2804.

[label,champions_spawn_hobgoblin]
if (npc_find(^champions_imp_spawn, champions_hobgoblin, 8, 0) = true) {
    return;
}
npc_add(map_findsquare(^champions_imp_spawn, 0, 2, ^map_findsquare_lineofwalk), champions_hobgoblin, 1000);

[ai_queue3,champions_hobgoblin]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (p_finduid(uid) = true) {
    @champions_hobgoblin_victory;
    return;
}
queue(queue_champions_hobgoblin_victory, 0, 0);

[queue,queue_champions_hobgoblin_victory]
@champions_hobgoblin_victory;

[label,champions_hobgoblin_victory]
%champions_defeated_hobgoblin = 1;
if (inv_total(inv, champions_challenge_hobgoblin) > 0) {
    inv_del(inv, champions_challenge_hobgoblin, 1);
}
// Leftover 15831 parchment stays closed. Leftover title lines as mes only.
mes("Well done, you defeated the Champion!");
mes("You are awarded: 232 Slayer Xp, 232 Hitpoint Xp.");
stat_advance(slayer, ^champions_hobgoblin_xp);
stat_advance(hitpoints, ^champions_hobgoblin_xp);
