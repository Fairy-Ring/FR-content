// Imp Champion leftover fight after Larxus accept.
// Combat stats VERIFIED unpack all.npc (hitpoints=40 attack=5 strength=5 defence=5).
// XP CANDIDATE 2007-base minus Changes (160/160). Banner leftover multivar.
// Do not open leftover 15831 / 2804.

[label,champions_spawn_imp]
if (npc_find(^champions_imp_spawn, champions_imp, 8, 0) = true) {
    return;
}
npc_add(map_findsquare(^champions_imp_spawn, 0, 2, ^map_findsquare_lineofwalk), champions_imp, 1000);

[ai_queue3,champions_imp]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (p_finduid(uid) = true) {
    @champions_imp_victory;
    return;
}
queue(queue_champions_imp_victory, 0, 0);

[queue,queue_champions_imp_victory]
@champions_imp_victory;

[label,champions_imp_victory]
%champions_defeated_imp = 1;
if (inv_total(inv, champions_challenge_imp) > 0) {
    inv_del(inv, champions_challenge_imp, 1);
}
// Leftover 15831 parchment stays closed. Leftover title lines as mes only.
mes("Well done, you defeated the Champion!");
mes("You are awarded: 160 Slayer Xp, 160 Hitpoint Xp.");
stat_advance(slayer, ^champions_imp_xp);
stat_advance(hitpoints, ^champions_imp_xp);
