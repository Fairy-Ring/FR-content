// Skeleton Champion leftover fight after Larxus accept.
// Combat stats VERIFIED unpack all.npc (vislevel=40 hitpoints=58 attack=1 strength=1 defence=34).
// XP CANDIDATE 2007-base minus Changes (232/232). Banner varbit 1460.
// Ranged-only is Larxus chat (CANDIDATE). Engine has no combat lock — ship fight anyway.
// Do not open leftover 15831 / 2804.

[label,champions_spawn_skeleton]
if (npc_find(^champions_imp_spawn, champions_skeleton, 8, 0) = true) {
    return;
}
npc_add(map_findsquare(^champions_imp_spawn, 0, 2, ^map_findsquare_lineofwalk), champions_skeleton, 1000);

[ai_queue3,champions_skeleton]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (p_finduid(uid) = true) {
    @champions_skeleton_victory;
    return;
}
queue(queue_champions_skeleton_victory, 0, 0);

[queue,queue_champions_skeleton_victory]
@champions_skeleton_victory;

[label,champions_skeleton_victory]
%champions_defeated_skeleton = 1;
if (inv_total(inv, champions_challenge_skeleton) > 0) {
    inv_del(inv, champions_challenge_skeleton, 1);
}
// Leftover 15831 parchment stays closed. Leftover title lines as mes only.
mes("Well done, you defeated the Champion!");
mes("You are awarded: 232 Slayer Xp, 232 Hitpoint Xp.");
stat_advance(slayer, ^champions_skeleton_xp);
stat_advance(hitpoints, ^champions_skeleton_xp);
