// Giant Champion leftover fight after Larxus accept.
// Combat stats VERIFIED unpack all.npc (size=2 vislevel=56 hitpoints=70 attack=36 strength=44 defence=52).
// XP CANDIDATE 2007-base minus Changes (280/280). Banner varbit 1454.
// Melee-only is Larxus chat (CANDIDATE). Engine has no combat lock — ship fight anyway.
// Do not open leftover 15831 / 2804.

[label,champions_spawn_giant]
if (npc_find(^champions_imp_spawn, champions_giant, 8, 0) = true) {
    return;
}
npc_add(map_findsquare(^champions_imp_spawn, 0, 2, ^map_findsquare_lineofwalk), champions_giant, 1000);

[ai_queue3,champions_giant]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (p_finduid(uid) = true) {
    @champions_giant_victory;
    return;
}
queue(queue_champions_giant_victory, 0, 0);

[queue,queue_champions_giant_victory]
@champions_giant_victory;

[label,champions_giant_victory]
%champions_defeated_giant = 1;
if (inv_total(inv, champions_challenge_giant) > 0) {
    inv_del(inv, champions_challenge_giant, 1);
}
// Leftover 15831 parchment stays closed. Leftover title lines as mes only.
mes("Well done, you defeated the Champion!");
mes("You are awarded: 280 Slayer Xp, 280 Hitpoint Xp.");
stat_advance(slayer, ^champions_giant_xp);
stat_advance(hitpoints, ^champions_giant_xp);
