// CANDIDATE: OSRS wall-safe fallback rules (revision 15355454); later changes
// are not applied. A successful crack grants 70 Thieving XP. The lobby roll
// uses the source's skill-1/skill-99 thresholds on a 0..255 roll.

[oploc1,roguesden_walldecor_safe]
~roguesden_lobby_safe;

[oploc1,roguesden_walldecor_mazesafe]
~roguesden_vault_safe;

[proc,roguesden_lobby_safe]
if (~roguesden_active = true) return;
if (stat_base(thieving) < 50) {
    // VERIFIED lobby requirement; wording is functional.
    mes("You need at least level 50 Thieving to crack this safe.");
    return;
}
if (inv_freespace(inv) < 1) {
    // UNKNOWN favourable-player refusal; do not take a crack without room.
    mes("You need a free inventory space before cracking the safe.");
    return;
}
def_int $low = 8;
def_int $high = 160;
def_int $level = min(99, max(1, stat(thieving)));
if (inv_total(inv, roguesden_stethoscope) > 0 | inv_total(worn, roguesden_stethoscope) > 0) {
    // CANDIDATE stethoscope thresholds from the retained OSRS source.
    $low = 16;
    $high = 192;
}
def_int $threshold = add($low, divide(multiply(sub($high, $low), sub($level, 1)), 98));
if (random(256) <= $threshold) {
    stat_advance(thieving, 700);
    ~roguesden_lobby_safe_loot;
    // UNKNOWN functional success wording.
    mes("You crack the safe and find something inside.");
    return;
}
def_int $damage = add(random(5), 2);
stat_sub(hitpoints, $damage, 0);
// CANDIDATE trap damage: 2-6 hitpoints on a failed crack.
// UNKNOWN functional failure wording.
mes("The safe trap injures you for <tostring($damage)> hitpoints.");
if (stat(hitpoints) <= 0) ~player_die;

[proc,roguesden_lobby_safe_loot]
def_int $roll = random(128);
if ($roll < 25) {
    inv_add(inv, coins, 10);
} else if ($roll < 81) {
    inv_add(inv, coins, 20);
} else if ($roll < 102) {
    inv_add(inv, coins, 40);
} else if ($roll < 114) {
    inv_add(inv, uncut_sapphire, 1);
} else if ($roll < 123) {
    inv_add(inv, uncut_emerald, 1);
} else if ($roll < 127) {
    inv_add(inv, uncut_ruby, 1);
} else {
    inv_add(inv, uncut_diamond, 1);
}

[proc,roguesden_vault_safe]
if (~roguesden_active = false) return;
if (inv_freespace(inv) < 1) {
    // UNKNOWN favourable-player refusal; leave the safe retryable.
    mes("You need a free inventory space before cracking the safe.");
    return;
}
// CANDIDATE: pass on 0..current Thieving, inclusive, from the 0..199 roll.
if (random(200) <= stat(thieving)) {
    ~roguesden_vault_reward;
    return;
}
if (random(2) = 0) {
    // CANDIDATE failure response: half the failed rolls eject the player.
    // UNKNOWN functional failure wording.
    mes("The safe catches you and sends you back to the lobby.");
    ~roguesden_leave(0);
    return;
}
def_int $before = stat(thieving);
stat_sub(thieving, 1, 0);
def_int $lost = sub($before, stat(thieving));
if ($lost > 0) ~roguesden_maze_drain_thieving($lost);
// CANDIDATE: the other half drain one Thieving level and still take the reward roll.
// UNKNOWN functional drain wording.
if ($lost > 0) {
    mes("The safe drains one level of Thieving, but you continue.");
} else {
    mes("You resist the safe's drain and continue.");
}
~roguesden_vault_reward;

[proc,roguesden_vault_reward]
// CANDIDATE: 3/8 Rogue kit, 5/8 equipment. UNKNOWN: uniform piece selection.
def_namedobj $reward = roguesden_kit;
if (random(8) >= 3) {
    switch_int(random(5)) {
        case 0 : $reward = roguesden_body;
        case 1 : $reward = roguesden_helm;
        case 2 : $reward = roguesden_legs;
        case 3 : $reward = roguesden_gloves;
        case 4 : $reward = roguesden_boots;
    }
}
~roguesden_leave(1);
inv_add(inv, $reward, 1);
// UNKNOWN functional success wording; the later crate choice is omitted.
mes("You crack the safe and receive a Rogue's reward.");
