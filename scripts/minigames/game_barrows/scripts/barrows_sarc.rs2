// Six original Search operations consume the existing brother/slain joins.
// Only the selected crypt offers its hidden tunnel; every other crypt has a resident.
[oploc1,barrow_ahrim_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_dharok_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_guthan_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_karil_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_torag_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_verac_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);

[proc,barrows_sarc_search](loc $sarcophagus, coord $anchor)
if (~barrows_phase ! ^barrows_phase_unlooted | ~barrows_inside(coord) = false | coordy(coord) ! 3 | ~barrows_inside($anchor) = false | coordy($anchor) ! 3) return;
def_npc $brother = enum(loc, npc, barrows_sarcophagus_brother, $sarcophagus);
if ($brother = null) return;
def_int $identity = ~barrows_brother_identity($brother);
if ($identity = 0) return;
if ($identity = ~barrows_tunnel_identity) {
    def_int $generation = %barrows_generation;
    def_coord $origin = coord;
    ~mesbox("You've found a hidden tunnel, do you want to enter?");
    if (~barrows_tunnel_enter($generation, $identity, $origin) = true) return;
    return;
}
if (~barrows_brother_slain($identity) = true | ~barrows_brother_find($brother) = true) return;
// Trace to the owner's legal approach tile, not the clipped sarcophagus origin.
def_coord $spawn = map_findsquare(coord, ^barrows_crypt_spawn_min_radius, ^barrows_crypt_spawn_radius, ^map_findsquare_lineofwalk);
if ($spawn = coord) return; // No eligible square: map_findsquare returns its origin.
if (npc_finduid(~barrows_actor_spawn($brother, $spawn, ^barrows_crypt_summon_lifetime)) = false) return;
npc_say("You dare disturb my rest!");
// Published summon convention: Rashiliyia's minions target the active player.
npc_setmode(~barrows_combat_start_mode($brother));
