// Six original Search operations consume S00's brother/slain joins. The selected
// hidden-tunnel crypt deliberately has no resident; S05 supplies its real route.
[oploc1,barrow_ahrim_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_dharok_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_guthan_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_karil_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_torag_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);
[oploc1,barrow_verac_sarcophagus] ~barrows_sarc_search(loc_type, loc_coord);

[proc,barrows_sarc_search](loc $sarcophagus, coord $anchor)
if (~barrows_phase ! ^barrows_phase_unlooted | ~barrows_inside(coord) = false | coordy(coord) ! 3 | ~barrows_inside($anchor) = false | coordy($anchor) ! 3) return;
def_npc $brother = enum(loc, npc, barrows_sarcophagus_brother, $sarcophagus);
if ($brother = null) return;
def_int $identity = ~barrows_brother_identity($brother);
if ($identity = 0 | $identity = ~barrows_tunnel_identity | ~barrows_brother_slain($identity) = true | ~barrows_brother_find($brother) = true) return;
def_coord $spawn = map_findsquare($anchor, ^barrows_crypt_spawn_min_radius, ^barrows_crypt_spawn_radius, ^map_findsquare_lineofwalk);
if ($spawn = null) return;
~barrows_actor_spawn($brother, $spawn, ^barrows_crypt_summon_lifetime);
