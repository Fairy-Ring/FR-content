// Measured mound footprints are unchanged. Crypt destinations consume S00's
// original NPC-to-coordinate joins; the same unfinished run is resumed.

[proc,barrows_dig]()(boolean)
if (inzone(0_55_51_45_24, 0_55_51_46_26, coord) = true) {
    ~barrows_dig_dest(enum(npc, coord, barrows_brother_crypt_entry, barrows_ahrim));
    return (true);
}
if (inzone(0_55_51_55_34, 0_55_51_55_34, coord) = true) {
    ~barrows_dig_dest(enum(npc, coord, barrows_brother_crypt_entry, barrows_dharok));
    return (true);
}
if (inzone(0_55_51_57_19, 0_55_51_57_19, coord) = true) {
    ~barrows_dig_dest(enum(npc, coord, barrows_brother_crypt_entry, barrows_guthan));
    return (true);
}
if (inzone(0_55_51_46_12, 0_55_51_46_12, coord) = true) {
    ~barrows_dig_dest(enum(npc, coord, barrows_brother_crypt_entry, barrows_karil));
    return (true);
}
if (inzone(0_55_51_33_19, 0_55_51_33_19, coord) = true) {
    ~barrows_dig_dest(enum(npc, coord, barrows_brother_crypt_entry, barrows_torag));
    return (true);
}
if (inzone(0_55_51_37_34, 0_55_51_37_34, coord) = true) {
    ~barrows_dig_dest(enum(npc, coord, barrows_brother_crypt_entry, barrows_verac));
    return (true);
}
return (false);

[proc,barrows_dig_dest](coord $dest)
if (~barrows_run_begin = false) return;
p_delay(1);
p_telejump($dest);
~barrows_resume;
