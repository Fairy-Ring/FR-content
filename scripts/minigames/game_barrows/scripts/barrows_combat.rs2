// Each converted ranged/magic type selects its native approach mode by config.
// This helper does not alter the actor, its owner or the encounter lifecycle.
[proc,barrows_combat_start_mode](npc $type)(npc_mode)
switch_int(nc_param($type, damagetype)) {
    case ^ranged_style, ^magic_style : return(applayer2);
}
return(opplayer2);

// CANDIDATE: the two level-77 skeletons cap at 10 without fitting Strength.
// Keep native contact readiness, accuracy, prayer, delivery and retaliation.
[ai_opplayer2,barrows_skeleton_unarmed] gosub(barrows_skeleton_attack);
[ai_opplayer2,barrows_skeleton_armed] gosub(barrows_skeleton_attack);

[proc,barrows_skeleton_attack]
~npc_default_attack_outcome(npc_param(barrows_maxhit), 0, false);

// VERIFIED barrows.bc-torag-special-existence; CANDIDATE protected-zero and 1-in-4.
[ai_opplayer2,barrows_torag] gosub(barrows_torag_attack);

[proc,barrows_torag_attack]
if (npc_stat(hitpoints) = 0) return;
def_boolean $attempted;
def_int $accuracy;
def_int $rolled;
def_int $delivered;
def_int $delivery_ticks;
$attempted, $accuracy, $rolled, $delivered, $delivery_ticks = ~npc_default_attack_outcome(npc_param(barrows_maxhit), 0, true);
if ($attempted = true & $accuracy = ^barrows_special_success_policy) {
    if (random(^barrows_torag_proc_denominator) = 0) {
        queue*(barrows_torag_corruption, ^barrows_special_delivery_order)(npc_uid);
    }
}

[queue,barrows_torag_corruption](npc_uid $source)
if (%death = ^true | stat(hitpoints) = 0) return;
if (npc_finduid($source) = false) return;
if (npc_stat(hitpoints) = 0 | %npc_attacking_uid ! uid) return;
def_int $energy = runenergy;
~barrows_torag_energy_change(calc($energy * ^barrows_torag_energy_remainder_percent / 100 - $energy));

[proc,barrows_torag_energy_change](int $change)
// PlayerOps.ts:1162 rejects script null -1. Only energy 1..5 needs it; +1 cannot clamp.
if ($change = -1) {
    healenergy(1);
    healenergy(-2);
} else {
    healenergy($change);
}

// VERIFIED Infestation existence; CANDIDATE Q3: only delivered damage heals.
[ai_opplayer2,barrows_guthan] gosub(barrows_guthan_attack);

[proc,barrows_guthan_attack]
if (npc_stat(hitpoints) = 0) return;
def_boolean $attempted;
def_int $accuracy;
def_int $rolled;
def_int $delivered;
def_int $delivery_ticks;
$attempted, $accuracy, $rolled, $delivered, $delivery_ticks = ~npc_default_attack_outcome(npc_param(barrows_maxhit), 0, true);
if ($attempted = true & $accuracy = ^barrows_special_success_policy) {
    if (random(^barrows_guthan_proc_denominator) = 0) {
        queue*(barrows_guthan_infestation, ^barrows_special_delivery_order)(npc_uid, $delivered);
    }
}

[queue,barrows_guthan_infestation](npc_uid $source, int $damage)
// Fatal damage runs first; this effect cannot heal more than the player lost.
if (%death = ^true | stat(hitpoints) = 0) return;
if (npc_finduid($source) = false) return;
if (npc_stat(hitpoints) = 0 | %npc_attacking_uid ! uid) return;
if ($damage <= 0 | npc_stat(hitpoints) >= npc_basestat(hitpoints)) return;
// Native NpcOps.ts:300-301 clears heroes at base HP; brief ruling 1 keeps it.
npc_statheal(hitpoints, $damage, 0);

// VERIFIED armour bypass; CANDIDATE Q1 prayer bypass and one chance in four.
[ai_opplayer2,barrows_verac] gosub(barrows_verac_attack);

[proc,barrows_verac_attack]
if (npc_stat(hitpoints) = 0) return;
if (~npc_default_attack_ready = false) return;
def_int $defence_policy = 0;
def_int $maxhit = npc_param(barrows_maxhit);
// UNKNOWN engineering order: one draw before accuracy, only on a ready attack.
if (random(^barrows_verac_proc_denominator) = 0) {
    $defence_policy = ^barrows_verac_unconditional_accuracy;
    if (~check_protect_prayer(^melee_style) = true) $maxhit = ^barrows_verac_protected_maxhit;
}
// Policy 2 skips accuracy and protection. Roll 0..15, never clamp a 0..23 roll.
~npc_meleeattack_outcome($maxhit, $defence_policy, false);

// VERIFIED Wretched Strength existence; CANDIDATE always-on missing-HP scaling.
[ai_opplayer2,barrows_dharok] gosub(barrows_dharok_attack);

[proc,barrows_dharok_attack]
// Read current HP once. No chance draw, temporary stat change or second hit.
def_int $hitpoints = npc_stat(hitpoints);
if ($hitpoints < ^barrows_dharok_living_hp_min) return;
if (~npc_default_attack_ready = false) return;
def_int $maxhit = calc((npc_param(barrows_maxhit) * (200 - $hitpoints) + ^barrows_dharok_round_half_up) / 100);
~npc_meleeattack_outcome($maxhit, 0, false);

// VERIFIED Tainted Shot existence/amount; CANDIDATE protected-zero and 1-in-4.
[ai_opplayer2,barrows_karil] npc_setmode(applayer2);
[ai_applayer2,barrows_karil] gosub(barrows_karil_attack);
[ai_queue1,barrows_karil] ~npc_default_retaliate_ap;

[proc,barrows_karil_attack]
if (npc_stat(hitpoints) = 0 | %death = ^true) return;
def_boolean $attempted;
def_int $accuracy;
def_int $rolled;
def_int $delivered;
def_int $delivery_ticks;
$attempted, $accuracy, $rolled, $delivered, $delivery_ticks = ~npc_rangeattack_outcome(npc_param(barrows_maxhit), true, false);
if ($attempted = true & $accuracy = ^barrows_special_success_policy) {
    if (random(^barrows_karil_proc_denominator) = 0) {
        // Append after the native damage and retaliation at their delivery tick.
        queue*(barrows_karil_tainted_shot, $delivery_ticks)(npc_uid);
    }
}

[queue,barrows_karil_tainted_shot](npc_uid $source)
if (%death = ^true | stat(hitpoints) = 0) return;
if (npc_finduid($source) = false) return;
if (npc_stat(hitpoints) = 0 | %npc_attacking_uid ! uid) return;
stat_sub(agility, 0, ^barrows_karil_agility_percent);

// Huntless defaults never initiate against a stranger. The native owner guard
// ends pursuit; the timer latches release on WANDER without changing retaliation.
[proc,barrows_owned_tunnel_guard]
if (npc_getmode = wander | npc_getmode = none) return;
if (npc_type = barrows_ahrim | npc_type = barrows_dharok | npc_type = barrows_guthan | npc_type = barrows_karil | npc_type = barrows_torag | npc_type = barrows_verac) return;
if (npc_getmode = playerescape | npc_inrange = false | coordy(coord) ! coordy(npc_coord) | %death = ^true | ~npc_check_notcombat = false) npc_setmode(wander);
