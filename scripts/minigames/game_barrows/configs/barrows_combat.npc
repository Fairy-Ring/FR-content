[barrows_bloodworm]
name=Bloodworm
desc=Think I should keep my distance...
model1=npc_2031
recol1s=29225
recol1d=18947
recol2s=26983
recol2d=16737
recol3s=25893
recol3d=15648
recol4s=20610
recol4d=10368
recol5s=6208
recol5d=64
walkanim=bloodworm_walk
readyanim=bloodworm_ready
op2=Attack
vislevel=52
hitpoints=45
attack=80
strength=20
defence=35
magic=1
ranged=1
// Huntless type defaults keep every owned reset passive; static scripts arm hunting.
timer=1
// as built; engineering choice; period value UNKNOWN.
huntrange=4
param=attackrate,4
param=damagetype,^stab_style
param=attackbonus,0
param=strengthbonus,0
param=magicattack,0
param=rangeattack,0
param=rangebonus,0
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
param=magicdefence,0
param=rangedefence,0
// CANDIDATE (operator decision 2026-11-16 12:00Z, own family): no published monster binds a
// bloodworm sequence; these share bloodworm_walk/bloodworm_ready's prefix and frame base and
// move only labels the model has. The pack names no bloodworm sound: sounds stay default.
param=attack_anim,bloodworm_attack
param=defend_anim,bloodworm_block
param=death_anim,bloodworm_death

[barrows_rat]
