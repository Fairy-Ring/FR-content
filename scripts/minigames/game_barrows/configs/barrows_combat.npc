recol2d=16941
walkanim=rat_walk
readyanim=rat_ready
op2=Attack
minimap=no
vislevel=43
hitpoints=35
attack=70
strength=20
defence=20
param=slayer_category,^slayer_rat
magic=1
ranged=1
timer=1
// as built; engineering choice; period value UNKNOWN.
huntrange=4
param=attackrate,4
param=damagetype,^stab_style
param=attackbonus,0
param=strengthbonus,0
param=magicattack,0
param=rangeattack,0
param=rangebonus,0
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
param=magicdefence,0
param=rangedefence,0
// CANDIDATE (operator rule 2026-11-16): same-model witchrat binds rat_death; rat_attack, rat_block
// and the rat sounds are the own rat_* family, as the published rat binds them. All share
// rat_walk/rat_ready's frame base.
param=attack_anim,rat_attack
param=defend_anim,rat_block
param=death_anim,rat_death
param=attack_sound,rat_attack
param=defend_sound,rat_hit
param=death_sound,rat_death

