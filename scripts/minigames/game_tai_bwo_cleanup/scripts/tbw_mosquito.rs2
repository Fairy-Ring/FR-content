[ai_queue3,tbwcu_mosquito_single] @tbw_mosquito_death(1, 175);
[ai_queue3,tbwcu_mosquito_swarm3] @tbw_mosquito_death(3, 350);
[ai_queue3,tbwcu_mosquito_swarm5] @tbw_mosquito_death(5, 750);

// CANDIDATE: Large mosquito 15216710 / Mosquito swarm 15216711.
// Anyone can kill another player's mosquito, including before Jungle Potion.
[label,tbw_mosquito_death](int $quantity, int $agility_xp)
gosub(npc_death);
if (npc_findhero = 1) {
    obj_add(npc_coord, mosquito_proboscis, $quantity, ^lootdrop_duration);
    stat_advance(agility, $agility_xp);
    // A favour write needs protected access; do not queue rewards for busy players.
    if (p_finduid(uid) = true) {
        if (~tbw_in_village = true & %cleanup_progress > 0) {
            ~tbw_add_favour(^tbw_favour_mosquito);
        }
    }
}

[opnpcu,tbwcu_mosquito_single] @tbw_mosquito_repellent;
[opnpcu,tbwcu_mosquito_swarm3] @tbw_mosquito_repellent;
[opnpcu,tbwcu_mosquito_swarm5] @tbw_mosquito_repellent;

[label,tbw_mosquito_repellent]
if (last_useitem ! insect_repellent) {
    ~displaymessage(^dm_default);
    return;
}
// CANDIDATE: reusable repellent halves combat stats (floor one), stops attacks 6s.
npc_statsub(attack, min(sub(npc_stat(attack), 1), divide(add(npc_stat(attack), 1), 2)), 0);
npc_statsub(strength, min(sub(npc_stat(strength), 1), divide(add(npc_stat(strength), 1), 2)), 0);
npc_statsub(defence, min(sub(npc_stat(defence), 1), divide(add(npc_stat(defence), 1), 2)), 0);
npc_statsub(magic, min(sub(npc_stat(magic), 1), divide(add(npc_stat(magic), 1), 2)), 0);
npc_statsub(ranged, min(sub(npc_stat(ranged), 1), divide(add(npc_stat(ranged), 1), 2)), 0);
%npc_action_delay = add(map_clock, 10);
// UNKNOWN functional message, no retained transcript supplies this line.
mes("You use the insect repellent on the mosquitoes.");
