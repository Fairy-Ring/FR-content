// Tai Bwo Wannai Cleanup, original 377 HUD and villagers.
// CANDIDATE mechanics: OSRS Cleanup; period/cache authority is in the subject note.

[proc,tbw_in_village]()(boolean)
if (inzone(0_43_47_0_0, 0_44_48_63_63, coord) = true) {
    return (true);
}
return (false);

// CANDIDATE access: Jungle Potion complete and Murcaily's explanation.
[proc,tbw_cleanup_can_work]()(boolean)
// UNKNOWN functional refusals: no retained source supplies these exact lines.
if (%junglepotion < ^junglepotion_complete) {
    mes("You need to complete Jungle Potion before helping the village.");
    return (false);
}
if (%cleanup_progress = 0) {
    mes("Speak to Murcaily about helping the village first.");
    return (false);
}
return (true);

[proc,tbw_cleanup_show_villagers]
if (%villagers_visible = 1) {
    return;
}
// Multi keys are 1–7 only (no key 0). Default chat_*=0 hides every villager.
// CANDIDATE: first visit shows the "with sticks" concrete (key 1).
%chat_sharimika = 1;
%chat_mamma = 1;
%chat_layleen = 1;
%chat_karaday = 1;
%chat_safta = 1;
%chat_gabooty = 1;
%chat_fanellaman = 1;
%chat_jag = 1;
%chat_murc = 1;
%chat_rion = 1;
%villagers_visible = 1;

[proc,tbw_cleanup_enter]
~tbw_cleanup_show_villagers;
%favour_percentage = divide(%vill_comm_points, 10);
if (%tbw_overlayopen = 0) {
    if_openoverlay(tai_bwo_favour);
    %tbw_overlayopen = 1;
}

[proc,tbw_cleanup_try_exit]
if (~tbw_in_village = true) {
    return;
}
if (%tbw_overlayopen = 1) {
    if_openoverlay(null);
    %tbw_overlayopen = 0;
}

[proc,tbw_cleanup_login]
if (~tbw_in_village = true) {
    ~tbw_cleanup_enter;
}
// CANDIDATE: claimed suppliers recover during all logged-in time, not just visits.
// Unvisited players have zero supplier state and need no recurring timer.
if (%tai_bwo_villagerchat ! 0) {
    if (~tbw_villager_has_cooldown = true) settimer(tbw_villager_cooldown, 300);
}

[mapzoneexit,0_43_47] ~tbw_cleanup_try_exit;
[mapzoneexit,0_43_48] ~tbw_cleanup_try_exit;
[mapzoneexit,0_44_47] ~tbw_cleanup_try_exit;
[mapzoneexit,0_44_48] ~tbw_cleanup_try_exit;
