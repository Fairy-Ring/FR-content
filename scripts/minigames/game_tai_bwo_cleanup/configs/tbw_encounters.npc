// Original 377 encounter NPC client fields moved verbatim from all.npc.
// Server-only combat params are appended below each final combat form.
// VERIFIED Sal's Realm period guide: spiders rarely poison; snakes and tribesmen poison more often.
// VERIFIED Sal's Realm period guide: Broodoo victims use magic; balm, antipoison and food match yellow, green and white.
// VERIFIED Broodoo incoming normal damage cap: 2; weakness items bypass that player-combat cap.
// CANDIDATE OSRS Broodoo attack interval: 6 ticks.

[tbwcu_village_snake]
name=Bush Snake
desc=A slithering serpent that likes to hide in the bush.
model1=npc_snake
walkanim=snake_walk
readyanim=snake_ready
op2=Attack
vislevel=35
hitpoints=25
attack=25
strength=25
defence=50
param=damagetype,^stab_style
param=attack_anim,snake_attack
param=defend_anim,snake_block
param=death_anim,snake_death
param=attack_sound,snake_attack
param=defend_sound,snake_hit
param=death_sound,snake_death
param=poison_severity,^tbw_snake_poison_severity
param=death_drop,village_snake_hide

