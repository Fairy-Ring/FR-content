// VERIFIED rules and native controls: Tip.It, 15 April 2006, and revision-377 interfaces.
// UNKNOWN generator: a valid cyclic seed with rotating symbols and clue positions.
// UNKNOWN selector interpretation: bind real rune models at runtime; never treat com_i model suffixes as object IDs.
// Original rogue_suduku1 low bits 0..15 are untouched. Approved temporary high bits:
// 16..19 selected rune, 20 large board, 21..28 generation (retained only during this login).
[proc,roguetrader_sudoku_open](int $large)
if (%feud_var < ^feud_complete | %runemysteries ! ^runemysteries_complete | %roguetrader_runes < 3) return;
~roguetrader_sudoku_close;
def_int $generation = calc((getbit_range(%rogue_suduku1, 21, 28) + 1) % 256);
%rogue_suduku1 = setbit_range_toint(%rogue_suduku1, $generation, 21, 28);
%rogue_suduku1 = setbit_range_toint(%rogue_suduku1, $large, 20, 20);
%roguetrader_playing_sudoku = 1;
def_int $side = 4;
def_int $box = 2;
if ($large = 1) { $side = 9; $box = 3; }
def_int $slot = 0;
while ($slot < calc($side * $side)) {
    def_int $row = calc($slot / $side);
    def_int $column = calc($slot % $side);
    if (calc(($row + $column + $generation) % 3) = 0) {
        def_int $value = calc(($row * $box + $row / $box + $column + $generation) % $side + 1);
        def_namedobj $rune = ~roguetrader_sudoku_rune($large, $value);
        inv_setslot(roguetrader_toughsudukuinv, $slot, $rune, 1);
        inv_setslot(roguetrader_sudoku_clueinv, $slot, $rune, 1);
    }
    $slot = calc($slot + 1);
}
if ($large = 1) {
    if_openmain(inter_295);
    inv_transmit(roguetrader_toughsudukuinv, inter_295:com_132);
    // UNKNOWN scale 72 follows the existing boardgames rune-preview convention.
    if_setobject(inter_295:com_122, naturerune, 72);
    if_setobject(inter_295:com_123, lawrune, 72);
    if_setobject(inter_295:com_124, chaosrune, 72);
    if_setobject(inter_295:com_125, deathrune, 72);
    if_setobject(inter_295:com_126, mindrune, 72);
    if_setobject(inter_295:com_127, bodyrune, 72);
    if_setobject(inter_295:com_128, bloodrune, 72);
    if_setobject(inter_295:com_129, cosmicrune, 72);
    if_setobject(inter_295:com_130, soulrune, 72);
    if_setobject(inter_295:com_131, null, 72);
} else {
    if_openmain(inter_296);
    inv_transmit(roguetrader_toughsudukuinv, inter_296:com_63);
    if_setobject(inter_296:com_58, firerune, 72);
    if_setobject(inter_296:com_59, waterrune, 72);
    if_setobject(inter_296:com_60, airrune, 72);
    if_setobject(inter_296:com_61, earthrune, 72);
    if_setobject(inter_296:com_62, null, 72);
}

[proc,roguetrader_sudoku_close]
inv_stoptransmit(inter_295:com_132);
inv_stoptransmit(inter_296:com_63);
inv_clear(roguetrader_toughsudukuinv);
inv_clear(roguetrader_sudoku_clueinv);
%roguetrader_playing_sudoku = 0;
%rogue_suduku1 = setbit_range_toint(%rogue_suduku1, 0, 16, 20);

[proc,roguetrader_sudoku_rune](int $large, int $value)(namedobj)
if ($large = 0) {
    if ($value = 1) return (firerune);
    if ($value = 2) return (waterrune);
    if ($value = 3) return (airrune);
    if ($value = 4) return (earthrune);
} else {
    if ($value = 1) return (naturerune);
    if ($value = 2) return (lawrune);
    if ($value = 3) return (chaosrune);
    if ($value = 4) return (deathrune);
    if ($value = 5) return (mindrune);
    if ($value = 6) return (bodyrune);
    if ($value = 7) return (bloodrune);
    if ($value = 8) return (cosmicrune);
    if ($value = 9) return (soulrune);
}
return (null);

[proc,roguetrader_sudoku_select](int $large, int $value)
if (%roguetrader_playing_sudoku = 0 | getbit_range(%rogue_suduku1, 20, 20) ! $large) return;
%rogue_suduku1 = setbit_range_toint(%rogue_suduku1, $value, 16, 19);
if ($large = 1) if_setobject(inter_295:com_131, ~roguetrader_sudoku_rune($large, $value), 72);
else if_setobject(inter_296:com_62, ~roguetrader_sudoku_rune($large, $value), 72);

[proc,roguetrader_sudoku_place](int $large, int $slot)
if (%roguetrader_playing_sudoku = 0 | getbit_range(%rogue_suduku1, 20, 20) ! $large) return;
if (inv_getobj(roguetrader_sudoku_clueinv, $slot) ! null) return;
def_int $value = getbit_range(%rogue_suduku1, 16, 19);
if ($value = 0) inv_delslot(roguetrader_toughsudukuinv, $slot);
else inv_setslot(roguetrader_toughsudukuinv, $slot, ~roguetrader_sudoku_rune($large, $value), 1);

[proc,roguetrader_sudoku_valid](int $large)(boolean)
def_int $side = 4;
def_int $box = 2;
if ($large = 1) { $side = 9; $box = 3; }
def_int $slot = 0;
while ($slot < calc($side * $side)) {
    def_obj $rune = inv_getobj(roguetrader_toughsudukuinv, $slot);
    if ($rune = null) return (false);
    def_int $row = calc($slot / $side);
    def_int $column = calc($slot % $side);
    def_int $previous = 0;
    while ($previous < $slot) {
        def_int $otherrow = calc($previous / $side);
        def_int $othercolumn = calc($previous % $side);
        if ($row = $otherrow | $column = $othercolumn | (calc($row / $box) = calc($otherrow / $box) & calc($column / $box) = calc($othercolumn / $box))) {
            if (inv_getobj(roguetrader_toughsudukuinv, $previous) = $rune) return (false);
        }
        $previous = calc($previous + 1);
    }
    $slot = calc($slot + 1);
}
return (true);

[proc,roguetrader_sudoku_submit](int $large)
if (%roguetrader_playing_sudoku = 0 | getbit_range(%rogue_suduku1, 20, 20) ! $large) return;
if (~roguetrader_sudoku_valid($large) = false) {
    // UNKNOWN functional refusal; a mistake does not close or reset the board.
    mes("The lock stays closed.");
    return;
}
if ($large = 1) { %roguetrader_runes = 4; %roguetrader_stallvar = 4; }
else { %roguetrader_justobt_runes = 1; %roguetrader_stallvar = 1; }
~roguetrader_sudoku_close;
if_close;
~roguetrader_completion;
mes("You hear the locking mechanism click open!");
~roguetrader_casket_opened($large);

[if_close,inter_295]
if (p_finduid(uid) = false) return;
~roguetrader_sudoku_close;
[if_close,inter_296]
if (p_finduid(uid) = false) return;
~roguetrader_sudoku_close;
[if_button,inter_295:com_10]
~roguetrader_sudoku_close;
if_close;
[if_button,inter_296:com_42]
~roguetrader_sudoku_close;
if_close;
[if_button,inter_295:com_9]
~roguetrader_sudoku_submit(1);
[if_button,inter_296:com_41]
~roguetrader_sudoku_submit(0);

[if_button,inter_296:com_58]
~roguetrader_sudoku_select(0, 1);
