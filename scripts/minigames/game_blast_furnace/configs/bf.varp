// Reserved original 377 slot 411: UNKNOWN persistent engineering fee deadline.
[blast_furnace_access_until]
type=int
scope=perm

// Original transmitted readings are derived; gauge-open bit 30 is temporary.
// Hot-bar state is reconstructed from permanent stock and the cooling counter.
// Shared room timer updates private stocks/readings atomically, including while a worker reads a modal gauge.
[blast_furnace_readings]
protect=no
transmit=yes
scope=temp

