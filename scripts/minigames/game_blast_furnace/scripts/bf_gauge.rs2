// VERIFIED gauge models/poses: original 377 interface and sequences. Numeric scale UNKNOWN.
[oploc1,blast_furnace_gauge]
p_arrivedelay;
~bf_update_readings;
if_openmain(blast_furnace_temp_gauge);
%blast_furnace_readings = setbit(%blast_furnace_readings, ^bf_gauge_bit);
~bf_gauge_refresh;

[if_close,blast_furnace_temp_gauge]
%blast_furnace_readings = clearbit(%blast_furnace_readings, ^bf_gauge_bit);

[proc,bf_gauge_refresh]
def_string $band = "White";
if (%blast_furnace_temperature_reading >= ^bf_green_low) $band = "Green";
if (%blast_furnace_temperature_reading > ^bf_green_high) $band = "Red";
if_settext(blast_furnace_temp_gauge:com_0, "Heat: <tostring(%blast_furnace_temperature_reading)> (<$band>)");
if (%blast_furnace_fuel_low_reading = 0) if_setanim(blast_furnace_temp_gauge:com_2, temp_gauge_flag_fuel_low_in);
else if_setanim(blast_furnace_temp_gauge:com_2, temp_gauge_flag_fuel_low_out);
if (%blast_furnace_broken_pipe_reading = 0) if_setanim(blast_furnace_temp_gauge:com_3, temp_gauge_flag_pipe_broken_in);
else if_setanim(blast_furnace_temp_gauge:com_3, temp_gauge_flag_pipe_broken_out);
// UNKNOWN byte-to-pose scale; animate the original needle, never rotate its dial case.
if_setanim(blast_furnace_temp_gauge:com_4, enum(int, seq, bf_gauge_needle_seq, scale(%blast_furnace_temperature_reading, 255, 100)));
