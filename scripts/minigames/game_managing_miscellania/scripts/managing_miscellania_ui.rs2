%misc_cooked = togglebit(%misc_cooked, 0);

[if_button,misc_both_manage:com_95]
%if2 = togglebit(%if2, 0);

[if_button,misc_both_manage:com_88]
p_countdialog;
def_int $requested_deposit = last_int;
def_int $coffer_space = sub(5000000, %misc_coffers);
def_int $deposit_amt = $requested_deposit;
if ($deposit_amt > $coffer_space) {
    $deposit_amt = $coffer_space;
}
if ($deposit_amt > 0) {
    def_int $inv_coins = inv_total(inv, coins);
    def_int $bank_coins = inv_total(bank, coins);
    def_int $total_available = add($inv_coins, $bank_coins);
    if ($total_available >= $deposit_amt) {
        def_int $taken_from_inv = 0;
        def_int $taken_from_bank = 0;
        if ($inv_coins >= $deposit_amt) {
            $taken_from_inv = $deposit_amt;
        } else {
            $taken_from_inv = $inv_coins;
        }
        if ($taken_from_inv > 0) {
            inv_del(inv, coins, $taken_from_inv);
        }
        $taken_from_bank = sub($deposit_amt, $taken_from_inv);
        if ($taken_from_bank > 0) {
            inv_del(bank, coins, $taken_from_bank);
        }
        %misc_coffers = add(%misc_coffers, $deposit_amt);
        ~mesbox("Added <tostring($deposit_amt)> coins to the coffers.");
    } else {
        ~mesbox("Not enough coins.");
    }
}
~open_manage_miscellania_interface;

[if_button,misc_both_manage:com_89]
p_countdialog;
def_int $withdraw_amt = last_int;
if (%misc_coffers >= $withdraw_amt) {
    if ($withdraw_amt > %misc_coffers) {
        $withdraw_amt = %misc_coffers;
    }
    %misc_coffers = sub(%misc_coffers, $withdraw_amt);
    inv_add(inv, coins, $withdraw_amt);
    ~mesbox("Withdrew <tostring($withdraw_amt)> coins.");
} else {
    ~mesbox("Not enough coins.");
}
~open_manage_miscellania_interface;
