[if_button,inter_349:com_95]
if (%boardgames_ingame ! 1 | %boardgames_viewing = 1) return;
if (.finduid(%duel2accept) = false) {
    ~runeversi_disconnect;
    return;
}
if (%boardgames_drawrequested = 1 | .%boardgames_drawrequested = 1) {
    ~runeversi_finish_game(0, 2, false);
    return;
}
%boardgames_drawrequested = 1;
.%boardgames_drawrequested = 1;
// Existing boardgames draw-request wording reused from RuneLink/Draughts.
if_settext(inter_349:com_147, "Asking opponent for a draw...");
.if_settext(inter_349:com_147, "Your opponent asked for a draw.");
if_settext(inter_349:com_143, "");
.if_settext(inter_349:com_143, "");

[proc,runeversi_cancel_challenge]
%boardgames_closinginterface = 0;
%boardgames_tablenum = 127;
if (.finduid(%duel2accept) = true) .%boardgames_tablenum = 127;
%duel2accept = null;
~reset_boardgames_varp;

[proc,runeversi_init_board]
%boardgames_ingame = 1;
%boardgames_gameended = 0;
%boardgames_viewing = 0;
%boardgames_myturn = 0;
%boardgames_numturns = 0;
%boardgames_drawrequested = 0;
%boardgames_closemode = ^boardgames_loss;
minimap_toggle(1);


%boardgames_closinginterface = 1;
if_openmain(inter_349);
%boardgames_closinginterface = 0;

if_setobject(inter_349:com_158, ~get_boardgames_rune_obj(%boardgames_piece), 72);
if_setobject(inter_349:com_159, ~get_boardgames_rune_obj(.%boardgames_piece), 72);
if (%boardgames_rankedgame = 1) {
    if_settext(inter_349:com_67, "<displayname> (<tostring(%boardgames_runeversi_rank)>)");
    if_settext(inter_349:com_76, "<.displayname> (<tostring(.%boardgames_runeversi_rank)>)");
} else {
    if_settext(inter_349:com_67, "<displayname>");
    if_settext(inter_349:com_76, "<.displayname>");
}
if_settext(inter_349:com_148, "Runeversi");
if_settext(inter_349:com_147, "Place a rune to bracket an opponent's rune.");
if_settext(inter_349:com_143, "");
if_settext(inter_349:com_99, "");

inv_clear(boardgames_boardinv);
def_namedobj $own = ~get_boardgames_player_rune(%boardgames_piece);
def_namedobj $opponent = ~get_boardgames_player_rune(.%boardgames_piece);
// CANDIDATE: standard four-disc Reversi opening; the second player's display is rotated 180 degrees.
if (%boardgames_control = 1) {
    inv_setslot(boardgames_boardinv, 27, $own, 1);
    inv_setslot(boardgames_boardinv, 36, $own, 1);
    inv_setslot(boardgames_boardinv, 28, $opponent, 1);
    inv_setslot(boardgames_boardinv, 35, $opponent, 1);
} else {
    inv_setslot(boardgames_boardinv, 28, $own, 1);
    inv_setslot(boardgames_boardinv, 35, $own, 1);
    inv_setslot(boardgames_boardinv, 27, $opponent, 1);
    inv_setslot(boardgames_boardinv, 36, $opponent, 1);
}
~boardgames_hide_tabs;
inv_transmit(boardgames_boardinv, inter_349:com_160);

