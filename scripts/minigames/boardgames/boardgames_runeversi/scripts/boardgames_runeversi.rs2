[if_button,boardgames_runeversi_options:com_67]
%boardgames_closinginterface = 1;
if_close;
if (.finduid(%duel2accept) = false) {
    ~runeversi_cancel_challenge;
    mes("That player is no longer available.");
    return;
}
if (.busy = true) {
    ~runeversi_cancel_challenge;
    mes("Other player is busy at the moment.");
    return;
}
if (~in_games_room(.coord) = false) {
    ~runeversi_cancel_challenge;
    mes("Other player has left the area.");
    return;
}
if (.%duel2accept = uid) {
    if (~boardgames_admission_ready = false) {
        ~runeversi_cancel_challenge;
        // UNKNOWN: plain functional refusal; the shared admission guard owns the exact cause.
        mes("This challenge can no longer be started.");
        return;
    }
    ~boardgames_table_setup;
    // Original unsigned seven-bit sentinel: 127 means no table was assigned.
    if (%boardgames_tablenum = 127) {
        ~runeversi_cancel_challenge;
        return;
    }
    if (.p_finduid(%duel2accept) = false) {
        ~boardgames_release_table;
        ~runeversi_cancel_challenge;
        return;
    }
    %boardgames_control = 0;
    .%boardgames_control = 1;
    if_openoverlay(null);
    set_skill_level(0);
    ~update_bas;
    .if_openoverlay(null);
    .set_skill_level(0);
    ~.update_bas;
    ~runeversi_init_board;
    ~.runeversi_init_board;
    ~runeversi_first_turn;
} else {
    %boardgames_closinginterface = 0;
    mes("Sending challenge...");
    ~send_boardgames_challenge_request;
}


