[ai_timer,templetrek_man_med] ~templetrek_companion_timer;
[ai_timer,templetrek_multi_retired_man_easy] ~templetrek_companion_timer;
[ai_timer,templetrek_retired_man_easy] ~templetrek_companion_timer;
[ai_timer,templetrek_multi_retired_soldier_easy] ~templetrek_companion_timer;
[ai_timer,templetrek_retired_soldier_easy] ~templetrek_companion_timer;
[proc,templetrek_companion_timer]
if (finduid(%npc_attacking_uid) = false) {
    npc_del;
    return;
}
if (%npc_attacking_uid ! uid | %npc_aggressive_player ! uid | %templetrek_temp_var_25_25 = 0 | ~templetrek_owned = false) {
    npc_del;
    return;
}
if (npc_getmode ! opnpc2) npc_setmode(playerfollow);

[ai_queue3,templetrek_multi_child_hard] ~templetrek_companion_death;
[ai_queue3,templetrek_child_hard] ~templetrek_companion_death;
[ai_queue3,templetrek_multi_oldman_hard] ~templetrek_companion_death;
[ai_queue3,templetrek_oldman_hard] ~templetrek_companion_death;
[ai_queue3,templetrek_multi_woman_med] ~templetrek_companion_death;
[ai_queue3,templetrek_woman_med] ~templetrek_companion_death;
[ai_queue3,templetrek_multi_man_med] ~templetrek_companion_death;
[ai_queue3,templetrek_man_med] ~templetrek_companion_death;
[ai_queue3,templetrek_multi_retired_man_easy] ~templetrek_companion_death;
[ai_queue3,templetrek_retired_man_easy] ~templetrek_companion_death;
[ai_queue3,templetrek_multi_retired_soldier_easy] ~templetrek_companion_death;
[ai_queue3,templetrek_retired_soldier_easy] ~templetrek_companion_death;
[proc,templetrek_companion_death]
def_player_uid $owner = %npc_attacking_uid;
if (finduid($owner) = true) {
    if (uid = $owner & %npc_aggressive_player = $owner & %templetrek_temp_var_25_25 = 1 & ~templetrek_owned = true) {
        queue(templetrek_companion_failed, 0, 0);
    }
}
~npc_default_death;

[queue,templetrek_companion_failed]
if (~templetrek_owned = true & %templetrek_temp_var_25_25 = 1) ~templetrek_leave(0);

