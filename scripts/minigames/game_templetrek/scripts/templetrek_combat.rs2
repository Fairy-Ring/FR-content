[ai_opnpc2,templetrek_giantsnail_2] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_giantsnail_3] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_tentacle_arm] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_tentacle_head] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_zombie] ~templetrek_hostile_companion_attack;
[proc,templetrek_hostile_companion_attack]
if (finduid(%npc_attacking_uid) = false) return;
if (npc_getmode ! opnpc2 | ~templetrek_hostile_owned = false) return;
if (.npc_type ! ~templetrek_companion_child_type & .npc_type ! ~templetrek_companion_type) return;
if (.%npc_attacking_uid ! uid | .%npc_aggressive_player ! uid) return;
if (npc_stat(hitpoints) <= 0 | .npc_stat(hitpoints) <= 0 | %npc_action_delay > map_clock) return;
def_int $style = npc_param(damagetype);
def_int $attack_roll = ~npc_melee_attack_roll_typeless;
def_int $defence_roll = ~templetrek_companion_defence_roll($style);
def_int $maxhit = ~npc_melee_maxhit;
def_int $damage = 0;
if (randominc($attack_roll) > randominc($defence_roll)) $damage = randominc($maxhit);
%npc_action_delay = add(map_clock, npc_param(attackrate));
~templetrek_apply_companion_hit($damage);
~templetrek_companion_eat;

[proc,templetrek_companion_defence_roll](int $style)(int)
def_int $effective_defence = ~combat_effective_stat(.npc_stat(defence), 100);
$effective_defence = add($effective_defence, 9);
return(~combat_stat($effective_defence, ~templetrek_companion_defence_bonus($style)));

[proc,templetrek_companion_defence_bonus](int $style)(int)
if ($style = ^stab_style) return(nc_param(.npc_type, stabdefence));
if ($style = ^slash_style) return(nc_param(.npc_type, slashdefence));
if ($style = ^crush_style) return(nc_param(.npc_type, crushdefence));
if ($style = ^ranged_style) return(nc_param(.npc_type, rangedefence));
if ($style = ^magic_style) return(nc_param(.npc_type, magicdefence));
return(nc_param(.npc_type, slashdefence));

[proc,templetrek_apply_companion_hit](int $damage)
if ($damage <= 0) {
    .npc_damage(^hitmark_block, 0);
    return;
}
.npc_damage(^hitmark_damage, $damage);
if (.npc_stat(hitpoints) = 0) .npc_queue(3, 0, 0);

[ai_queue3,templetrek_vampire_1] ~templetrek_combat_death;
[ai_queue3,templetrek_vampire_2] ~templetrek_combat_death;
[ai_queue3,templetrek_vampire_3] ~templetrek_combat_death;
[ai_queue3,templetrek_ghast_invis_1] ~templetrek_combat_death;
[ai_queue3,templetrek_ghast_invis_2] ~templetrek_combat_death;
[ai_queue3,templetrek_ghast_invis_3] ~templetrek_combat_death;
[ai_queue3,templetrek_ghast_vis_1] ~templetrek_combat_death;
[ai_queue3,templetrek_ghast_vis_2] ~templetrek_combat_death;
[ai_queue3,templetrek_ghast_vis_3] ~templetrek_combat_death;
[ai_queue3,templetrek_shade_1] ~templetrek_combat_death;
[ai_queue3,templetrek_shade_2] ~templetrek_combat_death;
[ai_queue3,templetrek_shade_3] ~templetrek_combat_death;
[ai_queue3,templetrek_snake_1] ~templetrek_combat_death;
[ai_queue3,templetrek_snake_2] ~templetrek_combat_death;
[ai_queue3,templetrek_snake_3] ~templetrek_combat_death;
[ai_queue3,templetrek_giantsnail_1] ~templetrek_combat_death;
[ai_queue3,templetrek_giantsnail_2] ~templetrek_combat_death;
[ai_queue3,templetrek_giantsnail_3] ~templetrek_combat_death;
[ai_queue3,templetrek_tentacle_arm] ~templetrek_combat_death;
[ai_queue3,templetrek_tentacle_head] ~templetrek_combat_death;
[ai_queue3,templetrek_zombie] ~templetrek_combat_death;
[proc,templetrek_combat_death]
if (%npc_int2 = 1) {
    ~npc_default_death;
    return;
}
%npc_int2 = 1;
def_int $event = %npc_int;
def_npc $dead_type = npc_type;
def_boolean $hero = false;
if (npc_findhero = ^true & uid = %npc_aggressive_player) $hero = true;
def_player_uid $owner = %npc_attacking_uid;
if (finduid($owner) = true) {
    if (uid = $owner & %npc_aggressive_player = $owner & %templetrek_temp_var_25_25 = 1 & ~templetrek_owned = true & %templetrek_last_event = $event) {
        if ($event >= 1 & $event <= 6) queue(templetrek_combat_decrement, 0, $event);
        if ($event = 7 & $hero = true) queue(templetrek_zombie_credit, 0, 0);
        if ($hero = true & ($event >= 1 & $event <= 6)) queue(templetrek_combat_credit, 0, $event);
        if ($hero = true & $event = 1 & ($dead_type = templetrek_ghast_vis_1 | $dead_type = templetrek_ghast_vis_2 | $dead_type = templetrek_ghast_vis_3)) queue(templetrek_ghast_prayer_reward, 0, %templetrek_temp_var_11_12);
    }
}
if ($dead_type = templetrek_snake_1 | $dead_type = templetrek_snake_2 | $dead_type = templetrek_snake_3) {
    // CANDIDATE original Skin corpse and 2007 guide; UNKNOWN 100-cycle lifetime.
    npc_changetype_keepall(templetrek_snake_dead, 100);
    npc_setmode(none);
    npc_settimer(0);
    return;
}
~npc_default_death;

[opnpc2,templetrek_snake_dead] @templetrek_skin_snake;
[opnpcu,templetrek_snake_dead]
if (last_useitem ! knife) { ~displaymessage(^dm_default); return; }
@templetrek_skin_snake;
[label,templetrek_skin_snake]
if (~templetrek_owned = false | %npc_attacking_uid ! uid | %npc_aggressive_player ! uid) return;
if (inv_total(inv, knife) = 0) { mes("You need a knife to skin the snake."); return; }
// UNKNOWN full-bag edge: retain the carcass until all five possible hides fit.
if (inv_freespace(inv) < 5) { mes("You need five free inventory spaces."); return; }
inv_add(inv, templetrek_swamp_snake_hide, ~random_range(2, 5));
npc_del;

[queue,templetrek_combat_decrement](int $event)
if (~templetrek_owned = false | %templetrek_temp_var_25_25 = 0 | %templetrek_last_event ! $event | %templetrek_temp_var_13_18 <= 0) return;
%templetrek_temp_var_13_18 = sub(%templetrek_temp_var_13_18, 1);

// UNKNOWN engineering score: one hundred points per owner-earned kill.
[queue,templetrek_combat_credit](int $event)
if (~templetrek_owned = false | %templetrek_temp_var_25_25 = 0 | %templetrek_last_event ! $event) return;
~templetrek_credit(100);

[queue,templetrek_zombie_credit]
if (~templetrek_owned = true & %templetrek_temp_var_25_25 = 1 & %templetrek_last_event = 7) ~templetrek_credit(100);

// CANDIDATE: Tip.It 2007-03-28 ghast prayer awards; stat_advance uses tenths.
[queue,templetrek_ghast_prayer_reward](int $route)
if (~templetrek_owned = false | %templetrek_temp_var_25_25 = 0 | %templetrek_last_event ! 1 | %templetrek_temp_var_11_12 ! $route) return;
if ($route = 1) stat_advance(prayer, 800);
if ($route = 2) stat_advance(prayer, 1100);
if ($route = 3) stat_advance(prayer, 1400);

[ai_opplayer2,templetrek_ghast_invis_1] ~templetrek_ghast_attack;
[ai_opplayer2,templetrek_ghast_invis_2] ~templetrek_ghast_attack;
[ai_opplayer2,templetrek_ghast_invis_3] ~templetrek_ghast_attack;
[proc,templetrek_ghast_attack]
if (npc_getmode ! opplayer2 | ~templetrek_hostile_owned = false | %templetrek_last_event ! 1) {
    npc_setmode(null);
    return;
}
if (%death = ^true) {
    npc_setmode(null);
    return;
}
if (%npc_action_delay > map_clock) return;
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) return;
if (add(%ghast_delay, 26) > map_clock) return;
if_close;
def_npc $visible = templetrek_ghast_vis_1;
if (npc_type = templetrek_ghast_invis_2) $visible = templetrek_ghast_vis_2;
if (npc_type = templetrek_ghast_invis_3) $visible = templetrek_ghast_vis_3;
if (inv_total(inv, druid_pouch) > 0) ~templetrek_ghast_reveal($visible);
npc_anim(inv_ghast_attack, 0);
sound_synth(ghast_attack, 1, 0);
def_int $rand = random(10);
%npc_action_delay = add(map_clock, 4);
%ghast_delay = map_clock;
if ($rand < 3) {
    npc_say("Oouuaarrr!");
    if (~ghast_check_food = false) {
        mes("A supernatural force draws energy from you.");
        queue(damage_player, 0, ~random_range(1, 3));
    }
} else {
    npc_say("OOooooohhh");
    mes("An attacking Ghast just misses you.");
}
npc_setmode(null);

[ai_opplayer2,templetrek_ghast_vis_1] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_ghast_vis_2] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_ghast_vis_3] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_vampire_1] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_vampire_2] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_vampire_3] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_shade_1] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_shade_2] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_shade_3] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_snake_1] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_snake_2] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_snake_3] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_giantsnail_1] npc_setmode(applayer2);
[ai_opplayer2,templetrek_giantsnail_2] npc_setmode(applayer2);
[ai_opplayer2,templetrek_giantsnail_3] npc_setmode(applayer2);
[ai_applayer2,templetrek_giantsnail_1] ~templetrek_snail_attack_player;
[ai_applayer2,templetrek_giantsnail_2] ~templetrek_snail_attack_player;
[ai_applayer2,templetrek_giantsnail_3] ~templetrek_snail_attack_player;
[ai_opplayer2,templetrek_tentacle_arm] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_tentacle_head] ~templetrek_hostile_attack_player;
[ai_opplayer2,templetrek_zombie] ~templetrek_hostile_attack_player;
// CANDIDATE guide: ranged attacks, ranged prayer and snelm protection.
// Original snail projectile assets; UNKNOWN flight constants reuse ordinary snails.
[proc,templetrek_snail_attack_player]
if (~templetrek_hostile_owned = false) { npc_setmode(null); return; }
if (~npc_default_attack_ready = false) return;
def_int $attack_roll = ~npc_ranged_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^ranged_style);
def_int $damage = 0;
if (~npc_attack_accuracy($attack_roll, $defence_roll) = true) $damage = ~snelm_reduction(randominc(~npc_ranged_maxhit));
%npc_action_delay = add(map_clock, npc_param(attackrate));
def_int $duration = ~player_projectile(npc_coord, coord, uid, trek_snail_acid_travel, 43, 31, 20, 16, 26, 56, 10);
~playerhit_n_ranged($damage, $duration, npc_param(attackrate));

[proc,templetrek_hostile_attack_player]
if (~templetrek_hostile_owned = false) {
    npc_setmode(null);
    return;
}
~npc_default_attack;

[opnpcu,templetrek_ghast_invis_1] ~templetrek_ghast_use_pouch(templetrek_ghast_vis_1);
[opnpcu,templetrek_ghast_invis_2] ~templetrek_ghast_use_pouch(templetrek_ghast_vis_2);
[opnpcu,templetrek_ghast_invis_3] ~templetrek_ghast_use_pouch(templetrek_ghast_vis_3);
[proc,templetrek_ghast_use_pouch](npc $visible)
if (last_useitem ! druid_pouch | inv_total(inv, druid_pouch) = 0) {
    ~displaymessage(^dm_default);
    return;
}
if (~templetrek_hostile_owned = false | %templetrek_last_event ! 1) {
    ~displaymessage(^dm_default);
    return;
}
if (~player_in_combat_check = false) return;
~templetrek_ghast_reveal($visible);

[proc,templetrek_ghast_reveal](npc $visible)
mes("The druid pouch makes the Ghast visible.");
inv_del(inv, druid_pouch, 1);
if (inv_total(inv, druid_pouch) = 0) {
    mes("You have nothing left in your druid pouch!");
    inv_add(inv, druid_pouch_empty, 1);
}
spotanim_npc(druidpouch_impact, 124, 90);
~npc_projectile(coord, npc_uid, druid_shooting_star, 43, 31, 51, 16, -5, 64, 10);
npc_delay(1);
npc_changetype_keepall($visible, 500);
%npc_attacking_uid = uid;
%npc_aggressive_player = uid;
npc_setmode(opplayer2);

[proc,templetrek_abidor_spawn]
if (~templetrek_owned = false | %templetrek_temp_var_25_25 = 0 | %templetrek_last_event ! 10) return;
def_coord $center = ~templetrek_room_coord(0_31_78_15_46);
npc_findall($center, templetrek_good_samaritan, 64, 0);
while (npc_findnext = true) {
    if (%npc_attacking_uid = uid & %npc_aggressive_player = uid & %npc_int = 10) return;
}
def_coord $tile = map_findsquare($center, 1, 3, ^map_findsquare_lineofwalk);
if ($tile = null) $tile = $center;
npc_add($tile, templetrek_good_samaritan, ^max_32bit_int);
%npc_attacking_uid = uid;
%npc_aggressive_player = uid;
%npc_int = 10;
%npc_int2 = 0;
npc_setmode(none);
npc_settimer(1);

[opnpc1,templetrek_good_samaritan] ~templetrek_abidor_talk;
[proc,templetrek_abidor_talk]
if (~templetrek_owned = false | %templetrek_temp_var_25_25 = 0 | %templetrek_last_event ! 10 |
    %npc_attacking_uid ! uid | %npc_aggressive_player ! uid | %npc_int ! 10) return;
if (%npc_int2 = 1) {
    mes("Abidor has already treated your wounds.");
    return;
}
def_npc_uid $abidor = npc_uid;
def_npc_uid $companion = ~templetrek_companion_uid;
if ($companion ! null & npc_finduid($companion) = true & ~templetrek_companion_owned = true) {
    npc_statheal(hitpoints, 100, 0);
    %templetrek_temp_var_0_6 = npc_stat(hitpoints);
}
// UNKNOWN engineering boost: restore first, then add 10% of each base stat.
~stat_reset(hitpoints);
~stat_reset(defence);
stat_boost(hitpoints, 0, 10);
stat_boost(defence, 0, 10);
stat_heal(hitpoints, 0, 200);
def_int $slot = 0;
while ($slot < inv_size(inv)) {
    if (inv_getobj(inv, $slot) = rotten_food) inv_setslot(inv, $slot, stew, 1);
    $slot = add($slot, 1);
}
if (npc_finduid($abidor) = true) %npc_int2 = 1;
// UNKNOWN functional feedback; the retained source describes the effect, not dialogue.
mes("Abidor heals you and your companion.");
