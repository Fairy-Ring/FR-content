if (finduid(%npc_attacking_uid) = false) return;
if (~templetrek_combat_attackable = false) return;
~npc_default_retaliate;

[opnpc2,templetrek_vampire_1] @templetrek_player_attack;
[opnpc2,templetrek_vampire_2] @templetrek_player_attack;
