if (npc_type = templetrek_vampire_1 | npc_type = templetrek_vampire_2 | npc_type = templetrek_vampire_3) return;
@player_combat_start_ap;

// Native NPC-to-NPC melee follows myreque2_escort's owner-checked pattern.
[ai_opnpc2,templetrek_vampire_1] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_vampire_2] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_vampire_3] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_ghast_vis_1] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_ghast_vis_2] ~templetrek_hostile_companion_attack;
[ai_opnpc2,templetrek_ghast_vis_3] ~templetrek_hostile_companion_attack;
