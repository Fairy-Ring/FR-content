    npc_del;
    return;
}
if (%npc_attacking_uid ! uid | %npc_aggressive_player ! uid | %templetrek_temp_var_25_25 = 0 | %npc_int ! %templetrek_last_event | ~templetrek_owned = false) npc_del;

