[opnpc1,ranging_guild_ticket_exchange]
// 377 leftover inter_232 is a shop-inv (8x4 Value/Buy), not the 289 button shop.
// 289 same-id 4461 is a different row; do not copy those if_button comps.
inv_transmit(rangingguild_trade_tickets, tickets_shop:inv);
if_openmain(tickets_shop);

[if_close,tickets_shop]
inv_stoptransmit(tickets_shop:inv);

// 289 ticket_merchant.rs2 bundle prices (same stock as rangingguild_trade_tickets).
[proc,ranging_ticket_price](obj $obj)(int)
switch_obj($obj) {
    case barbed_bolttips : return(140);
    case studded_body : return(150);
    case rune_arrow : return(2000);
    case coif : return(100);
    case dragonhide_body : return(2400);
    case adamant_javelin : return(2000);
    case default : return(-1);
}

[inv_button1,tickets_shop:inv]
def_obj $obj = inv_getobj(rangingguild_trade_tickets, last_slot);
if ($obj = null) return;
def_int $price = ~ranging_ticket_price($obj);
if ($price < 1) return;
def_int $count = inv_getnum(rangingguild_trade_tickets, last_slot);
def_string $item_name = oc_name($obj);
mes("<$item_name> x<tostring($count)>: currently costs <tostring($price)> Archery Tickets.");

[inv_button2,tickets_shop:inv]
def_obj $obj = inv_getobj(rangingguild_trade_tickets, last_slot);
if ($obj = null) return;
def_int $price = ~ranging_ticket_price($obj);
if ($price < 1) return;
def_int $count = inv_getnum(rangingguild_trade_tickets, last_slot);
switch_obj($obj) {
    case barbed_bolttips : @tickets_shop_buy(barbed_bolttips, $count, $price);
    case studded_body : @tickets_shop_buy(studded_body, $count, $price);
    case rune_arrow : @tickets_shop_buy(rune_arrow, $count, $price);
    case coif : @tickets_shop_buy(coif, $count, $price);
    case dragonhide_body : @tickets_shop_buy(dragonhide_body, $count, $price);
    case adamant_javelin : @tickets_shop_buy(adamant_javelin, $count, $price);
}

[label,tickets_shop_buy](namedobj $obj, int $count, int $price)
if (inv_total(inv, archery_ticket) < $price) {
    mes("You'd need <tostring($price)> Archery Tickets to buy that.");
    return;
}
if (inv_itemspace(inv, $obj, $count, inv_size(inv)) = false & $price ! inv_total(inv, archery_ticket)) {
    mes("You don't have enough inventory space to buy that.");
    return;
}
inv_del(inv, archery_ticket, $price);
inv_add(inv, $obj, $count);
