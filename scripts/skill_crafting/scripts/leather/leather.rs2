[if_button,leather_crafting:com_114] @process_leather_crafting(leather_gloves, 10);
[if_button,leather_crafting:com_118] @process_leather_crafting(leather_boots, 5);
[if_button,leather_crafting:com_117] @process_leather_crafting(leather_boots, 10);
