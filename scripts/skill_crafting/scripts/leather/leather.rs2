[if_button,leather_crafting:com_129] @process_leather_crafting(leather_cowl, 10);

[if_button,leather_crafting:com_89] if_close;

[opheldu,needle]
switch_obj (last_useitem)
{
    case thread : ~chatplayer("<p,happy>Perhaps I should use a needle with a piece of leather instead.");
    case leather : @craft_leather_interface;
    case hard_leather : @craft_leather(hardleather_body);
    case dragon_leather, dragon_leather_blue, dragon_leather_red, dragon_leather_black : @craft_dhide_interface(last_useslot);
    case default : ~displaymessage(^dm_default);
};

[opheldu,leather]
if (last_useitem = needle) {
    @craft_leather_interface;
}
~displaymessage(^dm_default);

[opheldu,hard_leather]
if (last_useitem = needle) @craft_leather(hardleather_body);
~displaymessage(^dm_default);

[opheldu,dragon_leather]
if (last_useitem = needle) @craft_dhide_interface(last_slot);
~displaymessage(^dm_default);

[opheldu,dragon_leather_blue]
if (last_useitem = needle) @craft_dhide_interface(last_slot);
~displaymessage(^dm_default);

[opheldu,dragon_leather_red]
if (last_useitem = needle) @craft_dhide_interface(last_slot);
~displaymessage(^dm_default);

[opheldu,dragon_leather_black]
if (last_useitem = needle) @craft_dhide_interface(last_slot);
~displaymessage(^dm_default);

[opheldu,thread]
if (last_useitem = needle) {
    ~chatplayer("<p,happy>Perhaps I should use a needle with a piece of leather instead.");
    return;
}
~displaymessage(^dm_default);

//--- all leather
[label,craft_leather](namedobj $product)
~craft_leather_make($product);

// Keep each batch item identical to the published single make.
[proc,craft_leather_make](namedobj $product)(boolean)
if_close;
db_find(craft_leather_table:product, $product);
def_dbrow $product_data = db_findnext;
if ($product_data = null) {
    ~displaymessage(^dm_default);
    return(false);
}
if (db_getfield($product_data, craft_leather_table:members, 0) = true) {
    if (map_members = ^false) {
        mes(^mes_members_feature);
        return(false);
    }
}
// check level
def_int $level = db_getfield($product_data, craft_leather_table:levelrequired, 0);
if (stat(crafting) < $level) {
    ~mesbox("You need a Crafting level of <tostring($level)> to make <db_getfield($product_data, craft_leather_table:name, 0)>.");
    return(false);
}
def_namedobj $leather;
def_int $leather_count;
$leather, $leather_count = db_getfield($product_data, craft_leather_table:leather, 0);
if (inv_total(inv, $leather) < $leather_count) {
    mes("You don't have enough leather to make <db_getfield($product_data, craft_leather_table:name, 0)>.");
    return(false);
}
if (inv_total(inv, thread) < 1) {
    ~objbox(thread, "You need some thread to make anything out of leather.", 250, 0, divide(^objbox_height, 2));
    return(false);
}
// delete thread after 5 uses are met
%thread_used = calc(%thread_used + 1);
if (%thread_used > 4) {
    inv_del(inv, thread, 1);
    mes("You use up one of your reels of Thread.");
    %thread_used = 0;
}
inv_del(inv, $leather, $leather_count);

inv_add(inv, $product, 1);
stat_advance(crafting, db_getfield($product_data, craft_leather_table:productexp, 0));
mes("You make <db_getfield($product_data, craft_leather_table:name, 0)>.");
return(true);

[label,process_leather_crafting](namedobj $product, int $count)
if_close;
anim(human_leather_crafting, 0);
if (%action_delay < map_clock) {
    %action_delay = add(map_clock, 2);
}
weakqueue*(craft_leather_queue, sub(%action_delay, map_clock))($product, $count);

[queue,craft_leather_queue](namedobj $product, int $count)
if (~craft_leather_make($product) = false) {
    anim(null, 20);
    return;
}
$count = sub($count, 1);
if ($count < 1) {
    anim(null, 20);
    return;
}
%action_delay = add(map_clock, 2);
@process_leather_crafting($product, $count);

[label,craft_leather_interface]
if (inv_total(inv, thread) < 1) {
    ~objbox(thread, "You need some thread to make anything out of leather.", 250, 0, divide(^objbox_height, 2));
    return;
}
if_setobject(leather_crafting:com_100, leather_cowl, 180);
if_openmain(leather_crafting);

//--- dragonhide interface
[label,craft_dhide_interface](int $last)
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
if (inv_total(inv, thread) < 1) {
    ~objbox(thread, "You need some thread to make anything out of leather.", 250, 0, divide(^objbox_height, 2));
    return;
}
def_obj $leather = inv_getobj(inv, $last);
db_find(dhide_interface_table:leather, $leather);
def_dbrow $leather_data = db_findnext;
if ($leather_data = null) {
    ~displaymessage(^dm_default);
    return;
}
def_namedobj $interface_item1;
def_namedobj $interface_item2;
def_namedobj $interface_item3;
$interface_item1, $interface_item2, $interface_item3 = db_getfield($leather_data, dhide_interface_table:interface_items, 0);
def_string $color = db_getfield($leather_data, dhide_interface_table:color, 0);
def_namedobj $product;
def_int $process_count;
$product, $process_count = ~skillmulti3($interface_item1, $interface_item2, $interface_item3);
if_close;
if ($product = null) {
    ~displaymessage(^dm_default);
    return;
}
if ($process_count < 1) {
    return;
}
db_find(craft_leather_table:product, $product);
def_dbrow $product_data = db_findnext;
if ($product_data = null) {
    ~displaymessage(^dm_default);
    return;
}
def_namedobj $ingredient;
def_int $ingredient_count;
$ingredient, $ingredient_count = db_getfield($product_data, craft_leather_table:leather, 0);
def_string $product_name = db_getfield($product_data, craft_leather_table:name, 0);
def_int $level = db_getfield($product_data, craft_leather_table:levelrequired, 0);
def_int $exp = db_getfield($product_data, craft_leather_table:productexp, 0);
if (stat(crafting) < $level) {
    ~mesbox("You need a Crafting level of <tostring($level)> to make <$product_name>.");
    return;
}
if (inv_total(inv, needle) < 1) {
    mes("You need a needle to make anything out of dragon leather.");
    return;
}
if (inv_total(inv, thread) < 1) {
    ~objbox(thread, "You need some thread to make anything out of leather.", 250, 0, divide(^objbox_height, 2));
    return;
}
if (inv_total(inv, $ingredient) < $ingredient_count) {
    def_string $end = substring($product_name, string_indexof_string("Dragonhide", $product_name), string_length($product_name));
    mes("You don't have enough <lowercase($color)> Dragon Leather to make <substring($product_name, 0, string_indexof_string("Dragonhide", $product_name))>");
    mes("<$end>.");
    return;
}
@process_dhide_crafting($product, $product_name, $level, $exp, $process_count, $ingredient, $ingredient_count, $color);

[label,process_dhide_crafting](namedobj $product, string $product_name, int $level, int $exp, int $process_count, namedobj $ingredient, int $ingredient_count, string $color)
anim(human_leather_crafting, 0);
if (%action_delay < map_clock) {
    %action_delay = add(map_clock, 2);
}
weakqueue*(craft_dhide_queue, sub(%action_delay, map_clock))($product, $product_name, $level, $exp, $process_count, $ingredient, $ingredient_count, $color);

[queue,craft_dhide_queue](namedobj $product, string $product_name, int $level, int $exp, int $process_count, namedobj $ingredient, int $ingredient_count, string $color)
if (map_members = ^false) {
    mes(^mes_members_feature);
    anim(null, 20);
    return;
}
if (stat(crafting) < $level) {
    ~mesbox("You need a Crafting level of <tostring($level)> to make <$product_name>.");
    anim(null, 20);
    return;
}
if (inv_total(inv, needle) < 1) {
    mes("You need a needle to make anything out of dragon leather.");
    anim(null, 20);
    return;
}
if (inv_total(inv, thread) < 1) {
    ~objbox(thread, "You need some thread to make anything out of leather.", 250, 0, divide(^objbox_height, 2));
    anim(null, 20);
    return;
}
if (inv_total(inv, $ingredient) < $ingredient_count) {
    def_string $end = substring($product_name, string_indexof_string("Dragonhide", $product_name), string_length($product_name));
    mes("You don't have enough <lowercase($color)> Dragon Leather to make <substring($product_name, 0, string_indexof_string("Dragonhide", $product_name))>");
    mes("<$end>.");
    anim(null, 20);
    return;
}
inv_del(inv, $ingredient, $ingredient_count);
inv_add(inv, $product, 1);
stat_advance(crafting, $exp);
mes("You make <$product_name>.");
%thread_used = calc(%thread_used + 1);
if (%thread_used > 4) {
    inv_del(inv, thread, 1);
    %thread_used = 0;
    if (inv_total(inv, thread) = 0) {
        mes("You use up your last reel of Thread.");
        anim(null, 20);
        return;
    }
    mes("You use up one of your reels of Thread.");
}
if (sub($process_count, 1) < 1) {
    anim(null, 20);
    return;
}
%action_delay = add(map_clock, 2);
@process_dhide_crafting($product, $product_name, $level, $exp, sub($process_count, 1), $ingredient, $ingredient_count, $color);

