[if_button,leather_crafting:com_120] @process_leather_crafting(leather_vambraces, 10);
[if_button,leather_crafting:com_124] @process_leather_crafting(leather_chaps, 5);
[if_button,leather_crafting:com_123] @process_leather_crafting(leather_chaps, 10);
[if_button,leather_crafting:com_127] @process_leather_crafting(coif, 5);
[if_button,leather_crafting:com_126] @process_leather_crafting(coif, 10);
