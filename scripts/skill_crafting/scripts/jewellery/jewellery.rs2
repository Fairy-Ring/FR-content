[label,craft_silver]
// 377 leftover inter_282 titled "Silver Casting" — name from cache text (274/289 used chat).
// Do not hunt 289 for this IF name.
// Conductor mould (fenk_lightning_mould) is a CoF silver-casting join (t_d99d6bbc).
if (inv_total(inv, holy_symbol_mould) = 0 & inv_total(inv, unholy_symbol_mould) = 0 & inv_total(inv, sickle_mould) = 0 & inv_total(inv, fenk_lightning_mould) = 0 & inv_total(inv, tiara_mould) = 0 & (inv_total(inv, agrith_sigil_mould) = 0 | map_members = ^false)) {
    ~mesbox("You require a mould to make that.");
    return;
}
if (inv_total(inv, holy_symbol_mould) > 0) {
    if_sethide(silver_casting:com_90, false);
    if_sethide(silver_casting:com_93, true);
} else {
    if_sethide(silver_casting:com_90, true);
    if_sethide(silver_casting:com_93, false);
}
if (inv_total(inv, unholy_symbol_mould) > 0 & map_members = ^true) {
    if_sethide(silver_casting:com_97, false);
    if_sethide(silver_casting:com_100, true);
} else {
    if_sethide(silver_casting:com_97, true);
    if_sethide(silver_casting:com_100, false);
}
if (inv_total(inv, sickle_mould) > 0 & map_members = ^true) {
    if_sethide(silver_casting:com_104, false);
    if_sethide(silver_casting:com_107, true);
