}
if (inv_total(inv, fenk_lightning_mould) > 0 & map_members = ^true) {
    if_sethide(silver_casting:com_111, false);
    if_sethide(silver_casting:com_114, true);
} else {
    if_sethide(silver_casting:com_111, true);
    if_sethide(silver_casting:com_114, false);
}
if (inv_total(inv, tiara_mould) > 0) {
    if_sethide(silver_casting:com_118, false);
    if_sethide(silver_casting:com_121, true);
} else {
    if_sethide(silver_casting:com_118, true);
    if_sethide(silver_casting:com_121, false);
}
if (inv_total(inv, agrith_sigil_mould) > 0 & map_members = ^true) {
    if_sethide(silver_casting:com_133, false);
    if_sethide(silver_casting:com_136, true);
} else {
    if_sethide(silver_casting:com_133, true);
    if_sethide(silver_casting:com_136, false);
}

if_setobject(silver_casting:com_94, nostringstar, 400);
if_setobject(silver_casting:com_101, nostringsnake, 400);
