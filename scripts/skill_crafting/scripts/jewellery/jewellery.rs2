[inv_button3,silver_casting:com_112] @craft_fenk_conductor(10);

[label,craft_fenk_conductor](int $count)
if (inv_total(inv, fenk_lightning_mould) < 1) {
    ~mesbox("You need a conductor mould to make that.");
    return;
}
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
// macro event
if (afk_event = ^true) {
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}
if_close;
~crafting_silver_conductor($count);

[proc,crafting_silver_conductor](int $count)
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
anim(human_furnace, 0);
sound_synth(furnace, 1, 0);
p_delay(2);
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
inv_del(inv, silver_bar, 1);
inv_add(inv, fenk_conductor, 1);
// 50 Crafting XP → tenths 500 (house: 1 XP = 10 units). CANDIDATE Transcript 534.
stat_advance(crafting, 500);
mes("You make a conductor.");
$count = calc($count - 1);
if ($count < 1) {
    return;
}
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
~crafting_silver_conductor($count);

[label,craft_silver_product](namedobj $product, int $count)

def_struct $struct = oc_param($product, crafting_jewelry_struct);

def_int $level = struct_param($struct, levelrequired);
if (stat(crafting) < $level) {
    ~mesbox("You need at least level <tostring($level)> Crafting to make that.");
    return;
}

// macro event
if (afk_event = ^true) {
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
def_int $productexp = struct_param($struct, productexp);
if_close;
~crafting_silver($product, $productexp, $count);

[proc,crafting_silver](namedobj $product, int $productexp, int $count)
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
anim(human_furnace, 0);
sound_synth(furnace, 1, 0);
// Preserve the current silver action's two-tick delay for each item.
p_delay(2);
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
def_struct $struct = oc_param($product, crafting_jewelry_struct);
inv_del(inv, silver_bar, 1);
inv_add(inv, $product, 1);
stat_advance(crafting, $productexp);
// Confirmed, no period at the end. https://i.imgur.com/sCKRVO9.png
mes("You make <~add_article(struct_param($struct, name))>");
$count = calc($count - 1);
if ($count < 1) {
    return;
}
if (inv_total(inv, silver_bar) < 1) {
    ~mesbox("You need a silver bar to make that.");
    return;
}
~crafting_silver($product, $productexp, $count);

