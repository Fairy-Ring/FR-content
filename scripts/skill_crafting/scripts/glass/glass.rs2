[if_button,glass_crafting:com_27] @craft_glass(oil_lamp_empty, 10);
[if_button,glass_crafting:com_28] @craft_glass(oil_lamp_empty, 5);
[if_button,glass_crafting:com_29] @craft_glass(oil_lamp_empty, 1);
