[if_button,glass_crafting:com_19] @craft_glass(beer_glass, 10);
[if_button,glass_crafting:com_20] @craft_glass(beer_glass, 5);
[if_button,glass_crafting:com_21] @craft_glass(beer_glass, 1);
[if_button,glass_crafting:com_22] @craft_glass_x(candle_lantern_empty);
[if_button,glass_crafting:com_23] @craft_glass(candle_lantern_empty, 10);
[if_button,glass_crafting:com_24] @craft_glass(candle_lantern_empty, 5);
[if_button,glass_crafting:com_25] @craft_glass(candle_lantern_empty, 1);
