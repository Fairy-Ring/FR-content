// N101: client fields and existing stats preserved from the 377 unpack.
[skeletal_wyvern1]
name=Skeletal Wyvern
desc=A very dangerous pile of animated wyvern bones.
model1=npc_3068
model2=npc_3068i2
model3=npc_3068i3
recol1s=26425
recol1d=22233
recol2s=21140
recol2d=20119
recol3s=15855
recol3d=15893
recol4s=10570
recol4d=11665
recol5s=0
recol5d=9581
size=3
vislevel=140
hitpoints=200
attack=125
strength=116
defence=120
walkanim=wyvern_skeleton_walk
readyanim=wyvern_skeleton_ready
op2=Attack
// CANDIDATE: Old School combat data; no later elemental weakness or XP bonus.
magic=125
ranged=120
category=slayer_wyvern
respawnrate=15
// UNKNOWN engineering: original reach and aggression geometry are not recovered.
attackrange=7
huntmode=ranged
param=slayer_category,^slayer_skeletalwyvern
param=attackrate,6
param=damagetype,^slash_style
param=stabdefence,140
param=slashdefence,90
param=crushdefence,90
param=magicdefence,80
param=rangedefence,140
// CANDIDATE: named cache presentation bindings. No unrelated sounds substituted.
param=attack_anim,wyvern_skeleton_bite
param=defend_anim,wyvern_skeleton_block
param=death_anim,wyvern_skeleton_death
param=attack_sound,null
param=defend_sound,null
param=death_sound,null
param=death_drop,wyvern_bones

