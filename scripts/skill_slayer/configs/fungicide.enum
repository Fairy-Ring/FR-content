// VERIFIED identities: the 377 cache names eleven charge forms, from 10 down to 0.
[slayer_spray_charges]
inputtype=obj
outputtype=int
default=-1
val=slayer_spray_pump_0,0
val=slayer_spray_pump_1,1
val=slayer_spray_pump_2,2
val=slayer_spray_pump_3,3
val=slayer_spray_pump_4,4
val=slayer_spray_pump_5,5
val=slayer_spray_pump_6,6
val=slayer_spray_pump_7,7
val=slayer_spray_pump_8,8
val=slayer_spray_pump_9,9
val=slayer_spray_pump_10,10

[slayer_spray_forms]
inputtype=int
outputtype=namedobj
default=null
val=0,slayer_spray_pump_0
val=1,slayer_spray_pump_1
val=2,slayer_spray_pump_2
val=3,slayer_spray_pump_3
val=4,slayer_spray_pump_4
val=5,slayer_spray_pump_5
val=6,slayer_spray_pump_6
val=7,slayer_spray_pump_7
val=8,slayer_spray_pump_8
val=9,slayer_spray_pump_9
val=10,slayer_spray_pump_10
