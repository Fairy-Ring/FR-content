[oploc1,bankbooth]
if (npc_findcat(loc_coord, bank_teller, 2, 0) = true) {
    @talk_to_banker;
}
@openbank; // default to just open bank if a bank teller was not found to start dialogue.

[oploc2,bankbooth] @openbank;
[oploc2,bank_booth] @openbank;

// CANDIDATE: use the published booth conversation and quick-bank paths.
// Only ordinary booths with no unbuilt service prerequisite join this category.
[oploc1,_bank_booth]
if (npc_findcat(loc_coord, bank_teller, 2, 0) = true) {
    if (npc_type = dwarf_city_banker1 | npc_type = dwarf_city_banker2) {
        @beta_dwarf_banker;
    }
    @talk_to_banker;
}
@openbank;

[oploc2,_bank_booth] @openbank;

// CANDIDATE: the published ghost banker owns the same speech/quick-bank rules.
[oploc1,ahoy_bankbooth]
if (npc_find(loc_coord, ahoy_ghost_banker, 2, 0) = true) {
    @special_ghost_banker_talk;
}

[oploc2,ahoy_bankbooth] @special_ghost_banker_quickbank;

// CANDIDATE: use the published pirate banker conversation without new words.
[oploc1,fever_bankbooth]
if (npc_find(loc_coord, fever_banker_01, 2, 0) = true) {
    @beta_pirate_banker;
}

[oploc2,fever_bankbooth] @openbank;

// CANDIDATE period Tip.It: use the original token on Burgh de Rott's booth.
[oplocu,burgh_bankbooth_repaired]
if (last_useitem = templetrek_blue_token | last_useitem = templetrek_yellow_token | last_useitem = templetrek_red_token) {
    ~templetrek_redeem(last_useitem);
    return;
}
~displaymessage(^dm_default);
