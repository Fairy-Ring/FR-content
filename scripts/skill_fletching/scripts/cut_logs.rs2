// logs
// OPHELDU lookup matches target category_22 before use-category sacred_oil
// (see engine OpHeldUHandler). 274 cut_logs default routes sacred oil → pyre logs
// (Server content skill_fletching/cut_logs.rs2 + game_mortton create_sacred_logs).
[opheldu,_category_22]
switch_obj(last_useitem) {
    case knife : @fletch_log(last_item);
    case tinderbox : @light_logs_inv(last_slot);
    case default :
        // oil on logs (use = sacred oil, target = logs)
        if (oc_category(last_useitem) = sacred_oil & last_item ! achey_tree_logs) {
            if (%morttonquest < ^mortton_created_sacred_oil) {
                mes("This sacred oil doesn't seem fresh. You should make your own.");
                return;
            }
            @create_sacred_logs(last_item, last_slot, last_useitem, last_useslot);
        // logs on oil (reverse order)
        } else if (oc_category(last_item) = sacred_oil & last_useitem ! achey_tree_logs) {
            if (%morttonquest < ^mortton_created_sacred_oil) {
                mes("This sacred oil doesn't seem fresh. You should make your own.");
                return;
            }
            @create_sacred_logs(last_useitem, last_useslot, last_item, last_slot);
        } else {
            ~displaymessage(^dm_default);
        }
}

[label,fletch_log](obj $log)
if (map_members = ^false) {
    mes(^mes_members_fletching); // guess
    return;
}
db_find(fletch_bow_table:log, $log);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}
def_namedobj $obj1 = arrow_shaft;
def_int $shaft_count = db_getfield($data, fletch_bow_table:shafts, 0);
def_namedobj $obj2;
def_namedobj $obj3;
$obj2, $obj3 = db_getfield($data, fletch_bow_table:objchoices, 0);
def_namedobj $product;
def_int $make_count;
// CANDIDATE for fletching: 377 skillmulti2/3 offer Make 1/5/10/X, not Make All.
// Product set: Tip.It guide captured 2006-05-01; no later crossbow stocks.
if ($shaft_count < 1) {
    $product, $make_count = ~skill_multi2(
        $obj2, 0, -15, 175, "\\n\\n\\n\\n<~string_removeright(oc_name($log), 5)> Short Bow",
        $obj3, 0, -15, 175, "\\n\\n\\n\\n<~string_removeright(oc_name($log), 5)> Long Bow"
    );
} else {
    $product, $make_count = ~skill_multi3(
        $obj1, 5, -15, 175, "\\n\\n\\n\\n15 Arrow Shafts",
        $obj2, 9, -11, 175, "\\n\\n\\n\\nShort Bow",
        $obj3, 0, -15, 175, "\\n\\n\\n\\nLong Bow"
    );
}
if_close;
if ($product = null | $make_count < 1) {
    return;
}
def_int $level = 1;
// default to shafts
def_int $count = 1;
// VERIFIED: the May 2006 Tip.It table gives 5 XP per set of 15 shafts.
def_int $fletching_experience = 50;
def_string $message;
// 2005-osrs, rsc
if ($product = $obj2) {
    $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:shortbow, 0);
    $message = "You carefully cut the wood into a shortbow.";
} else if ($product = $obj3) {
    $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:longbow, 0);
    $message = "You carefully cut the wood into a longbow.";
} else {
    $message = "You carefully cut the wood into <tostring($shaft_count)> arrow shafts.";
    $count = $shaft_count;
}
// Run the first cut in this tick's weak-queue phase, like all later cuts.
// CANDIDATE: immediate first cut; original 377 first-cut delay is unknown.
weakqueue*(fletch_log_make, 0)($log, $product, $level, $fletching_experience, $count, $message, $make_count);

[queue,fletch_log_make](obj $log, namedobj $product, int $level, int $experience, int $count, string $message, int $remaining)
if ($remaining < 1 | inv_total(inv, $log) < 1 | inv_total(inv, knife) < 1) {
    return;
}
if (stat(fletching) < $level) {
    // osrs has a level 1 fail message for arrow shafts but i doubt 2004 used it
    ~doubleobjbox($log, $product, "You need a Fletching level of at least <tostring($level)> to make <~add_article(lowercase(oc_name($product)))>.", 200);
    return;
}
anim(human_fletching, 0);
inv_del(inv, $log, 1);
mes($message);
stat_advance(fletching, $experience);
inv_add(inv, $product, $count);
if ($remaining > 1) {
    // CANDIDATE: uniform three-tick repeats, adapting Lost City 289's +2 queue.
    weakqueue*(fletch_log_make, 2)($log, $product, $level, $experience, $count, $message, sub($remaining, 1));
}
