// Reuse the published pickaxe, requirement and swing clock without changing
// any ordinary rock's handlers, random draws or data.
[oploc1,rocks_10946] @mining_firstswing(get_ore_quarry);
[oploc3,rocks_10946] @mining_continue(get_ore_quarry);
[oploc1,rocks_10947] @mining_firstswing(get_ore_quarry);
[oploc3,rocks_10947] @mining_continue(get_ore_quarry);

[label,get_ore_quarry]
db_find(mining_table:rock, loc_type);
def_dbrow $rock = db_findnext;
def_namedobj $output;
def_int $xp;
$output, $xp = ~quarry_roll_block($rock);
if ($output = null) {
    p_oploc(3);
    return;
}
// The checked later sources explicitly exclude gems from both stones.
def_int $respawn = ~scale_by_playercount(db_getfield($rock, mining_table:rock_respawnrate, 0));
loc_change(loc_param(next_loc_stage_mining), $respawn);
sound_synth(mine, 1, 0);
anim(null, 0);
inv_add(inv, $output, 1);
stat_advance(mining, $xp);
mes("You manage to mine some <db_getfield($rock, mining_table:ore_name, 0)>.");

// CANDIDATE largest-first cascade, using the published older stat_random.
// This is the same conditional-product-roll pattern as fish_roll.
[proc,quarry_roll_block](dbrow $rock)(namedobj, int)
db_find(quarry_blocks:stone, $rock);
def_dbrow $blocks = db_findnext;
def_int $i = 0;
while ($i < db_getfieldcount($blocks, quarry_blocks:block)) {
    def_namedobj $output;
    def_int $xp;
    def_int $low;
    def_int $high;
    $output, $xp, $low, $high = db_getfield($blocks, quarry_blocks:block, $i);
    if (stat_random(mining, $low, $high) = true) {
        return ($output, $xp);
    }
    $i = add($i, 1);
}
return (null, 0);
