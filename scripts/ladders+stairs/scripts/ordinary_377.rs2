[label,ordinary_wild_ladder_choice]
def_int $option = ~p_choice2_header("Climb Up.", 1, "Climb Down.", 2, "Climb up or down the ladder?");
if_close;
if ($option = 1) @ordinary_ladder_up;
@ordinary_ladder_down;

[oploc1,vampire_trap1]
