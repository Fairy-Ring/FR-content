[proc,get_spell_data](int $spell)(dbrow)
// look for spell in db
db_find(magic_spell_table:spell, $spell);
def_dbrow $spell_data = db_findnext;
if ($spell_data = null) {
    error("$spell_data is null.");
}
return ($spell_data);

// VERIFIED client availability: combo-runes.cache-elemental-alternatives.
[proc,check_spell_requirements](dbrow $spell_data)(boolean)
// check if members
if (db_getfield($spell_data, magic_spell_table:members, 0) = true & map_members = ^false) {
    // Camelot teleport: https://youtu.be/18eDNqcur2I
    // Current osrs combat spells have "You need to be on a members' world to cast that spell."
    // But i think this is after mems messages rework
    mes("You need to be on a members' server to use this spell.");
    return (false);
}
// check if high enough level
if (stat(magic) < db_getfield($spell_data, magic_spell_table:levelrequired, 0)) {
    mes("Your Magic level is not high enough for this spell.");
    return (false);
}
def_namedobj $rune1;
def_int $rune_count1;
def_namedobj $rune2;
def_int $rune_count2;
def_namedobj $rune3;
def_int $rune_count3;
$rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3 = ~staff_runes($spell_data);
// check if player has required runes
if (~spell_rune_total($rune1) < $rune_count1 & $rune1 ! null) {
    mes("You do not have enough <~string_removeright(oc_name($rune1), 5)> Runes to cast this spell.");
    return (false);
}
if (~spell_rune_total($rune2) < $rune_count2 & $rune2 ! null) {
    mes("You do not have enough <~string_removeright(oc_name($rune2), 5)> Runes to cast this spell.");
    return (false);
}
if (~spell_rune_total($rune3) < $rune_count3 & $rune3 ! null) {
    mes("You do not have enough <~string_removeright(oc_name($rune3), 5)> Runes to cast this spell.");
    return (false);
}
// check if worn is correct
if (db_getfieldcount($spell_data, magic_spell_table:wornrequired) > 0 & inv_total(worn, db_getfield($spell_data, magic_spell_table:wornrequired, 0)) < 1) {
    mes(db_getfield($spell_data, magic_spell_table:worn_reqmessage, 0));
    return(false);
}
return (true);

[proc,staff_runes](dbrow $spell_data)(namedobj, int, namedobj, int, namedobj, int)
// define spells
def_namedobj $rune1;
def_int $rune_count1;
def_namedobj $rune2;
def_int $rune_count2;
def_namedobj $rune3;
def_int $rune_count3;
$rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3 = db_getfield($spell_data, magic_spell_table:runesrequired, 0);
// check if wielding staff and look for staff in db
def_obj $staff = inv_getobj(worn, ^wearpos_rhand);
if (map_members = ^false & $staff ! null & oc_members($staff) = true) {
    return($rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3);
}
db_find(magic_staff_table:staff, $staff);
def_dbrow $staff_data = db_findnext;
def_dbrow $staff_data2 = db_findnext;
def_namedobj $staff_rune = null;
def_namedobj $staff_rune2 = null;
if ($staff_data ! null) {
    $staff_rune = db_getfield($staff_data, magic_staff_table:rune, 0);
}
if ($staff_data2 ! null) {
    $staff_rune2 = db_getfield($staff_data2, magic_staff_table:rune, 0);
}
// remove the number of runes required if the rune matches with staff rune
if ($staff_rune = $rune1 | $staff_rune2 = $rune1) {
    $rune_count1 = null;
}
if ($staff_rune = $rune2 | $staff_rune2 = $rune2) {
    $rune_count2 = null;
}
if ($staff_rune = $rune3 | $staff_rune2 = $rune3) {
    $rune_count3 = null;
}
return($rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3);

// CANDIDATE minimum total, then fewest combinations: combo-runes.period-payment-priority
// (generalized from the 2007 FAQ example, not 377 server proof). Co-credit:
// combo-runes.period-single-combo-dual-element. Enum tie order is an UNKNOWN
// product default: combo-runes.period-payment-ties. Current rows have at most two elements.
[proc,delete_spell_runes](dbrow $spell_data)
def_namedobj $rune1;
def_int $rune_count1;
def_namedobj $rune2;
def_int $rune_count2;
def_namedobj $rune3;
def_int $rune_count3;
$rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3 = ~staff_runes($spell_data);
if (map_members = ^false) {
    $rune_count1 = ~delete_plain_spell_rune($rune1, $rune_count1);
    $rune_count2 = ~delete_plain_spell_rune($rune2, $rune_count2);
    $rune_count3 = ~delete_plain_spell_rune($rune3, $rune_count3);
    return;
}
// Only the combination joining both required elements can save physical runes.
// Enumerate its bounded spend; every other combination covers one remaining slot.
def_namedobj $shared = null;
def_int $limit = 0;
def_int $i = 0;
while ($i < enum_getoutputcount(magic_combination_runes)) {
    def_namedobj $combination = enum(int, namedobj, magic_combination_runes, $i);
    def_namedobj $element1;
    def_namedobj $element2;
    $element1, $element2 = ~combination_rune_elements($combination);
    def_int $matches = 0;
    if ($rune_count1 > 0 & ($rune1 = $element1 | $rune1 = $element2)) {
        $matches = add($matches, 1);
    }
    if ($rune_count2 > 0 & ($rune2 = $element1 | $rune2 = $element2)) {
        $matches = add($matches, 1);
    }
    if ($rune_count3 > 0 & ($rune3 = $element1 | $rune3 = $element2)) {
        $matches = add($matches, 1);
    }
    if ($matches = 2) {
        $shared = $combination;
        $limit = min(inv_total(inv, $shared), max($rune_count1, max($rune_count2, $rune_count3)));
    }
    $i = add($i, 1);
}
def_int $best = 0;
def_int $best_cost = -1;
def_int $best_combos = 0;
def_int $best_steam = 0;
def_int $best_smoke = 0;
def_int $best_mist = 0;
def_int $best_dust = 0;
def_int $best_lava = 0;
def_int $best_mud = 0;
def_int $k = 0;
while ($k <= $limit) {
    def_int $cost;
    def_int $combos;
    def_int $steam;
    def_int $smoke;
    def_int $mist;
    def_int $dust;
    def_int $lava;
    def_int $mud;
    $cost, $combos, $steam, $smoke, $mist, $dust, $lava, $mud = ~spell_rune_plan($rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3, $shared, $k, false);
    def_boolean $better = false;
    if ($best_cost < 0 | $cost < $best_cost) {
        $better = true;
    } else if ($cost = $best_cost) {
        if ($combos ! $best_combos) {
            if ($combos < $best_combos) { $better = true; }
        } else if ($steam ! $best_steam) {
            if ($steam > $best_steam) { $better = true; }
        } else if ($smoke ! $best_smoke) {
            if ($smoke > $best_smoke) { $better = true; }
        } else if ($mist ! $best_mist) {
            if ($mist > $best_mist) { $better = true; }
        } else if ($dust ! $best_dust) {
            if ($dust > $best_dust) { $better = true; }
        } else if ($lava ! $best_lava) {
            if ($lava > $best_lava) { $better = true; }
        } else if ($mud ! $best_mud) {
            if ($mud > $best_mud) { $better = true; }
        }
    }
    if ($cost >= 0 & $better = true) {
        $best = $k;
        $best_cost = $cost;
        $best_combos = $combos;
        $best_steam = $steam;
        $best_smoke = $smoke;
        $best_mist = $mist;
        $best_dust = $dust;
        $best_lava = $lava;
        $best_mud = $mud;
    }
    $k = add($k, 1);
}
if ($best_cost < 0) {
    error("Spell rune payment reached without sufficient runes.");
}
def_int $unused_cost;
def_int $unused_combos;
def_int $unused_steam;
def_int $unused_smoke;
def_int $unused_mist;
def_int $unused_dust;
def_int $unused_lava;
def_int $unused_mud;
$unused_cost, $unused_combos, $unused_steam, $unused_smoke, $unused_mist, $unused_dust, $unused_lava, $unused_mud = ~spell_rune_plan($rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3, $shared, $best, true);

// CANDIDATE ranking: combo-runes.period-payment-priority; UNKNOWN enum ties:
// combo-runes.period-payment-ties. No period claim about this implementation.
// Evaluate one shared-combination spend without mutation, or apply the selected plan.
// Once shared spend is fixed, all remaining substitutes serve disjoint demands:
// plains before single-element substitutes minimizes combinations; enum order breaks ties.
[proc,spell_rune_plan](namedobj $rune1, int $count1, namedobj $rune2, int $count2, namedobj $rune3, int $count3, namedobj $shared, int $shared_count, boolean $apply)(int, int, int, int, int, int, int, int)
$count1 = max(0, $count1);
$count2 = max(0, $count2);
$count3 = max(0, $count3);
def_int $cost = 0;
def_int $combos = 0;
def_int $steam = 0;
def_int $smoke = 0;
def_int $mist = 0;
def_int $dust = 0;
def_int $lava = 0;
def_int $mud = 0;
def_int $plain1 = 0;
def_int $plain2 = 0;
def_int $plain3 = 0;
// Visit the shared rune first, then the six enum entries (skip its second visit).
def_int $i = -1;
while ($i < enum_getoutputcount(magic_combination_runes)) {
    def_namedobj $combination = $shared;
    if ($i >= 0) {
        $combination = enum(int, namedobj, magic_combination_runes, $i);
    }
    if ($combination ! null & ($i = -1 | $combination ! $shared)) {
        def_namedobj $element1;
        def_namedobj $element2;
        $element1, $element2 = ~combination_rune_elements($combination);
        def_int $required = 0;
        if ($rune1 = $element1 | $rune1 = $element2) {
            $required = max($required, $count1);
        }
        if ($rune2 = $element1 | $rune2 = $element2) {
            $required = max($required, $count2);
        }
        if ($rune3 = $element1 | $rune3 = $element2) {
            $required = max($required, $count3);
        }
        def_int $used = min(inv_total(inv, $combination), $required);
        if ($i = -1) {
            $used = $shared_count;
        }
        if ($used > 0) {
            if ($apply = true) {
                inv_del(inv, $combination, $used);
            }
            // CANDIDATE co-credit: combo-runes.period-single-combo-dual-element.
            if ($rune1 = $element1 | $rune1 = $element2) {
                $count1 = max(0, sub($count1, $used));
            }
            if ($rune2 = $element1 | $rune2 = $element2) {
                $count2 = max(0, sub($count2, $used));
            }
            if ($rune3 = $element1 | $rune3 = $element2) {
                $count3 = max(0, sub($count3, $used));
            }
            $combos = add($combos, $used);
            switch_obj($combination) {
                case steamrune : $steam = $used;
                case smokerune : $smoke = $used;
                case mistrune : $mist = $used;
                case dustrune : $dust = $used;
                case lavarune : $lava = $used;
                case mudrune : $mud = $used;
            }
        }
    }
    if ($i = -1) {
        // After fixing shared spend, reserve the available plains before substitutes.
        $plain1 = min($count1, inv_total(inv, $rune1));
        $plain2 = min($count2, inv_total(inv, $rune2));
        $plain3 = min($count3, inv_total(inv, $rune3));
        $count1 = sub($count1, $plain1);
        $count2 = sub($count2, $plain2);
        $count3 = sub($count3, $plain3);
    }
    $i = add($i, 1);
}
if ($count1 > 0 | $count2 > 0 | $count3 > 0) {
    return(-1, 0, 0, 0, 0, 0, 0, 0);
}
$cost = add($combos, add($plain1, add($plain2, $plain3)));
if ($apply = true) {
    $plain1 = ~delete_plain_spell_rune($rune1, $plain1);
    $plain2 = ~delete_plain_spell_rune($rune2, $plain2);
    $plain3 = ~delete_plain_spell_rune($rune3, $plain3);
}
return($cost, $combos, $steam, $smoke, $mist, $dust, $lava, $mud);

[proc,delete_plain_spell_rune](namedobj $rune, int $count)(int)
if ($count <= 0) {
    return(0);
}
def_int $used = min($count, inv_total(inv, $rune));
if ($used > 0) {
    inv_del(inv, $rune, $used);
}
return(sub($count, $used));

[proc,spell_rune_total](namedobj $rune)(int)
def_int $total = inv_total(inv, $rune);
if (map_members = ^false | ($rune ! airrune & $rune ! waterrune & $rune ! earthrune & $rune ! firerune)) {
    return($total);
}
def_int $i = 0;
while ($i < enum_getoutputcount(magic_combination_runes)) {
    def_namedobj $combination = enum(int, namedobj, magic_combination_runes, $i);
    def_namedobj $element1;
    def_namedobj $element2;
    $element1, $element2 = ~combination_rune_elements($combination);
    if ($rune = $element1 | $rune = $element2) {
        $total = add($total, inv_total(inv, $combination));
    }
    $i = calc($i + 1);
}
return($total);

[proc,combination_rune_elements](namedobj $rune)(namedobj, namedobj)
switch_obj($rune) {
    case steamrune : return(waterrune, firerune);
    case smokerune : return(airrune, firerune);
    case mistrune : return(airrune, waterrune);
    case dustrune : return(airrune, earthrune);
    case lavarune : return(earthrune, firerune);
    case mudrune : return(waterrune, earthrune);
}
error("Unknown combination rune.");
return(null, null);

[proc,give_spell_xp](dbrow $spell_data)
stat_advance(magic, db_getfield($spell_data, magic_spell_table:experience, 0));

// spells that convert one item into another are generalized
// spell dbrows with the convertobj field are spells that convertobj
[proc,magic_spell_search_convertobj](dbrow $data, obj $obj)(namedobj, seq, spotanim, synth)
def_int $i = 0;
while ($i <= db_getfieldcount($data, magic_spell_table:convertobj)) {
    def_obj $initial_obj;
    def_namedobj $final_obj;
    def_seq $seq;
    def_spotanim $spotanim;
    def_synth $sound;
    $initial_obj, $final_obj, $seq, $spotanim, $sound = db_getfield($data, magic_spell_table:convertobj, $i);
    if ($initial_obj = $obj) {
        return($final_obj, $seq, $spotanim, $sound);
    } else {
        $i = calc($i + 1);
    }
}
return(null, null, null, null);

// for opheldt spells that have specific messages for specific items
[proc,magic_spell_specificobj_reqmessage](dbrow $data, obj $obj)
def_int $i = 0;
while ($i <= db_getfieldcount($data, magic_spell_table:specificobj_reqmessage)) {
    def_obj $db_obj;
    def_string $string;
    $db_obj, $string = db_getfield($data, magic_spell_table:specificobj_reqmessage, $i);
    if ($db_obj = $obj) {
        mes($string);
        return;
    }
    $i = calc($i + 1);
}
return;

[proc,magic_spell_maxhit](dbrow $spell_data)(int)
def_int $maxhit = db_getfield($spell_data, magic_spell_table:maxhit, 0);
def_int $spell = db_getfield($spell_data, magic_spell_table:spell, 0);
if (inv_total(worn, gauntlets_of_chaos) > 0 & $spell >= ^wind_bolt & $spell <= ^fire_bolt) {
    $maxhit = add($maxhit, 3);
}
if($spell = ^magic_dart) {
    $maxhit = calc((stat(magic) / 10) + 10);
}
return($maxhit);
