// UNKNOWN product tie default: combo-runes.period-payment-ties.
// Steam, Smoke, Mist, Dust, Lava, Mud is not derived from a client debit order:
// the VERIFIED 377 CS1 additions are availability sums, not payment evidence.
[magic_combination_runes]
inputtype=int
outputtype=namedobj
val=0,steamrune
val=1,smokerune
val=2,mistrune
val=3,dustrune
val=4,lavarune
val=5,mudrune
