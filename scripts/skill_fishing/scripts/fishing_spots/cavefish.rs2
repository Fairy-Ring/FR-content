// SC-06F: original stationary spots; published small-net and Mort Myre rod clocks.
[opnpc1,0_49_149_cavefish] @attempt_fish_swamp_frogspawn;
[opnpc1,0_50_149_cavefish] @attempt_fish_swamp_frogspawn;
[opnpc3,0_49_149_cavefish] @attempt_fish_swamp_eel;
[opnpc3,0_50_149_cavefish] @attempt_fish_swamp_eel;
[opnpc4,0_49_149_cavefish] @fish_swamp_frogspawn;
[opnpc4,0_50_149_cavefish] @fish_swamp_frogspawn;
[opnpc5,0_49_149_cavefish] @fish_swamp_eel;
[opnpc5,0_50_149_cavefish] @fish_swamp_eel;

[opnpcu,0_49_149_cavefish] @swamp_fishing_use_item;
[opnpcu,0_50_149_cavefish] @swamp_fishing_use_item;

[label,swamp_fishing_use_item]
switch_obj(last_useitem) {
    case net : p_opnpc(1);
    case fishing_rod : p_opnpc(3);
    case default : @fishing_wrong_spot_message(last_useitem);
}

[label,attempt_fish_swamp_frogspawn]
if (stat(fishing) < 33) {
    anim(null, 0);
    ~mesbox("You need at least 33 Fishing to catch these fish.");
    return;
}
if (~check_fish_equipment(net) = false) return;
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more fish.");
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 4);
    p_opnpc(1);
    return;
}
if (%action_delay = calc(map_clock + 3)) {
    mes("You cast out your net...");
    anim(human_smallnet, 0);
    sound_synth(net, 1, 0);
    p_opnpc(4);
} else if (%action_delay = map_clock) {
    ~fish_roll(giant_frogspawn, null, net, null);
}

[label,fish_swamp_frogspawn]
if (stat(fishing) < 33) {
    anim(null, 0);
    ~mesbox("You need at least 33 Fishing to catch these fish.");
    return;
}
if (~check_fish_equipment(net) = false) return;
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more fish.");
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 5);
} else if (%action_delay = map_clock) {
    anim(human_smallnet, 0);
    ~fish_roll(giant_frogspawn, null, net, null);
}
p_opnpc(4);

[label,attempt_fish_swamp_eel]
if (stat(fishing) < 28) {
    anim(null, 0);
    ~mesbox("You need at least 28 Fishing to catch these fish.");
    return;
}
if (~check_fish_equipment(fishing_rod) = false) return;
if (inv_freespace(inv) < 1 & inv_total(inv, fishing_bait) > 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more fish.");
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 5);
    p_opnpc(3);
    return;
}
if (%action_delay = calc(map_clock + 4)) {
    mes("You cast out your line...");
    anim(human_fishing_casting, 0);
    p_opnpc(3);
    return;
} else if (%action_delay = calc(map_clock + 3)) {
    mes("You attempt to catch a fish.");
    sound_synth(fishing_cast, 1, 0);
    p_opnpc(5);
} else if (%action_delay = map_clock) {
    anim(human_fish_onspot, 0);
    ~swamp_fishing_eel_roll;
}

[label,fish_swamp_eel]
if (stat(fishing) < 28) {
    anim(null, 0);
    ~mesbox("You need at least 28 Fishing to catch these fish.");
    return;
}
if (~check_fish_equipment(fishing_rod) = false) return;
if (inv_freespace(inv) < 1 & inv_total(inv, fishing_bait) > 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more fish.");
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 4);
} else if (%action_delay = map_clock) {
    anim(human_fish_onspot, 0);
    ~swamp_fishing_eel_roll;
}
p_opnpc(5);

[proc,swamp_fishing_eel_roll]
if (stat(fishing) >= 38) {
    ~fish_roll(mort_slimey_eel, raw_cave_eel, fishing_rod, fishing_bait);
} else {
    ~fish_roll(mort_slimey_eel, null, fishing_rod, fishing_bait);
}
