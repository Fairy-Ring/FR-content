[oplocu,_smithing_furnace]
if (loc_type = viking_furnace | loc_type = viking_furnace2) {
    if (%viking < ^viking_complete) {
        mes("Only Fremenniks may use this furnace.");
        return;
    }
}
switch_obj (last_useitem)
{
    case gold_bar, perfect_gold_bar :
        // BAR leftover: gold_bar + mould + bit 9 → golden CB ask. Jewelry otherwise.
        // Never a second [oplocu,_smithing_furnace]. perfect_gold_bar stays jewelry.
        if (last_useitem = gold_bar & %dwarfrock_quest >= 10 & %dwarfrock_gold_cannonball = 1 & inv_total(inv, ammo_mould) > 0) {
            @dwarfrock_offer_gold_cb;
        }
        @craft_gold_interface;
    case silver_bar : @craft_silver;
    case steel_bar : @smelt_cannonballs;
    case bucket_sand, soda_ash : @smelt_glass;
    case caveorb1, caveorb2, caveorb3, caveorb4 :
        if(loc_type = furnace_upass) @destroy_orboflight(last_useitem);
        ~displaymessage(^dm_default);
    case elemental_workshop_ore : mes("This furnace is not hot enough to smelt elemental ore.");
    // Regicide bomb craft — limestone → quicklime (274 use_furnace)
    case limestone : @regicide_heat_quicklime;
    case default :
        if (oc_category(last_useitem) = category_91) {
            @smelt_ore(last_useitem);
        }
        ~displaymessage(^dm_default);
};

// Item-on-furnace and the picture menu share the recipe and weak-queue finish.
[label,smelt_ore](obj $last)
// find the bar that the ore smelts to
def_namedobj $bar = oc_param($last, smeltsto);
// using coal on furnace assumes steel bar. If using iron on furnace and player has 2 or more coal, then assume steel bar
if (($last = iron_ore & inv_total(inv, coal) >= 2 & stat(smithing) >= 30) | $last = coal) {
    $bar = steel_bar;
}
// for some reason jagex has blankrune and clay in the ores category
if ($bar = null) {
    ~displaymessage(^dm_default);
    return;
}
p_arrivedelay();
if (~validate_first_smelt($bar) = true) {
    @smelt_ore_weakqueue($bar, 1, 2);
}

[proc,validate_first_smelt](obj $bar)(boolean)
def_struct $struct = oc_param($bar, smelting_struct); 
// If smithing level isnt high enough, dislpay level fail message
if (stat(smithing) < struct_param($struct, levelrequired)) {
    ~mesbox(struct_param($struct, levelfailure));
    return(false);
}
def_int $primary_total = inv_total(inv, struct_param($struct, ingredient));
def_int $secondary_total = inv_total(inv, struct_param($struct, ingredient_secondary));
// If not enough ores
if ($primary_total < struct_param($struct, bar_count)) {
    ~mesbox(struct_param($struct, processfailure));
    return(false);
}
if ($secondary_total < struct_param($struct, ingredient_secondary_count)) {
    ~mesbox(struct_param($struct, processfailure));
    return(false);
}
return(true);

[proc,smelt_ore_start](struct $struct)
anim(human_furnace, 0);
sound_synth(furnace, 1, 0);

// display process message
mes(struct_param($struct, processmessage));

[proc,smelt_ore_finish](namedobj $bar, struct $struct)

// delete main ore
inv_del(inv, struct_param($struct, ingredient), struct_param($struct, bar_count));
// delete secondary ore
if (struct_param($struct, ingredient_secondary) ! null) {
    inv_del(inv, struct_param($struct, ingredient_secondary), struct_param($struct, ingredient_secondary_count));
}

if ($bar = iron_bar) {
    // if player is wearing ring of forging
    if (inv_total(worn, ring_of_forging) > 0 & map_members = ^true) {
        ~lose_charge_ring_of_forging;
    } else if (randominc(1) = 1) { // else assume 50% chance of success
        mes("The ore is too impure and you fail to refine it.");
        return;
    }
}

// If player is wearing gold smith gauntlets, 2.5x xp. The multiplier was 1.5x in RSC,
// earliest mention of 2.5x (56.2) xp is in aug 2004: https://web.archive.org/web/20040820223401/http://runevillage.net/ThePub/viewtopic.php?p=1257194&amp
// No mentioned updates to Family Crest or the gauntlets in that period. 
// Was likely changed when ported to rs2.
def_int $xp = struct_param($struct, productexp);
if ($bar = gold_bar & inv_total(worn, gauntlets_of_goldsmithing) > 0) {
    $xp = scale(5, 2, $xp); // 2.5x
}

stat_advance(smithing, $xp);

// add bar
inv_add(inv, $bar, 1);
// display product message
mes(struct_param($struct, productmessage));

[oploc2,_smithing_furnace]
if (loc_type = viking_furnace | loc_type = viking_furnace2) {
    if (%viking < ^viking_complete) {
        mes("Only Fremenniks may use this furnace.");
        return;
    }
}
@smelting_interface;

[label,smelting_interface]
if_setobject(smelting:com_4, bronze_bar, 150);
if_setobject(smelting:com_5, iron_bar, 150);
if_setobject(smelting:com_6, silver_bar, 150);
if_setobject(smelting:com_7, steel_bar, 150);
if_setobject(smelting:com_8, gold_bar, 150);
if_setobject(smelting:com_9, mithril_bar, 150);
if_setobject(smelting:com_10, adamantite_bar, 150);
if_setobject(smelting:com_11, runite_bar, 150);
if_openchat(smelting);

[if_button,smelting:com_15] @smelt_ore_batch(bronze_bar, 1);
[if_button,smelting:com_14] @smelt_ore_batch(bronze_bar, 5);
[if_button,smelting:com_13] @smelt_ore_batch(bronze_bar, 10);
[if_button,smelting:com_12] @smelt_ore_makex(bronze_bar);

[if_button,smelting:com_19] @smelt_ore_batch(iron_bar, 1);
[if_button,smelting:com_18] @smelt_ore_batch(iron_bar, 5);
[if_button,smelting:com_17] @smelt_ore_batch(iron_bar, 10);
[if_button,smelting:com_16] @smelt_ore_makex(iron_bar);

[if_button,smelting:com_23] @smelt_ore_batch(silver_bar, 1);
[if_button,smelting:com_22] @smelt_ore_batch(silver_bar, 5);
[if_button,smelting:com_21] @smelt_ore_batch(silver_bar, 10);
[if_button,smelting:com_20] @smelt_ore_makex(silver_bar);

[if_button,smelting:com_27] @smelt_ore_batch(steel_bar, 1);
[if_button,smelting:com_26] @smelt_ore_batch(steel_bar, 5);
[if_button,smelting:com_25] @smelt_ore_batch(steel_bar, 10);
[if_button,smelting:com_24] @smelt_ore_makex(steel_bar);

[if_button,smelting:com_31] @smelt_ore_batch(gold_bar, 1);
[if_button,smelting:com_30] @smelt_ore_batch(gold_bar, 5);
[if_button,smelting:com_29] @smelt_ore_batch(gold_bar, 10);
[if_button,smelting:com_28] @smelt_ore_makex(gold_bar);

[if_button,smelting:com_35] @smelt_ore_batch(mithril_bar, 1);
[if_button,smelting:com_34] @smelt_ore_batch(mithril_bar, 5);
[if_button,smelting:com_33] @smelt_ore_batch(mithril_bar, 10);
[if_button,smelting:com_32] @smelt_ore_makex(mithril_bar);

[if_button,smelting:com_39] @smelt_ore_batch(adamantite_bar, 1);
[if_button,smelting:com_38] @smelt_ore_batch(adamantite_bar, 5);
[if_button,smelting:com_37] @smelt_ore_batch(adamantite_bar, 10);
[if_button,smelting:com_36] @smelt_ore_makex(adamantite_bar);

[if_button,smelting:com_43] @smelt_ore_batch(runite_bar, 1);
[if_button,smelting:com_42] @smelt_ore_batch(runite_bar, 5);
[if_button,smelting:com_41] @smelt_ore_batch(runite_bar, 10);
[if_button,smelting:com_40] @smelt_ore_makex(runite_bar);

[label,smelt_ore_makex](namedobj $bar)
p_countdialog;
def_int $count = last_int;
if ($count <= 0) return;
@smelt_ore_batch($bar, $count);

[label,smelt_ore_batch](namedobj $bar, int $count)
if_close;
if ($bar = gold_bar & inv_total(inv, gold_ore) = 0 & inv_total(inv, perfect_gold_ore) > 0) {
    $bar = perfect_gold_bar;
}
if (~validate_first_smelt($bar) = true) {
    @smelt_ore_weakqueue($bar, $count, 4);
}

[queue,start_smelt_ore](namedobj $bar, struct $struct, int $count)
if (inv_total(inv, struct_param($struct, ingredient)) < struct_param($struct, bar_count)) {
    mes(struct_param($struct, queueore_primary));
    return;
}
if (inv_total(inv, struct_param($struct, ingredient_secondary)) < struct_param($struct, ingredient_secondary_count)) {
    mes(struct_param($struct, queueore_secondary));
    return;
}
%action_delay = calc(map_clock + 3);
~smelt_ore_start($struct);
weakqueue*(smelting_ore, 3)($bar, $struct, $count);

[queue,smelting_ore](namedobj $bar, struct $struct, int $count)
~smelt_ore_finish($bar, $struct);
if ($count > 1) {
    %action_delay = calc(map_clock + 1);
    @smelt_ore_weakqueue($bar, sub($count, 1), 4);
}

[label,smelt_ore_weakqueue](namedobj $bar, int $count, int $delay)
// Lost City selects perfect gold only after ordinary gold is exhausted.
if ($bar = gold_bar & inv_total(inv, gold_ore) = 0 & inv_total(inv, perfect_gold_ore) > 0) {
    $bar = perfect_gold_bar;
}
def_struct $struct = oc_param($bar, smelting_struct);
if (afk_event = ^true) {
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 3);
    ~smelt_ore_start($struct);
    weakqueue*(smelting_ore, $delay)($bar, $struct, $count);
} else {
    weakqueue*(start_smelt_ore, calc(%action_delay - map_clock - 1))($bar, $struct, $count);
}
