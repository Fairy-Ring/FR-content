[debugproc,skill]
if (p_finduid(uid) = false) {
    return;
}
def_obj $obj;
def_int $int;
$obj, $int = ~skillmulti1(rune_kiteshield);

mes("<oc_debugname($obj)>, <tostring($int)>");

[debugproc,skill2]
if (p_finduid(uid) = false) {
    return;
}
def_obj $obj;
def_int $int;
$obj, $int = ~skill_multi2(
    bronze_bar, 0, 0, 200, "\\n\\n\\n\\n<oc_name(bronze_bar)>",
    iron_bar, 0, 0, 200, "\\n\\n\\n\\n<oc_name(iron_bar)>"
);

mes("<oc_debugname($obj)>, <tostring($int)>");

