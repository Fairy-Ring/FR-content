// CANDIDATE Old School: no disease in the seed stage or after maturity.
// Disease prevents advancement. UNKNOWN next-tier death timing is configured
// in farming_growth; cache bands preserve the stage across watering and cure.

[proc,farming_potato_advance](int $stage, int $steps, int $window)(int)
// Do not truncate elapsed windows before the shared helper resolves disease.
return(~farming_allotment_advance($stage, $steps, farming_allotment_potato, $window));

[proc,farming_potato_advance_word](int $word, int $steps, int $flowerbit, int $window)(int)
def_int $bit = 0;
while ($bit < 32) {
    def_int $end = add($bit, 7);
    def_int $before = getbit_range($word, $bit, $end);
    def_dbrow $crop = ~farming_allotment_crop($before);
    def_int $flowerstart = add($flowerbit, multiply(divide($bit, 16), 8));
    def_int $flower = getbit_range(%farming_flower_varp, $flowerstart, add($flowerstart, 7));
    def_int $stage;
    def_int $watchbit = add(divide($flowerbit, 4), divide($bit, 8));
    if ($crop ! null & (~farming_protection_watched($watchbit) = true | ~farming_flower_protects($flower, $before) = true)) {
        $stage = ~farming_flower_advance_protected($before, $steps, $crop, $window);
    } else if (modulo($before, ^farming_watered_offset) >= ^farming_potato_seed & modulo($before, ^farming_watered_offset) <= ^farming_potato_harvest_last) {
        $stage = ~farming_potato_advance($before, $steps, $window);
    } else {
        $stage = ~farming_allotment_advance($before, $steps, $crop, $window);
    }
    $word = setbit_range_toint($word, $stage, $bit, $end);
    $bit = add($bit, 8);
}
return($word);

[proc,farming_potato_advance_all](int $steps, int $window)
def_int $first = ~farming_potato_advance_word(%farming_allotment_varp_1, $steps, 0, $window);
def_int $second = ~farming_potato_advance_word(%farming_allotment_varp_2, $steps, 16, $window);
%farming_allotment_varp_1 = $first;
%farming_allotment_varp_2 = $second;
