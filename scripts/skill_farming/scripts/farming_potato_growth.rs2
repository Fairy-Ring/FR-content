// CANDIDATE Old School: no disease in the seed stage or after maturity.
// Disease prevents advancement; an uncured plant dies on the following cycle,
// including offline. Cache bands preserve the stage across watering and cure.

[proc,farming_potato_growing](int $stage)(boolean)
if (($stage >= ^farming_potato_seed & $stage < ^farming_potato_fullygrown)
    | ($stage >= add(^farming_potato_seed, ^farming_watered_offset) & $stage < add(^farming_potato_fullygrown, ^farming_watered_offset))
    | ($stage > add(^farming_potato_seed, ^farming_diseased_offset) & $stage < add(^farming_potato_fullygrown, ^farming_diseased_offset))) return(true);
return(false);

[proc,farming_potato_advance](int $stage, int $steps)(int)
// Cap catch-up at four steps; disease can make the full potato path five steps.
// Late disease can remain curable after catch-up. Never loop over elapsed minutes.
$steps = min($steps, sub(^farming_potato_fullygrown, ^farming_potato_seed));
while ($steps > 0 & ~farming_potato_growing($stage) = true) {
    if ($stage > add(^farming_potato_seed, ^farming_diseased_offset)) {
        $stage = add($stage, sub(^farming_dead_offset, ^farming_diseased_offset));
    } else {
        def_int $chance = ^farming_potato_disease_dry;
        if ($stage >= add(^farming_potato_seed, ^farming_watered_offset)) {
            $stage = sub($stage, ^farming_watered_offset);
            $chance = ^farming_potato_disease_watered;
        }
        if ($stage = ^farming_potato_seed) {
            $stage = add($stage, 1);
        } else {
            if (random(^farming_disease_denominator) < $chance) {
                $stage = add($stage, ^farming_diseased_offset);
            } else {
                $stage = add($stage, 1);
            }
        }
    }
    $steps = sub($steps, 1);
}
return($stage);

[proc,farming_potato_advance_word](int $word, int $steps)(int)
def_int $bit = 0;
while ($bit < 32) {
    def_int $end = add($bit, 7);
    def_int $stage = ~farming_potato_advance(getbit_range($word, $bit, $end), $steps);
    $word = setbit_range_toint($word, $stage, $bit, $end);
    $bit = add($bit, 8);
}
return($word);

[proc,farming_potato_advance_all](int $steps)
def_int $first = ~farming_potato_advance_word(%farming_allotment_varp_1, $steps);
def_int $second = ~farming_potato_advance_word(%farming_allotment_varp_2, $steps);
%farming_allotment_varp_1 = $first;
%farming_allotment_varp_2 = $second;
