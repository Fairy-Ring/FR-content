// VERIFIED four original selectors of permanent transmitted varp 506.
[proc,farming_hops_stage]()(int)
switch_loc (loc_type) {
    case farming_hops_patch_1 : return(%farming_hops_varp_0_7);
    case farming_hops_patch_2 : return(%farming_hops_varp_8_15);
    case farming_hops_patch_3 : return(%farming_hops_varp_16_23);
    case farming_hops_patch_4 : return(%farming_hops_varp_24_31);
    case default : return(-1);
}

[proc,farming_hops_set_stage](int $stage)
if ($stage = ^farming_veg_weeded) ~farming_protection_clear(~farming_protection_loc_bit);
if ($stage = ^farming_veg_weeded & ~farming_hops_crop(~farming_hops_stage) ! null) ~farming_soil_clear(~farming_soil_index);
switch_loc (loc_type) {
    case farming_hops_patch_1 : %farming_hops_varp_0_7 = $stage;
    case farming_hops_patch_2 : %farming_hops_varp_8_15 = $stage;
    case farming_hops_patch_3 : %farming_hops_varp_16_23 = $stage;
    case farming_hops_patch_4 : %farming_hops_varp_24_31 = $stage;
}

// Dispatch binds the form the player sees; loc_type retains the map parent.
