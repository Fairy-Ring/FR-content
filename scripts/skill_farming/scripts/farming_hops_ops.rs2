[label,farming_hops_use]
if (~farming_pots_fill_on_patch = true) return;
def_int $stage = ~farming_hops_stage;
if ($stage = -1) {
    ~displaymessage(^dm_default);
    return;
}
if (last_useitem = bucket_compost | last_useitem = bucket_supercompost) {
    ~farming_soil_apply($stage);
    return;
}
if (last_useitem = rake & $stage >= 0 & $stage < ^farming_veg_weeded) {
    ~farming_rake_step(false);
    return;
}
def_dbrow $crop;
if ($stage = ^farming_veg_weeded) {
    $crop = ~farming_hops_seed(last_useitem);
    if ($crop = null) {
        ~displaymessage(^dm_default);
        return;
    }
    if (inv_total(inv, dibber) < 1) {
        ~displaymessage(^dm_farming_dibber);
        return;
    }
    def_obj $seed = db_getfield($crop, farming_hops:seed, 0);
    def_int $seeds = db_getfield($crop, farming_hops:seed_count, 0);
    if (inv_total(inv, $seed) < $seeds) {
        // UNKNOWN functional wording; period guide establishes the seed count.
        mes("You need <tostring($seeds)> seeds to plant this patch.");
        return;
    }
    def_int $level = db_getfield($crop, farming_hops:level, 0);
    if (stat_base(farming) < $level) {
        // UNKNOWN functional wording.
        mes("You need a Farming level of <tostring($level)> to plant this crop.");
        return;
    }
    // CANDIDATE cache-tool animation attribution, as in the published families.
    anim(farming_seed_dibbing, 0);
    inv_del(inv, $seed, $seeds);
    ~farming_hops_set_stage(db_getfield($crop, farming_hops:first, 0));
    stat_advance(farming, db_getfield($crop, farming_hops:plant_xp, 0));
    // UNKNOWN functional wording.
    mes("You plant the seeds in the hops patch.");
    return;
}
$crop = ~farming_hops_crop($stage);
if ($crop = null) {
    ~displaymessage(^dm_default);
    return;
}
def_int $after = ~farming_crop_care($stage, db_getfield($crop, farming_hops:first, 0), db_getfield($crop, farming_hops:mature, 0), "hops", true);
if ($after ! $stage) ~farming_hops_set_stage($after);

[label,farming_hops_harvest](boolean $automatic)
def_int $stage = ~farming_hops_stage;
def_dbrow $crop = ~farming_hops_crop($stage);
if ($crop = null) {
    ~displaymessage(^dm_farming_patch_no_crops);
    return;
}
def_int $mature = db_getfield($crop, farming_hops:mature, 0);
def_int $last = db_getfield($crop, farming_hops:last, 0);
if ($stage < $mature | $stage > $last) {
    ~displaymessage(^dm_farming_patch_no_crops);
    return;
}
// UNKNOWN hops-specific spade gate; period guide says only some harvests need it.
if (inv_total(inv, spade) < 1) {
    ~displaymessage(^dm_farming_spade);
    return;
}
if (inv_freespace(inv) < 1) {
    // UNKNOWN functional wording, shared with the published allotments.
    mes("You don't have enough inventory space.");
    return;
}
// UNKNOWN hops cadence/binding: reuse published 3/2-tick picking convention.
if (~farming_harvest_ready($automatic) = false) return;
anim(picking_low, 0);
inv_add(inv, db_getfield($crop, farming_hops:produce, 0), 1);
// VERIFIED period per-item XP. CANDIDATE three lives, with a life-saving roll.
stat_advance(farming, db_getfield($crop, farming_hops:harvest_xp, 0));
if (random(^farming_harvest_denominator) < ~farming_hops_life_loss) {
    if (~farming_soil_consume(~farming_soil_index) = false) {
        if ($stage < $last) {
            $stage = add($stage, 1);
        } else {
            $stage = ^farming_veg_weeded;
        }
        ~farming_hops_set_stage($stage);
    }
}
%action_delay = calc(map_clock + ^farming_harvest_auto_ticks);
if ($stage >= $mature) p_oploc(3);
// UNKNOWN functional wording.
def_string $plants = db_getfield($crop, farming_hops:plural, 0);
mes("You harvest some <$plants> from the hops patch.");
