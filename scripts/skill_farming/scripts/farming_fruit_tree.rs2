[proc,farming_fruit_tree_crop](int $stage)(dbrow)
if ($stage >= 8 & $stage <= 34) return(farming_fruit_tree_apple);
if ($stage >= 35 & $stage <= 61) return(farming_fruit_tree_banana);
if ($stage >= 72 & $stage <= 98) return(farming_fruit_tree_orange);
if ($stage >= 99 & $stage <= 125) return(farming_fruit_tree_curry);
if ($stage >= 136 & $stage <= 162) return(farming_fruit_tree_pineapple);
if ($stage >= 163 & $stage <= 189) return(farming_fruit_tree_papaya);
if ($stage >= 200 & $stage <= 226) return(farming_fruit_tree_palm);
return(null);

[proc,farming_fruit_tree_by_sapling](obj $sapling)(dbrow)
switch_obj ($sapling) {
    case plantpot_apple_sapling : return(farming_fruit_tree_apple);
    case plantpot_banana_sapling : return(farming_fruit_tree_banana);
    case plantpot_orange_sapling : return(farming_fruit_tree_orange);
    case plantpot_curry_sapling : return(farming_fruit_tree_curry);
    case plantpot_pineapple_sapling : return(farming_fruit_tree_pineapple);
    case plantpot_papaya_sapling : return(farming_fruit_tree_papaya);
    case plantpot_palm_sapling : return(farming_fruit_tree_palm);
}
return(null);

[proc,farming_fruit_tree_is_diseased](int $stage)(boolean)
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null) return(false);
def_int $diseased = db_getfield($crop, farming_fruit_tree:diseased, 0);
def_int $dead = db_getfield($crop, farming_fruit_tree:dead, 0);
if ($stage >= $diseased & $stage < $dead) return(true);
return(false);

[proc,farming_fruit_tree_is_dead](int $stage)(boolean)
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null) return(false);
def_int $dead = db_getfield($crop, farming_fruit_tree:dead, 0);
def_int $stump = db_getfield($crop, farming_fruit_tree:stump, 0);
if ($stage >= $dead & $stage < $stump) return(true);
return(false);

[proc,farming_fruit_tree_can_clear](int $stage)(boolean)
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null) return(false);
def_int $mature = db_getfield($crop, farming_fruit_tree:mature, 0);
def_int $last = db_getfield($crop, farming_fruit_tree:last, 0);
def_int $claim = db_getfield($crop, farming_fruit_tree:claim, 0);
def_int $stump = db_getfield($crop, farming_fruit_tree:stump, 0);
if ($stage >= $mature & $stage <= $last) return(true);
if ($stage = $claim | $stage = $stump) return(true);
return(false);

[proc,farming_fruit_tree_patch_stage](int $patch)(int)
switch_int ($patch) {
    case 0 : return(%farming_fruit_tree_varp_0_7);
    case 1 : return(%farming_fruit_tree_varp_8_15);
    case 2 : return(%farming_fruit_tree_varp_16_23);
    case 3 : return(%farming_fruit_tree_varp_24_31);
}
return(-1);

[proc,farming_fruit_tree_patch_set](int $patch, int $stage)
if ($patch < 0 | $patch > 3) return;
def_int $before = ~farming_fruit_tree_patch_stage($patch);
if ($stage = ^farming_veg_weeded & $before > ^farming_veg_weeded) {
    ~farming_soil_clear(add(31, $patch));
    ~farming_protection_clear(add(20, $patch));
}
~farming_fruit_tree_patch_set_visible($patch, $stage);

// SOFT growth writes only the original selector, never protected clearing state.
[proc,farming_fruit_tree_patch_set_visible](int $patch, int $stage)
switch_int ($patch) {
    case 0 : %farming_fruit_tree_varp_0_7 = $stage;
    case 1 : %farming_fruit_tree_varp_8_15 = $stage;
    case 2 : %farming_fruit_tree_varp_16_23 = $stage;
    case 3 : %farming_fruit_tree_varp_24_31 = $stage;
}

[proc,farming_fruit_tree_advance_all](int $steps, int $window)
if ($steps <= 0) return;
def_int $patch = 0;
while ($patch < 4) {
    def_int $stage = ~farming_fruit_tree_patch_stage($patch);
    def_dbrow $crop = ~farming_fruit_tree_crop($stage);
    if ($crop ! null) ~farming_fruit_tree_advance_patch($patch, $crop, $steps, $window);
    $patch = add($patch, 1);
}

[proc,farming_fruit_tree_advance_patch](int $patch, dbrow $crop, int $steps, int $window)
def_int $stage = ~farming_fruit_tree_patch_stage($patch);
def_int $first = db_getfield($crop, farming_fruit_tree:first, 0);
def_int $mature = db_getfield($crop, farming_fruit_tree:mature, 0);
def_int $last = db_getfield($crop, farming_fruit_tree:last, 0);
def_int $claim = db_getfield($crop, farming_fruit_tree:claim, 0);
def_int $diseased = db_getfield($crop, farming_fruit_tree:diseased, 0);
def_int $dead = db_getfield($crop, farming_fruit_tree:dead, 0);
def_int $stump = db_getfield($crop, farming_fruit_tree:stump, 0);
def_int $period = db_getfield(db_getfield($crop, farming_fruit_tree:growth, 0), farming_growth:period, 0);
def_int $treatment = ~farming_soil_treatment(add(31, $patch));
if ($stage = $stump) {
    // UNKNOWN favorable fallback: a checked fruit-tree stump returns fully grown after one family window.
    ~farming_fruit_tree_patch_set_visible($patch, $last);
    return;
}
while ($steps > 0) {
    if ($stage = $claim | $stage >= $dead) return;
    if (~farming_fruit_tree_is_diseased($stage) = true) {
        def_int $virtual = add(sub($stage, $diseased), add(1, ^farming_diseased_offset));
        def_int $advanced = ~farming_crop_advance($virtual, 1, 0, sub($mature, $first), false, $treatment, db_getfield($crop, farming_fruit_tree:growth, 0), $window);
        if ($advanced >= ^farming_dead_offset) $stage = add($dead, sub($advanced, add(^farming_dead_offset, 1)));
        else $stage = add($diseased, sub($advanced, add(^farming_diseased_offset, 1)));
    } else if ($stage >= $first & $stage < $mature) {
        if (~farming_protection_watched(add(20, $patch)) = true) {
            $stage = add($stage, 1);
        } else {
            def_int $virtual = sub($stage, $first);
            def_int $advanced = ~farming_crop_advance($virtual, 1, 0, sub($mature, $first), false, $treatment, db_getfield($crop, farming_fruit_tree:growth, 0), $window);
            if ($advanced >= ^farming_dead_offset) $stage = add($dead, sub($advanced, add(^farming_dead_offset, 1)));
            else if ($advanced >= ^farming_diseased_offset) $stage = add($diseased, sub($advanced, add(^farming_diseased_offset, 1)));
            else $stage = add($first, $advanced);
        }
        if ($stage = $mature) $stage = $claim;
    } else if ($stage >= $mature & $stage < $last) {
        // UNKNOWN regrowth cadence: reuse the fruit-family window, one fruit per window.
        $stage = add($stage, 1);
    } else {
        return;
    }
    ~farming_fruit_tree_patch_set_visible($patch, $stage);
    $steps = sub($steps, 1);
    $window = add($window, $period);
}

[label,farming_fruit_tree_use]
if (~farming_pots_fill_on_patch = true) return;
def_int $soil = ~farming_soil_index;
if ($soil < 31 | $soil > 34) {
    ~displaymessage(^dm_default);
    return;
}
def_int $patch = sub($soil, 31);
def_int $stage = ~farming_fruit_tree_patch_stage($patch);
if (last_useitem = rake & $stage >= 0 & $stage < ^farming_veg_weeded) {
    ~farming_fruit_tree_rake(false);
    return;
}
if (last_useitem = bucket_compost | last_useitem = bucket_supercompost) {
    ~farming_soil_apply($stage);
    return;
}
if ($stage = ^farming_veg_weeded) {
    def_dbrow $crop = ~farming_fruit_tree_by_sapling(last_useitem);
    if ($crop = null) {
        ~displaymessage(^dm_default);
        return;
    }
    if (inv_total(inv, spade) < 1) {
        // UNKNOWN plain functional wording.
        mes("You need a spade to plant a tree sapling.");
        return;
    }
    def_int $level = db_getfield($crop, farming_fruit_tree:level, 0);
    if (stat_base(farming) < $level) {
        // UNKNOWN plain functional wording.
        mes("You need a Farming level of <tostring($level)> to plant this tree.");
        return;
    }
    if (inv_getobj(inv, last_useslot) ! last_useitem) {
        ~displaymessage(^dm_default);
        return;
    }
    anim(farming_seed_dibbing, 0);
    inv_setslot(inv, last_useslot, plantpot_empty, 1);
    ~farming_fruit_tree_patch_set($patch, db_getfield($crop, farming_fruit_tree:first, 0));
    stat_advance(farming, db_getfield($crop, farming_fruit_tree:plant_xp, 0));
    // UNKNOWN plain functional wording.
    mes("You plant the sapling in the fruit tree patch.");
    return;
}
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null) {
    ~displaymessage(^dm_default);
    return;
}
if ((last_useitem = secateurs | last_useitem = fairy_enchanted_secateurs) & ~farming_fruit_tree_is_diseased($stage) = true) {
    anim(pruning_all, 0);
    def_int $after = add(db_getfield($crop, farming_fruit_tree:first, 0), add(sub($stage, db_getfield($crop, farming_fruit_tree:diseased, 0)), 1));
    ~farming_fruit_tree_patch_set($patch, $after);
    // UNKNOWN plain functional wording.
    mes("You prune the diseased tree.");
    return;
}
if (last_useitem = spade & (~farming_fruit_tree_is_dead($stage) = true | $stage = db_getfield($crop, farming_fruit_tree:stump, 0))) {
    anim(human_dig, 0);
    ~farming_fruit_tree_patch_set($patch, ^farming_veg_weeded);
    // UNKNOWN plain functional wording.
    mes("You dig up the tree stump.");
    return;
}
if (last_useitem = rake) {
    ~displaymessage(^dm_farming_patch_planted);
    return;
}
// Plant cure intentionally has no tree branch: diseased trees require pruning with secateurs.
~displaymessage(^dm_default);

[label,farming_fruit_tree_rake_continue]
~farming_fruit_tree_rake(true);

[proc,farming_fruit_tree_rake](boolean $repeat)
def_int $soil = ~farming_soil_index;
if ($soil < 31 | $soil > 34) return;
def_int $patch = sub($soil, 31);
def_int $stage = ~farming_fruit_tree_patch_stage($patch);
if ($stage < 0 | $stage >= ^farming_veg_weeded | inv_total(inv, rake) < 1) return;
if (inv_freespace(inv) < 1) {
    mes("You don't have enough inventory space.");
    return;
}
if ($repeat = true & %action_delay > map_clock) {
    p_oploc(3);
    return;
}
anim(farming_raking, 0);
inv_add(inv, weeds, 1);
stat_advance(farming, ^farming_weed_xp);
$stage = add($stage, 1);
~farming_fruit_tree_patch_set($patch, $stage);
if ($stage < ^farming_veg_weeded) {
    %action_delay = calc(map_clock + ^farming_rake_step_ticks);
    p_oploc(3);
}

[label,farming_fruit_tree_check_health]
def_int $soil = ~farming_soil_index;
if ($soil < 31 | $soil > 34) return;
def_int $patch = sub($soil, 31);
def_int $stage = ~farming_fruit_tree_patch_stage($patch);
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null | $stage ! db_getfield($crop, farming_fruit_tree:claim, 0)) {
    ~displaymessage(^dm_default);
    return;
}
~farming_fruit_tree_patch_set($patch, db_getfield($crop, farming_fruit_tree:last, 0));
stat_advance(farming, db_getfield($crop, farming_fruit_tree:check_xp, 0));

[label,farming_fruit_tree_harvest](boolean $automatic)
def_int $soil = ~farming_soil_index;
if ($soil < 31 | $soil > 34) return;
def_int $patch = sub($soil, 31);
def_int $stage = ~farming_fruit_tree_patch_stage($patch);
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null | $stage <= db_getfield($crop, farming_fruit_tree:mature, 0) | $stage > db_getfield($crop, farming_fruit_tree:last, 0)) return;
if (inv_freespace(inv) < 1) {
    mes("You don't have enough inventory space.");
    return;
}
if (~farming_harvest_ready($automatic) = false) return;
anim(picking_low, 0);
inv_add(inv, db_getfield($crop, farming_fruit_tree:produce, 0), 1);
stat_advance(farming, db_getfield($crop, farming_fruit_tree:harvest_xp, 0));
$stage = sub($stage, 1);
~farming_fruit_tree_patch_set($patch, $stage);
%action_delay = calc(map_clock + ^farming_harvest_auto_ticks);
if ($stage > db_getfield($crop, farming_fruit_tree:mature, 0)) p_oploc(3);

[label,farming_fruit_tree_chop_start]
def_int $soil = ~farming_soil_index;
if ($soil < 31 | $soil > 34) return;
def_int $patch = sub($soil, 31);
def_int $stage = ~farming_fruit_tree_patch_stage($patch);
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null | $stage ! db_getfield($crop, farming_fruit_tree:mature, 0)) return;
def_namedobj $axe = ~woodcutting_axe_checker(true);
if ($axe = null) return;
if (%action_delay > map_clock) {
    p_oploc(1);
    return;
}
// UNKNOWN favourable engineering cadence: one three-tick Woodcutting swing, no log roll or XP.
%action_delay = calc(map_clock + 3);
anim(struct_param(oc_param($axe, woodcutting_struct), skill_anim), 0);
sound_synth(woodchop1, 1, 0);
mes("You swing your axe at the tree.");
p_oploc(3);

[label,farming_fruit_tree_chop_continue]
if (%action_delay > map_clock) {
    p_oploc(3);
    return;
}
def_int $soil = ~farming_soil_index;
if ($soil < 31 | $soil > 34) return;
def_int $patch = sub($soil, 31);
def_int $stage = ~farming_fruit_tree_patch_stage($patch);
def_dbrow $crop = ~farming_fruit_tree_crop($stage);
if ($crop = null | $stage ! db_getfield($crop, farming_fruit_tree:mature, 0)) return;
~farming_fruit_tree_patch_set($patch, db_getfield($crop, farming_fruit_tree:stump, 0));
sound_synth(tree_fall, 1, 0);
anim(null, 0);

