// VERIFIED: four original selectors in permanent transmitted varp 508.
[proc,farming_flower_stage]()(int)
switch_loc (loc_type) {
    case farming_flower_patch_1 : return(%farming_flower_varp_0_7);
    case farming_flower_patch_2 : return(%farming_flower_varp_8_15);
    case farming_flower_patch_3 : return(%farming_flower_varp_16_23);
    case farming_flower_patch_4 : return(%farming_flower_varp_24_31);
    case default : return(-1);
}

[proc,farming_flower_set_stage](int $stage)
if ($stage = ^farming_veg_weeded & ~farming_flower_crop(~farming_flower_stage) ! null) ~farming_soil_clear(~farming_soil_index);
switch_loc (loc_type) {
    case farming_flower_patch_1 : %farming_flower_varp_0_7 = $stage;
    case farming_flower_patch_2 : %farming_flower_varp_8_15 = $stage;
    case farming_flower_patch_3 : %farming_flower_varp_16_23 = $stage;
    case farming_flower_patch_4 : %farming_flower_varp_24_31 = $stage;
}

// Native dispatch selects the visible form; loc_type retains the map parent.
[oplocu,farming_flower_patch_1] @farming_flower_use;
[oplocu,farming_flower_patch_2] @farming_flower_use;
[oplocu,farming_flower_patch_3] @farming_flower_use;
