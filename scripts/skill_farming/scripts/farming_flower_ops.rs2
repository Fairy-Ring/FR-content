[label,farming_flower_use]
def_int $stage = ~farming_flower_stage;
if ($stage = -1) {
    ~displaymessage(^dm_default);
    return;
}
if (last_useitem = bucket_compost | last_useitem = bucket_supercompost) {
    ~farming_soil_apply($stage);
    return;
}
if (last_useitem = rake & (($stage >= 0 & $stage < ^farming_veg_weeded) | ($stage >= 33 & $stage < 36))) {
    ~farming_rake_step(false);
    return;
}
// UNKNOWN placement on a weedy patch; cache weed forms do not prove the gate.
if (last_useitem = scarecrow_complete & $stage >= 0 & $stage <= ^farming_veg_weeded) {
    ~farming_scarecrow_install($stage);
    return;
}
if ($stage >= 33 & $stage <= 36) {
    ~farming_scarecrow_remove($stage);
    return;
}
def_dbrow $crop;
if ($stage = ^farming_veg_weeded) {
    $crop = ~farming_flower_seed(last_useitem);
    if ($crop = null) {
        ~displaymessage(^dm_default);
        return;
    }
    if (inv_total(inv, dibber) < 1) {
        ~displaymessage(^dm_farming_dibber);
        return;
    }
    def_obj $seed = db_getfield($crop, farming_flower:seed, 0);
    if (inv_total(inv, $seed) < 1) return;
    def_int $level = db_getfield($crop, farming_flower:level, 0);
    if (stat_base(farming) < $level) {
        // UNKNOWN functional wording.
        mes("You need a Farming level of <tostring($level)> to plant this flower.");
        return;
    }
    // CANDIDATE cache animation attribution. VERIFIED period one-seed cost.
    anim(farming_seed_dibbing, 0);
    inv_del(inv, $seed, 1);
    ~farming_flower_set_stage(db_getfield($crop, farming_flower:first, 0));
    stat_advance(farming, db_getfield($crop, farming_flower:plant_xp, 0));
    // UNKNOWN functional wording.
    mes("You plant the flower seed in the patch.");
    return;
}
$crop = ~farming_flower_crop($stage);
if ($crop = null) {
    ~displaymessage(^dm_default);
    return;
}
def_int $first = db_getfield($crop, farming_flower:first, 0);
def_int $mature = db_getfield($crop, farming_flower:mature, 0);
// The cache also maps a dead mature form; allow its ordinary spade clearing.
if ($stage = add($mature, ^farming_dead_offset)) $mature = add($mature, 1);
def_int $after = ~farming_crop_care($stage, $first, $mature, "flower", true);
if ($after ! $stage) ~farming_flower_set_stage($after);

[label,farming_flower_pick]
def_int $stage = ~farming_flower_stage;
def_dbrow $crop = ~farming_flower_crop($stage);
if ($crop = null) {
    ~displaymessage(^dm_farming_patch_no_crops);
    return;
}
if ($stage ! db_getfield($crop, farming_flower:mature, 0)) {
    ~displaymessage(^dm_farming_patch_no_crops);
    return;
}
// UNKNOWN flower-specific spade gate; general period wording does not establish it.
if (inv_total(inv, spade) < 1) {
    ~displaymessage(^dm_farming_spade);
    return;
}
def_int $yield = db_getfield($crop, farming_flower:yield, 0);
if (inv_freespace(inv) < $yield) {
    // UNKNOWN functional inventory-full wording.
    mes("You don't have enough inventory space.");
    return;
}
// VERIFIED period fixed yield, with picking XP awarded once, not per item.
// CANDIDATE cache animation attribution, shared with the published picking.
anim(picking_low, 0);
inv_add(inv, db_getfield($crop, farming_flower:produce, 0), $yield);
stat_advance(farming, db_getfield($crop, farming_flower:harvest_xp, 0));
~farming_flower_set_stage(^farming_veg_weeded);
// UNKNOWN functional wording.
mes("You pick the flowers from the patch.");
