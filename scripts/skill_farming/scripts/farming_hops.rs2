// VERIFIED named 377 cache bands. Direct lookup preserves the growth DB cursor.
[proc,farming_hops_crop](int $stage)(dbrow)
def_int $base = modulo($stage, ^farming_watered_offset);
def_dbrow $crop = null;
if ($base >= 4 & $base <= 10) $crop = farming_hops_hammerstone;
if ($base >= 11 & $base <= 18) $crop = farming_hops_asgarnian;
if ($base >= 19 & $base <= 27) $crop = farming_hops_yanillian;
if ($base >= 28 & $base <= 37) $crop = farming_hops_krandorian;
if ($base >= 38 & $base <= 48) $crop = farming_hops_wildblood;
if ($base >= 49 & $base <= 55) $crop = farming_hops_barley;
if ($base >= 56 & $base <= 63) $crop = farming_hops_jute;
if ($crop = null) return(null);
def_int $first = db_getfield($crop, farming_hops:first, 0);
def_int $mature = db_getfield($crop, farming_hops:mature, 0);
// Only the original cache's wet growth and diseased/dead intermediate forms.
if ($stage >= ^farming_diseased_offset) {
    if ($base <= $first | $base >= $mature) return(null);
} else if ($stage >= ^farming_watered_offset & $base >= $mature) return(null);
return($crop);

[proc,farming_hops_seed](obj $seed)(dbrow)
switch_obj ($seed) {
    case hammerstone_hop_seed, hammerstone_hop_seed_2, hammerstone_hop_seed_3, hammerstone_hop_seed_4, hammerstone_hop_seed_5 : return(farming_hops_hammerstone);
    case asgarnian_hop_seed, asgarnian_hop_seed_2, asgarnian_hop_seed_3, asgarnian_hop_seed_4, asgarnian_hop_seed_5 : return(farming_hops_asgarnian);
    case yanillian_hop_seed, yanillian_hop_seed_2, yanillian_hop_seed_3, yanillian_hop_seed_4, yanillian_hop_seed_5 : return(farming_hops_yanillian);
    case krandorian_hop_seed, krandorian_hop_seed_2, krandorian_hop_seed_3, krandorian_hop_seed_4, krandorian_hop_seed_5 : return(farming_hops_krandorian);
    case wildblood_hop_seed, wildblood_hop_seed_2, wildblood_hop_seed_3, wildblood_hop_seed_4, wildblood_hop_seed_5 : return(farming_hops_wildblood);
    case barley_seed, barley_seed_2, barley_seed_3, barley_seed_4, barley_seed_5 : return(farming_hops_barley);
    case jute_seed, jute_seed_2, jute_seed_3, jute_seed_4, jute_seed_5 : return(farming_hops_jute);
    case default : return(null);
}

// CANDIDATE shared legacy care: seed/mature immunity, one-cycle water,
// disease blocks growth and becomes death on the next uncured cycle.
[proc,farming_hops_advance](int $stage, int $steps, int $treatment)(int)
def_dbrow $crop = ~farming_hops_crop($stage);
if ($crop = null) return($stage);
return(~farming_crop_advance($stage, $steps, db_getfield($crop, farming_hops:first, 0), db_getfield($crop, farming_hops:mature, 0), true, $treatment));

[proc,farming_hops_advance_all](int $steps)
def_int $word = %farming_hops_varp;
def_int $bit = 0;
while ($bit < 32) {
    def_int $end = add($bit, 7);
    def_int $before = getbit_range($word, $bit, $end);
    def_int $stage = $before;
    def_int $index = add(8, divide($bit, 8));
    def_int $treatment = ~farming_soil_treatment($index);
    if (~farming_protection_watched(add(8, divide($bit, 8))) = true
        & $before < ^farming_diseased_offset & $steps > 0) {
        def_dbrow $crop = ~farming_hops_crop($before);
        if ($crop ! null) {
            def_int $mature = db_getfield($crop, farming_hops:mature, 0);
            $stage = min($mature, add(modulo($before, ^farming_watered_offset), $steps));
            if ($before >= $mature & $before < ^farming_watered_offset) $stage = $before;
        }
    } else {
        $stage = ~farming_hops_advance($before, $steps, $treatment);
    }
    if ($treatment ! 0 & $before ! $stage) {
        def_dbrow $harvestcrop = ~farming_hops_crop($stage);
        if ($harvestcrop ! null) ~farming_soil_mature($index, $before, $stage, db_getfield($harvestcrop, farming_hops:mature, 0));
    }
    $word = setbit_range_toint($word, $stage, $bit, $end);
    $bit = add($bit, 8);
}
%farming_hops_varp = $word;

// CANDIDATE shared Old School three-life model; endpoints are UNKNOWN.
[proc,farming_hops_life_loss]()(int)
return(~farming_crop_life_loss(^farming_hops_save_low, ^farming_hops_save_high));
