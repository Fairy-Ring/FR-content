    case farming_tree_patch_3 : return(%farming_tree_varp_16_23);
    case farming_tree_patch_4 : return(%farming_tree_varp_24_31);
    case farming_fruit_tree_patch_1 : return(%farming_fruit_tree_varp_0_7);
    case farming_fruit_tree_patch_2 : return(%farming_fruit_tree_varp_8_15);
    case farming_fruit_tree_patch_3 : return(%farming_fruit_tree_varp_16_23);
    case farming_fruit_tree_patch_4 : return(%farming_fruit_tree_varp_24_31);
    case farming_cactus_patch : return(%cactus_compost_varbit_basevar_0_5);
    case farming_belladonna_patch : return(%cactus_compost_varbit_basevar_16_21);
    case farming_mushroom_patch : return(%cactus_compost_varbit_basevar_8_13);
    case farming_calquat_tree_patch : return(%farming_special_tree_varp_24_29);
    case farming_spirit_tree_patch_1 : return(%farming_special_tree_varp_0_5);
    case farming_spirit_tree_patch_2 : return(%farming_special_tree_varp_8_13);
