// Read only: never reconcile growth or call a patch, inventory or XP writer.
[label,farming_inspect]
db_find(farming_inspect_patch:patch, loc_type);
def_dbrow $patch = db_findnext;
def_int $family = db_getfield($patch, farming_inspect_patch:family, 0);
def_int $state = ~farming_inspect_state(loc_type);
db_find(farming_inspect:state, calc($family * ^farming_inspect_state_stride + $state));
def_dbrow $row = db_findnext;
mes(db_getfield($row, farming_inspect:line, 0));
// CANDIDATE quotation: protection is a separate paragraph/message.
// Read the same neighbouring-flower pairing used by published growth.
// Only healthy growing sweetcorn is actually protected by a scarecrow.
if ($family = 1 & $state < ^farming_diseased_offset) {
    def_int $base = modulo($state, ^farming_watered_offset);
    if ($base >= 34 & $base < 40) {
        def_int $bit = multiply(divide(~farming_protection_loc_bit, 2), 8);
        def_int $flower = getbit_range(%farming_flower_varp, $bit, add($bit, 7));
        if ($flower >= 33 & $flower <= 36 & ~farming_flower_protects($flower, $state) = true) {
            mes(db_getfield(farming_inspect_scarecrow, farming_inspect:line, 0));
        }
    }
}

// VERIFIED original 377 selectors. Eight unplanted families bind only0..3.
[proc,farming_inspect_state](loc $patch)(int)
switch_loc ($patch) {
    case farming_veg_patch_1 : return(%farming_allotment_varp_1_0_7);
    case farming_veg_patch_2 : return(%farming_allotment_varp_1_8_15);
    case farming_veg_patch_3 : return(%farming_allotment_varp_1_16_23);
    case farming_veg_patch_4 : return(%farming_allotment_varp_1_24_31);
    case farming_veg_patch_5 : return(%farming_allotment_varp_2_0_7);
    case farming_veg_patch_6 : return(%farming_allotment_varp_2_8_15);
    case farming_veg_patch_7 : return(%farming_allotment_varp_2_16_23);
    case farming_veg_patch_8 : return(%farming_allotment_varp_2_24_31);
    case farming_flower_patch_1 : return(%farming_flower_varp_0_7);
    case farming_flower_patch_2 : return(%farming_flower_varp_8_15);
    case farming_flower_patch_3 : return(%farming_flower_varp_16_23);
    case farming_flower_patch_4 : return(%farming_flower_varp_24_31);
    case farming_herb_patch_1 : return(%bits_780_varp515_bits_0_7);
    case farming_herb_patch_2 : return(%bits_781_varp515_bits_8_15);
    case farming_herb_patch_3 : return(%bits_782_varp515_bits_16_23);
    case farming_herb_patch_4 : return(%bits_783_varp515_bits_24_31);
    case farming_hops_patch_1 : return(%farming_hops_varp_0_7);
    case farming_hops_patch_2 : return(%farming_hops_varp_8_15);
    case farming_hops_patch_3 : return(%farming_hops_varp_16_23);
    case farming_hops_patch_4 : return(%farming_hops_varp_24_31);
    case farming_bush_patch_1 : return(%farming_bush_varp_0_7);
    case farming_bush_patch_2 : return(%farming_bush_varp_8_15);
    case farming_bush_patch_3 : return(%farming_bush_varp_16_23);
    case farming_bush_patch_4 : return(%farming_bush_varp_24_31);
    case farming_tree_patch_1 : return(%farming_tree_varp_0_7);
