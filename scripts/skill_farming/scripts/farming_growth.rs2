// CANDIDATE: pre-rework OSRS Farming revision 5658331 (26 January 2018).
// Global UTC windows last five minutes. Each player's 500-game-tick timer
// resets at login/logout and can miss a window. No post-2018 offset or fix.

[proc,farming_growth_steps](int $last, int $now, int $period, boolean $offline)(int)
if ($last = 0 | $now <= $last) return(0);
if ($offline = true) {
    // UNKNOWN engineering catch-up arithmetic: the source confirms offline
    // growth and reset on logout, but gives no saved-time calculation.
    // Count only complete windows whose start follows the saved checkpoint.
    return(max(0, sub(divide(sub($now, ^farming_growth_window_minutes), $period), divide($last, $period))));
}
// Online timers do not replay missed windows or grant multiple stages.
if (modulo($now, $period) < ^farming_growth_window_minutes
    & divide($now, $period) > divide($last, $period)) return(1);
return(0);

[proc,farming_reconcile](boolean $offline)
def_int $now = date_minutes;
def_int $last = %farming_growth_minute;
if ($now < $last) return;
// Consume the shared range first so a script failure cannot replay writes.
%farming_growth_minute = $now;
db_listall(farming_growth);
def_dbrow $row = db_findnext;
while ($row ! null) {
    def_int $steps = ~farming_growth_steps($last, $now, db_getfield($row, farming_growth:period, 0), $offline);
    ~farming_growth_dispatch(db_getfield($row, farming_growth:handler, 0), $steps);
    $row = db_findnext;
}

[proc,farming_growth_dispatch](int $handler, int $steps)
if ($steps = 0) return;
switch_int ($handler) {
    case ^farming_handler_potato : ~farming_potato_advance_all($steps);
    case ^farming_handler_herb : ~farming_herb_advance_all($steps);
    case ^farming_handler_flower : ~farming_flower_advance_all($steps);
}

[proc,farming_login]
~farming_reconcile(true);
// Keep the player's phase even with no planted crop. Planting never resets it.
settimer(farming_growth, ^farming_growth_poll_ticks);

[proc,farming_logout]
def_int $now = date_minutes;
if ($now >= %farming_growth_minute) %farming_growth_minute = $now;
cleartimer(farming_growth);

[timer,farming_growth]
~farming_reconcile(false);
