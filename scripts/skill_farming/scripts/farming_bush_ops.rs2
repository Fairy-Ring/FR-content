// UNKNOWN functional action wording below; no period bush-action transcript retained.
// The patch parent keeps the original 256-stage selector; handlers attach to visible children.
[proc,farming_bush_stage]()(int)
switch_loc (loc_type) {
    case farming_bush_patch_1 : return(%farming_bush_varp_0_7);
    case farming_bush_patch_2 : return(%farming_bush_varp_8_15);
    case farming_bush_patch_3 : return(%farming_bush_varp_16_23);
    case farming_bush_patch_4 : return(%farming_bush_varp_24_31);
    case default : return(-1);
}

[proc,farming_bush_set_stage](int $stage)
def_int $before = ~farming_bush_stage;
if ($stage = ^farming_veg_weeded) {
    if (~farming_bush_crop($before) ! null) ~farming_soil_clear(~farming_soil_index);
    ~farming_protection_clear(~farming_protection_loc_bit);
}
switch_loc (loc_type) {
    case farming_bush_patch_1 : %farming_bush_varp_0_7 = $stage;
    case farming_bush_patch_2 : %farming_bush_varp_8_15 = $stage;
    case farming_bush_patch_3 : %farming_bush_varp_16_23 = $stage;
    case farming_bush_patch_4 : %farming_bush_varp_24_31 = $stage;
}

