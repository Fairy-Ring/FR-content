// CANDIDATE: pre-rework Farming revision 5658331 (26 January 2018).
// Zero-offset global :00/:10/:20/:30/:40/:50 windows. The period Tip.It guide
// supports shared ticks but describes five-minute allotment ticks instead.
[farming_growth_potato]
table=farming_growth
data=period,10
data=handler,1

// CANDIDATE: operator-adopted Old School herb family period; legacy windows.
[farming_growth_herb]
table=farming_growth
data=period,20
data=handler,2

// CANDIDATE pre-rework Old School family interval. Period Tip.It estimates
// 17.5 minutes total; four full five-minute windows are not that estimate.
[farming_growth_flower]
table=farming_growth
data=period,5
data=handler,3
