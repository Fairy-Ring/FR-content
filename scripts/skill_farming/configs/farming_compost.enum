// VERIFIED original map parents and permanent byte order in varp 511.
[farming_compost_patch]
inputtype=loc
outputtype=int
default=-1
val=farming_compost_bin_1,0
val=farming_compost_bin_2,1
val=farming_compost_bin_3,2
val=farming_compost_bin_4,3

// CANDIDATE classes: Jagex KB 1875, 29 April 2007; Farming wiki, 20 February 2007.
// The 2014 Compost Bin history names identified and unidentified herbs.
// Original 377 herb forms mirror their identified class; certificates stay refused.
// The 2007 wiki adds calquat fruit, coconut shells and white tree fruit.
// UNKNOWN encoding: refused 0, normal 1, super 2, tomato-only 3.
[farming_compost_ingredients]
inputtype=obj
outputtype=int
default=0
val=weeds,1
val=barley,1
val=hammerstone_hops,1
val=asgarnian_hops,1
val=jute_fibre,1
